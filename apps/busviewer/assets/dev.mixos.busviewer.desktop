[Desktop Entry]
Type=Application
Name=Bus Viewer
Comment=Browse and call MixOS Bus services
Exec=/opt/mixos/bin/busviewer
TryExec=/opt/mixos/bin/busviewer
Icon=dev.mixos.busviewer-symbolic
Terminal=false
Categories=Development;System;
StartupWMClass=dev.mixos.busviewer
