[Desktop Entry]
Type=Application
Name=DOpus
Comment=MixOS twin-pane file manager
Exec=@{prefix}/bin/dopus %F
TryExec=@{prefix}/bin/dopus
Icon=dev.mixos.dopus-symbolic
Terminal=false
Categories=System;FileManager;
MimeType=inode/directory;
StartupWMClass=dev.mixos.dopus
