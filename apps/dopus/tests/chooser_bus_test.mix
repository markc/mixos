-- SPDX-License-Identifier: MIT OR Apache-2.0
-- The real chooser, driven on a private nested compd and private broker.
-- No installed desktop, VT or service is touched. No local Rust build.
$n = require("../../../tests/desktop/nested_host_lib.mix")
$root = dirname(dirname(dirname(dirname(realpath($0)))))
$bin = env("MIXOS_TEST_BIN", $root .. "/target/debug")
$mix = env("MIXOS_TEST_MIX", $bin .. "/mix")
$dopus = env("MIXOS_TEST_DOPUS", $bin .. "/dopus")
$comp = env("MIXOS_TEST_COMPD", $bin .. "/compd")
$noded = env("MIXOS_TEST_NODED", $bin .. "/noded")
for $exe in [$mix, $dopus, $comp, $noded]
  if not is_file($exe) then raise("CHOOSER_TEST", "missing binary " .. $exe) end
end
$run = $n.new_run("/tmp/mixos-chooser")
$tmp = $run.path
$broker = nil
$session = nil
$provider = nil
$watcher = nil
$passed = false

fn check($condition, $message)
  if not $condition then raise("CHOOSER_TEST", $message) end
end

fn call($command, $body)
  $r = $n.call("files", $command, $body)
  check($r.rc == 0, $command .. ": " .. json_encode($r))
  return $r.result
end

fn choose($body)
  return call("files.choose", $body).request
end

fn drive($id, $command, $body)
  return call("files." .. $command, merge($body, {viewport:$id}))
end

fn ready($id)
  for $i = 1 to 80
    $r = $n.call("files", "files.ui.tree", {viewport:$id})
    if $r.rc == 0 and contains(json_encode($r.result), "Places") then return end
    sleep(0.1)
  end
  raise("CHOOSER_TEST", "chooser viewport did not draw: " .. $id .. " " .. json_encode($r))
end

fn click_end($id, $label)
  -- Closing the viewport can settle the drive input with CANCELLED. The
  -- request's outcome, checked below, is the authoritative acceptance.
  $r = $n.call("files", "files.ui.click", {viewport:$id, label:$label})
  check($r.rc == 0 or $r.result.error_code == "CANCELLED", "end click: " .. json_encode($r))
end

fn ended($id, $response, $reason)
  for $i = 1 to 80
    $r = call("files.choose.result", {request:$id})
    if $r.state == "done" then
      check($r.outcome.response == $response and $r.outcome.reason == $reason, "outcome: " .. json_encode($r))
      return $r.outcome
    end
    sleep(0.1)
  end
  raise("CHOOSER_TEST", "request did not end " .. $id)
end

fn topic($id)
  for $i = 1 to 80
    $events = if is_file($tmp .. "/chosen.jsonl") then lines(read_file($tmp .. "/chosen.jsonl")) else [] end
    $matches = []
    for $line in $events
      if trim($line) != "" then
        $event = json_parse($line)
        if $event.request == $id then push($matches, $event) end
      end
    end
    if len($matches) > 0 then
      check(len($matches) == 1, "duplicate outcome publication")
      return $matches[0]
    end
    sleep(0.1)
  end
  raise("CHOOSER_TEST", "no files.chosen event for " .. $id)
end

try
  $broker = $n.private_bus({dir:$tmp .. "/broker", name:"chooser-test", noded:$noded})
  mkdir($tmp .. "/home/Documents", {parents:true})
  write_file($tmp .. "/home/notes.txt", "original")
  write_file($tmp .. "/settings.json", "{}")
  $session = $n.start({bin:$comp, tag:"chooser", run:$run, config:$tmp .. "/settings.json", software:true})
  check($n.wait_ready($session, 40), "nested compd did not start: " .. $session.log)
  $client = $n.client_env($session, {HOME:$tmp .. "/home", XDG_CONFIG_HOME:$tmp .. "/config", XDG_STATE_HOME:$tmp .. "/state",
    MIXOS_COMP_SERVICE:$session.service, WINIT_UNIX_BACKEND:"wayland", WGPU_BACKEND:"gl", LIBGL_ALWAYS_SOFTWARE:"1",
    MESA_VK_WSI_PRESENT_MODE:"mailbox", MIXOS_NODED_URL:$broker.url})
  $provider = spawn([$dopus, "--choose-service", "--noded-url", $broker.url],
    {env:$client, stdout:{file:$tmp .. "/files.log"}, stderr:"stdout", detach:true})
  $up = false
  for $i = 1 to 100
    if not process_alive($provider) then break end
    $r = $n.call("files", "files.choose.list", {})
    if $r.rc == 0 then $up = true; break end
    sleep(0.1)
  end
  check($up, "files did not register: " .. $tmp .. "/files.log")
  write_file($tmp .. "/watch.mix", 'subscribe("files.chosen")' .. "\n" ..
    'write_file(env("CHOOSER_WATCH"), "")' .. "\n" ..
    'on files.chosen' .. "\n" .. '  append_file(env("CHOOSER_WATCH"), json_encode($event.args) .. "\n")' .. "\nend\n")
  $watcher = spawn([$mix, "--serve", $tmp .. "/watch.mix", "--name", "chooser-watch"],
    {env:{CHOOSER_WATCH:$tmp .. "/chosen.jsonl"}, stdout:{file:$tmp .. "/watch.log"}, stderr:"stdout", detach:true})
  for $i = 1 to 80
    if is_file($tmp .. "/chosen.jsonl") then break end
    sleep(0.1)
  end
  check(is_file($tmp .. "/chosen.jsonl"), "subscriber did not start")

  -- Drive the real path bar and name field, with no file writes by the chooser.
  $id = choose({mode:"save", current_folder:$tmp .. "/home", current_name:"draft", on_behalf_of:"test-app"})
  ready($id)
  drive($id, "ui.click", {label:"Path"})
  drive($id, "ui.key", {key:"A", modifiers:["ctrl"]})
  drive($id, "ui.type", {text:$tmp .. "/home/Documents"})
  drive($id, "ui.key", {key:"Enter"})
  drive($id, "ui.click", {label:"File name"})
  drive($id, "ui.key", {key:"A", modifiers:["ctrl"]})
  drive($id, "ui.type", {text:"new.txt"})
  click_end($id, "Save")
  $out = ended($id, 0, "chosen")
  check(deep_eq($out.uris, ["file://" .. $tmp .. "/home/Documents/new.txt"]), "save URIs: " .. json_encode($out))
  check(deep_eq(topic($id), $out), "topic differs from result")
  check(not exists($tmp .. "/home/Documents/new.txt"), "chooser wrote a file")
  $next = choose({mode:"save", current_name:"remembered.txt", on_behalf_of:"test-app"})
  ready($next)
  check(contains(json_encode(drive($next,"ui.tree",{})), "Documents"), "remembered folder was lost")
  click_end($next, "Cancel")
  ended($next, 1, "cancelled")
  topic($next)

  -- Two native choosers remain independent. Untargeted drive is refused.
  $a = choose({current_folder:$tmp .. "/home", title:"Chooser A"})
  $b = choose({directory:true, current_folder:$tmp .. "/home/Documents", title:"Chooser B"})
  ready($a)
  ready($b)
  $ambiguous = $n.call("files", "files.ui.tree", {})
  check($ambiguous.rc == 10 and $ambiguous.result.error_code == "ARGUMENT", "ambiguous drive was accepted")
  drive($a, "ui.click", {label:"notes.txt"})
  click_end($a, "Open")
  check(deep_eq(ended($a,0,"chosen").uris, ["file://" .. $tmp .. "/home/notes.txt"]), "open URI")
  check(call("files.choose.result", {request:$b}).state == "open", "A ended B")
  click_end($b, "Open")
  check(deep_eq(ended($b,0,"chosen").uris, ["file://" .. $tmp .. "/home/Documents"]), "directory URI")
  topic($a)
  topic($b)
  $id = choose({})
  ready($id)
  call("files.choose.cancel", {request:$id})
  ended($id,1,"caller")
  topic($id)
  call("files.choose.cancel", {request:$id})
  check(len(call("files.choose.list", {}).requests) == 0, "chooser leaked after cancel")
  $id = choose({})
  ready($id)
  $r = $n.call("files", "files.window", {viewport:$id, action:"close"})
  ended($id,1,"cancelled")
  topic($id)
  $passed = true
  print("PASS chooser window Bus, native viewports, save, open, directory, cancel, close, remembered folder and concurrent drive")
finally
  for $child in [$provider, $watcher]
    if $child != nil and process_alive($child) then kill($child,15) end
  end
  if $session != nil then $n.stop($session) end
  if $broker != nil and process_alive($broker.pid) then kill($broker.pid,15) end
  $n.finish_run($run,$passed)
end
