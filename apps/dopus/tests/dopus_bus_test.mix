-- End-to-end (dopus P4): a private noded and the real `mixos-dopus
-- --headless --service dopus-test --noded-url …`, driven by one-shot Mix
-- clients. The twin panes are proven over the Bus: dopus.info reports two
-- panes; dopus.open lands the first PATH in the left pane and the second in
-- the right (extras logged and ignored, `~` expanded); nav.switch-pane (Tab)
-- flips the active pane and every active-pane command (view.sort-* with law 5's
-- same-column toggle, view.toggle-hidden, nav.parent/back/forward/home,
-- selection.*) moves only the active pane while dopus.state shows both;
-- refusals stay honest (unknown action INVALID_ARGUMENT, unknown command
-- UNKNOWN_COMMAND, theme.set AND the theme.* actions UNAVAILABLE headless).
-- File actions use the same core path over the Bus. Headless cancels
-- prompts and confirmations because it has no window; copy and move use
-- the real worker and change files. Windowed prompt/confirm/drop answers
-- are covered through drive input in tests/prompt.rs.
-- Accepted actions appear on dopus-test.action.executed in order, origin bus.
--
-- Nothing here can reach the host Bus: private TCP port, private unix
-- socket, admission off, HOME and state dirs in the temp dir.
--
-- Run: MIXOS=<checkout> mix apps/dopus/tests/dopus_bus_test.mix [--dopus PATH]
-- Binaries: --dopus (or MIXOS_TEST_DOPUS), default
-- $MIXOS/target/release-fast/dopus; MIXOS_TEST_MIX /
-- MIXOS_TEST_NODED point at freshly built mix / noded, defaults are the
-- system install.
$root = env("MIXOS")
if $root == "" then raise("TEST_CONFIG", "set MIXOS to the checkout root") end
$argv = args()
$dopus = env("MIXOS_TEST_DOPUS") ?? ""
for each $k in range(0, length($argv) - 2)
  if $argv[$k] == "--dopus" then $dopus = $argv[$k + 1] end
end
if $dopus == "" then $dopus = $root .. "/target/release-fast/dopus" end
$mix = env("MIXOS_TEST_MIX") ?? ""
if $mix == "" then $mix = (mixos_path("prefix") .. "/bin/mix") end
$noded = env("MIXOS_TEST_NODED") ?? ""
if $noded == "" then $noded = (mixos_path("prefix") .. "/bin/noded") end
for each $bin in [$dopus, $mix, $noded]
  if not exists($bin) then raise("TEST_CONFIG", "missing binary " .. $bin) end
end
$tmp = trim(run_argv_must(["mktemp", "-d", "/tmp/mixos-dopus-bus-test.XXXXXXXX"]))
$tag = uuid()
$node = $tmp .. "/node.conf.mix"
$env = {MIXOS_NODE_CONFIG: $node, MIX_STATS: "off", PATH: "/usr/bin:/bin",
  HOME: $tmp, XDG_STATE_HOME: $tmp, XDG_RUNTIME_DIR: $tmp, XDG_CONFIG_HOME: $tmp .. "/config",
  DOPUS_LOG: "info"}
$noded_pid = nil
$dopus_pid = nil
$chooser_pid = nil
$target = "dopus-test"
$alpha = $tmp .. "/work/alpha"
$beta = $tmp .. "/work/beta"
$gamma = $tmp .. "/work/gamma"
-- dopus-test.action.executed, one JSON line per delivery, written by a
-- `mix --serve` watcher; $expected is every accepted dopus.execute id, in order.
$watch_pid = nil
$watch_out = $tmp .. "/executed.jsonl"
$expected = []

fn check($condition, $message)
  if not $condition then raise("DOPUS_BUS_TEST", $message) end
end
-- One-shot client. `$line` is literal Mix source after `send dopus-test`;
-- runtime values come in as `$a`, decoded from argv.
fn call($line, $a)
  $src = "$a = json_parse($1)\nsend " .. $target .. " " .. $line ..
    " timeout=15\nprint(json_encode({rc: $rc, result: $result, reply: $reply}))\n"
  write_file($tmp .. "/step.mix", $src)
  $run = run_argv([$mix, $tmp .. "/step.mix", json_encode($a)], {clear_env: true, env: $env, timeout: 20})
  check($run.ok, "client step failed (exit " .. to_string($run.exit_code) .. "): " .. $run.stderr .. $run.stdout ..
    "\n--- step.mix\n" .. $src .. "--- args " .. json_encode($a))
  return json_parse($run.stdout)
end
fn ok($line, $a)
  $r = call($line, $a)
  check($r.rc == 0, "dopus-test " .. $line .. " failed: " .. json_encode($r))
  return $r.reply
end
-- A call that must be refused with rc 10 + this error_code.
fn refused($line, $a, $code)
  $r = call($line, $a)
  check($r.rc == 10, "dopus-test " .. $line .. " not refused: " .. json_encode($r))
  check($r.reply.error_code == $code, "dopus-test " .. $line .. " wrong error_code: " .. json_encode($r.reply))
  return $r.reply
end
fn act($id)
  $reply = ok('dopus.execute id=$a.id', {id: $id})
  push($expected, $id)
  return $reply
end
fn act_on($id, $pane)
  $reply = ok('dopus.execute body=$a.body', {body: json_encode({id: $id, params: {pane: $pane}})})
  push($expected, $id)
  return $reply
end
-- The executed runs the watcher has seen so far, minus its readiness probes.
fn executed()
  $rows = []
  for each $line in lines(read_file($watch_out))
    if $line != "" and not contains($line, $tag) then push($rows, json_parse($line)) end
  end
  return $rows
end
-- The pane's row in dopus.state (re-fetched each time: state only moves
-- through commands, and every command here answers before the next call).
fn pane($index)
  $st = ok('dopus.state', {})
  check(length($st.panes) == 2, "dopus.state has " .. to_string(length($st.panes)) .. " panes")
  return $st.panes[$index]
end
fn pane_is($index, $path, $what)
  $p = pane($index)
  check($p.path == $path, $what .. ": pane " .. to_string($index) .. " at " .. $p.path .. ", wanted " .. $path)
  return $p
end

try
  mkdir($tmp .. "/work")
  mkdir($alpha)
  mkdir($beta)
  mkdir($beta .. "/sub")
  mkdir($gamma)
  write_file($alpha .. "/a.txt", "a\n")
  write_file($beta .. "/b.txt", "b\n")

  $broker_alive = false
  for each $attempt in range(1, 5)
    $port = random(48000, 48999)
    -- The private-broker config shape ced_nested_gate.mix proves live: JSON
    -- is legal node.conf.mix content, and noded REFUSES a set-but-missing
    -- MIXOS_NODE_CONFIG — the file must exist.
    write_file($node, json_encode({node: "dopus-bus-test-" .. $tag, wg_ip: "", mesh: "dopus-bus-test.invalid",
      noded: {port: $port, admission: "off", unix_socket: $tmp .. "/bus.sock"}}))
    $noded_pid = spawn([$noded, "serve", "--listen", "127.0.0.1:" .. to_string($port),
      "--node", "dopus-bus-test-" .. $tag, "--no-monitor", "--no-log"],
      {detach: true, clear_env: true, env: $env, stdout: {file: $tmp .. "/noded.log"}, stderr: "stdout"})
    sleep(0.5)
    $broker_alive = run_argv(["kill", "-0", "--", to_string($noded_pid)]).ok
    if $broker_alive then break end
  end
  check($broker_alive, "broker exhausted port retries")

  -- Broker URLs carry the /ws path (mixos-lib-config's own loopback
  -- fallback is ws://127.0.0.1:4200/ws — a bare host:port never connects).
  $url = "ws://127.0.0.1:" .. to_string($port) .. "/ws"
  $dopus_pid = spawn([$dopus, "--headless", "--service", "dopus-test", "--noded-url", $url],
    {detach: true, clear_env: true, env: $env, stdout: {file: $tmp .. "/dopus.log"}, stderr: "stdout"})
  -- Harness startup wait (bounded).
  $pong = nil
  for each $i in range(1, 80)
    $r = call('dopus.ping', {})
    if $r.rc == 0 then $pong = $r.reply; break end
    sleep(0.2)
  end
  check($pong != nil, "dopus --headless did not register")
  check($pong.pong and $pong.service == "dopus-test" and $pong.schema == "dopus.v1" and $pong.headless,
    "dopus.ping: " .. json_encode($pong))
  $desc = ok('dopus.describe', {})
  check($desc.contract == "ctk-app-control.v0" and $desc.app == "dopus" and $desc.engine == "egui"
    and contains(join($desc.commands, " "), "dopus.state"),
    "dopus.describe: " .. json_encode($desc))

  -- 0. watch dopus-test.action.executed. The `on` line must name the full
  -- topic, and subscribe() returns before the broker confirms it, so publish
  -- probes (carrying $tag) until one comes back: then the watcher is live.
  -- The bare hyphenated `on` name needs mix 0.113.1 or later.
  write_file($tmp .. "/watch.mix", "subscribe(\"dopus-test.action.executed\")\nwrite_file(env(\"WATCH_OUT\"), \"\")\n" ..
    "on dopus-test.action.executed\n  append_file(env(\"WATCH_OUT\"), json_encode($event.args) .. \"\\n\")\nend\n")
  write_file($tmp .. "/probe.mix", "publish(\"dopus-test.action.executed\", json_encode({probe: $1}))\nexit(if $rc == 0 then 0 else 1 end)\n")
  $watch_pid = spawn([$mix, "--serve", $tmp .. "/watch.mix", "--name", "dopus-test-watch"],
    {detach: true, clear_env: true, env: merge($env, {WATCH_OUT: $watch_out}),
     stdout: {file: $tmp .. "/watch.log"}, stderr: "stdout"})
  $watching = false
  for each $i in range(1, 50)
    if exists($watch_out) then
      $_probe = run_argv([$mix, $tmp .. "/probe.mix", $tag], {clear_env: true, env: $env, timeout: 10})
      sleep(0.2)
      if contains(read_file($watch_out), $tag) then $watching = true; break end
    else
      sleep(0.2)
    end
  end
  check($watching, "the executed-topic watcher never saw its own probe")

  -- 1. boot: two panes, both at home, pane 0 active, name ascending
  $info = ok('dopus.info', {})
  check($info.headless and $info.panes == 2, "dopus.info: " .. json_encode($info))
  $p0 = pane(0)
  $p1 = pane(1)
  check($p0.active and not $p1.active, "boot active pane: " .. json_encode([$p0, $p1]))
  check($p0.path == $tmp and $p1.path == $tmp, "boot paths: " .. json_encode([$p0.path, $p1.path]))
  check($p0.sort == "name" and $p0.ascending and $p1.sort == "name" and $p1.ascending, "boot sort: " .. json_encode([$p0, $p1]))
  check(not $p0.show_hidden and not $p1.show_hidden, "boot hidden: " .. json_encode([$p0, $p1]))

  -- 2. dopus.open: first path → left pane, second → right pane
  $op = ok('dopus.open paths=[$a.l, $a.r]', {l: $alpha, r: $beta})
  check($op.opened and $op.accepted == 2, "dopus.open: " .. json_encode($op))
  pane_is(0, $alpha, "open left")
  pane_is(1, $beta, "open right")
  $p0 = pane(0)
  check($p0.active, "open did not move the active pane")

  -- 3. a third path is logged and ignored
  $op = ok('dopus.open paths=[$a.l, $a.r, $a.x]', {l: $alpha, r: $beta, x: $gamma})
  check($op.accepted == 3 and $op.opened, "dopus.open extras: " .. json_encode($op))
  pane_is(0, $alpha, "extras left")
  pane_is(1, $beta, "extras right")

  -- 3b. Explicit right-pane navigation while LEFT stays active. Restore
  -- beta before continuing the legacy default-active checks below.
  act_on("nav.parent", "right")
  pane_is(1, $tmp .. "/work", "targeted parent right")
  $p0 = pane_is(0, $alpha, "targeted parent left untouched")
  check($p0.active and not pane(1).active, "targeted navigation stole focus")
  act_on("nav.back", 1)
  pane_is(1, $beta, "targeted back right")
  ok('dopus.open paths=[$a.g] pane="right"', {g: $gamma})
  pane_is(1, $gamma, "targeted open right")
  check(pane_is(0, $alpha, "targeted open left untouched").active, "targeted open stole focus")
  ok('dopus.open paths=[$a.b] pane=1', {b: $beta})
  act_on("view.sort-size", "right")
  check(pane(1).sort == "size" and pane(0).sort == "name", "targeted sort leaked")
  act_on("view.sort-name", "right")
  refused('dopus.execute body=$a.body', {body: json_encode({id: "nav.parent", params: {pane: "other"}})}, "INVALID_ARGUMENT")
  -- The pre-family body shape (pane at the top level) is refused too.
  refused('dopus.execute id="nav.parent" pane="left"', {}, "INVALID_ARGUMENT")
  refused('dopus.open paths=[] pane="right"', {}, "INVALID_ARGUMENT")
  $info = ok('dopus.info', {})
  check($info.panes == 2 and length($info.pane_states) == 2
    and $info.pane_states[0].pane == 0 and $info.pane_states[0].active
    and $info.pane_states[1].pane == 1 and not $info.pane_states[1].active,
    "info pane state shape: " .. json_encode($info))

  -- 4. nav.switch-pane flips the active pane
  act("nav.switch-pane")
  $p1 = pane(1)
  check($p1.active and not pane(0).active, "switch-pane flipped active: " .. json_encode([$p0, $p1]))

  -- 5. sort on the ACTIVE pane only; same-column repeats toggle (law 5)
  act("view.sort-size")
  $p1 = pane(1)
  check($p1.sort == "size" and $p1.ascending, "sort size: " .. json_encode($p1))
  check(pane(0).sort == "name", "sort leaked to the idle pane")
  act("view.sort-size")
  $p1 = pane(1)
  check($p1.sort == "size" and not $p1.ascending, "same-column toggle: " .. json_encode($p1))
  act("view.sort-name")
  $p1 = pane(1)
  check($p1.sort == "name" and $p1.ascending, "column switch is ascending: " .. json_encode($p1))

  -- 6. hidden files on the ACTIVE pane only
  act("view.toggle-hidden")
  check(pane(1).show_hidden and not pane(0).show_hidden, "toggle-hidden: " .. json_encode([pane(0), pane(1)]))
  act("view.toggle-hidden")
  check(not pane(1).show_hidden, "toggle-hidden back")
  -- previews (thumbnails) on by default, per pane
  check(pane(1).previews and pane(0).previews, "previews default on: " .. json_encode([pane(0), pane(1)]))
  act("view.toggle-previews")
  check(not pane(1).previews and pane(0).previews, "toggle-previews: " .. json_encode([pane(0), pane(1)]))
  act("view.toggle-previews")
  check(pane(1).previews, "toggle-previews back")

  -- 7. navigation on the ACTIVE pane (pane 1, at beta): parent, back, forward, home
  act("nav.parent")
  pane_is(1, $tmp .. "/work", "parent")
  pane_is(0, $alpha, "parent left the idle pane alone")
  act("nav.back")
  pane_is(1, $beta, "back")
  act("nav.forward")
  pane_is(1, $tmp .. "/work", "forward")
  act("nav.home")
  pane_is(1, $tmp, "home")

  -- 8. `~` expands to home in dopus.open paths
  -- Single-quoted on purpose: Mix expands double-quoted "~/…" at PARSE time
  -- (feedback_mix_tilde_needle_single_quotes), which would substitute the
  -- harness's HOME before dopus ever sees the tilde. The tilde must reach
  -- dopus raw so IT expands it against the process HOME under test ($tmp).
  ok('dopus.open paths=[$a.t]', {t: '~/work/gamma'})
  pane_is(0, $gamma, "tilde expand")
  ok('dopus.open paths=[$a.l, $a.r]', {l: $alpha, r: $beta})

  -- 9. selection acts on the ACTIVE pane (both panes have rows). Listings
  -- are async: wait (bounded ~5 s) until BOTH panes report rows, or
  -- selection.next races an empty listing and "selects" nothing.
  $listed = false
  for each $i in range(1, 25)
    $st = ok('dopus.state', {})
    if $st.panes[0].rows > 0 and $st.panes[1].rows > 0 then $listed = true; break end
    sleep(0.2)
  end
  check($listed, "listings never landed in 5 s: " .. json_encode($st))
  act("selection.next")
  $active = if pane(0).active then pane(0) else pane(1) end
  check($active.selected != nil, "selection.next selected nothing: " .. json_encode($active))
  act("selection.first")
  $active = if pane(0).active then pane(0) else pane(1) end
  check($active.selected != nil, "selection.first selected nothing: " .. json_encode($active))

  -- 9b. the availability flags are not vacuous: exercise BOTH states
  -- through real core transitions. Availability is ACTIVE-pane scoped, and
  -- §9/§4 left pane 1 active with its §9 selection — flip to pane 0 first,
  -- then navigate it to gamma (EMPTY — selection clears on nav): nothing
  -- to act on, every selection-taking file.* row reads disabled;
  -- file.new-folder stays ENABLED (it needs only the idle single-flight
  -- slot — a new folder is exactly what an empty dir is for). Back on
  -- alpha with a fresh selection, all seven read enabled (file.mail too:
  -- alpha's one entry, a.txt, is a regular file).
  act("nav.switch-pane")
  ok('dopus.open paths=[$a.g]', {g: $gamma})
  $acts = ok('dopus.actions', {})
  $disabled = 0
  for each $row in $acts.actions
    if starts_with($row.id, "file.") then
      if $row.id == "file.new-folder" then
        check($row.enabled, "new-folder must stay enabled in an empty dir: " .. json_encode($row))
      else
        check(not $row.enabled, $row.id .. " must be disabled without a selection: " .. json_encode($row))
        $disabled = $disabled + 1
      end
    end
  end
  check($disabled == 6, "expected 6 disabled file rows in an empty dir, got " .. to_string($disabled))
  ok('dopus.open paths=[$a.l]', {l: $alpha})
  $relisted = false
  for each $i in range(1, 25)
    if pane(0).rows > 0 then $relisted = true; break end
    sleep(0.2)
  end
  check($relisted, "alpha listing never came back in 5 s: " .. json_encode(pane(0)))
  act("selection.next")
  $acts = ok('dopus.actions', {})
  $enabled = 0
  for each $row in $acts.actions
    if starts_with($row.id, "file.") then
      check($row.enabled, $row.id .. " must be enabled with a selection: " .. json_encode($row))
      $enabled = $enabled + 1
    end
  end
  check($enabled == 7, "expected 7 enabled file rows with a selection, got " .. to_string($enabled))

  -- 10. refusals stay honest
  refused('dopus.execute id="no.such-action"', {}, "INVALID_ARGUMENT")
  refused('dopus.execute id="location.focus"', {}, "UNAVAILABLE")
  $acts = ok('dopus.actions', {})
  $location_rows = 0
  for each $row in $acts.actions
    if $row.id == "location.focus" then
      $location_rows = $location_rows + 1
      check(not $row.enabled, "headless location.focus must be disabled")
    end
  end
  check($location_rows == 1, "actions.list must contain location.focus")

  -- P4: plain panel state exists headless, but toggles require a window.
  $before_panels = ok('dopus.state', {})
  check($before_panels.places.open and $before_panels.properties.open,
    "both panels default open")
  check($before_panels.places.width > 0.149 and $before_panels.places.width < 0.151
    and $before_panels.properties.width > 0.219 and $before_panels.properties.width < 0.221,
    "panel defaults must be Places 15%, Properties 22%")
  for each $id in ["view.toggle-places", "view.toggle-properties"]
    $refusal = refused('dopus.execute body=$a.body', {body: json_encode({id: $id, params: {pane: "right"}})}, "UNAVAILABLE")
    check($refusal.reason == "headless", $id .. " must report headless")
    $found = 0
    for each $row in $acts.actions
      if $row.id == $id then
        $found = $found + 1
        check(not $row.enabled, $id .. " must be disabled headless")
        check(length($row.keys) > 0, $id .. " needs a default key")
      end
    end
    check($found == 1, "missing or duplicate action " .. $id)
  end
  $after_panels = ok('dopus.state', {})
  check(deep_eq($after_panels.places, $before_panels.places)
    and deep_eq($after_panels.properties, $before_panels.properties),
    "refused headless toggles changed panel state")
  refused('dopus.frobnicate', {}, "UNKNOWN_COMMAND")
  refused('dopus.theme.set mode="dark"', {}, "UNAVAILABLE")
  -- Theme actions need a painter and remain UNAVAILABLE headless.
  refused('dopus.execute id="theme.mode-toggle"', {}, "UNAVAILABLE")
  refused('dopus.execute id="theme.scheme-ocean"', {}, "UNAVAILABLE")
  -- A second registration under the same name must fail (single instance):
  $dupe = run_argv([$dopus, "--headless", "--service", "dopus-test", "--noded-url", $url],
    {clear_env: true, env: $env, timeout: 20})
  check(not $dupe.ok, "a second dopus-test registered")
  check(contains($dupe.stderr, "already registered"), "duplicate diagnostics: " .. $dupe.stderr)

  -- Chooser mode is a separate service, with no main window and no DOpus
  -- commands. Stage 2a has no presenter, so a valid request is UNAVAILABLE.
  refused('files.choose', {}, "UNKNOWN_COMMAND")
  $target = "files"
  $chooser_pid = spawn([$dopus, "--choose-service", "--noded-url", $url],
    {detach: true, clear_env: true, env: $env, stdout: {file: $tmp .. "/files.log"}, stderr: "stdout"})
  $chooser_ready = false
  for $i = 1 to 80
    $r = call('files.choose.list', {})
    if $r.rc == 0 then $chooser_ready = true; break end
    sleep(0.2)
  end
  check($chooser_ready, "chooser service did not register")
  $listing = $r.reply
  check(re_match($listing.incarnation, "^[0-9a-f]{16}$") and length($listing.requests) == 0,
    "chooser initial list: " .. json_encode($listing))
  $chooser_desc = ok('app.describe', {})
  check($chooser_desc.app == "files" and length($chooser_desc.commands) == 20 and deep_eq(slice($chooser_desc.commands, 0, 4),
    ["files.choose", "files.choose.result", "files.choose.cancel", "files.choose.list"]),
    "chooser command set: " .. json_encode($chooser_desc))
  $chooser_help = ok('HELP', {})
  check(length($chooser_help) == 22, "chooser HELP must list chooser, drive and discovery commands")
  refused('dopus.ping', {}, "UNKNOWN_COMMAND")
  refused('dopus.quit', {}, "UNKNOWN_COMMAND")
  refused('files.choose mode="bad"', {}, "ARGUMENT")
  refused('files.choose mode="save" multiple=false', {}, "ARGUMENT")
  refused('files.choose mode="save_files"', {}, "ARGUMENT")
  refused('files.choose', {}, "UNAVAILABLE")
  refused('files.choose mode="save" current_name="file.txt"', {}, "UNAVAILABLE")
  refused('files.choose mode="save_files" files=["a", "b"]', {}, "UNAVAILABLE")
  $unknown = $listing.incarnation .. "-1"
  $result = refused('files.choose.result request=$a.id', {id: $unknown}, "ARGUMENT")
  check($result.reason == "unknown", "unknown result must carry reason")
  ok('files.choose.cancel request=$a.id', {id: $unknown})
  ok('files.choose.cancel request="0000000000000000-1"', {})
  refused('files.choose.cancel request="bad"', {}, "ARGUMENT")
  check(length(ok('files.choose.list', {}).requests) == 0, "refused chooser kept a request")
  $target = "dopus-test"

  -- 10b. Every file action is reachable. Headless answers modal requests
  -- No; windowed callers answer the same dialogs through drive input.
  for $id in ["file.open", "file.new-folder", "file.rename", "file.delete"]
    act($id)
    sleep(0.3)
  end
  check(is_file($alpha .. "/a.txt"), "headless delete must await confirmation")
  act("file.copy-other-pane")
  for $attempt = 1 to 50
    if is_file($beta .. "/a.txt") then break end
    sleep(0.1)
  end
  check(read_file($beta .. "/a.txt") == "a\n", "Bus copy did not preserve bytes")
  sleep(0.3)
  run_argv_must(["rm", "--", $beta .. "/a.txt"])
  act("selection.first")
  act("file.move-other-pane")
  for $attempt = 1 to 50
    if not is_file($alpha .. "/a.txt") and is_file($beta .. "/a.txt") then break end
    sleep(0.1)
  end
  check(not is_file($alpha .. "/a.txt") and read_file($beta .. "/a.txt") == "a\n", "Bus move did not move bytes")
  -- State keeps its documented shape after file operations.
  $st = ok('dopus.state', {})
  check(length($st.panes) == 2, "dopus.state panes: " .. json_encode($st))
  $p = $st.panes[0]
  check($p.pane == 0 and $p.path != nil and $p.active != nil and $p.show_hidden != nil
    and $p.sort != nil and $p.ascending != nil and $p.rows != nil and $p.status != nil
    and $p.summary != nil
    and $st.theme_scheme != nil and $st.theme_mode != nil,
    "dopus.state shape: " .. json_encode($st))
  -- actions.list describes the same availability for keyboard and Bus.
  $acts = ok('dopus.actions', {})
  $file_rows = 0
  for each $row in $acts.actions
    if starts_with($row.id, "file.") then
      $file_rows = $file_rows + 1
      check($row.enabled != nil, "file row without enabled: " .. json_encode($row))
    end
  end
  check($file_rows == 7, "expected 7 file.* rows in actions.list, got " .. to_string($file_rows))

  -- 10c. dopus-test.action.executed carried every accepted dopus.execute, in
  -- order, from the bus, and nothing else: no refused action (unknown id,
  -- bad pane, headless-unavailable, theme.*) and no other command.
  -- The publisher is async: wait for the count, then a beat for strays.
  for each $i in range(1, 50)
    if length(executed()) >= length($expected) then break end
    sleep(0.1)
  end
  sleep(0.5)
  $runs = executed()
  $ids = []
  for each $row in $runs
    push($ids, $row.id)
  end
  check(length($expected) > 10, "only " .. to_string(length($expected)) .. " actions were recorded as accepted")
  check(deep_eq($ids, $expected),"executed ids " .. json_encode($ids) .. ", wanted " .. json_encode($expected))
  for each $k in range(0, length($runs) - 1)
    $row = $runs[$k]
    check($row.v == 2 and has_key($row, "params") and $row.params == nil
      and has_key($row, "result") and $row.result == nil
      and $row.origin == "bus" and $row.seq == $k + 1 and $row.dropped == 0
      and $row.run == $runs[0].run and $row.run != "" and $row.at_ms > 0,
      "executed run " .. to_string($k + 1) .. ": " .. json_encode($row))
  end

  -- 11. dopus.quit answers rc 0 BEFORE the process exits (item 6: the reply
  -- arrives on this client's send — an exit-first shape would time out here)
  $q = ok('dopus.quit', {})
  check($q.quitting, "dopus.quit: " .. json_encode($q))
  $exited = false
  for each $i in range(1, 100)
    if not process_alive($dopus_pid) then $exited = true; break end
    sleep(0.1)
  end
  check($exited, "dopus still running 10 s after dopus.quit")
  $dopus_pid = nil
  print("PASS dopus headless e2e: boot twin-pane state, dopus.open pane routing + extras ignored + tilde, switch-pane, active-pane sort (law 5 toggle)/hidden/nav/selection, refusals (unknown action/command, theme.set + theme.*), file actions open (headless modal cancellation, real copy/move, shared availability), single instance, executed topic (every accepted action in order, origin bus, seq from 1, refusals absent), reply-then-exit quit")
catch $err
  for each $log in glob($tmp .. "/*.log")
    print("--- " .. $log .. "\n" .. read_file($log))
  end
  raise("DOPUS_BUS_TEST", to_string($err))
finally
  -- Cleanup raises NOTHING (run_argv, never run_argv_must): a cleanup
  -- failure must never mask the original error raised in the try body.
  for each $child in [$chooser_pid, $watch_pid, $dopus_pid, $noded_pid]
    if $child != nil then
      $_kill = run_argv(["kill", "--", to_string($child)], {timeout: 10})
      -- Bounded exit wait before rm -rf: kill(1) returns before the
      -- process dies, and rm must not race a child still writing into $tmp.
      for each $i in range(1, 50)
        if not process_alive($child) then break end
        sleep(0.1)
      end
    end
  end
  if starts_with($tmp, "/tmp/mixos-dopus-bus-test.") then
    $_remove = run_argv(["rm", "-rf", "--", $tmp], {timeout: 30})
    if not $_remove.ok then print("CLEANUP FAILED (original error above): rm -rf " .. $tmp) end
  end
end
