[Unit]
Description=MixOS file chooser for session %i
# The session target chooses the broker (noded@%i or the system noded.service);
# this unit only orders after both. Never Wants= or Requires= a broker: on a desk
# with the system broker noded@%i is masked.
After=noded@%i.service noded.service
PartOf=session@%i.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=mixos
EnvironmentFile=@{etc}/session/%i.env
ExecStart=@{prefix}/bin/dopus --choose-service
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=15
