[Desktop Entry]
Type=Application
Name=Monitor
Comment=Processes and performance for this node and the mesh
Exec=@{prefix}/bin/monitor
TryExec=@{prefix}/bin/monitor
Icon=dev.mixos.monitor-symbolic
Terminal=false
Categories=System;Monitor;
Keywords=task;manager;process;cpu;memory;
StartupWMClass=dev.mixos.monitor
