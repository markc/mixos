[Desktop Entry]
Type=Application
Name=Preferences
Comment=MixOS desktop preferences
Exec=@{prefix}/bin/prefs
TryExec=@{prefix}/bin/prefs
Icon=dev.mixos.prefs-symbolic
Terminal=false
Categories=Settings;
StartupWMClass=dev.mixos.prefs
Keywords=prefs;settings;preferences;
