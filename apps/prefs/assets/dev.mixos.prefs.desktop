[Desktop Entry]
Type=Application
Name=Preferences
Comment=MixOS desktop preferences
Exec=/opt/mixos/bin/prefs
TryExec=/opt/mixos/bin/prefs
Icon=dev.mixos.prefs-symbolic
Terminal=false
Categories=Settings;
StartupWMClass=dev.mixos.prefs
Keywords=prefs;settings;preferences;
