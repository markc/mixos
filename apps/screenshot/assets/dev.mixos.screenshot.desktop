# SPDX-License-Identifier: MIT OR Apache-2.0
[Desktop Entry]
Type=Application
Name=Screenshot
Comment=Screenshots and annotations
Exec=@{prefix}/bin/screenshot %f
TryExec=@{prefix}/bin/screenshot
Icon=dev.mixos.screenshot-symbolic
Terminal=false
Categories=Utility;Graphics;
MimeType=image/png;
StartupWMClass=dev.mixos.screenshot
Actions=Region;Screen;

[Desktop Action Region]
Name=Screenshot of a region
Exec=@{prefix}/bin/screenshot --capture region

[Desktop Action Screen]
Name=Screenshot of the screen
Exec=@{prefix}/bin/screenshot --capture screen
