# Interim session unit: the headless screenshot Bus service for session %i.
# Moves into deskd when deskd lands (see docs/screenshot.md, "Session service").
[Unit]
Description=MixOS screenshot Bus service (headless) for session %i
Wants=compd@%i.service
After=compd@%i.service
PartOf=session@%i.target

[Service]
Type=simple
User=markc
EnvironmentFile=/etc/mixos/session/%i.env
ExecStart=/opt/mixos/bin/screenshot --headless
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=1
