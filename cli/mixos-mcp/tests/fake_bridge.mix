-- Unit-test bridge: no ssh, broker, model or indexd process.
$state_file = args()[0]
$starts = if is_file($state_file) then to_number(read_file($state_file)) + 1 else 1 end
write_file($state_file, to_string($starts))
while true
    $line = readline()
    if $line == "" then break end
    $request = json_parse($line)
    $mode = $request.body.mode ?? "normal"
    if $mode == "failure" or ($mode == "die_once" and $starts == 1) then
        eprint("fixture child failure")
        exit(7)
    end
    if $mode == "timeout" then sleep(30) end
    if $mode == "transport_error" then
        print(json_encode({id: $request.id, rc: -1, error: "fixture Bus closed"}))
        exit(1)
    end
    $reply_body = if $mode == "error" then {error: "fixture refusal"} else {echo: $request.body, verb: $request.verb} end
    $reply_rc = if $mode == "rc" then 10 else 0 end
    $reply_id = if $mode == "wrong_id" then $request.id + 1 else $request.id end
    print(json_encode({id: $reply_id, rc: $reply_rc, body: $reply_body}))
end
write_file($state_file .. ".eof", "closed")
