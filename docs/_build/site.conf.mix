-- site.conf.mix — the mixos.dev site definition, read by _build/gen-site.mix.
-- Strict data (load_data): no variables, no calls. Edit, then run
--   mix docs/_build/gen-site.mix
-- Pages are every docs/**/*.md outside _build/ and _web/; this file only says
-- how they are dressed (sidebar order, icons) and where things moved.
site: {
  schema: "mixos.site.v1",
  url: "https://mixos.dev",
  name: "MixOS",
  home_title: "MixOS — an agent-operable computing system",
  description: "MixOS — an agent-operable computing system: legible, modifiable, and reconstructible by design. The MixOS manual.",
  llms_summary: "MixOS is an agent-operable computing system: a Linux userland where every app is a service, every service speaks one message bus, and Mix is the shell. It is tried as a small signed systemd-nspawn image that runs on its own virtual terminal beside the user's existing desktop, at native GPU, input and audio speed.",

  -- Icons: Lucide, the checked-in SVG set the MixOS desktop draws from
  -- (libs/toolkit/assets/icons). gen-site.mix verifies each file it uses by
  -- sha256, writes a copy at the desktop's stroke width to _web/icons/, and
  -- emits one CSS mask per data-lucide name in _web/icons.css. No icon font,
  -- no script, no CDN. Upstream files are never edited.
  icons: {
    version: "1.54.0",
    -- Repo-relative directory of the upstream SVGs, one <file>.svg each.
    source: "libs/toolkit/assets/icons",
    -- Stroke width of the generated copies only, matching the desktop.
    stroke: "1.5",
    -- Lucide licence, copied to _web/icons/ and verified by sha256 like the icons.
    licence: {file: "LICENSE-lucide.txt", sha256: "b495047bd93a9b06913511076f504daba17d5bbeb3e0650f3bb53a4220329c57"},
    -- Templates keep data-lucide="<name>" (base.js swaps names at runtime).
    -- Where the Lucide file has another name, map it here.
    aliases: {"home": "house", "box": "package"},
    -- Icons base.js swaps in at runtime (theme, pin, tree folders); they never
    -- appear in a template, so they are listed here.
    dynamic: ["sun", "moon", "pin", "pin-off", "folder", "folder-open"],
    -- sha256 of each upstream file the site may draw, keyed by its Lucide file
    -- name. An empty value stops the build until the file is pinned.
    sha256: {
      "house": "28216c479005731ef5e382e7d8627eda2b129b019eb1f3d9de9f5915576d448e",
      "package": "69d6bc7650d26c4d24dd55eb22791607b982ce7637073944c256f1f61575509d",
      "menu": "af6491988ac1ba30dc5414f485bc48713e957e1edb0fbef4a0dd8691c3c21598",
      "pin": "55e8e5e04bcb671179fc1dd589abf09cf6a1e71301ff14eb739419cfab6011e7",
      "pin-off": "149a4fb01201562c05dd7eb53573090cd3a0ba5b111686c45e2df8c6cd04a3be",
      "sun": "a3955c8b0425fcc5c9ba12d2bdd77fe53b2cd5dd05e7742a56f342e996fb2ef8",
      "moon": "205b959e940d5841f0ce1d09c933153da9d9c94130a54d5cc0c68c2af1d403da",
      "folder": "f0d92b94b797a8ab7d4c4ae33c3236c47f64068351b4e14bdb5014ee42898a39",
      "folder-open": "ee57452b40e71df310214091dd9da1941a397c83197b8ff8d7ae66dd4242578b",
      "book-open": "9b9bed0ff057283d5c5c5a1c71f8d3e927db26a56639603a92fdf7b25961510e",
      "globe": "82c6b8fa0b8e8d775ec9becd86f74a4e50bff7bee4c81f7362de45348504f14d",
      "share-2": "de283acf45610a564ade56bc55bb94e7cf4040bc942efe9163fd98cdfe07672c",
      "network": "626be730feea1e5ea7539fbf78b4a3fcb927ce5d7dc43364f2216908672ac792",
      "mail": "3236a51d5b8ce9b0528cf2e6ad07e527bd636dded6f5a9d656072052b99caea8",
      "monitor": "d1a443233345724859de8e4fb48968ba91e885e12ddbd710701548bd91b39428",
      "zap": "4c395891eab4d1e5627c5d414a16db037317cb2f12453de0f3a1130964c6d444",
      "layers": "ce16d0a955e3581cda17f6b2fd5c5bc2034b405f9cecc31c8ebb8495b4afc1bb",
      "chevron-left": "83b0681aa38bf55e9d52a1e4b4cced624abe1fe7678ecafda133a574f1161d93",
      "chevron-right": "2758143d7b2434e4aa7307dfd34405c87909ff4052f21b5f3f40d45224b4f19b",
      "cpu": "ec83bb69ec029d367d749afc445b39c8e95891ebf99b0400652677c2b149b99c",
      "file-text": "52ca55846c202335fb870c8aa23e9345630ec10489303756d62e750f7109605c",
      "file-terminal": "455ce900b11eb3814216a0fbb8e407f9ab2124639fd67e099f384e4985cd7eb4",
      "mouse-pointer-2": "a87128b1d33024c22ab598d1ce313081ce8942efd1a70274215bcc53421b7c7e",
      "pencil": "7e1ca7a6f5c1eb949671df762f2baadd32f5bd841d43153c3a15279af7d78d0c",
      "server": "f7bea54b609dc488f3b848995014041846b2443fd2a880653e9e583d7a034f61",
      "settings": "0ae27fd0f81999229e3127ac96c5b32edfea448e291d509e76212b917551d66b"
    }
  },

  -- Text and emoji faces: cut from the SAME pinned asset set as the icons,
  -- so mixos.dev sets type in exactly the files the MixOS desktop renders
  -- (share/assets/core.conf.mix is the lock; the sha256 values are its).
  -- gen-site.mix verifies each source, subsets it with hb-subset (variation
  -- axes kept), compresses it with woff2_compress, writes
  -- _web/fonts/<role>.woff2 and GENERATES _web/fonts.css. Neither is edited
  -- by hand. CSS family names are the ones _web/base.css already uses.
  fonts: {
    asset_set: "/opt/mixos/share/assets/sets/2026-10-04-core-3",
    -- Coverage every text face is cut to: Basic Latin + Latin-1 Supplement,
    -- Latin Extended-A, General Punctuation, Arrows, Currency Symbols, plus
    -- the trade mark, minus and division signs, ZWNBSP and U+FFFD. Nothing
    -- outside it is served; Greek, Cyrillic and Vietnamese fall through to
    -- the visitor's own fonts.
    unicodes: "U+0000-00FF,U+0100-017F,U+2000-206F,U+2190-21FF,U+20A0-20CF,U+2122,U+2212,U+2215,U+FEFF,U+FFFD",
    -- Preloaded on every page (the body face); the rest load on first use.
    preload: ["sans"],
    faces: [
      {role: "sans", family: "Inter", file: "fonts/InterVariable.ttf",
       sha256: "4989b125924991b90d05b2d16e0e388c48f7d5bb8b30539bbf9c755278d0ccaf",
       style: "normal", weight: "100 900", licence: "LICENSE-Inter.txt"},
      {role: "mono", family: "JetBrains Mono", file: "fonts/JetBrainsMono.ttf",
       sha256: "662a196d58f1183bf2d77428b6d5283fe3f45161ab021bea4036bc98e5cac016",
       style: "normal", weight: "100 800", licence: "LICENSE-JetBrainsMono.txt"},
      {role: "mono-italic", family: "JetBrains Mono", file: "fonts/JetBrainsMono-Italic.ttf",
       sha256: "f115aaa12113718c02ce72864fe6823b87241bc23d3e44cf1220155f861063f2",
       style: "italic", weight: "100 800", licence: "LICENSE-JetBrainsMono.txt"},
      {role: "display", family: "Quicksand", file: "fonts/Quicksand.ttf",
       sha256: "39c9b64223561f56aaff6062a6f04063c4fc86809ad6768722c06614d977e1cc",
       style: "normal", weight: "300 700", licence: "LICENSE-Quicksand.txt"},
      -- Noto Color Emoji, COLRv1 build: the set's web emoji. Its own
      -- coverage is the emoji presentation blocks and the joiners that make
      -- sequences (ZWJ, keycap, VS16, tags); deliberately NOT (c), (R), TM
      -- or the arrows, which the text faces own. The generated CSS carries
      -- that coverage as unicode-range, so a browser fetches the file only
      -- for a page that shows an emoji.
      {role: "emoji", family: "MixOS Emoji", file: "web/NotoColorEmoji-COLRv1.ttf",
       sha256: "0ae57fe58645638523ba35f388d93739d292539a9acb84df5700c81b1e1a28d2",
       style: "normal", weight: "400", licence: "LICENSE-NotoColorEmoji.txt",
       unicodes: "U+200D,U+20E3,U+FE0F,U+203C,U+2049,U+2139,U+231A-231B,U+2328,U+23CF,U+23E9-23FA,U+24C2,U+25AA-25AB,U+25B6,U+25C0,U+25FB-25FE,U+2600-27BF,U+2934-2935,U+2B05-2B07,U+2B1B-2B1C,U+2B50,U+2B55,U+3030,U+303D,U+3297,U+3299,U+1F000-1FAFF,U+E0020-E007F"}
    ],
    -- Each face's licence, copied from the set into _web/fonts/ under the
    -- name the face refers to; verified by sha256 like the fonts.
    licences: {
      "LICENSE-Inter.txt": {file: "licences/Inter-OFL.txt",
        sha256: "262481e844521b326f5ecd053e59b98c8b2da78c8ee1bdbb6e8174305e54935a"},
      "LICENSE-JetBrainsMono.txt": {file: "licences/JetBrainsMono-OFL.txt",
        sha256: "30f0c136e3c88e422d0791acd97238870f9054a9729bc34cf2ff0d4ed8cac4ad"},
      "LICENSE-Quicksand.txt": {file: "licences/Quicksand-OFL.txt",
        sha256: "14d28541780d90f6577bb7abcc6f005bf6969614294e75c82abb8758a696ad46"},
      "LICENSE-NotoColorEmoji.txt": {file: "licences/NotoColorEmoji-OFL.txt",
        sha256: "6a73f9541c2de74158c0e7cf6b0a58ef774f5a780bf191f2d7ec9cc53efe2bf2"}
    }
  },

  -- Left sidebar: one carousel panel per entry. Items are links
  -- {title, href, icon} or {divider: true}. Every internal href must resolve.
  left_panels: [
    {
      title: "MixOS",
      items: [
        {title: "Home", href: "/", icon: "home"},
        {title: "Docs", href: "/docs/", icon: "book-open"},
        {title: "The Mix language", href: "/mix/", icon: "file-text"},
        {divider: true},
        {title: "Try it beside your desktop", href: "/docs/try/", icon: "monitor"},
        {title: "Driving apps over the Bus", href: "/docs/drive/", icon: "network"},
        {title: "Components", href: "/docs/components/", icon: "box"},
        {title: "Decision: egui applications", href: "/docs/decisions/2026-10-09-egui-applications/", icon: "layers"},
        {divider: true},
        {title: "Decision: source layout", href: "/docs/decisions/2026-10-04-source-layout/", icon: "file-text"}
      ]
    }
  ],

  -- "On this page" for the home page (doc pages list their own headings).
  home_toc: [
    {title: "Desktop and server", href: "#what", icon: "layers"},
    {title: "Built to be driven", href: "#capabilities", icon: "network"},
    {title: "Try it beside your desktop", href: "#try", icon: "monitor"},
    {title: "Read more", href: "#docs", icon: "book-open"}
  ],

  -- Moved pages: old URL path -> new URL path. Each old path gets a static
  -- redirect page (meta refresh + canonical), because GitHub Pages has no
  -- server-side redirects. Never delete an entry; URLs are forever.
  redirects: {},

  -- Components that do not have their page (docs/<name>/README.md) yet.
  -- Every app, service, cli and lib component needs one, or gen-site --check
  -- fails. This list only shrinks: --check refuses a name here that now has
  -- a page, so remove it in the same change that adds the page. Never add a
  -- new component here; write its page instead
  -- (docs/docs/decisions/2026-10-16-site-url-layout.md).
  missing_pages: []
}
