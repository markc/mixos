-- SPDX-License-Identifier: MIT OR Apache-2.0
-- The bridged instance config and wire contract as data (docs/spec/bridge/README.md).
-- services/bridged/tests/bridge_core_test.mix holds the core against it.
{
  status:"draft", version:"0.1.0", service:"bridged",
  config:{
    path:"<etc>/bridge/<name>.conf.mix", etc_default:"/etc/mixos", etc_env:"MIXOS_ETC", override_env:"BRIDGED_CONFIG",
    required:["port"],
    keys:[
      {key:"host", type:"string", default:"127.0.0.1", values:["127.0.0.1", "localhost"]},
      {key:"port", type:"integer", min:1, max:65535},
      {key:"auth", type:"string", default:"token", values:["token", "none"]},
      {key:"token_file", type:"string", note:"required with auth token, refused with auth none; 64 hex characters; ~/ expands"},
      {key:"timeout_s", type:"number", default:5, min_exclusive:0, max:300},
      {key:"connect_timeout_s", type:"number", default:2, min_exclusive:0, max:300},
      {key:"backoff_s", type:"number", default:2, min:0, max:300},
      {key:"max_line", type:"integer", default:1048576, min:64, max:16777216},
      {key:"instance", type:"string", pattern:"^[A-Za-z0-9_-]{1,64}$"}
    ]
  },
  name:{pattern:"^[a-z][a-z0-9-]{1,30}$", registry:"/opt/mixos/share/bus/verbs.conf.mix", registry_env:"BRIDGED_VERBS"},
  verbs:["call", "commands", "execute", "inspect", "screenshot", "status"],
  rc:{ok:0, app_error:10, transport:11, bad_request:12},
  deadline:{covers:["connect", "auth reply", "request reply"], writes:"unbounded until Mix 0.112.1 tcp_send timeout (pending)"},
  start:{argv:"mix bridged.mix --start <app>", refusal_exit:2, unexpected_exit:3, otherwise:"the serve child's exit code"},
  host_connect:"127.0.0.1", token_mode_mask:63, redaction:"[redacted]",
  name_refused:{prefix:"mixos-", broker:["noded", "noded-*", "^[tc][a-z0-9]{1,7}-[a-z2-7]{22}$"]},
  start_refusals:{exit:2, codes:["NAME_INVALID", "NAME_RESERVED", "REGISTRY", "CONFIG", "TOKEN"]}
}
