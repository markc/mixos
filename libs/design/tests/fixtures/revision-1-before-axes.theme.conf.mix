            when: { variant: "destructive", interaction: "disabled", focus_visible: true },
            set: { ring: { kind: "null" } }
          },
          {
            when: { variant: "ghost", interaction: "disabled", focus_visible: true },
            set: { ring: { kind: "null" } }
          }
        ]
      }
    },
