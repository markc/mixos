und.muted\": { color_space: \"oklch\", l: 0.89, c: 0, h: 0, alpha: 1 },\n            \"palette.foreground.default\": { color_space: \"oklch\", l: 0.2, c: 0, h: 0, alpha: 1 },\n            \"palette.foreground.muted\": { color_space: \"oklch\", l: 0.5, c: 0, h: 0, alpha: 1 },\n            \"palette.foreground.quiet\": { color_space: \"oklch\", l: 0.45, c: 0, h: 0, alpha: 1 }\n          }\n        },\n        semantics: {\n          pairs: {\n            muted: { surface: \"palette.background.muted\", foreground: \"palette.foreground.quiet\" }\n          }\n        }\n      }\n    ],\n    semantics: {\n      pairs: {\n        base: { surface: \"palette.background.1\", foreground: \"palette.foreground.default\" },\n        card: {\n          surface: \"transparent\",\n          foreground: \"palette.foreground.muted\",\n          backdrop: \"palette.background.1\"\n        },\n        elevated: {\n          surface: \"palette.background.elevated\",\n          foreground: \"palette.foreground.default\"\n        },\n        primary: {\n          derive: {\n            name: \"selection_pair\",\n            args: [\n              { kind: \"colour\", value: \"palette.accent.default\" },\n              { kind: \"colour\", value: \"palette.background.2\" }\n            ]\n          }\n        },\n        secondary: { surface: \"palette.background.2\", foreground: \"palette.foreground.default\" },\n        muted: { surface: \"palette.background.muted\", foreground: \"palette.foreground.default\" },\n        accent: {\n          derive: {\n            name: \"control_pair\",\n            args: [\n              { kind: \"colour\", value: \"palette.background.3\" },\n              { kind: \"colour\", value: \"palette.accent.default\" },\n              { kind: \"colour\", value: \"palette.background.1\" },\n              { kind: \"colour\", value: \"palette.foreground.default\" }\n            ]\n          }\n        },\n        destructive: { surface: \"status.danger\", foreground: \"palette.background.1\" }\n      },\n      non_text: {\n        border: { value: \"palette.background.3\", adjacent: [\"secondary\"] },\n        input: { value: \"transparent\", adjacent: [\"muted\"] },\n        ring: { value: \"palette.accent.default\", adjacent: [\"accent\", \"muted\", \"secondary\"] }\n      }\n    },\n    # Desktop type: Inter (UI) and JetBrains Mono (numbers, code) at compact\n    # desktop sizes. Weight is a token: each role names the weight it wants and\n    # the renderer selects the matching static face (300 Light, 400 Regular,\n    # 500 Medium, 600 SemiBold). The light profile is ui and small at 300 with\n    # ui_display at 500 (same sizes); switch by editing the weights only.\n    typography: {\n      records: {\n        ui: { family: \"Inter\", fallbacks: [\"Noto Sans\", \"DejaVu Sans\"], generic: \"sans_serif\", logical_px: 12.5, weight: 400 },\n        ui_display: { family: \"Inter\", fallbacks: [\"Noto Sans\", \"DejaVu Sans\"], generic: \"sans_serif\", logical_px: 15, weight: 600 },\n        small: { family: \"Inter\", fallbacks: [\"Noto Sans\", \"DejaVu Sans\"], generic: \"sans_serif\", logical_px: 10.5, weight: 400 },\n        mono: { family: \"JetBrains Mono\", fallbacks: [\"DejaVu Sans Mono\", \"Noto Sans Mono\"], generic: \"monospace\", logical_px: 12, weight: 400 },\n        terminal: { family: \"SF Mono\", fallbacks: [\"DejaVu Sans Mono\", \"Noto Sans Mono\"], generic: \"monospace\", logical_px: 21.333333333333332, weight: 300 },\n        \"button.md\": { family: \"Noto Sans\", type_step: \"type.body\", weight: 400 },\n        \"button.sm\": { family: \"Noto Sans\", type_step: \"type.compact\", weight: 400 }\n      }\n    },\n    families: {\n      chrome: {\n        coverage: \"explicit\",\n        roles: {\n          chrome: \"chrome.chrome\",\n          canvas: \"chrome.canvas\",\n          canvas_dot: \"chrome.canvas_dot\",\n          dock: \"chrome.dock\",\n          card: \"chrome.card\",\n          card_border: \"chrome.card_border\",\n          tab_strip: \"chrome.tab_strip\",\n          field: \"chrome.field\",\n          field_border: \"chrome.field_border\",\n          hover: \"chrome.hover\",\n          pressed: \"chrome.pressed\",\n          row_selected: \"chrome.row_selected\",\n          text: \"chrome.text\",\n          text_dim: \"chrome.text_dim\",\n          text_faint: \"chrome.text_faint\",\n          icon: \"chrome.icon\",\n          accent: \"chrome.accent\",\n          accent_soft: \"chrome.accent_soft\",\n          accent_border: \"chrome.accent_border\",\n          accent_text: \"chrome.accent_text\",\n          menu_highlight: \"chrome.menu_highlight\",\n          menu_highlight_text: \"chrome.menu_highlight_text\",\n          separator: \"chrome.separator\",\n          shadow: \"chrome.shadow\",\n          scrim: \"chrome.scrim\",\n          primary_bg: \"chrome.primary_bg\",\n          primary_text: \"chrome.primary_text\",\n          danger: \"chrome.danger\",\n          warning: \"chrome.warning\",\n          caption_close: \"chrome.caption_close\",\n          caption_close_text: \"chrome.caption_close_text\"\n        }\n      },\n      # Chrome forms and lengths (families.style): each scheme takes one\n      # named style. The hue schemes share `plain`, their pair-derived look\n      # as data; the chrome schemes take the specification's grammars.\n      style: {\n        schemes: {\n          ocean: \"plain\", crimson: \"plain\", stone: \"plain\", forest: \"plain\", sunset: \"plain\", mono: \"plain\",\n          pro: \"pro\", studio: \"studio\", classic: \"classic\"\n        },\n        styles: {\n          plain: {\n            widgets: \"pairs\", base: \"mode\", faces: \"typography\", body_size: 12.5,\n            bevels: false, widget_stroke: \"role\", selection: \"accent\", scroll_bars: \"thin\", canvas_dots: true,\n            toggle: \"switch\", switch: \"round\", knob: \"plain\", slider_fill: \"text_dim\",\n            push_shape: \"rounded\"