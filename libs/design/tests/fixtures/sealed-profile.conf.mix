        \"member\": \"surface\"\n        },\n        \"control_active\": {\n          \"kind\": \"token\",\n          \"value\": \"palette.accent.default\"\n        },\n        \"thumb\": {\n          \"kind\": \"token\",\n          \"value\": \"palette.accent.hover\"\n        },\n        \"meter_green\": {\n          \"kind\": \"token\",\n          \"value\": \"status.success\"\n        },\n        \"meter_amber\": {\n          \"kind\": \"token\",\n          \"value\": \"status.warning\"\n        },\n        \"meter_red\": {\n          \"kind\": \"token\",\n          \"value\": \"status.danger\"\n        },\n        \"text\": {\n          \"kind\": \"pair\",\n          \"value\": \"base\",\n          \"member\": \"foreground\"\n        },\n        \"text_dim\": {\n          \"kind\": \"token\",\n          \"value\": \"palette.foreground.muted\"\n        },\n        \"border\": {\n          \"kind\": \"token\",\n          \"value\": \"border\"\n        },\n        \"row_hover\": {\n          \"kind\": \"pair\",\n          \"value\": \"secondary\",\n          \"member\": \"surface\"\n        },\n        \"row_selected\": {\n          \"kind\": \"pair\",\n          \"value\": \"primary\",\n          \"member\": \"surface\"\n        },\n        \"row_selected_text\": {\n          \"kind\": \"pair\",\n          \"value\": \"primary\",\n          \"member\": \"foreground\"\n        },\n        \"row_selected_text_dim\": {\n          \"kind\": \"pair\",\n          \"value\": \"primary\",\n          \"member\": \"foreground\"\n        },\n        \"scrim\": {\n          \"kind\": \"token\",\n          \"value\": \"transparent\"\n        },\n        \"danger_surface\": {\n          \"kind\": \"pair\",\n          \"value\": \"destructive\",\n          \"member\": \"surface\"\n        },\n        \"control_gap\": {\n          \"kind\": \"metric\",\n          \"value\": \"legacy.control_gap\"\n        },\n        \"corner_radius\": {\n          \"kind\": \"metric\",\n          \"value\": \"legacy.corner_radius\"\n        },\n        \"fader_width\": {\n          \"kind\": \"metric\",\n          \"value\": \"legacy.fader_width\"\n        },\n        \"fader_height\": {\n          \"kind\": \"metric\",\n          \"value\": \"legacy.fader_height\"\n        },\n        \"knob_size\": {\n          \"kind\": \"metric\",\n          \"value\": \"legacy.knob_size\"\n        },\n        \"meter_width\": {\n          \"kind\": \"metric\",\n          \"value\": \"legacy.meter_width\"\n        },\n        \"scheme\": {\n          \"kind\": \"modifier_axis_selection\",\n          \"axis\": \"scheme\"\n        },\n        \"mode\": {\n          \"kind\": \"modifier_axis_selection\",\n          \"axis\": \"mode\"\n        },\n        \"typography.family\": {\n          \"kind\": \"component_mapping_cell\",\n          \"family\": \"button\",\n          \"variant\": \"default\",\n          \"size\": \"md\",\n          \"part\": \"label\",\n          \"property\": \"typography_family\"\n        },\n        \"typography.body_px\": {\n          \"kind\": \"component_mapping_cell\",\n          \"family\": \"button\",\n          \"variant\": \"default\",\n          \"size\": \"md\",\n          \"part\": \"label\",\n          \"property\": \"typography_body_px\"\n        }\n      }\n    }\n  },\n  \"style\": \"studio\",\n  \"decorations\": \"ssd\",\n  \"caption_side\": \"right\"\n}"
