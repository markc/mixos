  "embedded_source": "scheme: \"ocean\"\nmode: \"light\"\ntypography: { family: \"Noto Sans\", body_px: 13.333 }\nsurface: \"#f3fafc\"\npanel: \"#e9f4f7\"\nmaster_panel: \"#d8e8ed\"\ntrack: \"#e9f4f7\"\ncontrol: \"#d8f4fd\"\ncontrol_active: \"#006f87\"\nthumb: \"#005f75\"\nmeter_green: \"#006818\"\nmeter_amber: \"#c79600\"\nmeter_red: \"#c21725\"\ntext: \"#002631\"\ntext_dim: \"#386b7b\"\nborder: \"#d8e8ed\"\nrow_hover: \"#e9f4f7\"\nrow_selected: \"#1d5869\"\nrow_selected_text: \"#e9f4f7\"\nrow_selected_text_dim: \"#e9f4f7\"\nscrim: \"#00000000\"\ndanger_surface: \"#c21725\"\ncontrol_gap: 8.0\ncorner_radius: 5.0\nfader_width: 42.0\nfader_height: 250.0\nknob_size: 58.0\nmeter_width: 28.0\n\ndesign: {\n  schema_version: 1,\n  \"v1\": {\n    kind: \"base\",\n    resolution_order: [\"scheme\", \"mode\"],\n    primitives: {\n      colors: {\n        \"palette.background.1\": { color_space: \"oklch\", l: 0.98, c: 0.008, h: 220.0 },\n        \"palette.background.2\": { color_space: \"oklch\", l: 0.96, c: 0.012, h: 220.0 },\n        \"palette.background.3\": { color_space: \"oklch\", l: 0.92, c: 0.018, h: 220.0 },\n        \"palette.background.muted\": { color_space: \"oklch\", l: 0.89, c: 0.012, h: 220.0 },\n        \"palette.background.elevated\": { color_space: \"oklch\", l: 0.85, c: 0.018, h: 220.0 },\n        \"palette.foreground.default\": { color_space: \"oklch\", l: 0.25, c: 0.06, h: 220.0 },\n        \"palette.foreground.muted\": { color_space: \"oklch\", l: 0.50, c: 0.06, h: 220.0 },\n        # Declared in the base so the modifier blocks may override it: a\n        # modifier cannot introduce a path the base never authored. The base\n        # value is the ocean light anchor; every other block re-authors it —\n        # light per scheme, dark at the L 0.65 tier that clears WCAG AA on\n        # the L 0.26 dark muted surface (the dark muted foreground's L 0.61\n        # measures 4.10:1 there).\n        \"palette.foreground.quiet\": { color_space: \"oklch\", l: 0.45, c: 0.06, h: 220.0 },\n        \"palette.accent.default\": { color_space: \"oklch\", l: 0.50, c: 0.12, h: 220.0 },\n        \"palette.accent.hover\": { color_space: \"oklch\", l: 0.45, c: 0.14, h: 220.0 },\n        \"status.success\": { color_space: \"oklch\", l: 0.45, c: 0.15, h: 145.0 },\n        \"status.warning\": { color_space: \"oklch\", l: 0.70, c: 0.15, h: 85.0 },\n        \"status.danger\": { color_space: \"oklch\", l: 0.52, c: 0.20, h: 25.0 },\n        \"transparent\": { color_space: \"oklch\", l: 0.0, c: 0.0, h: 0.0, alpha: 0.0 },\n        # Chrome (families.chrome): Pro Medium Gray in the base so every\n        # scheme compiles; the pro, studio and classic blocks re-author them.\n        \"chrome.chrome\": { color_space: \"oklch\", l: 0.442255056, c: 0.000000016, h: 89.875563495, alpha: 1.000000000 },\n        \"chrome.canvas\": { color_space: \"oklch\", l: 0.276848201, c: 0.000000010, h: 89.875563771, alpha: 1.000000000 },\n        \"chrome.canvas_dot\": { color_space: \"oklch\", l: 0.276848201, c: 0.000000010, h: 89.875563771, alpha: 1.000000000 },\n        \"chrome.dock\": { color_space: \"oklch\", l: 0.379093581, c: 0.000000014, h: 89.875562221, alpha: 1.000000000 },\n        \"chrome.card\": { color_space: \"oklch\", l: 0.442255056, c: 0.000000016, h: 89.875563495, alpha: 1.000000000 },\n        \"chrome.card_border\": { color_space: \"oklch\", l: 0.379093581, c: 0.000000014, h: 89.875562221, alpha: 1.000000000 },\n        \"chrome.tab_strip\": { color_space: \"oklch\", l: 0.409120001, c: 0.000000015, h: 89.875563025, alpha: 1.000000000 },\n        \"chrome.field\": { color_space: \"oklch\", l: 0.390420841, c: 0.000000015, h: 89.875563283, alpha: 1.000000000 },\n        \"chrome.field_border\": { color_space: \"oklch\", l: 0.517303114, c: 0.000000019, h: 89.875562672, alpha: 1.000000000 },\n        \"chrome.hover\": { color_space: \"oklch\", l: 0.496155543, c: 0.000000018, h: 89.875562591, alpha: 1.000000000 },\n        \"chrome.pressed\": { color_space: \"oklch\", l: 0.545169122, c: 0.000000020, h: 89.875563159, alpha: 1.000000000 },\n        \"chrome.row_selected\": { color_space: \"oklch\", l: 0.527795834, c: 0.000000020, h: 89.875563604, alpha: 1.000000000 },\n        \"chrome.text\": { color_space: \"oklch\", l: 0.949119254, c: 0.000000035, h: 89.875562714, alpha: 1.000000000 },\n        \"chrome.text_dim\": { color_space: \"oklch\", l: 0.869943540, c: 0.000000032, h: 89.875563239, alpha: 1.000000000 },\n        \"chrome.text_faint\": { color_space: \"oklch\", l: 0.705757008, c: 0.000000026, h: 89.875562545, alpha: 1.000000000 },\n        \"chrome.icon\": { color_space: \"oklch\", l: 0.912790408, c: 0.000000034, h: 89.875563449, alpha: 1.000000000 },\n        \"chrome.accent\": { color_space: \"oklch\", l: 0.643494390, c: 0.168268215, h: 254.060729774, alpha: 1.000000000 },\n        \"chrome.accent_soft\": { color_space: \"oklch\", l: 0.538236659, c: 0.000000020, h: 89.875563441, alpha: 1.000000000 },\n        \"chrome.accent_border\": { color_space: \"oklch\", l: 0.643494390, c: 0.168268215, h: 254.060729774, alpha: 1.000000000 },\n        \"chrome.accent_text\": { color_space: \"oklch\", l: 0.999999993, c: 0.000000037, h: 89.875563096, alpha: 1.000000000 },\n        \"chrome.menu_highlight\": { color_space: \"oklch\", l: 0.643494390, c: 0.168268215, h: 254.060729774, alpha: 1.000000000 },\n        \"chrome.menu_highlight_text\": { color_space: \"oklch\", l: 0.999999993, c: 0.000000037, h: 89.875563096, alpha: 1.000000000 },\n        \"chrome.separator\": { color_space: \"oklch\", l: 0.363857246, c: 0.000000014, h: 89.875563146, alpha: 1.000000000 },\n        \"chrome.shadow\": { color_space: \"oklch\", l: 0.000000000, c: 0.000000000, h: 0.000000000, alpha: 0.588235294 },\n        \"chrome.scrim\": { color_space: \"oklch\", l: 0.000000000, c: 0.000000000, h: 0.000000000, alpha: 0.431372549 },\n        \"chrome.primary_bg\": { color_space: \"oklch\", l: 0.643494390, c: 0.168268215, h: 254.060729774, alpha: 1.000000000 },\n        \"chrome.primary_text\": { color_space: \"oklch\", l: 0.999999993, c: 0.000000037, h: 89.875563096, alpha: 1.000000000 },\n        \"chrome.danger\": { color_space: \"oklch\", l: 0.661680892, c: 0.179222347, h: 20.627670484, alpha: 1.000000000 },\n        \"chrome.warning\": { color_space: \"oklch\", l: 0.790244473, c: 0.136395200, h: 80.169253871, alpha: 1.000000000 },\n        \"chrome.caption_close\": { color_space: \"oklch\", l: 0.536149835, c: 0.191185691, h: 30.071355694, alpha: 1.000000000 },\n        \"chrome.caption_close_text\": { color_space: \"oklch\", l: 0.999999993, c: 0.000000037, h: 89.875563096, alpha: 1.000000000 }\n      },\n      metrics: {\n        \"button.height.sm\": { kind: \"px\", value: 24.0 },\n        \"button.height.md\": { kind: \"px\", value: 28.0 },\n        \"button.height.lg\": { kind: \"px\", value: 32.0 },\n        \"button.min_width.none\": { kind: \"px\", value: 0.0 },\n        \"button.min_width.standard\": { kind: \"px\", value: 72.0 },\n        \"button.padding_x\": { kind: \"step\", scale: \"spacing\", value: 5 },\n        \"button.border_width\": { kind: \"px\", value: 1.0 },\n        \"radius\": { kind: \"px\", value: 6.0 },\n        \"radius.md\": { kind: \"step\", scale: \"radius\", value: 1 },\n        \"type.body\": { kind: \"step\", scale: \"type\", value: 1 },\n        \"type.compact\": { kind: \"step\", scale: \"type\", value: 0 },\n        \"lift.hover\": { kind: \"ratio\", value: 0.06 },\n        \"lift.ghost.hover\": { kind: \"ratio\", value: 0.03 },\n        \"lift.press\": { kind: \"ratio\", value: 0.06 },\n        \"lift.ghost.press\": { kind: \"ratio\", value: 0.09 },\n        \"lift.disabled\": { kind: \"ratio\", value: 0.09 },\n        \"lift.ghost.disabled\": { kind: \"ratio\", value: 0.13 },\n        \"disabled.chroma_reduction\": { kind: \"ratio\", value: 0.50 },\n        \"legacy.control_gap\": { kind: \"px\", value: 8.0 },\n        \"legacy.corner_radius\": { kind: \"px\", value: 5.0 },\n        \"legacy.fader_width\": { kind: \"px\", value: 42.0 },\n        \"legacy.fader_height\": { kind: \"px\", value: 250.0 },\n        \"legacy.knob_size\": { kind: \"px\", value: 58.0 },\n        \"legacy.meter_width\": { kind: \"px\", value: 28.0 }\n      },\n      scales: {\n        spacing: [\n          { kind: \"px\", value: 0.0 },\n          { kind: \"px\", value: 2.0 },\n          { kind: \"px\", value: 4.0 },\n          { kind: \"px\", value: 6.0 },\n          { kind: \"px\", value: 8.0 },\n          { kind: \"px\", value: 10.0 },\n          { kind: \"px\", value: 12.0 },\n          { kind: \"px\", value: 16.0 },\n          { kind: \"px\", value: 20.0 },\n          { kind: \"px\", value: 24.0 }\n        ],\n        type: [\n          { kind: \"px\", value: 11.333 },\n          { kind: \"px\", value: 13.333 }\n        ]\n      }\n    },\n    modifiers: [\n      {\n        when: { scheme: \"ocean\", mode: \"light\" },\n        semantics: {\n          pairs: {\n            # The muted pair's light text half rides the quiet anchor: at\n            # full default weight, hierarchy text (disabled controls,\n            # secondary labels) reads as enabled on the light quiet\n            # surface. Dark keeps the default foreground — dark's ramp was\n            # already flat, and re-tiering it is a later decision. The\n            # quiet anchor itself needs no override here: the base carries\n            # the ocean light value verbatim.\n            muted: {\n              surface: \"palette.background.muted\",\n              foreground: \"palette.foreground.quiet\"\n            }\n          }\n        }\n      },\n      {\n        when: { scheme: \"ocean\", mode: \"dark\" },\n        primitives: {\n          colors: {\n            \"palette.background.1\": { color_space: \"oklch\", l: 0.12, c: 0.015, h: 220.0 },\n            \"palette.background.2\": { color_space: \"oklch\", l: 0.16, c: 0.02, h: 220.0 },\n            \"palette.background.3\": { color_space: \"oklch\", l: 0.22, c: 0.025, h: 220.0 },\n            \"palette.background.muted\": { color_space: \"oklch\", l: 0.26, c: 0.02, h: 220.0 },\n            \"palette.background.elevated\": { color_space: \"oklch\", l: 0.34, c: 0.025, h: 220.0 },\n            \"palette.foreground.default\": { color_space: \"oklch\", l: 0.95, c: 0.02, h: 220.0 },\n            \"palette.foreground.muted\": { color_space: \"oklch\", l: 0.61, c: 0.04, h: 220.0 },\n            \"palette.foreground.quiet\": { color_space: \"oklch\", l: 0.65, c: 0.04, h: 220.0 },\n            \"palette.accent.default\": { color_space: \"oklch\", l: 0.75, c: 0.12, h: 220.0 },\n            \"palette.accent.hover\": { color_space: \"oklch\", l: 0.85, c: 0.10, h: 220.0 }\n          }\n        }\n      },\n      {\n        when: { scheme: \"crimson\", mode: \"light\" },\n        primitives: {\n          colors: {\n            \"palette.background.1\": { color_space: \"oklch\", l: 0.98, c: 0.008, h: 25.0 },\n            \"palette.background.2\": { color_space: \"oklch\", l: 0.96, c: 0.012, h: 25.0 },\n            \"palette.background.3\": { color_space: \"oklch\", l: 0.92, c: 0.018, h: 25.0 },\n            \"palette.background.muted\": { color_space: \"oklch\", l: 0.89, c: 0.012, h: 25.0 },\n            \"palette.background.elevated\": { color_space: \"oklch\", l: 0.85, c: 0.018, h: 25.0 },\n            \"palette.foreground.default\": { color_space: \"oklch\", l: 0.25, c: 0.04, h: 25.0 },\n            \"palette.foreground.quiet\": { color_space: \"oklch\", l: 0.45, c: 0.04, h: 25.0 },\n            \"palette.foreground.muted\": { color_space: \"oklch\", l: 0.50, c: 0.04, h: 25.0 },\n            \"palette.accent.default\": { color_space: \"oklch\", l: 0.47, c: 0.20, h: 25.0 },\n            \"palette.accent.hover\": { color_space: \"oklch\", l: 0.42, c: 0.22, h: 25.0 }\n          }\n        },\n        semantics: {\n          pairs: {\n            muted: {\n              surface: \"palette.background