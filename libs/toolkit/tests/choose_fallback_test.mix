-- SPDX-License-Identifier: MIT OR Apache-2.0
-- External acceptance client; production libraries unchanged.
-- Good private broker: portald/files/driver. Empty private broker: Handle.
$n = require("../../../tests/desktop/nested_host_lib.mix")
$pb = require("../../../tests/lib/private_bus.mix")
$root = dirname(dirname(dirname(dirname(realpath($0)))))
$bin = env("MIXOS_TEST_BIN",$root .. "/target/release")
$probe = env("MIXOS_CHOOSE_PROBE",$bin .. "/examples/choose_probe")
$run = $n.new_run("/tmp/toolkit-fallback")
$tmp = $run.path
$empty = nil
$broker = nil
$compositor = nil
$dbus = nil
$provider = nil
$portal = nil
$passed = false
$owners = {}
fn identity($pid)
  if not process_alive($pid) then return nil end
  $p = "/proc/" .. $pid
  $s = read_file($p .. "/stat")
  return {uid:stat($p).uid,start:split(trim(slice($s,last_index_of($s,")")+2))," ")[19],argv:read_file($p .. "/cmdline")}
end
fn stop_owned($pid,$expected)
  if $pid == nil or $expected == nil then return end
  for $signal in [15,9]
    if not process_alive($pid) or not deep_eq(identity($pid),$expected) then return end
    $stopped = kill($pid,$signal)
    $deadline = monotonic()+2
    while process_alive($pid) and monotonic() < $deadline sleep(0.05) end
  end
  if process_alive($pid) and deep_eq(identity($pid),$expected) then raise("CLEANUP","owned child survived " .. $pid) end
end
try
  $empty = $pb.start({dir:$tmp .. "/empty",name:"chooser-empty",noded:$bin .. "/noded",export:false})
  $broker = $pb.start({dir:$tmp .. "/broker",name:"chooser-driver",noded:$bin .. "/noded"})
  mkdir($tmp .. "/home",{parents:true})
  mkdir($tmp .. "/runtime",{parents:true})
  chmod($tmp .. "/runtime",0o700)
  write_file($tmp .. "/home/notes.md","original")
  copy($root .. "/tests/desktop/smoke-settings.json",$tmp .. "/settings.json")
  $client = merge($pb.client_env($broker),{HOME:$tmp .. "/home",XDG_CONFIG_HOME:$tmp .. "/config",XDG_STATE_HOME:$tmp .. "/state",MIXOS_APP_HOME:$tmp .. "/dopus",MIXOS_COMP_SERVICE:"fallbackcomp",WINIT_UNIX_BACKEND:"wayland",WGPU_BACKEND:"gl",LIBGL_ALWAYS_SOFTWARE:"1",XDG_RUNTIME_DIR:$tmp .. "/runtime",WAYLAND_DISPLAY:"chooser-fallback",DISPLAY:"",MIXOS_BUS_SOCKET:nil,MIXOS_SESSION_FD:nil,DBUS_SESSION_BUS_ADDRESS:nil})
  $dbus = spawn(["dbus-daemon","--session","--nofork","--nopidfile","--print-address=1"],{env:$client,stdout:{file:$tmp .. "/dbus.address"},stderr:{file:$tmp .. "/dbus.log"},detach:true})
  $owners.dbus = identity($dbus)
  $deadline = monotonic()+10
  while monotonic() < $deadline
    if is_file($tmp .. "/dbus.address") and trim(read_file($tmp .. "/dbus.address")) != "" then break end
    sleep(0.05)
  end
  $client.DBUS_SESSION_BUS_ADDRESS = trim(read_file($tmp .. "/dbus.address"))
  if $client.DBUS_SESSION_BUS_ADDRESS == "" then raise("FALLBACK","private D-Bus unavailable") end
  $compositor = spawn([$bin .. "/compd","--headless","--socket","chooser-fallback","--size","1280x800","--config-file",$tmp .. "/settings.json","--bus-service","fallbackcomp"],{env:$client,stdout:{file:$tmp .. "/compd.log"},stderr:"stdout",detach:true})
  $owners.compositor = identity($compositor)
  $deadline = monotonic()+20
  while not exists($tmp .. "/runtime/chooser-fallback") and monotonic() < $deadline sleep(0.1) end
  if not exists($tmp .. "/runtime/chooser-fallback") then raise("FALLBACK","private headless compd unavailable") end
  $provider = spawn([$bin .. "/dopus","--choose-service","--noded-url",$broker.url],{env:$client,stdout:{file:$tmp .. "/files.log"},stderr:"stdout",detach:true})
  $owners.provider = identity($provider)
  $deadline = monotonic() + 20
  $ready = false
  while monotonic() < $deadline
    $r = $n.call_within("files","files.choose.list",{},2)
    if $r.rc == 0 then $ready = true; break end
    sleep(0.1)
  end
  if not $ready then raise("FALLBACK","files did not register") end
  $portal = spawn([$bin .. "/portald","serve","--instance","test"],{env:$client,stdout:{file:$tmp .. "/portal.log"},stderr:"stdout",detach:true})
  $owners.portal = identity($portal)
  -- System mode waits boundedly for the real portal's D-Bus version before
  -- constructing any Handle. Its driver uses the separate explicit URL.
  $probe_env = merge($client,{MIXOS_NODED_URL:$empty.url,CHOOSER_DRIVER_URL:$broker.url,MIXOS_NODE_CONFIG:$empty.conf,MIXOS_BUS_SOCKET:nil,MIXOS_SESSION_FD:nil,MIXOS_RUN:$empty.dir .. "/run",MIXOS_ETC:$empty.dir .. "/etc",MIXOS_VAR:$empty.dir .. "/var"})
  $r = run_argv([$probe,$tmp .. "/home","system"],{env:$probe_env,timeout:300,stderr:"stdout"})
  write_file($tmp .. "/system.log",$r.stdout)
  print($r.stdout)
  if not $r.ok then raise("FALLBACK","system client failed: " .. $tmp) end
  -- Only the caller loses D-Bus. The actual portal and files stay alive.
  $probe_env.DBUS_SESSION_BUS_ADDRESS = "unix:path=" .. $tmp .. "/no-session-bus"
  $r = run_argv([$probe,$tmp .. "/home","embedded"],{env:$probe_env,timeout:180,stderr:"stdout"})
  write_file($tmp .. "/embedded.log",$r.stdout)
  print($r.stdout)
  if not $r.ok then raise("FALLBACK","embedded client failed: " .. $tmp) end
  $passed = true
finally
  $errors = []
  for $child in [{pid:$portal,id:$owners.portal ?? nil},{pid:$provider,id:$owners.provider ?? nil},{pid:$compositor,id:$owners.compositor ?? nil},{pid:$dbus,id:$owners.dbus ?? nil}]
    try stop_owned($child.pid,$child.id) catch $message push($errors,$message) end
  end
  for $owned_bus in [$broker,$empty]
    if $owned_bus != nil then
      try $pb.stop($owned_bus) catch $message push($errors,$message) end
    end
  end
  if len($errors) > 0 then $passed = false end
  write_file($tmp .. "/receipt.json",json_encode({passed:$passed,cleanup_errors:$errors}))
  $n.finish_run($run,$passed)
  if len($errors) > 0 then raise("CLEANUP",json_encode($errors)) end
end
