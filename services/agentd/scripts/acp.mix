-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.1.0
-- ACP stdio reader. The child citizen owns only this connection's projection;
-- agentd owns agent processes, native effects, permission state and history.
$a = require("lib/acp.mix")
$mix = mixos_path("prefix", "bin/mix")
$connection = slice(replace(uuid(), "-", ""), 0, 16)
$operations = {initialize: "initialize", "session/new": "new", "session/load": "load",
  "session/list": "list", "session/prompt": "prompt", "session/cancel": "cancel",
  "session/set_mode": "mode", "session/set_config_option": "option"}
$name = "acp-" .. $connection
$child = spawn([$mix, "--serve", dirname(script_path()) .. "/acp_worker.mix", "--name", $name],
  {die_with_parent: true, env: {MIXOS_ACP_CONNECTION: $connection, MIX_STATS: "off"}, stdout: "inherit", stderr: "inherit"})
try
  $up = false
  for $i = 1 to 50
    send $name INFO timeout=0.2
    if $rc == 0 then $up = true; break end
    if not process_alive($child) then break end
    sleep(0.05)
  end
  if not $up then raise("ACP_START", "ACP citizen did not start") end
  loop
    $line = readline()
    if $line == nil then break end
    if trim($line) == "" then continue end
    $m = nil
    try
      if len($line) > 1048576 then raise("ACP_INPUT", "input exceeds 1 MiB") end
      $m = json_parse($line)
      if type($m) != "map" or $m.jsonrpc != "2.0" then raise("ACP_INPUT", "invalid JSON-RPC envelope") end
      if $m.id != nil and not $a.valid_id($m.id) then raise("ACP_INPUT", "invalid request id") end
      if $m.method != nil and (type($m.method) != "string" or type($m.params ?? {}) != "map") then raise("ACP_INPUT", "invalid request") end
      if $m.method == nil and $m.result == nil and $m.error == nil then raise("ACP_INPUT", "invalid response") end
      if $m.method == nil and (($m.result != nil and type($m.result) != "map") or ($m.error != nil and type($m.error) != "map")) then raise("ACP_INPUT", "invalid response value") end
      if contains(["session/new", "session/load"], $m.method) then
        if type($m.params.mcpServers) != "list" then raise("ACP_INPUT", "mcpServers is required") end
        $ref = "acp-" .. $connection .. "-" .. slice(hash_sha256(json_encode($m.id)), 0, 16) .. ".json"
        $a.save_mcp($ref, $m.params.mcpServers ?? [])
        $m.params.mcp_digest = hash_sha256(json_encode($m.params.mcpServers ?? []))
        $m.params = delete($m.params, "mcpServers")
        $m.params.mcp_ref = $ref
      end
      $p = $m.params ?? {}
      $args = {cwd: $p.cwd, mcp_ref: $p.mcp_ref, mcp_digest: $p.mcp_digest, session: $p.sessionId,
        content: $p.prompt, mode: $p.modeId, option: $p.configId, value: $p.value}
      $op = $operations[$m.method] ?? "unknown"
      if $m.method == nil then
        $op = "permission"
        $outcome = if type($m.result) == "map" then $m.result.outcome else {outcome: "cancelled"} end
        if type($outcome) != "map" then raise("ACP_INPUT", "invalid permission response") end
        $args = {outcome: $outcome}
      end
    catch $message
      $bad_id = if type($m) == "map" and $a.valid_id($m.id) then $m.id else nil end
      send $name acp.input body=json_encode({operation: "invalid", request: $bad_id}) timeout=20
      if $rc != 0 then raise("ACP_TRANSPORT", "ACP citizen did not acknowledge invalid input") end
      continue
    end
    -- Translate at ingress: no JSON-RPC envelopes travel on the native Bus.
    send $name acp.input body=json_encode({operation: $op, request: $m.id, args: $args}) timeout=20
    if $rc != 0 then raise("ACP_TRANSPORT", "ACP citizen did not acknowledge input; outcome may be unknown") end
  end
finally
  -- Disconnect is not agent cancellation. Native session state survives.
  if process_alive($child) then $stopped = kill($child, 15) end
  for $path in glob($a.mcp_dir() .. "/acp-" .. $connection .. "-*.json")
    $a.remove_mcp(basename($path))
  end
end
