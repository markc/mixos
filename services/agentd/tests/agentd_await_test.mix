-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Awaits against real agentd and ACP pipes on an owned private Bus only.
$pb = require("../../../tests/lib/private_bus.mix")
$here = dirname(realpath($0))
$mix = env("MIXOS_TEST_MIX", mixos_path("prefix", "bin/mix"))
$tmp = env("TMPDIR", "/tmp") .. "/agentd-await-test." .. uuid()
$results = []
$pids = []
$fixture = json_parse(read_file($here .. "/fixtures/buildd-done-47b2f6cef23b.json"))

fn check($name, $ok)
  push($results, {name: $name, ok: $ok})
  print((if $ok then "PASS " else "FAIL " end) .. $name)
end

fn call($command, $b)
  send agent $command body=json_encode($b) timeout=10
  return {rc: $rc, v: $reply}
end

fn citizen($file, $name, $env)
  $pid = spawn([$mix, "--serve", $file, "--name", $name], {detach: true, env: $env,
    stdout: {file: $tmp .. "/" .. $name .. ".log", append: true}, stderr: "stdout"})
  push($pids, $pid)
  return $pid
end

fn up()
  for $i = 1 to 60
    if call("agent.agents", {}).rc == 0 then return true end
    sleep(0.1)
  end
  return false
end

fn status($s)
  return call("agent.session.read", {session: $s}).v.session.status
end

fn wait_status($s, $want)
  for $i = 1 to 100
    if status($s) == $want then return true end
    sleep(0.1)
  end
  return false
end

fn events($s, $kind)
  return filter(call("agent.session.read", {session: $s}).v.events ?? [], fn($e) = $e.kind == $kind)
end

fn topics($name, $field, $value)
  if not is_file($tmp .. "/topics") then return [] end
  $rows = map(filter(lines(read_file($tmp .. "/topics")), fn($l) = $l != ""), fn($l) = json_parse($l))
  return filter($rows, fn($r) = $r.topic == $name and $r.body[$field] == $value)
end

fn outcomes($s)
  return filter(events($s, "prompt"), fn($e) = contains(json_encode($e.content), "[await]"))
end

fn wait_outcomes($s, $n)
  for $i = 1 to 100
    if len(outcomes($s)) >= $n then return true end
    sleep(0.1)
  end
  return false
end

fn start($agent)
  $r = call("agent.session.new", {agent: $agent, cwd: $tmp .. "/ws"})
  if $r.rc != 0 then raise("HARNESS", json_encode($r)) end
  if not wait_status($r.v.session, "ready") then raise("HARNESS", "session never ready") end
  return $r.v.session
end

fn register($s, $op, $extra)
  $r = call("agent.session.await", merge({session: $s, service: "ops", op: $op}, $extra))
  if $r.rc != 0 then raise("HARNESS", "await refused: " .. json_encode($r)) end
  return $r.v.await
end

fn row($id)
  return filter(call("agent.await.list", {}).v.awaits, fn($r) = $r.id == $id)[0]
end

fn wait_await($id, $want)
  for $i = 1 to 100
    if row($id).state == $want then return true end
    sleep(0.1)
  end
  return false
end

fn prompt($s, $text)
  return call("agent.session.prompt", {session: $s, content: $text})
end

fn op_done($op, $state)
  publish("ops.op.done", json_encode(merge($fixture, {op: $op, state: $state})), {command: "ops.op.done"})
end

fn close_session($s)
  call("agent.session.close", {session: $s})
  wait_status($s, "ended")
end

fn restart()
  call("QUIT", {})
  sleep(0.5)
  citizen($here .. "/../scripts/agentd.mix", "agent", $agent_env)
  if not up() then raise("HARNESS", "agentd restart failed") end
end

$bus = nil
mkdir($tmp .. "/ws", {parents: true})
try
  $bus = $pb.start({dir: $tmp .. "/bus", name: "agentd-await"})
  $env = merge($pb.client_env($bus), {HOME: $tmp .. "/home"})
  $fake_env = {FAKE_ACP_REFUSE_FILE: $tmp .. "/refuse", FAKE_ACP_CRASH_FILE: $tmp .. "/crash", FAKE_ACP_REOPEN_DELAY: "0.2", FAKE_ACP_HOLD_FILE: $tmp .. "/hold"}
  $conf = {max_live: 1, agents: {
    resumer: {argv: [$mix, $here .. "/fixtures/fake_acp_agent.mix", "resume"], roots: [$tmp .. "/ws"], env: $fake_env},
    stubborn: {argv: [$mix, $here .. "/fixtures/fake_acp_agent.mix", "resume,stubborn"], roots: [$tmp .. "/ws"]}}}
  write_file($tmp .. "/conf.mix", data_encode($conf))
  write_file($tmp .. "/ops.json", "{}")
  citizen($here .. "/fixtures/fake_op.mix", "ops", merge($env, {FAKE_OPS: $tmp .. "/ops.json"}))
  citizen($here .. "/fixtures/await_listener.mix", "awaitlisten", merge($env, {AWAIT_EVENTS: $tmp .. "/topics"}))
  $agent_env = merge($env, {MIXOS_AGENTD_CONF: $tmp .. "/conf.mix", MIXOS_AGENTD_DB: $tmp .. "/sessions.db",
    MIXOS_AGENTD_MCP: "/bin/true", MIXOS_AGENTD_CLOSE_GRACE_S: "0.3"})
  citizen($here .. "/../scripts/agentd.mix", "agent", $agent_env)
  check("agentd answers", up())
  sleep(0.3)

  $s = start("resumer")
  $a1 = register($s, "one", {note: "finish my job"})
  prompt($s, "work then wait")
  check("suspends at turn boundary", wait_status($s, "waiting"))
  sleep(0.1)
  check("suspension topic without ended", len(topics("agent.session.suspended", "session", $s)) == 1 and len(topics("agent.session.ended", "session", $s)) == 0)
  check("unknown stays pending", row($a1).state == "pending")
  $cl = run_argv([$mix, $here .. "/../scripts/agent_cli.mix", "list"], {env: $env, timeout: 10})
  $cr = run_argv([$mix, $here .. "/../scripts/agent_cli.mix", "read", $s], {env: $env, timeout: 10})
  check("CLI list and read show waiting", $cl.ok and $cr.ok and contains($cl.stdout, "waiting") and contains($cr.stdout, "waiting"))
  check("cancel waiting does not resume", call("agent.session.cancel", {session: $s}).v.cancelled == false and status($s) == "waiting")
  restart()
  check("waiting survives restart", status($s) == "waiting")
  op_done("one", "done")
  check("event resumes waiting and delivers", wait_outcomes($s, 1) and wait_await($a1, "delivered"))
  sleep(0.1)
  check("fired and delivered topics", len(topics("agent.await.fired", "await", $a1)) == 1 and len(topics("agent.await.delivered", "await", $a1)) == 1)
  check("outcome contains captured data and note", contains(json_encode(outcomes($s)), $fixture.log) and contains(json_encode(outcomes($s)), "finish my job"))
  op_done("one", "done")
  sleep(0.3)
  check("duplicate event adds no turn", len(outcomes($s)) == 1)
  close_session($s)

  $s = start("stubborn")
  register($s, "race", {})
  prompt($s, "work")
  sleep(0.1)
  op_done("race", "done")
  check("event during close survives", wait_outcomes($s, 1))
  close_session($s)

  $s = start("resumer")
  $aid = register($s, "restart-fired", {})
  prompt($s, "work")
  wait_status($s, "waiting")
  call("QUIT", {})
  sleep(0.5)
  $db = sqlopen($tmp .. "/sessions.db", "rw")
  $wire = json_encode({op: "restart-fired", state: "done"})
  sqlexec($db, "UPDATE awaits SET state = 'fired', fired = ?, outcome = ? WHERE id = ?", [time(), $wire, $aid])
  sqlexec($db, "INSERT INTO await_outbox (id, await_id, session, fired, outcome) VALUES (?, ?, ?, ?, ?)", [uuid(), $aid, $s, time(), $wire])
  sqlclose($db)
  citizen($here .. "/../scripts/agentd.mix", "agent", $agent_env)
  up()
  check("restart delivers fired undelivered outbox", wait_outcomes($s, 1) and wait_await($aid, "delivered"))
  close_session($s)

  $s = start("resumer")
  write_file($tmp .. "/ops.json", json_encode({past: {op: "past", state: "done"}}))
  $r = call("agent.session.await", {session: $s, service: "ops", op: "past"})
  check("catch-up fires before reply", $r.rc == 0 and $r.v.state == "fired")
  check("catch-up delivers without suspension", wait_outcomes($s, 1) and len(events($s, "suspended")) == 0)
  close_session($s)

  $s = start("resumer")
  $aid = register($s, "deadline", {deadline_s: 0.5})
  prompt($s, "wait")
  check("deadline turn delivered", wait_outcomes($s, 1))
  check("deadline leaves await pending", wait_status($s, "waiting") and row($aid).state == "pending")
  op_done("deadline", "done")
  check("real outcome after deadline delivered", wait_outcomes($s, 2) and wait_await($aid, "delivered"))
  close_session($s)

  $s = start("resumer")
  $aid = register($s, "cancelled", {})
  prompt($s, "wait")
  wait_status($s, "waiting")
  op_done("cancelled", "cancelled")
  check("cancelled op is terminal", wait_outcomes($s, 1) and wait_await($aid, "delivered"))
  close_session($s)

  $s = start("resumer")
  prompt($s, "SLOW")
  $aid = register($s, "busy", {})
  op_done("busy", "done")
  sleep(0.2)
  check("busy outcome held", len(outcomes($s)) == 0 and row($aid).state == "fired")
  call("agent.session.cancel", {session: $s})
  check("busy outcome delivered after turn", wait_outcomes($s, 1) and wait_await($aid, "delivered"))
  close_session($s)

  $s = start("resumer")
  $aid = register($s, "refuse", {})
  prompt($s, "wait")
  wait_status($s, "waiting")
  write_file($tmp .. "/refuse", "yes")
  op_done("refuse", "failed")
  check("reopen failure fails await", wait_await($aid, "failed") and wait_status($s, "ended"))
  sleep(0.1)
  check("reopen failure topic", len(topics("agent.await.failed", "await", $aid)) == 1)
  run_argv_must(["rm", $tmp .. "/refuse"])

  $s = start("resumer")
  $aid = register($s, "closed", {})
  prompt($s, "wait")
  wait_status($s, "waiting")
  close_session($s)
  op_done("closed", "done")
  sleep(0.2)
  check("close cancels and does not resurrect", row($aid).state == "cancelled" and row($aid).reason == "closed" and status($s) == "ended" and len(outcomes($s)) == 0)

  $s = start("resumer")
  $aid = register($s, "human", {})
  prompt($s, "ERROR")
  check("error reply suspends", wait_status($s, "waiting"))
  prompt($s, "human turn")
  check("human prompt resumes then suspends again", wait_status($s, "waiting") and len(events($s, "suspended")) == 2)
  prompt($s, "DIE")
  check("self exit becomes waiting", wait_status($s, "waiting") and row($aid).state == "pending")
  close_session($s)

  $s = start("resumer")
  $aid = register($s, "crash", {})
  prompt($s, "wait")
  wait_status($s, "waiting")
  write_file($tmp .. "/crash", "yes")
  op_done("crash", "done")
  check("crash redelivery capped", wait_await($aid, "failed") and row($aid).redeliveries == 3 and len(outcomes($s)) == 4)
  check("crash redelivery framed", contains(json_encode(outcomes($s)), "Redelivery"))
  run_argv_must(["rm", $tmp .. "/crash"])
  close_session($s)

  $s1 = start("resumer")
  $a1 = register($s1, "fifo1", {})
  prompt($s1, "wait")
  wait_status($s1, "waiting")
  $s2 = start("resumer")
  $a2 = register($s2, "fifo2", {})
  prompt($s2, "wait")
  wait_status($s2, "waiting")
  $blocker = start("resumer")
  check("waiting does not count towards max_live", call("agent.agents", {}).v.live == 1)
  op_done("fifo1", "done")
  sleep(0.1)
  op_done("fifo2", "done")
  sleep(0.2)
  check("max_live holds outboxes", len(outcomes($s1)) == 0 and len(outcomes($s2)) == 0)
  close_session($blocker)
  check("FIFO oldest gets slot", wait_outcomes($s1, 1) and len(outcomes($s2)) == 0)
  close_session($s1)
  check("FIFO next gets freed slot", wait_outcomes($s2, 1))
  close_session($s2)

  $s = start("resumer")
  $a1 = register($s, "batch1", {})
  $a2 = register($s, "batch2", {})
  prompt($s, "wait")
  wait_status($s, "waiting")
  $blocker = start("resumer")
  op_done("batch1", "done")
  op_done("batch2", "lost")
  sleep(0.1)
  close_session($blocker)
  prompt($s, "human after outcomes")
  check("batch delivered", wait_await($a1, "delivered") and wait_await($a2, "delivered"))
  wait_status($s, "ready")
  $ps = events($s, "prompt")
  check("outcomes batched before human prompt", len($ps) == 3 and contains(json_encode($ps[1].content), "batch1") and contains(json_encode($ps[1].content), "batch2") and contains(json_encode($ps[2].content), "human after outcomes"))
  close_session($s)

  $s = start("resumer")
  $aid = register($s, "no-suspend", {suspend: false})
  prompt($s, "ordinary turn")
  wait_status($s, "ready")
  check("suspend false keeps agent ready", status($s) == "ready" and row($aid).state == "pending")
  check("cancel changes only pending await", call("agent.await.cancel", {await: $aid}).v.cancelled == true and call("agent.await.cancel", {await: $aid}).v.cancelled == false)
  check("list filters by session", len(call("agent.await.list", {session: $s}).v.awaits) == 1)
  check("unknown session refused", call("agent.session.await", {session: "abcd1234", service: "ops", op: "none"}).rc == 14)
  close_session($s)

  $s = start("resumer")
  $aid = register($s, "queued-cancel", {})
  call("agent.session.set", {session: $s, option: "model", value: "slow-test"})
  prompt($s, "queued")
  call("agent.session.cancel", {session: $s})
  check("cancel queued prompt suspends", wait_status($s, "waiting") and len(events($s, "prompt")) == 0)
  close_session($s)

  $s = start("resumer")
  $aid = register($s, "crash-once", {})
  prompt($s, "wait")
  wait_status($s, "waiting")
  write_file($tmp .. "/crash", "once")
  op_done("crash-once", "done")
  check("one crash redelivers successfully", wait_await($aid, "delivered") and row($aid).redeliveries == 1 and len(outcomes($s)) == 2)
  close_session($s)

  $s = start("resumer")
  $aid = register($s, "restart-inflight", {})
  prompt($s, "wait")
  wait_status($s, "waiting")
  write_file($tmp .. "/hold", "yes")
  op_done("restart-inflight", "done")
  wait_outcomes($s, 1)
  check("not delivered before stop", row($aid).state == "fired")
  call("QUIT", {})
  sleep(0.5)
  run_argv_must(["rm", $tmp .. "/hold"])
  citizen($here .. "/../scripts/agentd.mix", "agent", $agent_env)
  up()
  check("restart redelivers in-flight outcome", wait_await($aid, "delivered") and row($aid).redeliveries == 1 and len(outcomes($s)) == 2)
  close_session($s)
catch $m
  check("harness: " .. $m, false)
finally
  for each $pid in $pids
    try kill($pid) catch $m end
  end
  if $bus != nil then $pb.stop($bus) end
end
$failed = filter($results, fn($r) = not $r.ok)
print(to_string(len($results) - len($failed)) .. "/" .. to_string(len($results)) .. " passed; logs in " .. $tmp)
exit(if len($failed) == 0 then 0 else 1 end)
