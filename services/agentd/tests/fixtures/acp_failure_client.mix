-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.1.0
-- Failure paths use only processes and sessions on this test's private Bus.
$mix = env("MIXOS_TEST_MIX")
$tmp = env("ACP_TEST_DIR")
$S = {watch: nil, sid: nil, phase: "start", text: "", card: nil, retired: false,
  bad_frames: 0, agent_pid: to_number(env("ACP_TEST_AGENT_PID")), recovered: false, interrupted: false}
$mcp = [{name: "t3-code", type: "http", url: "http://127.0.0.1:1/mcp", headers: [{name: "X-Fixture", value: "one"}]}]

fn check($name, $condition)
  print((if $condition then "PASS " else "FAIL " end) .. $name)
  if not $condition then exit(1) end
end

fn input($m)
  $m.jsonrpc = "2.0"
  if not process_write($S.watch, json_encode($m) .. "\n") then raise("ACP_TEST", "input refused") end
end

fn load($id, $servers)
  input({id: $id, method: "session/load", params: {sessionId: $S.sid, cwd: $tmp .. "/workspace", mcpServers: $servers}})
end

fn prompt($id, $text)
  $S.text = ""
  input({id: $id, method: "session/prompt", params: {sessionId: $S.sid, prompt: [{type: "text", text: $text}]}})
end

fn restart_agent()
  $stopped = kill($S.agent_pid, 15)
  $waited = run_argv(["pidwait", "-p", to_string($S.agent_pid)], {timeout: 3})
  check("owned native gateway stopped", $waited.ok)
  $S.agent_pid = spawn([$mix, "--serve", env("ACP_TEST_AGENTD"), "--name", "agent"],
    {exit_event: true, die_with_parent: true, env: {MIXOS_AGENTD_CONF: $tmp .. "/agent.conf.mix", MIXOS_AGENTD_DB: $tmp .. "/sessions.db"},
      stdout: {file: $tmp .. "/restarted-agent.log"}, stderr: "stdout"})
end

fn crash_waiting_agent()
  send agent agent.session.new body=json_encode({agent: "fixture", cwd: $tmp .. "/workspace"}) timeout=5
  check("native child operation started", $rc == 0)
  $child = $result.session
  send agent agent.session.await body=json_encode({session: $S.sid, service: "agent", op: $child, suspend: true}) timeout=5
  check("native suspended await registered", $rc == 0)
  $r = run_argv(["pgrep", "-P", to_string($S.agent_pid)], {timeout: 3})
  $found = false
  for $line in split(trim($r.stdout), "\n")
    if $line != "" then
      $path = "/proc/" .. $line .. "/environ"
      if is_file($path) and contains(split(read_file($path), "\0"), "MIXOS_AGENT_SESSION=" .. $S.sid) then
        $stopped = kill(to_number($line), 9)
        $found = true
      end
    end
  end
  check("only this test session's ACP child crashed", $found)
end

fn load_after_recovery()
  if $S.recovered and $S.interrupted and $S.phase == "restart-wait" then
    $S.phase = "recover-load"
    load(4, $mcp)
  end
end

on proc.line
  if $event.args.stream == "stderr" then append_file($tmp .. "/adapter.stderr", $event.args.line .. "\n"); return nil end
  $m = json_parse($event.args.line)
  append_file($tmp .. "/frames.jsonl", $event.args.line .. "\n")
  if $m.method == "session/update" then
    if $m.params.update.sessionUpdate == "agent_message_chunk" then $S.text = $S.text .. ($m.params.update.content.text ?? "") end
  elif $m.method == "$/cancel_request" then
    check("native settlement retires the outstanding ACP request", $m.params.requestId == $S.card)
    $S.retired = true
    input({id: $S.card, error: {code: -32800, message: "cancelled"}})
  elif $m.method == "session/request_permission" then
    $S.card = $m.id
    $S.retired = false
    if $S.phase == "external-answer" then
      send agent agent.permission.respond body=json_encode({session: $S.sid, request: split($m.id, ":")[2], option: "allow"}) timeout=5
      check("a native peer answers the same permission", $rc == 0)
    else
      input({method: "session/cancel", params: {sessionId: $S.sid}})
    end
  elif $m.id == 90 or $m.id == 91 then
    check("malformed params produce an error", $m.error != nil)
    $S.bad_frames = $S.bad_frames + 1
  elif $m.id == 1 then
    check("adapter survives malformed frames and error responses", $S.bad_frames == 2)
    input({id: 2, method: "session/new", params: {cwd: $tmp .. "/workspace", mcpServers: $mcp}})
  elif $m.id == 2 then
    check("setup after bad frames succeeds", $m.error == nil)
    $S.sid = $m.result.sessionId
    input({id: 5, method: "session/set_mode", params: {sessionId: $S.sid, modeId: "plan"}})
  elif $m.id == 5 then
    load(6, $mcp)
  elif $m.id == 6 then
    check("load returns current mode", $m.result.modes.currentModeId == "plan")
    check("equal-MCP load leaves one credential file", len(glob($tmp .. "/mcp/acp-*.json")) == 1)
    $S.phase = "external-answer"
    prompt(7, "PERMISSION")
  elif $m.id == 7 then
    check("externally answered permission retires before completion", $S.retired and contains($S.text, "perm:allow"))
    $S.phase = "permission-cancel"
    prompt(8, "PERMISSION SLOW")
  elif $m.id == 8 then
    check("Stop retires pending permission and completes its turn", $S.retired and $m.result.stopReason == "cancelled")
    $S.phase = "restart-turn"
    prompt(3, "SLOW")
  elif $m.id == 3 then
    check("gateway restart settles the outstanding ACP prompt", $m.error != nil)
    $S.interrupted = true
    load_after_recovery()
  elif $m.id == 4 then
    check("same editor resumes the native conversation after restart", $m.error == nil)
    $changed = $mcp
    $changed[0].headers = [{name: "X-Fixture", value: "two"}]
    load(20, $changed)
  elif $m.id == 20 then
    check("changed-MCP load completes its native reopen", $m.error == nil)
    check("changed-MCP load replaces the session attachment", len(glob($tmp .. "/mcp/acp-*.json")) == 1)
    $S.phase = "wait-turn"
    prompt(9, "SLOW")
  elif $m.id == 9 then
    check("suspended native turn settles its ACP prompt", $m.error != nil)
    check("native waiting session remains available", true)
    exit(0)
  elif $m.error != nil then
    check("unexpected error: " .. json_encode($m), false)
  end
end

on agent.session.updated
  if $event.args.session == $S.sid and $event.args.kind == "prompt" then
    if $S.phase == "restart-turn" then
      $S.phase = "restart-wait"
      restart_agent()
    elif $S.phase == "wait-turn" then
      $S.phase = "suspend-wait"
      crash_waiting_agent()
    end
  end
end

on proc.watch_exited
  raise("ACP_TEST", "adapter exited during a failure-path test")
end

on agent.session.ended
  if $event.args.session == $S.sid and $event.args.error_code == "agentd_restart" then
    $S.recovered = true
    load_after_recovery()
  end
end

subscribe("agent.session.updated")
subscribe("agent.session.ended")
$S.watch = process_watch([$mix, env("ACP_TEST_ADAPTER")], {stdin: "pipe", stderr: "lines", overflow: "block", max_line: 16777216})
input({id: 90, method: "initialize", params: 5})
input({id: 91, method: "initialize", params: "bad"})
input({id: "already-cancelled", error: {code: -32800, message: "cancelled"}})
input({id: 1, method: "initialize", params: {protocolVersion: 1}})
