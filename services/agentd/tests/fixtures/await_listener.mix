-- SPDX-License-Identifier: MIT OR Apache-2.0
fn record()
  append_file(env("AWAIT_EVENTS"), json_encode({topic: $event.command, body: $event.args}) .. "\n")
end
on agent.await.fired
  record()
end
on agent.await.delivered
  record()
end
on agent.await.failed
  record()
end
on agent.session.suspended
  record()
end
on agent.session.ended
  record()
end
on agent.op.done
  record()
end
for each $topic in ["agent.op.done", "agent.await.fired", "agent.await.delivered", "agent.await.failed", "agent.session.suspended", "agent.session.ended"]
  subscribe($topic)
end
