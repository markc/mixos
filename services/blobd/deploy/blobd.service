# MixOS blob store daemon (blobd). The same identities as the previous unit it
# replaces: uid blobd, group blob (522), the same state root
# @{state}/blobd and config @{config}/blobd/config.conf.mix, so the
# store is read in place. Stop blobd before starting this one: both
# register as the Bus service "blobd" and both hold the lane port.

[Unit]
Description=MixOS blob store daemon (blobd)
After=network-online.target noded.service
Wants=network-online.target noded.service
StartLimitIntervalSec=10min
StartLimitBurst=3

[Service]
Type=simple
User=blobd
Group=blobd
SupplementaryGroups=blob
StateDirectory=mixos/blobd
StateDirectoryMode=0750
RuntimeDirectory=mixos/blobd
RuntimeDirectoryMode=0750
ConfigurationDirectory=mixos/blobd
ConfigurationDirectoryMode=0755
WorkingDirectory=%S/mixos/blobd
ExecStart=@{prefix}/bin/blobd -c %E/mixos/blobd/config.conf.mix
Restart=on-failure
RestartSec=30s
Environment=RUST_LOG=blobd=info
Environment=HOME=%S/mixos/blobd
Environment=MIXOS_NODE_CONFIG=%E/mixos/node.conf.mix
StandardOutput=journal
StandardError=journal
SyslogIdentifier=blobd
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10000

# §5.1 required (Level 1)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

# §5.2 mandatory hardening (Level 2)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallFilter=@chown
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
UMask=0027
PrivateDevices=yes

[Install]
WantedBy=multi-user.target
