-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.1.0
-- bridged: a Bus bridge to an external application's line-delimited JSON
-- control channel, one instance per application. The protocol and logic are
-- lib/bridge_core.mix; this file is only the Bus surface.
--
-- Run: mix bridged.mix --start <app>             (the unit: checks, then serves)
--      mix --serve bridged.mix --name <app>      (serve directly, Bus service "<app>")
--      mix bridged.mix --check <app>             (the start checks only)
--
-- The serve name must be one Bus service-name segment ([a-z][a-z0-9-]{1,30})
-- that no registered Bus verb already starts with (registry: $BRIDGED_VERBS,
-- else /opt/mixos/share/bus/verbs.conf.mix; missing or unreadable refuses).
-- mix --serve registers the name before this file runs, so a refusal in
-- serve mode comes just after registration. --start runs the checks first,
-- in this process, and only then starts the serve citizen as its child, so a
-- refused name never reaches the Bus.
-- Config: $BRIDGED_CONFIG, else <etc>/bridge/<app>.conf.mix with <etc> =
-- $MIXOS_ETC or /etc/mixos. Keys: host, port, auth, token_file, timeout_s,
-- connect_timeout_s, backoff_s, max_line, instance (docs/spec/bridge/).
-- A refusal at start prints "bridged: refusing to start: CODE: message" and
-- exits 2 (CODE: NAME_INVALID, NAME_RESERVED, REGISTRY, CONFIG, TOKEN); an
-- unexpected error at start exits 3. --start otherwise exits with its
-- child's exit code. The unit never restarts on 2.
--
-- Verbs (body is a JSON object where one is listed):
--   <app>.call        {method, params?}   pass-through, any method
--   <app>.commands    engine.commands
--   <app>.execute     {command, params?}  engine.execute
--   <app>.inspect     ui.inspect
--   <app>.screenshot  {path?, focus?}     ui.screenshot
--   <app>.status      connection state; never shows the token
-- Replies: rc 0 = JSON text of the app's result; rc 10 = app error text;
-- rc 11 = transport/connect/auth/timeout (text says which); rc 12 = bad request.

$core = require("lib/bridge_core.mix")

-- A documented refusal exits 2 (the unit skips, never restarts). Anything
-- else is unexpected and exits 3, so the unit fails visibly instead.
$REFUSALS = ["NAME_INVALID", "NAME_RESERVED", "REGISTRY", "CONFIG", "TOKEN"]

fn refuse($code, $message)
  if contains($REFUSALS, $code) then
    eprint("bridged: refusing to start: " .. $code .. ": " .. $message)
    exit(2)
  end
  eprint("bridged: unexpected error at start: " .. $code .. ": " .. $message)
  exit(3)
end

-- Every start check: the name, the registry, the config and the token.
-- Returns {cfg, token}.
fn preflight($name)
  $core.check_name($name, $core.registry_path())
  $c = $core.load_config($core.config_path($name))
  $t = nil
  if $c.auth == "token" then $t = $core.load_token($c.token_file) end
  return {cfg: $c, token: $t}
end

$svc = serve_name()
if $svc == nil then
  $a = args()
  if len($a) != 2 or ($a[0] != "--check" and $a[0] != "--start") then
    eprint("usage: mix bridged.mix --start <app> | mix bridged.mix --check <app> | mix --serve bridged.mix --name <app>")
    exit(3)
  end
  $app = $a[1]
  try
    $p = preflight($app)
    print("bridged: " .. $app .. " may start (" .. $core.config_path($app) .. ", auth " .. $p.cfg.auth .. ")")
    $p = nil
  catch $m, $e
    refuse($e.code ?? "FAILED", $m)
  end
  if $a[0] == "--check" then exit(0) end
  -- --start: Mix has no process-replacing exec, so the serve citizen is a
  -- child of this process (deliberately: the checks above ran first, in
  -- process). This process waits for it and exits with its code; the unit's
  -- control-group kill reaches both; Mix then records the SIGTERM this process
  -- got and exits 143 whatever the child returned (the unit's clean-stop
  -- status). There is no parent-death protection outside the unit. BRIDGED_MIX
  -- names the mix binary for the child (default /opt/mixos/bin/mix); it exists
  -- for tests and must come from administrator-controlled environment only.
  $mix = env("BRIDGED_MIX") ?? ""
  if $mix == "" then $mix = "/opt/mixos/bin/mix" end
  $code = 3
  try
    $code = run_stream([$mix, "--serve", realpath($0), "--name", $app])
  catch $m
    eprint("bridged: could not start the serve citizen: " .. $m)
    $code = 3
  end
  exit($code)
end

$cfg = nil
$token = nil
try
  $p = preflight($svc)
  $cfg = $p.cfg
  $token = $p.token
  $p = nil
catch $m, $e
  refuse($e.code ?? "FAILED", $m)
end

$S = $core.new_state($cfg, $token)
$token = nil

on @.call desc "Pass-through: body {method, params} is sent as one control request; the app's result comes back as JSON text."
  $req = $core.parse_body($event.body)
  $err = $core.need_string($req, "method")
  if $err != nil then
    reply(12, $svc .. ".call: " .. $err)
  else
    $r = $core.dispatch($S, $req.method, $req.params ?? {})
    $S = $r.st
    reply($r.rc, $r.body)
  end
end

on @.commands desc "List the app's control commands (engine.commands)."
  $r = $core.dispatch($S, "engine.commands", {})
  $S = $r.st
  reply($r.rc, $r.body)
end

on @.execute desc "Run one app command: body {command, params?} is sent as engine.execute."
  $req = $core.parse_body($event.body)
  $err = $core.need_string($req, "command")
  if $err != nil then
    reply(12, $svc .. ".execute: " .. $err)
  else
    $r = $core.dispatch($S, "engine.execute", {command: $req.command, params: $req.params ?? {}})
    $S = $r.st
    reply($r.rc, $r.body)
  end
end

on @.inspect desc "Read the app's UI tree (ui.inspect)."
  $r = $core.dispatch($S, "ui.inspect", {})
  $S = $r.st
  reply($r.rc, $r.body)
end

on @.screenshot desc "Capture the app (ui.screenshot). Optional body {path?, focus?}; an empty body is fine."
  $raw = $event.body ?? ""
  $req = {}
  if $raw != "" then $req = $core.parse_body($raw) end
  if $raw != "" and type($req) != "map" then
    reply(12, $svc .. ".screenshot: body must be a JSON object")
  else
    $r = $core.dispatch($S, "ui.screenshot", $core.optional_params($req, ["path", "focus"]))
    $S = $r.st
    reply($r.rc, $r.body)
  end
end

on @.status desc "Connection state, last error and last round-trip latency. Never includes the token."
  reply(0, json_encode(merge({service: $svc}, $core.status($S))))
end
