-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.1.0
-- bridged_condition: the unit's ExecCondition. Runs `bridged.mix --check
-- <app>` (beside this file) as a child and maps its exit for systemd, which
-- skips the unit on any exit 1-254 and fails it on 255:
--   0          the instance may start             -> 0
--   2          a deliberate, documented refusal    -> 2   (skipped, not restarted)
--   any other  an unexpected error, a crash, a
--              signal or a timeout                 -> 255 (a failure, visible)
-- Kept this small on purpose: an error here would itself exit 1 and read as
-- a skip.
--
-- Run: mix bridged_condition.mix <app>

$code = 255
try
  $a = args()
  if len($a) == 1 then
    $r = run_argv(["/opt/mixos/bin/mix", dirname(realpath($0)) .. "/bridged.mix", "--check", $a[0]],
      {stdout: "inherit", stderr: "inherit", timeout: 60})
    if $r.signal == nil and not $r.timed_out and ($r.exit_code == 0 or $r.exit_code == 2) then $code = $r.exit_code end
  else
    eprint("usage: mix bridged_condition.mix <app>")
  end
catch $m
  eprint("bridged_condition: " .. $m)
end
exit($code)
