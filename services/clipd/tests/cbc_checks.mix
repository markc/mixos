-- version: 0.1.0
-- Run only through the authorised CBC launcher. fmt prints its patch and
-- restores this job's own edits while the worker lock is still held.
if len(args()) != 1 or not contains(["fmt", "gate"], args()[0]) then
  raise("USAGE", "CBC helper requires exactly one mode: fmt or gate")
end
if args()[0] == "fmt" then
  try
    run_argv_must(["cargo", "fmt", "-p", "mix", "-p", "mixos-mcp", "-p", "inputd"], {timeout: 120})
    print(run_argv_must(["git", "diff", "--", "libs/mix", "cli/mixos-mcp", "services/inputd"]))
  finally
    run_argv_must(["git", "checkout", "-q", "--", "."])
  end
else
  run_argv_must(["cargo", "fmt", "-p", "mix", "-p", "mixos-mcp", "-p", "inputd", "--", "--check"], {timeout: 120, stdout: "inherit", stderr: "inherit"})
  run_argv_must(["cargo", "clippy", "-p", "mix", "-p", "mixos-mcp", "--all-targets", "--", "-D", "warnings"], {timeout: 3600, stdout: "inherit", stderr: "inherit"})
  run_argv_must(["cargo", "test", "-p", "mix", "-p", "mixos-mcp"], {timeout: 3600, stdout: "inherit", stderr: "inherit"})
  run_argv_must(["cargo", "clippy", "-p", "inputd", "--all-targets", "--", "-D", "warnings"], {timeout: 3600, stdout: "inherit", stderr: "inherit"})
  run_argv_must(["cargo", "test", "-p", "inputd", "--lib"], {timeout: 3600, stdout: "inherit", stderr: "inherit"})
end
