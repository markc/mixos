[Unit]
Description=MixOS session clipboard (host desktop)
After=graphical-session.target noded.service
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=@{prefix}/bin/clipd --session vt1
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
