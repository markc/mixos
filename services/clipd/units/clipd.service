[Unit]
Description=MixOS clipboard store
Wants=noded.service
After=noded.service

[Service]
Type=simple
Environment=MIXOS_CLIPD_MODE=store
Environment=MIX_STATS=off
ExecStart=@{prefix}/bin/mix --serve @{prefix}/lib/clipd/clipd.mix --name clipd
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
