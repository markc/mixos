[Unit]
Description=MixOS session clipboard for VT%i
After=compd@%i.service
PartOf=session@%i.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=mixos
EnvironmentFile=@{etc}/session/%i.env
ExecStart=@{prefix}/bin/clipd --session vt%i
Restart=on-failure
RestartSec=2

[Install]
WantedBy=session@%i.target
