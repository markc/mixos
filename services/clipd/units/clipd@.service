[Unit]
Description=MixOS clipboard for session %i
# The session target chooses the broker (noded@%i or the system noded.service);
# this unit only orders after both. Never Wants= or Requires= a broker: on a desk
# with the system broker noded@%i is masked.
After=noded@%i.service noded.service
PartOf=session@%i.target

[Service]
Type=simple
User=mixos
EnvironmentFile=@{etc}/session/%i.env
Environment=MIXOS_CLIPD_SESSION=vt%i
Environment=MIXOS_CLIPD_MODE=wayland
Environment=MIX_STATS=off
ExecStart=@{prefix}/bin/mix --serve @{prefix}/lib/clipd/clipd.mix --name clipd
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
UMask=0077
