-- The same owned, throwaway broker used by the compositor's Mix gates.
$pb = require("../../../../../../tests/lib/private_bus.mix")
$a = args()
$record = $a[1] .. "/bus.json"
if $a[0] == "start" then
  $bus = $pb.start({dir: $a[1], name: "headless-test", noded: $a[2], export: false})
  write_file($record, json_encode($bus))
  print(json_encode($bus))
elif $a[0] == "stop" then
  $pb.stop(json_parse(read_file($record)))
elif $a[0] == "ready" then
  $service = if len($a) > 2 then $a[2] else "comp-headless" end
  $deadline = monotonic() + 15
  while monotonic() < $deadline
    send $service comp.windows.list timeout=1 body="{}"
    if $rc == 0 then exit(0) end
    sleep(0.1)
  end
  raise("COMPD_READY", "headless Bus port did not register")
else
  $verb = $a[2]
  $body = $a[3]
  $service = if len($a) > 4 then $a[4] else "comp-headless" end
  send $service $verb timeout=10 body=$body
  print(json_encode({rc: $rc, body: $result}))
end
