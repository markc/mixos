# layers.conf.mix — the compd crate layer table (strict data, load_data).
# version: 0.3.1
#
# Read by tools/layering_gate.mix and tools/closure_gate.mix.
#
# RULE: every dependency edge between workspace crates goes to a LOWER layer
# or WITHIN THE SAME LAYER, and the crate graph is acyclic (cargo already
# refuses cycles in normal/build deps). An edge from a lower layer to a higher
# one fails the layering gate. A workspace crate of this component missing
# from `layers` fails too ("unknown crate") unless the gate runs with
# --allow-unlisted.
#
# The table lists every compd crate, present or still to land; the gates only
# look up crates the workspace has, so an entry for a crate that has not
# landed yet is inert. A crate's layer is a design decision: change it
# deliberately, never to make a build pass.
#
# closure_gate.mix reads three lists below: `headless_crates` (no smithay,
# egui, wgpu, winit or Bevy in their closure), `core_crates` (no Bevy and no
# ash: the compositor is GLES only) and `effects_crates` (the only crates
# that may ever reach Bevy; none today). Nothing in the component may reach
# the iced toolkit.

# The component this table orders; packages outside it (libs/) are not listed.
component: "compd"

layers: {
  # 0 — model and the slot/channel/persist system
  "model": 0,
  "slots": 0,
  # 0 — the engine-neutral policy cores: surface registry, frame/presentation
  #     ledgers, the comp.* wire model, policy
  "surfaces": 0,
  "ledger": 0,
  "comp-model": 0,
  "policy": 0,
  # 0 — the desktop shell's panel/edge model (pure, no dependencies)
  "edges": 0,
  # 0 — motion maths: curves, springs, routes, Fitts (pure, no dependencies)
  "motion": 0,

  # 1 — device primitives (drm/udev/seat/input/gpu + kernel.scanout),
  #     GLES renderer primitives, the one wgpu device factory
  "kms": 1,
  "render-gles": 1,
  "graphics": 1,

  # 2 — smithay state + dispatch, Xwayland WM, effects trait, drivers
  "protocols": 2,
  "dispatcher": 2,
  "x11-wm": 2,
  "effects": 2,
  "drivers": 2,

  # 3 — core state, seat, scene, the compositor's own egui UI
  "world": 3,
  "seat": 3,
  "scenegraph": 3,
  "ui": 3,
  # 3 — wlr-screencopy v3 over the Dispatch (L2) and the schedule
  "screencopy": 3,
  # 3 — server-side decoration chrome (decor layout + design tokens)
  "decor": 3,

  # 4 — frame ledgers, native backend + executor, nested backend,
  #     capture, display, protocols
  "frames": 4,
  "native": 4,
  "nested": 4,
  "recorder": 4,
  "outputs": 4,
  "policy-host": 4,
  # 4 — headless test harness over core state (dev-dependency only)
  "testkit": 4,

  # 5 — the Mix Scenes shell host
  "scene-host": 5,

  # 6 — the Bus port
  "comp-service": 6,

  # 7 — the binary
  "compd": 7,
}

# The binary package.
binary: "compd"

# No GPU, windowing or compositor toolkit in their closure.
headless_crates: ["model", "surfaces", "ledger", "comp-model", "policy", "edges", "motion", "comp-service"]

# Must reach neither bevy nor ash, in every feature configuration.
core_crates: ["model", "slots", "surfaces", "ledger", "comp-model", "policy", "edges", "motion", "kms", "render-gles", "graphics", "protocols", "dispatcher", "x11-wm", "effects", "drivers", "world", "seat", "scenegraph", "ui", "screencopy", "decor", "frames", "native", "nested", "recorder", "outputs", "policy-host", "scene-host", "comp-service", "compd"]

# The only crates allowed to reach bevy. None today.
effects_crates: []
