-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Copyright 2026 Mark Constable <mc@mixos.dev>
-- version: 0.1.0
-- Build share/daylight/zones.mx, the zone -> place table daylight.mix reads,
-- from the IANA time zone database (tzdb), which is in the public domain.
--
--   mix services/daylight/tools/zones_from_tzdb.mix [--tzdata DIR] [--out FILE] [--check]
--
-- DIR holds zone.tab, zone1970.tab and tzdata.zi (default
-- /usr/share/zoneinfo). Each zone gets the coordinates tzdb records for it:
-- the principal location the zone is named after, which tzdb picks as the
-- region's most populous city. In order:
-- 1. zone.tab, one row per country and zone (Europe/Oslo keeps Oslo);
-- 2. zone1970.tab, for any zone zone.tab lacks;
-- 3. tzdata.zi links ("L target alias"), so an alias such as
--    Australia/Queensland gets its target's place.
-- Zones with no place (UTC, Etc/GMT+10) are left out: daylight.mix then
-- reports the sun as unknown. --check exits 1 when FILE differs from what
-- DIR would build.
$opt = getopt(args(), {tzdata: {arg: true}, out: {arg: true}, check: {}})
if len($opt.errors) > 0 or len($opt.rest) > 0 then raise("ARGS", "usage: zones_from_tzdb.mix [--tzdata DIR] [--out FILE] [--check]") end
$g = $opt.opts
$dir = $g.tzdata ?? "/usr/share/zoneinfo"
$here = dirname(realpath($0))
$out = $g.out ?? ($here .. "/../../../share/daylight/zones.mx")

-- ISO 6709 "+DDMM+DDDMM" or "+DDMMSS+DDDMMSS" to [lat, lon] in degrees,
-- rounded to 4 places (about 10 m, far finer than the sun needs).
fn coords($iso)
  $m = re_find($iso, "^([+-])([0-9]{2})([0-9]{2})([0-9]{2})?([+-])([0-9]{3})([0-9]{2})([0-9]{2})?$")
  if len($m) != 1 then raise("TZDB", "bad coordinates: " .. $iso) end
  $p = $m[0].groups
  $lat = to_number($p[1]) + to_number($p[2]) / 60 + to_number($p[3] ?? "0") / 3600
  $lon = to_number($p[5]) + to_number($p[6]) / 60 + to_number($p[7] ?? "0") / 3600
  if $p[0] == "-" then $lat = -$lat end
  if $p[4] == "-" then $lon = -$lon end
  return [round($lat * 10000) / 10000, round($lon * 10000) / 10000]
end

fn tab($path)
  $rows = {}
  for $line in lines(read_file($path))
    if $line == "" or starts_with($line, "#") then continue end
    $f = split($line, "\t")
    if len($f) < 3 then raise("TZDB", "short row in " .. $path .. ": " .. $line) end
    $rows[$f[2]] = coords($f[1])
  end
  return $rows
end

for $f in ["zone.tab", "zone1970.tab", "tzdata.zi"]
  if not is_file($dir .. "/" .. $f) then raise("TZDB", "missing " .. $dir .. "/" .. $f) end
end
$zi = lines(read_file($dir .. "/tzdata.zi"))
$version = if starts_with($zi[0] ?? "", "# version ") then trim(slice($zi[0], 10)) else raise("TZDB", "tzdata.zi has no version line") end

$zones = tab($dir .. "/zone.tab")
for $z, $c in tab($dir .. "/zone1970.tab")
  if $zones[$z] == nil then $zones[$z] = $c end
end
-- Links to a fixpoint: a link whose target is itself a link resolves once
-- its target has a place, whatever the file order.
$links = []
for $line in $zi
  if starts_with($line, "L ") then
    $f = fields($line)
    if len($f) == 3 then push($links, [$f[1], $f[2]]) end
  end
end
$grew = true
while $grew
  $grew = false
  for $l in $links
    if $zones[$l[0]] != nil and $zones[$l[1]] == nil then
      $zones[$l[1]] = $zones[$l[0]]
      $grew = true
    end
  end
end

-- One zone per line, sorted, so a tzdb update reads as a small diff.
$rows = map(sort(keys($zones)), fn($z) = "    " .. json_encode($z) .. ": " .. json_encode($zones[$z]))
$text = "-- SPDX-License-Identifier: LicenseRef-Public-Domain\n" ..
  "-- Generated by services/daylight/tools/zones_from_tzdb.mix from the IANA\n" ..
  "-- time zone database (zone.tab, zone1970.tab, tzdata.zi links), which is in\n" ..
  "-- the public domain (share/daylight/LICENSE-tzdb.txt). Do not edit by hand.\n" ..
  "{\n  schema: 1,\n  source: \"https://www.iana.org/time-zones\",\n  version: " .. json_encode($version) ..
  ",\n  zones: {\n" .. join($rows, ",\n") .. "\n  }\n}\n"
-- The text must read back as the same table.
$sorted = data_parse($text).zones
if len($sorted) != len($zones) or not deep_eq($sorted, $zones) then raise("TZDB", "zones.mx does not read back as built") end

if $g.check ?? false then
  if not is_file($out) or read_file($out) != $text then
    print("zones.mx differs from tzdb " .. $version .. " in " .. $dir)
    exit(1)
  end
  print("zones.mx matches tzdb " .. $version .. " (" .. to_string(len($sorted)) .. " zones)")
else
  write_atomic($out, $text)
  print("wrote " .. $out .. ": " .. to_string(len($sorted)) .. " zones from tzdb " .. $version)
end
