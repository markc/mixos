-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Captured VuIO protocol oracle, with deliberate differences asserted below.
$D = require("../scripts/lib/dlna.mix")
$H = require("../scripts/lib/http.mix")
$results = []
fn check($name, $ok)
  push($results, $ok)
  print((if $ok then "PASS " else "FAIL " end) .. $name)
end
fn fixture($name)
  return read_file("services/dlnad/tests/fixtures/vuio/" .. $name .. ".txt")
end
fn nodes($node)
  return filter($node.children, fn($c) = type($c) == "map")
end
fn response($xml)
  return xml_parse($xml).Envelope.Body.BrowseResponse
end
$refsoap = fixture("browse_video")
$ref = response($refsoap)
$refdidl = xml_parse($ref.Result)
$entries = []
for $item in $refdidl["DIDL-Lite"].item
  push($entries, {kind: "item", name: $item.title, rel: $item.title, size: to_number($item.res["@size"]), mime: $D.mime($item.title), srt: nil})
end
$base = "http://192.0.2.30:8200"
$didl = $D.didl("/unused", $entries, $base)
$items = xml_parse($didl)["DIDL-Lite"].item
$rt = xml_parse($ref.Result, {mode: "tree"})
$dt = xml_parse($didl, {mode: "tree"})
for $ns in ["xmlns", "xmlns:dc", "xmlns:upnp", "xmlns:sec"]
  check("DIDL namespace " .. $ns, $rt.attrs[$ns] == $dt.attrs[$ns])
end
-- Exception: unused VuIO pv namespace is replaced by dlna for our dialect.
check("namespace extension exception", $rt.attrs["xmlns:pv"] == "http://www.pv.com/pvplay/" and $dt.attrs["xmlns:dlna"] == "urn:schemas-dlna-org:metadata-1-0/")
for $i = 0 to length($items) - 1
  $r = $refdidl["DIDL-Lite"].item[$i]
  $a = $items[$i]
  check("item attribute set " .. to_string($i), deep_eq(sort(keys(nodes($rt)[$i].attrs)), sort(keys(nodes($dt)[$i].attrs))))
  check("restricted " .. to_string($i), $a["@restricted"] == $r["@restricted"])
  check("class " .. to_string($i), $a.class == $r.class)
  check("res attributes " .. to_string($i), deep_eq(sort(keys(nodes(nodes($rt)[$i])[2].attrs)), sort(keys(nodes(nodes($dt)[$i])[2].attrs))))
  check("res size " .. to_string($i), $a.res["@size"] == $r.res["@size"])
  check("protocolInfo transport/network/mime " .. to_string($i), deep_eq(slice(split($a.res["@protocolInfo"], ":"), 0, 3), slice(split($r.res["@protocolInfo"], ":"), 0, 3)))
  -- Exception: relative-path ids and root 0 avoid a persistent numeric index.
  check("path id exception " .. to_string($i), $a["@id"] == "/" .. $r.title and $a["@parentID"] == "0" and $r["@parentID"] == "video")
  check("path URL exception " .. to_string($i), $a.res["#text"] == $base .. $D.url_path($r.title))
  -- Exception: titles omit the extension for readable TV listings.
  check("title exception " .. to_string($i), $a.title == $D.stem($r.title))
  -- Exception: OP=01 is byte seek only; we do not implement time seeking (11).
  check("OP exception " .. to_string($i), replace($r.res["@protocolInfo"], "DLNA.ORG_OP=11", "DLNA.ORG_OP=01") == $a.res["@protocolInfo"])
end

$tmp = "/tmp/dlnad-oracle-" .. uuid()
mkdir($tmp)
for $e in $entries
  write_file($tmp .. "/" .. $e.name, "")
end
$body = "<Browse><ObjectID>0</ObjectID><BrowseFlag>BrowseDirectChildren</BrowseFlag><StartingIndex>0</StartingIndex><RequestedCount>0</RequestedCount><SortCriteria>-dc:title</SortCriteria></Browse>"
$actual = $D.control("ContentDirectory", {soapaction: "#Browse"}, $body, {root: $tmp, base: $base, title: "Example"})
$at = xml_parse($actual.body, {mode: "tree"})
$st = xml_parse($refsoap, {mode: "tree"})
check("SOAP envelope name and attributes", $at.name == $st.name and deep_eq($at.attrs, $st.attrs))
check("SOAP Body and response namespace", nodes($at)[0].name == nodes($st)[0].name and deep_eq(nodes(nodes($at)[0])[0].attrs, nodes(nodes($st)[0])[0].attrs))
$a = response($actual.body)
for $key in ["NumberReturned", "TotalMatches"]
  check("SOAP " .. $key, $a[$key] == $ref[$key])
end
check("SOAP response field set", deep_eq(sort(keys($a)), sort(keys($ref))))
-- Exception: UpdateID is live container mtime, not VuIO's constant 1.
check("update id exception", to_number($a.UpdateID) == floor(stat($tmp).mtime))
-- Exception: flat root exposes files directly, without virtual media categories.
$rootref = xml_parse(response(fixture("browse_root")).Result)["DIDL-Lite"]
check("flat root exception", length($rootref.container) == 4 and length(xml_parse($a.Result)["DIDL-Lite"].item) == 13)
$sort = $D.control("ContentDirectory", {soapaction: "#GetSortCapabilities"}, "", {root: $tmp})
check("no requested sort capability", contains($sort.body, "<SortCaps></SortCaps>"))
check("descending request retains fixed ascending order", deep_eq(map(xml_parse($a.Result)["DIDL-Lite"].item, fn($x) = $x.title), sort(map($entries, fn($x) = $D.stem($x.name)))))
run_argv_must(["rm", "-rf", $tmp])

$desc = xml_parse($D.description({uuid: "11111111-2222-3333-4444-555555555555", name: "Example"})).root
$rd = xml_parse(fixture("description")).root
check("description spec version", deep_eq($desc.specVersion, $rd.specVersion))
check("description device type and UDN", $desc.device.deviceType == $rd.device.deviceType and $desc.device.UDN == $rd.device.UDN)
for $i = 0 to 2
  $x = $desc.device.serviceList.service[$i]
  $y = $rd.device.serviceList.service[$i]
  check("description service identity " .. to_string($i), $x.serviceType == $y.serviceType and $x.serviceId == $y.serviceId)
  -- Exception: dlnad owns its endpoint paths, independent of VuIO routes.
  check("description route exception " .. to_string($i), starts_with($x.SCPDURL, "/dlna/") and starts_with($x.controlURL, "/ctl/") and starts_with($x.eventSubURL, "/evt/"))
end
-- Exception: local branding and DMS marker describe dlnad, not VuIO.
check("branding exception", $desc.device.manufacturer == "MixOS" and $rd.device.manufacturer == "VuIO" and $desc.device.X_DLNADOC == "DMS-1.50")
for $pair in [["cds_scpd", $D.content_directory_scpd()], ["cms_scpd", $D.connection_manager_scpd()]]
  $r = xml_parse(fixture($pair[0])).scpd
  $a = xml_parse($pair[1]).scpd
  $ra = $r.actionList.action
  if type($ra) != "list" then $ra = [$ra] end
  $aa = $a.actionList.action
  for $action in $ra
    $matches = filter($aa, fn($x) = $x.name == $action.name)
    check($pair[0] .. " action/argument list " .. $action.name, length($matches) == 1 and deep_eq($matches[0], $action))
  end
  -- Exception: CDS adds standard capability/update queries so clients can
  -- discover empty sort/search capabilities and the live update id.
  $expected = map($ra, fn($x) = $x.name)
  if $pair[0] == "cds_scpd" then $expected = concat($expected, ["GetSearchCapabilities", "GetSortCapabilities", "GetSystemUpdateID"]) end
  check($pair[0] .. " complete action list", deep_eq(map($aa, fn($x) = $x.name), $expected))
  $rv = $r.serviceStateTable.stateVariable
  $av = $a.serviceStateTable.stateVariable
  $expected_names = []
  for $var in $rv
    $expected_var = $var
    $label = $pair[0] .. " state variable " .. $var.name
    $matches = filter($av, fn($x) = $x.name == $var.name)
    push($expected_names, $var.name)
    if $pair[0] == "cds_scpd" and $var.name == "A_ARG_TYPE_BrowseFlag" then
      -- Exception: constrain BrowseFlag to the two modes dlnad implements;
      -- the capture leaves this string unconstrained.
      $expected_var.allowedValueList = {allowedValue: ["BrowseMetadata", "BrowseDirectChildren"]}
      $label = $label .. " supported browse modes exception"
    elif $pair[0] == "cms_scpd" and $var.name == "A_ARG_TYPE_Direction" then
      -- Exception: publish the valid ConnectionManager direction values;
      -- the capture leaves this string unconstrained.
      $expected_var.allowedValueList = {allowedValue: ["Input", "Output"]}
      $label = $label .. " direction enumeration exception"
    elif $pair[0] == "cms_scpd" and $var.name == "A_ARG_TYPE_ConnectionStatus" then
      -- Exception: publish the valid ConnectionManager status values;
      -- the capture leaves this string unconstrained.
      $expected_var.allowedValueList = {allowedValue: ["OK", "ContentFormatMismatch", "InsufficientBandwidth", "UnreliableChannel", "Unknown"]}
      $label = $label .. " status enumeration exception"
    end
    check($label, length($matches) == 1 and deep_eq($matches[0], $expected_var))
  end
  if $pair[0] == "cds_scpd" then
    -- Exception: the extra capability-query actions need their own string
    -- variables. Neither capability is evented; both query results are empty.
    for $name in ["SearchCapabilities", "SortCapabilities"]
      push($expected_names, $name)
      $matches = filter($av, fn($x) = $x.name == $name)
      check($pair[0] .. " capability variable exception " .. $name, length($matches) == 1 and deep_eq($matches[0], {name: $name, dataType: "string", "@sendEvents": "no"}))
    end
  end
  check($pair[0] .. " complete state variable names", deep_eq(sort(map($av, fn($x) = $x.name)), sort($expected_names)))
  for $action in $aa
    $arguments = $action.argumentList.argument
    if type($arguments) != "list" then $arguments = [$arguments] end
    for $argument in $arguments
      $matches = filter($av, fn($x) = $x.name == $argument.relatedStateVariable)
      check($pair[0] .. " relatedStateVariable " .. $action.name .. "/" .. $argument.name, length($matches) == 1)
    end
  end
end
for $name in ["media_head", "media_range"]
  $ref = $D.ssdp_parse(fixture($name))
  $r = if $name == "media_range" then $H.byte_range("bytes=0-99", 660074912) else nil end
  $status = if $r == nil then 200 else 206 end
  $out = $D.ssdp_parse($H.response_head($status, $H.media_headers("video/x-matroska", 660074912, $r, $D.DLNA_FEATURES)))
  check($name .. " status", $out.start == $ref.start)
  for $key in ["content-type", "accept-ranges", "transfermode.dlna.org", "content-length", "content-range"]
    check($name .. " " .. $key, $out.headers[$key] == $ref.headers[$key])
  end
  check($name .. " OP exception", $out.headers["contentfeatures.dlna.org"] == replace($ref.headers["contentfeatures.dlna.org"], "OP=11", "OP=01"))
  -- Exception: no Content-Disposition; DLNA media URLs already identify the
  -- resource. Server/Connection are added for identification and close framing.
  $expected = delete($ref.headers, "content-disposition")
  $expected.server = $out.headers.server
  $expected.connection = "close"
  check($name .. " complete header set", deep_eq(sort(keys($out.headers)), sort(keys($expected))))
  check($name .. " close framing", $out.headers.connection == "close")
  -- Date is generated at response time, so compare shape rather than clock.
  check($name .. " date shape", re_match($out.headers.date, "^[A-Z][a-z]{2}, [0-9]{2} [A-Z][a-z]{2} [0-9]{4} [0-9:]{8} GMT$"))
end
$n = length(filter($results, fn($ok) = $ok))
print(to_string($n) .. "/" .. to_string(length($results)) .. " passed")
if $n != length($results) then exit(1) end
