[Unit]
Description=MixOS shared editor service for session %i
# Wants, not Requires or BindsTo: editd's Bus client reconnects by itself,
# and a session that uses the node's system broker (noded@%i masked) must
# still start it. A binding to a masked unit refuses every start job.
Wants=noded@%i.service
After=noded@%i.service noded.service
PartOf=session@%i.target

[Service]
Type=simple
User=mixos
EnvironmentFile=@{etc}/session/%i.env
UnsetEnvironment=DBUS_SESSION_BUS_ADDRESS DBUS_STARTER_ADDRESS DBUS_STARTER_BUS_TYPE DBUS_SYSTEM_BUS_ADDRESS
ExecStart=@{prefix}/bin/editd serve
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=1
