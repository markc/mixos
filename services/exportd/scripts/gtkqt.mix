-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.1.0
-- exportd-gtkqt: one-way export of the settings authority's look to GTK
-- and Qt on a desk (key space v2 §5.3; clean-room daemon spec §6.3-§6.4).
-- A per-session Mix citizen. It subscribes to the appearance, window and
-- accessibility keys topics, and on each delivery (the retained replay at
-- start included) reads one record (settings.get values + settings.palette
-- at one revision) and writes what changed under $XDG_CONFIG_HOME:
--   gtk-4.0/mixos/{dark,light}.css, gtk-{3,4}.0/gtk.css -> the mode's css,
--   gtk-{3,4}.0/settings.ini [Settings] keys, qt{5,6}ct/colors/MixOS*.conf,
--   qt{5,6}ct/qt{5,6}ct.conf [Appearance] and [Fonts] keys, and gsettings
--   when the desk has it. `appearance.export_toolkits = false` stops the
--   writes and undoes nothing. A key the user changed by hand is left alone.
-- Environment: XDG_CONFIG_HOME (required; never the user's ~/.config unless
-- MIXOS_EXPORTD_GTKQT_HOME=1), MIXOS_SETTINGS_INSTANCE (the binding's
-- instance, else the node name), MIXOS_SETTINGS_PROFILE ("default", the only one served),
-- MIXOS_EXPORTD_STATE (default $MIXOS_VAR/exportd/gtkqt or
-- $XDG_STATE_HOME/mixos/exportd/gtkqt), MIXOS_SETTINGS_SERVICE
-- (the settings service, default settingsd).
$T = require("lib/gtkqt_map.mix")

fn absolute_dir($name)
  $d = env($name, "")
  if $d == "" or not starts_with($d, "/") or contains("/" .. $d .. "/", "/../") then return nil end
  $d = re_replace($d, "/+", "/")
  $d = replace($d, "/./", "/")
  $d = re_replace($d, "/\\.$", "")
  return if $d == "/" then $d else re_replace($d, "/+$", "") end
end

$config = absolute_dir("XDG_CONFIG_HOME")
$home = absolute_dir("HOME")
$skip = nil
if $config == nil then
  $skip = "XDG_CONFIG_HOME is unset or not absolute"
elif $home != nil and ($config == $home .. "/.config" or $config == (realpath($home) ?? $home) .. "/.config") and env("MIXOS_EXPORTD_GTKQT_HOME", "") != "1" then
  -- A nested or shared desk must never write through to its host desktop.
  $skip = "XDG_CONFIG_HOME is the home directory's own .config"
end
$state_dir = env("MIXOS_EXPORTD_STATE", "")
if $state_dir == "" then
  $var = absolute_dir("MIXOS_VAR")
  $xstate = absolute_dir("XDG_STATE_HOME")
  $state_dir = if $var != nil then $var .. "/exportd/gtkqt"
    elif $xstate != nil then $xstate .. "/mixos/exportd/gtkqt"
    elif $home != nil then $home .. "/.local/state/mixos/exportd/gtkqt"
    else nil end
end
if $state_dir == nil then raise("STATE", "exportd-gtkqt needs MIXOS_VAR, XDG_STATE_HOME or HOME") end
mkdir($state_dir)
chmod($state_dir, 0o700)
$record_path = $state_dir .. "/records.json"

$node_config = env("MIXOS_NODE_CONFIG", mixos_path("etc") .. "/node.conf.mix")
$node = if is_file($node_config) then load_data($node_config).node else nil end
$binding = {instance: env("MIXOS_SETTINGS_INSTANCE", ""), profile: env("MIXOS_SETTINGS_PROFILE", "default")}
if $binding.profile != "default" then raise("BINDING", "exportd-gtkqt follows the default profile only") end
if $binding.instance == "" then $binding.instance = $node end
if type($binding.instance) != "string" or $binding.instance == "" then raise("BINDING", "set MIXOS_SETTINGS_INSTANCE or a node name") end
$source = env("MIXOS_SETTINGS_SERVICE", "settingsd")

-- What we wrote, so undo restores originals and a hand edit is noticed:
-- files {path: {original, written}} where each is {kind: absent|file|link,
-- data|target}; keys {path: {"Section/key": {original, written}}}.
$R = {files: {}, keys: {}, created: {}, paused: false, pending: nil}
$record_error = nil
if is_file($record_path) then
  try
    $loaded = json_parse(read_file($record_path))
    if type($loaded) != "map" or type($loaded.files) != "map" or type($loaded.keys) != "map" or type($loaded.paused) != "bool" then raise("RECORD", "invalid record shape") end
    $R = merge($R, $loaded)
  catch $m
    -- Keep the evidence, stay available for status, and refuse all writes.
    $record_error = "unreadable records.json: " .. $m
    $skip = $record_error
  end
end
$status = {skip: $skip, config: $config, binding: $binding, revision: nil, incarnation: nil,
  outcome: (if $skip != nil then "skipped" else "waiting" end), written: [], kept: [],
  icon_theme_missing: false, gsettings: nil, last_error: nil, reconciles: 0}

fn save_records()
  if $record_error != nil then raise("RECORD", $record_error) end
  write_atomic($record_path, json_encode($R), {mode: 0o600, durability: "file"})
end

fn lstat($path)
  try
    return stat($path, {follow_symlinks: false})
  catch $m
    return nil
  end
end

-- Check every existing ancestor, including those above XDG_CONFIG_HOME.
-- The final gtk.css link is owned by us; its parents must still be plain.
fn plain_parents($path)
  $dir = dirname($path)
  loop
    $s = lstat($dir)
    if $s != nil and ($s.is_symlink or not is_dir($dir)) then raise("SYMLINK", "config ancestor is not a plain directory: " .. $dir) end
    if $dir == "/" then break end
    $dir = dirname($dir)
  end
end

-- One path's current state, as a record.
fn current($path)
  plain_parents($path)
  $s = lstat($path)
  if $s == nil then return {kind: "absent"} end
  if $s.is_symlink then return {kind: "link", target: read_link($path)} end
  if not is_file($path) then raise("NOT_A_FILE", $path .. " is not a regular file") end
  if $s.size > 262144 then raise("TOO_LARGE", $path .. " is over 256 KiB") end
  return {kind: "file", data: read_file($path)}
end

fn same($a, $b)
  return deep_eq($a, $b)
end

-- One atomic filesystem operation with a durable write-ahead intent.
-- On restart an intent is replayed only if the path still has its before
-- bytes; already-applied intents are harmless, and hand edits survive.
fn install_state($path, $after)
  plain_parents($path)
  if $after.kind == "absent" then
    if lstat($path) != nil then remove($path) end
  else
    mkdir(dirname($path))
    if $after.kind == "file" then
      write_atomic($path, $after.data, {durability: "file"})
    else
      $tmp = $path .. ".mixos-" .. uuid()
      symlink($after.target, $tmp)
      rename($tmp, $path)
    end
  end
end

fn recover_pending()
  $p = $R.pending
  if $p == nil then return nil end
  $now = current($p.path)
  if same($now, $p.before) then install_state($p.path, $p.after) end
  $R.pending = nil
  save_records()
end

fn commit_state($path, $before, $after)
  $R.pending = {path: $path, before: $before, after: $after}
  save_records()
  install_state($path, $after)
  $R.pending = nil
  save_records()
end

fn remember_original($path)
  if $R.files[$path] == nil then $R.files[$path] = {original: current($path), written: nil} end
end

fn put_file($path, $content)
  $now = current($path)
  if $now.kind == "link" then raise("SYMLINK", "refusing to write through a link: " .. $path) end
  $rec = $R.files[$path]
  if $rec != nil and ($rec.kept == true or ($rec.written != nil and not same($now, $rec.written))) then
    $R.files[$path].kept = true
    $status.kept = push($status.kept, $path)
    save_records()
    return false
  end
  if $now.kind == "file" and $now.data == $content then return false end
  remember_original($path)
  $R.files[$path].written = {kind: "file", data: $content}
  commit_state($path, $now, $R.files[$path].written)
  return true
end

fn put_link($path, $target)
  $now = current($path)
  $rec = $R.files[$path]
  if $rec != nil and ($rec.kept == true or ($rec.written != nil and not same($now, $rec.written))) then
    $R.files[$path].kept = true
    $status.kept = push($status.kept, $path)
    save_records()
    return false
  end
  if $now.kind == "link" and $now.target == $target then return false end
  remember_original($path)
  mkdir(dirname($path))
  if $now.kind == "file" and not is_file($path .. ".bak") and lstat($path .. ".bak") == nil then
    -- A foreign gtk.css is kept once beside it, as the reference does.
    put_file($path .. ".bak", $now.data)
  end
  $R.files[$path].written = {kind: "link", target: $target}
  commit_state($path, $now, $R.files[$path].written)
  return true
end

-- Keys we own in a shared file. A key whose value differs from what we last
-- wrote was changed by hand: it is kept, and reported.
fn put_keys($path, $section, $pairs)
  $now = current($path)
  if $now.kind == "link" then raise("SYMLINK", "refusing to write through a link: " .. $path) end
  $text = if $now.kind == "file" then $now.data else "" end
  $mine = $R.keys[$path] ?? {}
  $set = []
  for $p in $pairs
    $id = $section .. "/" .. $p[0]
    $have = $T.ini_get($text, $section, $p[0])
    $rec = $mine[$id]
    if $rec != nil and ($rec.kept == true or ($rec.written != nil and $have != $rec.written)) then
      $mine[$id].kept = true
      $status.kept = push($status.kept, $path .. " " .. $id)
      continue
    end
    if $rec == nil then $mine[$id] = {original: $have, written: nil} end
    $mine[$id].written = $p[1]
    push($set, $p)
  end
  $R.keys[$path] = $mine
  if $now.kind == "absent" then $R.created[$path] = true end
  $next = $T.ini_set($text, $section, $set)
  if $next == $text then return false end
  commit_state($path, $now, {kind: "file", data: $next})
  return true
end

fn have_in($sub, $name)
  $dirs = []
  $data_home = absolute_dir("XDG_DATA_HOME")
  if $data_home != nil then push($dirs, $data_home) elif $home != nil then push($dirs, $home .. "/.local/share") end
  for $d in split(env("XDG_DATA_DIRS", "/usr/local/share:/usr/share"), ":")
    if starts_with($d, "/") then push($dirs, $d) end
  end
  if $sub == "icons" and $home != nil then push($dirs, $home .. "/.icons") end
  return any($dirs, fn($d) = is_dir($d .. "/" .. $sub .. "/" .. $name))
end

fn call($command, $body)
  $wire = json_encode($body)
  send $source $command body=$wire timeout=5
  if $rc != 0 then raise("SETTINGS", $command .. " refused or unavailable (rc " .. to_string($rc) .. ")") end
  $v = if type($result) == "string" then json_parse($result) else $result end
  if type($v) != "map" or $v.status != "current" then raise("SETTINGS", $command .. " did not answer current") end
  if not deep_eq($v.binding, $binding) then raise("WRONG_TARGET", $command .. " answered another binding") end
  return $v
end

-- One record: the values and both modes' palette at one revision.
fn read_record()
  for $attempt = 1 to 3
    $values = call("settings.get", {binding: $binding, view: "values", keys: $T.KEYS})
    $palette = call("settings.palette", {binding: $binding})
    if $values.incarnation == $palette.incarnation and $values.revision == $palette.revision then
      return {values: $values, palette: $palette}
    end
  end
  raise("MOVED", "the record kept moving between the values and palette reads")
end

fn gsettings($list)
  if which("gsettings") == nil then return "absent" end
  $failed = 0
  for $g in $list
    $r = run_argv(["gsettings", "set", $g[0], $g[1], $g[2]], {timeout: 5, stderr: "null"})
    if not $r.ok then $failed = $failed + 1 end
  end
  return if $failed == 0 then "set" else to_string($failed) .. " failed" end
end

fn reconcile($why)
  $status.reconciles = $status.reconciles + 1
  if $skip != nil then return nil end
  try
    plain_parents($config .. "/probe")
    recover_pending()
    $rec = read_record()
    $v = $rec.values.values
    $status.incarnation = $rec.values.incarnation
    $status.revision = $rec.values.revision
    if $v["appearance.export_toolkits"] == false or $R.paused then
      $status.outcome = if $R.paused then "paused" else "gated" end
      return nil
    end
    $mode = $rec.values.resolved.mode
    $p = $T.plan($v, $mode, $rec.palette.palette, {config: $config,
      have_icon: fn($n) = have_in("icons", $n), have_theme: fn($n) = have_in("themes", $n)})
    $written = []
    $status.kept = []
    for $f in $p.files
      if put_file($f.path, $f.content) then push($written, $f.path) end
    end
    -- The colour files land before the links flip to them.
    for $l in $p.links
      if put_link($l.path, $l.target) then push($written, $l.path) end
    end
    for $i in $p.ini
      if put_keys($i.path, $i.section, $i.pairs) then push($written, $i.path .. " [" .. $i.section .. "]") end
    end
    $status.written = $written
    save_records()
    $status.gsettings = gsettings($p.gsettings)
    $status.icon_theme_missing = $p.icon_theme_missing
    $status.outcome = if len($status.written) > 0 then "written" else "unchanged" end
    $status.last_error = nil
    if len($status.written) > 0 then
      eprint("exportd-gtkqt: revision " .. to_string($status.revision) .. " (" .. $why .. "): wrote " .. to_string(len($status.written)))
    end
  catch $m, $err
    $status.outcome = "error"
    $status.last_error = {code: $err.code ?? "EXPORT", message: $m}
    eprint("exportd-gtkqt: " .. ($err.code ?? "EXPORT") .. ": " .. $m)
  end
end

-- Restores every file and key whose current content is still what we
-- wrote; anything changed since is left and listed.
fn undo()
  if $skip != nil then raise("REFUSED", $skip) end
  $R.paused = true
  save_records()
  recover_pending()
  $left = []
  $restored = []
  for $path, $f in $R.files
    if $f.written == nil then continue end
    $now = current($path)
    if same($now, $f.original) and $f.kept != true then
      $R.files = delete($R.files, $path)
      save_records()
      continue
    end
    if $f.kept == true or not same($now, $f.written) then
      $R.files[$path].kept = true
      push($left, $path)
      save_records()
      continue
    end
    $o = $f.original
    commit_state($path, $now, $o)
    $R.files = delete($R.files, $path)
    save_records()
    push($restored, $path)
  end
  for $path, $keys in $R.keys
    $now = current($path)
    if $now.kind != "file" then continue end
    $text = $now.data
    for $id, $k in $keys
      $i = index_of($id, "/")
      $section = slice($id, 0, $i)
      $key = slice($id, $i + 1)
      $have = $T.ini_get($text, $section, $key)
      if $k.kept != true and ($have == $k.written or $have == $k.original) then
        $text = $T.ini_set($text, $section, [[$key, $k.original]])
      else
        $R.keys[$path][$id].kept = true
        push($left, $path .. " " .. $id)
      end
    end
    $husk = $R.created[$path] == true and all(split($text, "\n"), fn($l) = trim($l) == "" or (starts_with(trim($l), "[") and ends_with(trim($l), "]")))
    if $text != $now.data or $husk then
      commit_state($path, $now, if $husk then {kind: "absent"} else {kind: "file", data: $text} end)
      push($restored, $path)
    end
    for $id, $k in $R.keys[$path]
      if $k.kept != true then $R.keys[$path] = delete($R.keys[$path], $id) end
    end
    if len(keys($R.keys[$path])) == 0 then $R.keys = delete($R.keys, $path); $R.created = delete($R.created, $path) end
    save_records()
  end
  save_records()
  $status.outcome = "paused"
  return {restored: $restored, left: $left}
end

on exportd.gtkqt.status desc "what exportd-gtkqt last wrote, kept and skipped"
  reply(0, json_encode(merge($status, {paused: $R.paused, state: $state_dir})))
end

on exportd.gtkqt.reconcile desc "resume after an undo and write the current record now"
  if $skip != nil then reply(10, json_encode({error_code: "REFUSED", message: $skip})); return nil end
  $R.paused = false
  save_records()
  reconcile("request")
  reply(0, json_encode($status))
end

on exportd.gtkqt.undo desc "restore every file and key still as exportd-gtkqt wrote it, then pause until exportd.gtkqt.reconcile"
  try
    reply(0, json_encode(undo()))
  catch $m, $err
    reply(10, json_encode({error_code: $err.code ?? "UNDO", message: $m}))
  end
end

$topics = map(["appearance", "window", "accessibility"], fn($p) = "settingsd.desktop.keys." .. $binding.profile .. "." .. $p)
for $t in $topics subscribe($t) end

-- Every keys topic is a hint: the record itself is always read whole, so a
-- burst of three topics from one revision writes once and then finds
-- nothing changed. A topic delivery is dispatched by its inner command,
-- which settingsd sets to the topic name, so the handlers name the
-- `default` profile every desk binds.
on "settingsd.desktop.keys.default.appearance"
  reconcile("appearance")
end
on "settingsd.desktop.keys.default.window"
  reconcile("window")
end
on "settingsd.desktop.keys.default.accessibility"
  reconcile("accessibility")
end

on bus.connected
  reconcile("connected")
end
