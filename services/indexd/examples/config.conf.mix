-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Copy to mixos:config/indexd/config.conf.mix and set the local snapshot path.
schema_version: 1
service: {
  vectors_db: "mixos:state/indexd/vectors.db",
  model_dir: "mixos:state/indexd/model",
  dtype: "f16",
  idle_timeout_secs: 300
}
domains: {map: {
  "/home/user/Projects/mixos": "mixos",
  "/home/user/.mix": "mix",
  "/home/user/.ns": "ns",
  "/home/user/.mc": "mc"
}}
