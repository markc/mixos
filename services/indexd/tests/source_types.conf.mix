# SPDX-License-Identifier: MIT OR Apache-2.0
# Source policy captured from the existing deployment, without private values.
schema_version: 1
source_types: {
  doc: {required: ["path", "domain"]},
  journal: {required: ["path", "domain", "date"], date_field: "date"},
  memory: {required: ["path", "domain", "date", "generator"], date_field: "date"},
  "mix-script": {required: ["file", "domain"]},
  notes: {required: ["path", "domain"]},
  observation: {required: ["observer", "tool", "observed_at", "domain"]},
  plan: {required: ["path", "domain"]},
  "rust-doc": {required: ["file", "kind", "domain"]},
  skill: {required: ["name", "trigger", "approach"]},
  spec: {required: ["path", "domain"]}
}
