# The MixOS input broker. Registers the "inputd" Bus service and answers
# input.* (query, bind, unbind, mode, reload, key and pointer injection).
#
# The shipped ExecStart is the SAFE form: the Bus service only, no
# keyboard. Grabbing a keyboard is a dead-keyboard risk, so an operator
# turns it on with a drop-in after a supervised run (see
# services/inputd/examples/inputd-grab.conf.example). While the daemon holds a grab
# it is a single point of failure: Restart=always with a short RestartSec
# is the main mitigation, and any death releases the grab with its fds.
#
# Root, because reading keyboard event nodes and writing /dev/uinput need
# it. Hardened, but PrivateDevices stays off and the input and uinput
# devices are allowed explicitly: they are the daemon's whole job.
#
# The broker is found the usual way (node.conf.mix, MIXOS_* overrides); the
# client retries until it appears, so no ordering on a broker unit.
[Unit]
Description=MixOS input broker

[Service]
Type=simple
ExecStart=@{prefix}/bin/inputd
Restart=always
RestartSec=500ms
# The keymap lives at $STATE_DIRECTORY/keymap.json
# (@{var}/inputd/keymap.json), never in a home directory.
StateDirectory=mixos/inputd
StateDirectoryMode=0700
Environment=RUST_LOG=inputd=info
SyslogIdentifier=inputd
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10000
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallArchitectures=native
# The daemon's job: do NOT set PrivateDevices=yes.
DeviceAllow=char-input rw
DeviceAllow=/dev/uinput rw
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
