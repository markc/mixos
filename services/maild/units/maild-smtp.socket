# SPDX-License-Identifier: MIT OR Apache-2.0
[Unit]
Description=MixOS inbound SMTP socket
Documentation=https://mixos.dev/maild/

[Socket]
# Replace ListenStream in a host drop-in to select its mesh address.
ListenStream=127.0.0.1:25
FreeBind=yes
FileDescriptorName=smtp
Service=maild.service

[Install]
WantedBy=sockets.target
