# SPDX-License-Identifier: MIT OR Apache-2.0
[Unit]
Description=MixOS implicit TLS submission socket
Documentation=https://mixos.dev/maild/

[Socket]
# Render every smtp_smtps address from this instance's config in a drop-in.
# No address is enabled by default. Example: ListenStream=192.0.2.10:465
FreeBind=yes
FileDescriptorName=submissions
Service=maild@%i.service

[Install]
WantedBy=sockets.target
