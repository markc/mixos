# SPDX-License-Identifier: MIT OR Apache-2.0
[Unit]
Description=MixOS mail service using broker instance %i
Documentation=https://mixos.dev/maild/
After=network-online.target noded@%i.service
Wants=network-online.target
Requires=noded@%i.service

[Service]
Type=simple
User=maild
Group=maild
EnvironmentFile=@{etc}/session/%i.env
Environment=MIXOS_ETC=@{etc}
Environment=MIXOS_VAR=%S/maild
Environment=HOME=%S/maild
Environment=RUST_LOG=maild=info
StateDirectory=maild
StateDirectoryMode=0750
RuntimeDirectory=maild
RuntimeDirectoryMode=0750
ConfigurationDirectory=mixos/maild
ConfigurationDirectoryMode=0750
WorkingDirectory=%S/maild
ExecStart=@{prefix}/bin/maild -c @{etc}/maild/config.conf.mix serve
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=maild
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10000
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
UMask=0027

[Install]
WantedBy=multi-user.target
