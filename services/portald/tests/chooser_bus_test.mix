-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Real portal, chooser and viewport driving on private D-Bus/noded/compd.
-- Needs CBC's headless weston host. Never touches a desktop, VT or service.
-- Build on CBC: cargo build -p portald -p dopus -p compd -p noded -p system --bins --examples
-- MIXOS_TEST_BIN=<bin> mix services/portald/tests/chooser_bus_test.mix
$n = require("../../../tests/desktop/nested_host_lib.mix")
$root = dirname(dirname(dirname(dirname(realpath($0)))))
$bin = env("MIXOS_TEST_BIN", $root .. "/target/debug")
$run = $n.new_run("/tmp/mixos-portal-chooser")
$tmp = $run.path
$broker = nil
$session = nil
$provider = nil
$portal = nil
$passed = false
try
  $broker = $n.private_bus({dir:$tmp .. "/broker", name:"portal-chooser-test", noded:$bin .. "/noded"})
  mkdir($tmp .. "/home", {parents:true})
  write_file($tmp .. "/home/notes.txt", "original")
  write_file($tmp .. "/settings.json", read_file($root .. "/tests/desktop/smoke-settings.json"))
  $session = $n.start({bin:$bin .. "/compd", tag:"portal-chooser", run:$run, config:$tmp .. "/settings.json", software:true, dbus:true})
  if not $n.wait_ready($session,40) then raise("PORTAL_TEST", "nested compd did not start: " .. $session.log) end
  $client = $n.client_env($session,{HOME:$tmp .. "/home", XDG_CONFIG_HOME:$tmp .. "/config", XDG_STATE_HOME:$tmp .. "/state",
    MIXOS_APP_HOME:$tmp .. "/dopus", MIXOS_COMP_SERVICE:$session.service, WINIT_UNIX_BACKEND:"wayland", WGPU_BACKEND:"gl", LIBGL_ALWAYS_SOFTWARE:"1",
    MESA_VK_WSI_PRESENT_MODE:"mailbox", MIXOS_NODED_URL:$broker.url})
  $provider = spawn([$bin .. "/dopus", "--choose-service", "--noded-url", $broker.url],
    {env:$client, stdout:{file:$tmp .. "/files.log"}, stderr:"stdout", detach:true})
  $ready = false
  for $i = 1 to 100
    $r = $n.call("files","files.choose.list",{})
    if $r.rc == 0 then $ready = true; break end
    sleep(0.1)
  end
  if not $ready then raise("PORTAL_TEST","files did not register: " .. $tmp .. "/files.log") end
  $portal = spawn([$bin .. "/portald", "serve", "--instance", "test"],
    {env:$client, stdout:{file:$tmp .. "/portal.log"}, stderr:"stdout", detach:true})
  -- rfd must use the portal. An empty PATH prevents its external fallback
  -- from opening anything when the portal path fails.
  mkdir($tmp .. "/empty-path", {parents:true})
  $probe_env = $client
  $probe_env.PATH = $tmp .. "/empty-path"
  $result = run_argv([$bin .. "/examples/filechooser_probe", $tmp .. "/home"],
    {env:$probe_env,timeout:300,stderr:"stdout"})
  print($result.stdout)
  if $result.exit_code != 0 or $result.timed_out then raise("PORTAL_TEST","probe failed; logs " .. $tmp) end
  $passed = true
  print("PASS portal FileChooser OpenFile, SaveFile replacement, SaveFiles, accept and cancel on real native chooser viewports")
finally
  for $child in [$portal,$provider]
    if $child != nil and process_alive($child) then kill($child,15) end
  end
  if $session != nil then $n.stop($session) end
  if $broker != nil and process_alive($broker.pid) then kill($broker.pid,15) end
  $n.finish_run($run,$passed)
end
