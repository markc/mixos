[Unit]
Description=MixOS application releases for session %i
# The session target chooses the broker (noded@%i or the system noded.service);
# this unit only orders after both. Never Wants= or Requires= a broker: on a desk
# with the system broker noded@%i is masked.
After=noded@%i.service noded.service network-online.target
PartOf=session@%i.target

[Service]
Type=simple
User=mixos
# The session's HOME and XDG directories: installs go to the session user's
# ~/.local, the catalogue is ~/.config/mixos/releases.mx.
EnvironmentFile=@{etc}/session/%i.env
ExecStart=@{prefix}/bin/mix --serve @{prefix}/lib/releasesd/releasesd.mix --name releases
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=2
