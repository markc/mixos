        "palette.foreground.default": { color_space: "oklch", l: 0.25, c: 0.06, h: 220.0 },
        "palette.foreground.muted": { color_space: "oklch", l: 0.50, c: 0.06, h: 220.0 },
        # Declared in the base so the modifier blocks may override it: a
        # modifier cannot introduce a path the base never authored. The base
        # value is the ocean light anchor; every other block re-authors it —
        # light per scheme, dark at the L 0.65 tier that clears WCAG AA on
        # the L 0.26 dark muted surface (the dark muted foreground's L 0.61
        # measures 4.10:1 there).
        "palette.foreground.quiet": { color_space: "oklch", l: 0.45, c: 0.06, h: 220.0 },
        "palette.accent.default": { color_space: "oklch", l: 0.50, c: 0.12, h: 220.0 },
        "palette.accent.hover": { color_space: "oklch", l: 0.45, c: 0.14, h: 220.0 },
        "status.success": { color_space: "oklch", l: 0.45, c: 0.15, h: 145.0 },
        "status.warning": { color_space: "oklch", l: 0.70, c: 0.15, h: 85.0 },
        "status.danger": { color_space: "oklch", l: 0.52, c: 0.20, h: 25.0 },
        "transparent": { color_space: "oklch", l: 0.0, c: 0.0, h: 0.0, alpha: 0.0 },
        # Shadow and scrim for chrome derived from a palette (families.chrome.derive).
        "chrome.shade.shadow": { color_space: "oklch", l: 0.0, c: 0.0, h: 0.0, alpha: 0.2 },
        "chrome.shade.scrim": { color_space: "oklch", l: 0.0, c: 0.0, h: 0.0, alpha: 0.4 },
        # Chrome (families.chrome): placeholders, declared here so the scheme
        # blocks may author them (pro, studio and classic do, every role). A
        # scheme that authors none derives its chrome from its palette
