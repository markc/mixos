  "v1": {
    kind: "base",
    resolution_order: ["scheme", "mode"],
    primitives: {
      colors: {
        "palette.background.1": { color_space: "oklch", l: 0.98, c: 0.008, h: 220.0 },
        "palette.background.2": { color_space: "oklch", l: 0.96, c: 0.012, h: 220.0 },
        "palette.background.3": { color_space: "oklch", l: 0.92, c: 0.018, h: 220.0 },
