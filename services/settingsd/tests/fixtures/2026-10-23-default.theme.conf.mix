        "chrome.chrome": { color_space: "oklch", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },
        "chrome.canvas": { color_space: "oklch", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },
