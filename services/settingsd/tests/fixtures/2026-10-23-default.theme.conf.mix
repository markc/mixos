      chrome: {
        coverage: "explicit",
        roles: {
          chrome: "chrome.chrome",
          canvas: "chrome.canvas",
          canvas_dot: "chrome.canvas_dot",
          dock: "chrome.dock",
          card: "chrome.card",
          card_border: "chrome.card_border",
          tab_strip: "chrome.tab_strip",
          field: "chrome.field",
          field_border: "chrome.field_border",
          hover: "chrome.hover",
          pressed: "chrome.pressed",
          row_selected: "chrome.row_selected",
          text: "chrome.text",
          text_dim: "chrome.text_dim",
          text_faint: "chrome.text_faint",
          icon: "chrome.icon",
          accent: "chrome.accent",
          accent_soft: "chrome.accent_soft",
          accent_border: "chrome.accent_border",
          accent_text: "chrome.accent_text",
          menu_highlight: "chrome.menu_highlight",
          menu_highlight_text: "chrome.menu_highlight_text",
          separator: "chrome.separator",
          shadow: "chrome.shadow",
          scrim: "chrome.scrim",
          primary_bg: "chrome.primary_bg",
          primary_text: "chrome.primary_text",
          danger: "chrome.danger",
          warning: "chrome.warning",
          caption_close: "chrome.caption_close",
          caption_close_text: "chrome.caption_close_text"
        },
        # A palette that authors no chrome colours (the hue schemes) derives
        # them from its semantic pairs, so any scheme can take a chrome
        # style. A role the selected scheme's blocks author wins.
        derive: {
          chrome: { kind: "pair", pair: "base", part: "surface" },
          canvas: { kind: "pair", pair: "muted", part: "surface" },
          canvas_dot: { kind: "non_text", value: "border" },
          dock: { kind: "pair", pair: "muted", part: "surface" },
          card: { kind: "pair", pair: "secondary", part: "surface" },
          card_border: { kind: "non_text", value: "border" },
          tab_strip: { kind: "pair", pair: "muted", part: "surface" },
          field: { kind: "pair", pair: "base", part: "surface" },
          field_border: { kind: "non_text", value: "border" },
          hover: { kind: "mix", pair: "secondary", from: "surface", toward: "foreground", amount: 0.08 },
          pressed: { kind: "mix", pair: "secondary", from: "surface", toward: "foreground", amount: 0.16 },
          row_selected: { kind: "pair", pair: "accent", part: "surface" },
          text: { kind: "pair", pair: "base", part: "foreground" },
          # Dimmed text keeps WCAG AA on every chrome surface it is drawn on.
          text_dim: { kind: "mix", pair: "base", from: "foreground", toward: "surface", amount: 0.08,
            min_contrast: 4.5, against: ["chrome", "card", "field", "tab_strip", "dock", "canvas", "hover"] },
          text_faint: { kind: "mix", pair: "base", from: "foreground", toward: "surface", amount: 0.18,
            min_contrast: 4.5, against: ["chrome", "card", "field", "tab_strip", "dock", "canvas", "hover"] },
          icon: { kind: "pair", pair: "base", part: "foreground" },
          accent: { kind: "pair", pair: "accent", part: "surface" },
          accent_soft: { kind: "pair", pair: "accent", part: "surface" },
          accent_border: { kind: "non_text", value: "ring" },
          accent_text: { kind: "pair", pair: "accent", part: "foreground" },
          menu_highlight: { kind: "pair", pair: "accent", part: "surface" },
          menu_highlight_text: { kind: "pair", pair: "accent", part: "foreground" },
          separator: { kind: "non_text", value: "border" },
          shadow: { kind: "primitive", value: "chrome.shade.shadow" },
          scrim: { kind: "primitive", value: "chrome.shade.scrim" },
          primary_bg: { kind: "pair", pair: "primary", part: "surface" },
          primary_text: { kind: "pair", pair: "primary", part: "foreground" },
          danger: { kind: "pair", pair: "destructive", part: "surface" },
          warning: { kind: "primitive", value: "status.warning" },
          caption_close: { kind: "pair", pair: "destructive", part: "surface" },
          caption_close_text: { kind: "pair", pair: "destructive", part: "foreground" }
        }
      },
      # Chrome forms and lengths (families.style): each scheme takes one
      # named style. The hue schemes share `plain`, their pair-derived look
      # as data; the chrome schemes take the specification's grammars.
      style: {
        schemes: {
          ocean: "plain", crimson: "plain", stone: "plain", forest: "plain", sunset: "plain", mono: "plain",
          pro: "pro", studio: "studio", classic: "classic", breeze: "breeze", adwaita: "adwaita"
        },
