    },
    modifiers: [
      {
        when: { scheme: "ocean", mode: "light" },
        semantics: {
          pairs: {
            # The muted pair's light text half rides the quiet anchor: at
            # full default weight, hierarchy text (disabled controls,
            # secondary labels) reads as enabled on the light quiet
            # surface. Dark keeps the default foreground — dark's ramp was
            # already flat, and re-tiering it is a later decision. The
            # quiet anchor itself needs no override here: the base carries
            # the ocean light value verbatim.
            muted: {
              surface: "palette.background.muted",
              foreground: "palette.foreground.quiet"
            }
          }
        }
      },
      {
        when: { scheme: "ocean", mode: "dark" },
