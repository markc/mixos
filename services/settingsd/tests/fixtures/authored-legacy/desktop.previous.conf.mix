d: \"palette.background.1\" }\n      },\n      non_text: {\n        border: { value: \"palette.background.3\", adjacent: [\"secondary\"] },\n        input: { value: \"transparent\", adjacent: [\"muted\"] },\n        ring: { value: \"palette.accent.default\", adjacent: [\"accent\", \"muted\", \"secondary\"] }\n      }\n    },\n    # Desktop type: Inter (UI) and JetBrains Mono (numbers, code) at compact\n    # desktop sizes. Weight is a token: each role names the weight it wants and\n    # the renderer selects the matching static face (300 Light, 400 Regular,\n    # 500 Medium, 600 SemiBold). The light profile is ui and small at 300 with\n    # ui_display at 500 (same sizes); switch by editing the weights only.\n    typography: {\n      records: {\n        ui: { family: \"Inter\", fallbacks: [\"Noto Sans\", \"DejaVu Sans\"], generic: \"sans_serif\", logical_px: 12.5, weight: 400 },\n        ui_display: { family: \"Inter\", fallbacks: [\"Noto Sans\", \"DejaVu Sans\"], generic: \"sans_serif\", logical_px: 15, weight: 600 },\n        small: { family: \"Inter\", fallbacks: [\"Noto Sans\", \"DejaVu Sans\"], generic: \"sans_serif\", logical_px: 10.5, weight: 400 },\n        mono: { family: \"JetBrains Mono\", fallbacks: [\"DejaVu Sans Mono\", \"Noto Sans Mono\"], generic: \"monospace\", logical_px: 12, weight: 400 },\n        terminal: { family: \"SF Mono\", fallbacks: [\"DejaVu Sans Mono\", \"Noto Sans Mono\"], generic: \"monospace\", logical_px: 21.333333333333332, weight: 300 },\n        \"button.md\": { family: \"Noto Sans\", type_step: \"type.body\", weight: 400 },\n        \"button.sm\": { family: \"Noto Sans\", type_step: \"type.compact\", weight: 400 }\n      }\n    },\n    families: {\n      chrome: {\n        coverage: \"explicit\",\n        roles: {\n          chrome: \"chrome.chrome\",\n          canvas: \"chrome.canvas\",\n          canvas_dot: \"chrome.canvas_dot\",\n          dock: \"chrome.dock\",\n          card: \"chrome.card\",\n          card_border: \"c