name: \"contrast_safe_lift\",\n                args: [\n                  { kind: \"pair\", value: \"primary\" },\n                  { kind: \"ratio\", value: \"lift.hover\" }\n                ]\n              }\n            }\n          },\n          {\n            when: { variant: \"default\", interaction: \"hovered\" },\n            set: {\n              pair: {\n                kind: \"derive\",\n                name: \"contrast_safe_lift\",\n                args: [\n                  { kind: \"pair\", value: \"secondary\" },\n                  { kind: \"ratio\", value: \"lift.hover\" }\n                ]\n              }\n            }\n          },\n          {\n            when: { variant: \"destructive\", interaction: \"hovered\" },\n            set: {\n              pair: {\n                kind: \"derive\",\n                name: \"contrast_safe_lift\",\n                args: [\n                  { kind: \"pair\", value: \"destructive\" },\n                  { kind: \"ratio\", value: \"lift.hover\" }\n                ]\n              }\n            }\n          },\n          {\n            when: { variant: \"ghost\", interaction: \"hovered\" },\n            set: {\n              pair: {\n                kind: \"derive\",\n                name: \"contrast_safe_toward\",\n                args: [\n                  { kind: \"pair\", value: \"accent\" },\n                  { kind: \"ratio\", value: \"lift.ghost.hover\" }\n                ]\n              }\n            }\n          },\n          {\n            when: { variant: \"default\", interaction: \"pressed\" },\n            set: {\n              pair: {\n                kind: \"derive\",\n                name: \"contrast_safe_toward\",\n                args: [\n                  { kind: \"pair\", value: \"secondary\" },\n                  { kind: \"ratio\", value: \"lift.press\" }\n                ]\n              }\n            }\n          },\n          {\n            when: { variant: \"primary\", inte