icit\",\n        roles: {\n          chrome: \"chrome.chrome\",\n          canvas: \"chrome.canvas\",\n          canvas_dot: \"chrome.canvas_dot\",\n          dock: \"chrome.dock\",\n          card: \"chrome.card\",\n          card_border: \"chrome.card_border\",\n          tab_strip: \"chrome.tab_strip\",\n          field: \"chrome.field\",\n          field_border: \"chrome.field_border\",\n          hover: \"chrome.hover\",\n          pressed: \"chrome.pressed\",\n          row_selected: \"chrome.row_selected\",\n          text: \"chrome.text\",\n          text_dim: \"chrome.text_dim\",\n          text_faint: \"chrome.text_faint\",\n          icon: \"chrome.icon\",\n          accent: \"chrome.accent\",\n          accent_soft: \"chrome.accent_soft\",\n          accent_border: \"chrome.accent_border\",\n          accent_text: \"chrome.accent_text\",\n          menu_highlight: \"chrome.menu_highlight\",\n          menu_highlight_text: \"chrome.menu_highlight_text\",\n          separator: \"chrome.separator\",\n          shadow: \"chrome.shadow\",\n          scrim: \"chrome.scrim\",\n          primary_bg: \"chrome.primary_bg\",\n          primary_text: \"chrome.primary_text\",\n          danger: \"chrome.danger\",\n          warning: \"chrome.warning\",\n          caption_close: \"chrome.caption_close\",\n          caption_close_text: \"chrome.caption_close_text\"\n        },\n        # A palette that authors no chrome colours (the hue schemes) derives\n        # them from its semantic pairs, so any scheme can take a chrome\n        # style. A role the selected scheme's blocks author wins.\n        derive: {\n          chrome: { kind: \"pair\", pair: \"base\", part: \"surface\" },\n          canvas: { kind: \"pair\", pair: \"muted\", part: \"surface\" },\n          canvas_dot: { kind: \"non_text\", value: \"border\" },\n          dock: { kind: \"pair\", pair: \"muted\", part: \"surface\" },\n          card: { kind: \"pair\", pair: \"secondary\", part: \"surface\" },\n          card_border: { kind: \"non_text\", value: \"border\" },\n          tab_strip: { kind: \"pair\", pair: \"muted\", part: \"surface\" },\n          field: { kind: \"pair\", pair: \"base\", part: \"surface\" },\n          field_border: { kind: \"non_text\", value: \"border\" },\n          hover: { kind: \"mix\", pair: \"secondary\", from: \"surface\", toward: \"foreground\", amount: 0.08 },\n          pressed: { kind: \"mix\", pair: \"secondary\", from: \"surface\", toward: \"foreground\", amount: 0.16 },\n          row_selected: { kind: \"pair\", pair: \"accent\", part: \"surface\" },\n          text: { kind: \"pair\", pair: \"base\", part: \"foreground\" },\n          # Dimmed text keeps WCAG AA on every chrome surface it is drawn on.\n          text_dim: { kind: \"mix\", pair: \"base\", from: \"foreground\", toward: \"surface\", amount: 0.08,\n            min_contrast: 4.5, against: [\"chrome\", \"card\", \"field\", \"tab_strip\", \"dock\", \"canvas\", \"hover\"] },\n          text_faint: { kind: \"mix\", pair: \"base\", from: \"foreground\", toward: \"surface\", amount: 0.18,\n            min_contrast: 4.5, against: [\"chrome\", \"card\", \"field\", \"tab_strip\", \"dock\", \"canvas\", \"hover\"] },\n          icon: { kind: \"pair\", pair: \"base\", part: \"foreground\" },\n          accent: { kind: \"pair\", pair: \"accent\", part: \"surface\" },\n          accent_soft: { kind: \"pair\", pair: \"accent\", part: \"surface\" },\n          accent_border: { kind: \"non_text\", value: \"ring\" },\n          accent_text: { kind: \"pair\", pair: \"accent\", part: \"foreground\" },\n          menu_highlight: { kind: \"pair\", pair: \"accent\", part: \"surface\" },\n          menu_highlight_text: { kind: \"pair\", pair: \"accent\", part: \"foreground\" },\n          separator: { kind: \"non_text\", value: \"border\" },\n          shadow: { kind: \"primitive\", value: \"chrome.shade.shadow\" },\n          scrim: { kind: \"primitive\", value: \"chrome.shade.scrim\" },\n          primary_bg: { kind: \"pair\", pair: \"primary\", part: \"surface\" },\n          primary_text: { kind: \"pair\", pair: \"primary\", part: \"foreground\" },\n          danger: { kind: \"pair\", pair: \"destructive\", part: \"surface\" },\n          warning: { kind: \"primitive\", value: \"status.warning\" },\n          caption_close: { kind: \"pair\", pair: \"destructive\", part: \"surface\" },\n          caption_close_text: { kind: \"pair\", pair: \"destructive\", part: \"foreground\" }\n        }\n      },\n      # Chrome forms and lengths (families.style): each scheme takes one\n      # named style. The hue schemes share `plain`, their pair-derived look\n      # as data; the chrome schemes take the specification's grammars.\n      style: {\n        schemes: {\n          ocean: \"plain\", crimson: \"plain\", stone: \"plain\", forest: \"plain\", sunset: \"plain\", mono: \"plain\",\n          pro: \"pro\", studio: \"studio\", classic: \"classic\", breeze: \"breeze\", adwaita: \"adwaita\"\n        },\n        styles: {\n          plain: {\n            bar_padding_y: 0,\n            dark_luminance: 0.18, square_radius: 0,\n            \"animation_time\": 0.2,\n            \"bar_row_gap\": 4,\n            \"bars_bar_inset\": 8,\n            \"bars_rail_rule\": 6,\n            \"button_icon_share\": 0.52,\n            \"button_link_icon\": 14,\n            \"button_link_size\": 12,\n            \"button_padding_x\": 10,\n            \"button_padding_y\": 4,\n            \"button_pro_outline\": 1.5,\n            \"button_push_padding\": 28,\n            \"canvas_bar\": 12,\n            \"canvas_dot_pitch\": 16,\n            \"canvas_dot_size\": 1,\n            \"canvas_thumb_inset\": 3,\n            \"canvas_thumb_min\": 24,\n            \"caption_gap\": 4,\n            \"caption_glyph\": 10,\n            \"caption_width\": 46,\n            \"checkbox_box\": 14,\n            \"close_pressed_alpha\": 0.8,\n            \"combo_chevron_alpha\": 0.8,\n          