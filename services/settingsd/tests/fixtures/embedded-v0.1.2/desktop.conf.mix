{"schema": 1, "format": 3, "binding": {"instance": "example", "profile": "default"}, "incarnation": "01a16c6b-3069-7cd1-8ca4-a3b136c0c407", "revision": "33", "design_revision": "33", "desktop": {"appearance": {"scheme": "breeze", "style": "breeze", "mode": "dark", "contrast": "high", "decorations": "ssd", "source": nil}, "ui": {"density": 1, "text_scale": 1, "reduced_motion": false}, "shell": {"panels": {"bottom": {"edge": "bottom", "mode": "dock", "thickness": 40}}, "page_order": []}, "apps": {}}, "embedded_source": "scheme: \"ocean\"\nmode: \"light\"\ntypography: { family: \"Noto Sans\", body_px: 13.333 }\nsurface: \"#f3fafc\"\npanel: \"#e9f4f7\"\nmaster_panel: \"#d8e8ed\"\ntrack: \"#e9f4f7\"\ncontrol: \"#d8f4fd\"\ncontrol_active: \"#006f87\"\nthumb: \"#005f75\"\nmeter_green: \"#006818\"\nmeter_amber: \"#c79600\"\nmeter_red: \"#c21725\"\ntext: \"#002631\"\ntext_dim: \"#386b7b\"\nborder: \"#d8e8ed\"\nrow_hover: \"#e9f4f7\"\nrow_selected: \"#1d5869\"\nrow_selected_text: \"#e9f4f7\"\nrow_selected_text_dim: \"#e9f4f7\"\nscrim: \"#00000000\"\ndanger_surface: \"#c21725\"\ncontrol_gap: 8.0\ncorner_radius: 5.0\nfader_width: 42.0\nfader_height: 250.0\nknob_size: 58.0\nmeter_width: 28.0\n\ndesign: {\n  schema_version: 1,\n  \"v1\": {\n    kind: \"base\",\n    resolution_order: [\"scheme\", \"mode\"],\n    primitives: {\n      colors: {\n        \"palette.background.1\": { color_space: \"oklch\", l: 0.98, c: 0.008, h: 220.0 },\n        \"palette.background.2\": { color_space: \"oklch\", l: 0.96, c: 0.012, h: 220.0 },\n        \"palette.background.3\": { color_space: \"oklch\", l: 0.92, c: 0.018, h: 220.0 },\n        \"palette.background.muted\": { color_space: \"oklch\", l: 0.89, c: 0.012, h: 220.0 },\n        \"palette.background.elevated\": { color_space: \"oklch\", l: 0.85, c: 0.018, h: 220.0 },\n        \"palette.foreground.default\": { color_space: \"oklch\", l: 0.25, c: 0.06, h: 220.0 },\n        \"palette.foreground.muted\": { color_space: \"oklch\", l: 0.50, c: 0.06, h: 220.0 },\n        # Declared in the base so the modifier blocks may override it: a\n        # modifier cannot introduce a path the base never authored. The base\n        # value is the ocean light anchor; every other block re-authors it —\n        # light per scheme, dark at the L 0.65 tier that clears WCAG AA on\n        # the L 0.26 dark muted surface (the dark muted foreground's L 0.61\n        # measures 4.10:1 there).\n        \"palette.foreground.quiet\": { color_space: \"oklch\", l: 0.45, c: 0.06, h: 220.0 },\n        \"palette.accent.default\": { color_space: \"oklch\", l: 0.50, c: 0.12, h: 220.0 },\n        \"palette.accent.hover\": { color_space: \"oklch\", l: 0.45, c: 0.14, h: 220.0 },\n        \"status.success\": { color_space: \"oklch\", l: 0.45, c: 0.15, h: 145.0 },\n        \"status.warning\": { color_space: \"oklch\", l: 0.70, c: 0.15, h: 85.0 },\n        \"status.danger\": { color_space: \"oklch\", l: 0.52, c: 0.20, h: 25.0 },\n        \"transparent\": { color_space: \"oklch\", l: 0.0, c: 0.0, h: 0.0, alpha: 0.0 },\n        # Shadow and scrim for chrome derived from a palette (families.chrome.derive).\n        \"chrome.shade.shadow\": { color_space: \"oklch\", l: 0.0, c: 0.0, h: 0.0, alpha: 0.2 },\n        \"chrome.shade.scrim\": { color_space: \"oklch\", l: 0.0, c: 0.0, h: 0.0, alpha: 0.4 },\n        # Chrome (families.chrome): placeholders, declared here so the scheme\n        # blocks may author them (pro, studio and classic do, every role). A\n        # scheme that authors none derives its chrome from its palette\n        # (families.chrome.derive).\n        \"chrome.chrome\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.canvas\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.canvas_dot\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.dock\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.card\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.card_border\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.tab_strip\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.field\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.field_border\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.hover\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.pressed\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.row_selected\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.text\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.text_dim\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.text_faint\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.icon\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.accent\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.accent_soft\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.accent_border\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.accent_text\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.menu_highlight\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.menu_highlight_text\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.separator\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.shadow\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.scrim\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.primary_bg\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.primary_text\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.danger\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.warning\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.caption_close\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 },\n        \"chrome.caption_close_text\": { color_space: \"oklch\", l: 0.5, c: 0.0, h: 0.0, alpha: 0.0 }\n      },\n      metrics: {\n        \"button.height.sm\": { kind: \"px\", value: 24.0 },\n        \"button.height.md\": { kind: \"px\", value: 28.0 },\n        \"button.height.lg\": { kind: \"px\", value: 32.0 },\n        \"button.min_width.none\": { kind: \"px\", value: 0.0 },\n        \"button.min_width.standard\": { kind: \"px\", value: 72.0 },\n        \"button.padding_x\": { kind: \"step\", scale: \"spacing\", value: 5 },\n        \"button.border_width\": { kind: \"px\", value: 1.0 },\n        \"radius\": { kind: \"px\", value: 6.0 },\n        \"radius.md\": { kind: \"step\", scale: \"radius\", value: 1 },\n        \"type.body\": { kind: \"step\", scale: \"type\", value: 1 },\n        \"type.compact\": { kind: \"step\", scale: \"type\", value: 0 },\n        \"lift.hover\": { kind: \"ratio\", value: 0.06 },\n        \"lift.ghost.hover\": { kind: \"ratio\", value: 0.03 },\n        \"lift.press\": { kind: \"ratio\", value: 0.06 },\n        \"lift.ghost.press\": { kind: \"ratio\", value: 0.09 },\n        \"lift.disabled\": { kind: \"ratio\", value: 0.09 },\n        \"lift.ghost.disabled\": { kind: \"ratio\", value: 0.13 },\n        \"disabled.chroma_reduction\": { kind: \"ratio\", value: 0.50 },\n        \"icon.stroke_width\": { kind: \"px\", value: 1.5 },\n        \"legacy.control_gap\": { kind: \"px\", value: 8.0 },\n        \"legacy.corner_radius\": { kind: \"px\", value: 5.0 },\n        \"legacy.fader_width\": { kind: \"px\", value: 42.0 },\n        \"legacy.fader_height\": { kind: \"px\", value: 250.0 },\n        \"legacy.knob_size\": { kind: \"px\", value: 58.0 },\n        \"legacy.meter_width\": { kind: \"px\", value: 28.0 }\n      },\n      scales: {\n        spacing: [\n          { kind: \"px\", value: 0.0 },\n          { kind: \"px\", value: 2.0 },\n          { kind: \"px\", value: 4.0 },\n          { kind: \"px\", value: 6.0 },\n          { kind: \"px\", value: 8.0 },\n          { kind: \"px\", value: 10.0 },\n          { kind: \"px\", value: 12.0 },\n          { kind: \"px\", value: 16.0 },\n          { kind: \"px\", value: 20.0 },\n          { kind: \"px\", value: 24.0 }\n        ],\n        type: [\n          { kind: \"px\", value: 11.333 },\n          { kind: \"px\", value: 13.333 }\n        ]\n      }\n    },\n    modifiers: [\n      {\n        when: { scheme: \"ocean\", mode: \"light\" },\n        semantics: {\n          pairs: {\n            # The muted pair's light text half rides the quiet anchor: at\n            # full default weight, hierarchy text (disabled controls,\n            # secondary labels) reads as enabled on the light quiet\n            # surface. Dark keeps the default foreground — dark's ramp was\n            # already flat, and re-tiering it is a later decision. The\n            # quiet anchor itself needs no override here: the base carries\n            # the ocean light value verbatim.\n            muted: {\n              surface: \"palette.background.muted\",\n              foreground: \"palette.foreground.quiet\"\n            }\n          }\n        }\n      },\n      {\n        when: { scheme: \"ocean\", mode: \"dark\" },\n        primitives: {\n          colors: {\n            \"palette.background.1\": { color_space: \"oklch\", l: 0.12, c: 0.015, h: 220.0 },\n            \"palette.background.2\": { color_space: \"oklch\", l: 0.16, c: 0.02, h: 220.0 },\n            \"palette.background.3\": { color_space: \"oklch\", l: 0.22, c: 0.025, h: 220.0 },\n            \"palette.background.muted\": { color_space: \"oklch\", l: 0.26, c: 0.02, h: 220.0 },\n            \"palette.background.elevated\": { color_space: \"oklch\", l: 0.34, c: 0.025, h: 220.0 },\n            \"palette.foreground.default\": { color_space: \"oklch\", l: 0.95, c: 0.02, h: 220.0 },\n            \"palette.foreground.muted\": { color_space: \"oklch\", l: 0.61, c: 0.04, h: 220.0 },\n            \"palette.foreground.quiet\": { color_space: \"oklch\", l: 0.65, c: 0.04, h: 220.0 },\n            \"palette.accent.default\": { color_space: \"oklch\", l: 0.75, c: 0.12, h: 220.0 },\n            \"palette.accent.hover\": { color_space: \"oklch\", l: 0.85, c: 0.10, h: 220.0 }\n          }\n        }\n      },\n      {\n        when: { scheme: \"crimson\", mode: \"light\" },\n        primitives: {\n          colors: {\n            \"palette.background.1\": { color_space: \"oklch\", l: 0.98, c: 0.008, h: 25.0 },\n            \"palette.background.2\": { color_space: \"oklch\", l: 0.96, c: 0.012, h: 25.0 },\n            \"palette.background.3\": { color_space: \"oklch\", l: 0.92, c: 0.018, h: 25.0 },\n            \"palette.background.muted\": { color_space: \"oklch\", l: 0.89, c: 0.012, h: 25.0 },\n            \"palette.background.elevated\": { color_space: \"oklch\", l: 0.85, c: 0.018, h: 25.0 },\n            \"palette.foreground.default\": { color_space: \"oklch\", l: 0.25, c: 0.04, h: 25.0 },\n            \"palette.foreground.quiet\": { color_space: \"oklch\", l: 0.45, c: 0.04, h: 25.0 },\n            \"palette.foreground.muted\": { color_space: \"oklch\", l: 0.50, c: 0.04, h: 25.0 },\n            \"palette.accent.default\": { color_space: \"oklch\", l: 0.47, c: 0.20, h: 25.0 },\n            \"palette.accent.hover\": { color_space: \"oklch\", l: 0.42, c: 0.22, h: 25.0 }\n          }\n        },\n        semantics: {\n          pairs: {\n            muted: {\n              surface: \"palette.background.muted\",\n              foreground: \"palette.foreground.quiet\"\n            }\n          }\n        }\n      },\n      {\n        when: { scheme: \"crimson\", mode: \"dark\" },\n        primitives: {\n          colors: {\n            \"palette.background.1\": { color_space: \"oklch\", l: 0.10, c: 0.015, h: 25.0 },\n            \"palette.background.2\": { color_space: \"oklch\", l: 0.14, c: 0.02, h: 25.0 },\n            \"palette.background.3\": { color_space: \"oklch\", l: 0.20, c: 0.025, h: 25.0 },\n            \"palette.background.muted\": { color_space: \"oklch\", l: 0.26, c: 0.02, h: 25.0 },\n            \"palette.background.elevated\": { color_space: \"oklch\", l: 0.34, c: 0.025, h: 25.0 },\n            \"palette.foreground.default\": { color_space: \"oklch\", l: 0.95, c: 0.02, h: 25.0 },\n            \"palette.foreground.muted\": { color_space: \"oklch\", l: 0.61, c: 0.03, h: 25.0 },\n            \"palette.foreground.quiet\": { color_space: \"oklch\", l: 0.65, c: 0.03, h: 25.0 },\n            \"palette.accent.default\": { color_space: \"oklch\", l: 0.63, c: 0.23, h: 25.0 },\n            \"palette.accent.hover\": { color_space: \"oklch\", l: 0.70, c: 0.25, h: 25.0 }\n          }\n        }\n      },\n      {\n        when: { scheme: \"stone\", mode: \"light\" },\n        primitives: {\n          colors: {\n            \"palette.background.1\": { color_space: \"oklch\", l: 0.98, c: 0.005, h: 60.0 },\n            \"palette.background.2\": { color_space: \"oklch\", l: 0.96, c: 0.008, h: 60.0 },\n            \"palette.background.3\": { color_space: \"oklch\", l: 0.92, c: 0.012, h: 60.0 },\n            \"palette.background.muted\": { color_space: \"oklch\", l: 0.89, c: 0.008, h: 60.0 },\n            \"palette.background.elevated\": { color_space: \"oklch\", l: 0.85, c: 0.012, h: 60.0 },\n            \"palette.foreground.default\": { color_space: \"oklch\", l: 0.25, c: 0.02, h: 60.0 },\n            \"palette.foreground.quiet\": { color_space: \"oklch\", l: 0.45, c: 0.015, h: 60.0 },\n            \"palette.foreground.muted\": { color_space: \"oklch\", l: 0.50, c: 0.015, h: 60.0 },\n            \"palette.accent.default\": { color_space: \"oklch\", l: 0.45, c: 0.05, h: 60.0 },\n            \"palette.accent.hover\": { color_space: \"oklch\", l: 0.35, c: 0.06, h: 60.0 }\n          }\n        },\n        semantics: {\n          pairs: {\n            muted: {\n              surface: \"palette.background.muted\",\n              foreground: \"palette.foreground.quiet\"\n            }\n          }\n        }\n      },\n      {\n        when: { scheme: \"stone\", mode: \"dark\" },\n        primitives: {\n          colors: {\n            \"palette.background.1\": { color_space: \"oklch\", l: 0.12, c: 0.01, h: 60.0 },\n            \"palette.background.2\": { color_space: \"oklch\", l: 0.16, c: 0.012, h: 60.0 },\n            \"palette.background.3\": { color_space: \"oklch\", l: 0.22, c: 0.015, h: 60.0 },\n            \"palette.background.muted\": { color_space: \"oklch\", l: 0.26, c: 0.012, h: 60.0 },\n            \"palette.background.elevated\": { color_space: \"oklch\", l: 0.34, c: 0.015, h: 60.0 },\n            \"palette.foreground.default\": { color_space: \"oklch\", l: 0.95, c: 0.01, h: 60.0 },\n            \"palette.foreground.muted\": { color_space: \"oklch\", l: 0.61, c: 0.015, h: 60.0 },\n            \"palette.foreground.quiet\": { color_space: \"oklch\", l: 0.65, c: 0.015, h: 60.0 },\n            \"palette.accent.default\": { color_space: \"oklch\", l: 0.80, c: 0.03, h: 60.0 },\n            \"palette.accent.hover\": { color_space: \"oklch\", l: 0.90, c: 0.02, h: 60.0 }\n          }\n        }\n      },\n      {\n        when: { scheme: \"forest\", mode: \"light\" },\n        primitives: {\n          colors: {\n            \"palette.background.1\": { color_space: \"oklch\", l: 0.98, c: 0.008, h: 150.0 },\n            \"palette.background.2\": { color_space: \"oklch\", l: 0.96, c: 0.012, h: 150.0 },\n            \"palette.background.3\": { color_space: \"oklch\", l: 0.92, c: 0.018, h: 150.0 },