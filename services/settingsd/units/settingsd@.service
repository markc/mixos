[Unit]
Description=MixOS settings authority for session %i
# Wants, not Requires: the client reconnects to the broker by itself, and a
# Requires= restart job fails by dependency while noded is in start-limit-hit,
# which leaves the unit queued for a restart that never comes.
Wants=noded@%i.service
After=noded@%i.service
# Each start waits at most a few seconds for the broker, so retrying every
# second until it is up cannot spin; never let the start limit park the unit.
StartLimitIntervalSec=0
PartOf=session@%i.target

[Service]
Type=simple
User=mixos
EnvironmentFile=/etc/mixos/session/%i.env
UnsetEnvironment=DBUS_SESSION_BUS_ADDRESS DBUS_STARTER_ADDRESS DBUS_STARTER_BUS_TYPE DBUS_SYSTEM_BUS_ADDRESS
ExecStartPre=/opt/mixos/bin/settingsd seed --instance %H
ExecStart=/opt/mixos/bin/settingsd serve --instance %H
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=1
