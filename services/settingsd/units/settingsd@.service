[Unit]
Description=MixOS settings authority for session %i
# The session target chooses the broker (noded@%i or the system noded.service);
# this unit only orders after both. Never Wants= or Requires= a broker: on a desk
# with the system broker noded@%i is masked.
# The client reconnects to the broker by itself.
After=noded@%i.service noded.service
# Each start waits at most a few seconds for the broker, so retrying every
# second until it is up cannot spin; never let the start limit park the unit.
StartLimitIntervalSec=0
PartOf=session@%i.target

[Service]
Type=simple
User=mixos
EnvironmentFile=@{etc}/session/%i.env
UnsetEnvironment=DBUS_SESSION_BUS_ADDRESS DBUS_STARTER_ADDRESS DBUS_STARTER_BUS_TYPE DBUS_SYSTEM_BUS_ADDRESS
ExecStartPre=@{prefix}/bin/settingsd seed --instance %H
ExecStart=@{prefix}/bin/settingsd serve --instance %H
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=1
