-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.1.0
-- Pure rendering for toolkit-export: what GTK and Qt files hold for one
-- settings record. settingsd computes every colour (settings.palette's
-- `toolkit` block); this module only formats it and picks names.
$GTK_HEADER = "/* GENERATED BY MIXOS toolkit-export: rewritten on every settings change */"
$QT_HEADER = "# GENERATED BY MIXOS toolkit-export: rewritten on every settings change"
-- The stamp in qt5ct.conf/qt6ct.conf marks the file as one we have written.
$QT_STAMP = "mixos_qt_version"
$QT_VERSION = "1"
-- The design's defaults when a font key is null (key space v2 §2.2).
$FONT_FAMILY = "Inter"
$MONO_FAMILY = "JetBrains Mono"
$FONT_PX = 13.333
-- The settings keys a reconcile reads.
$KEYS = ["appearance.mode", "appearance.contrast", "appearance.font_family", "appearance.font_size",
  "appearance.mono_family", "appearance.icon_theme", "appearance.export_toolkits",
  "window.caption_side", "window.controls.minimize", "window.controls.maximize",
  "accessibility.text_scale"]

fn channels($hex)
  if type($hex) != "string" or not re_match($hex, "^#[0-9A-Fa-f]{8}$") then
    raise("COLOUR", "expected #RRGGBBAA, got " .. to_string($hex))
  end
  $b = bytes_from_hex(slice($hex, 1, 9))
  return [$b[0], $b[1], $b[2], $b[3]]
end

-- `rgba(R, G, B, A.AA)`: 0-255 channels and a two-decimal alpha.
fn css_colour($hex)
  $c = channels($hex)
  return sprintf("rgba(%d, %d, %d, %.2f)", $c[0], $c[1], $c[2], $c[3] / 255)
end

-- Qt's `#AARRGGBB`, alpha first.
fn qt_colour($hex)
  channels($hex)
  $h = upper($hex)
  return "#" .. slice($h, 7, 9) .. slice($h, 1, 7)
end

fn gtk_css($gtk)
  if type($gtk) != "map" or len($gtk) == 0 then raise("PALETTE", "palette has no toolkit.gtk colours") end
  $lines = [$GTK_HEADER]
  for $name in sort(keys($gtk))
    if not re_match($name, "^[a-z0-9_]+$") then raise("PALETTE", "bad GTK colour name") end
    push($lines, "@define-color " .. $name .. " " .. css_colour($gtk[$name]) .. ";")
  end
  return join($lines, "\n") .. "\n"
end

fn qt_group($group)
  if type($group) != "list" or len($group) != 21 then raise("PALETTE", "a Qt palette group has 21 colours") end
  return join(map($group, fn($c) = qt_colour($c)), ", ")
end

fn qt_scheme($qt)
  if type($qt) != "map" then raise("PALETTE", "palette has no toolkit.qt groups") end
  return join([$QT_HEADER, "", "[ColorScheme]",
    "active_colors=" .. qt_group($qt.active),
    "disabled_colors=" .. qt_group($qt.disabled),
    "inactive_colors=" .. qt_group($qt.inactive)], "\n") .. "\n"
end

-- Points from MixOS px (96 dpi): 13.333 px is 10 pt. Half points at most.
fn points($px)
  return sprintf("%g", round($px * 0.75 * 2) / 2)
end

fn font_size($v)
  $px = $v["appearance.font_size"]
  return if type($px) == "number" then $px else $FONT_PX end
end

fn family($v, $key, $fallback)
  $f = $v[$key]
  return if type($f) == "string" and trim($f) != "" then trim($f) else $fallback end
end

-- GTK's title-bar button order from the caption side and the two toggles.
fn decoration_layout($v)
  $buttons = []
  if $v["window.controls.minimize"] != false then push($buttons, "minimize") end
  if $v["window.controls.maximize"] != false then push($buttons, "maximize") end
  if $v["window.caption_side"] == "left" then
    return join(concat(["close"], $buttons), ",") .. ":menu"
  end
  return "menu:" .. join(concat($buttons, ["close"]), ",")
end

-- The icon theme to name: `<name>-dark` under dark when installed, else
-- `<name>`; a desk without it keeps MixOS's own `mixos` theme (Craft title
-- bars draw their buttons from it) and reports `icon_theme_missing`.
fn icon_theme($v, $mode, $have)
  $name = $v["appearance.icon_theme"]
  if type($name) != "string" or not re_match($name, "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$") then $name = "breeze" end
  if $mode == "dark" and $have($name .. "-dark") then return {name: $name .. "-dark", missing: false} end
  if $have($name) then return {name: $name, missing: false} end
  return {name: (if $have("mixos") then "mixos" else nil end), missing: true}
end

-- The whole wanted state of one record: files we own outright, the mode
-- links, and the keys we own in shared ini-style files. `$env` gives
-- {config, have_icon(name), have_theme(name)}.
fn plan($v, $mode, $palette, $env)
  if not contains(["dark", "light"], $mode) then raise("MODE", "resolved mode must be dark or light") end
  $cfg = $env.config
  $files = []
  $links = []
  $ini = []
  for $m in ["dark", "light"]
    $t = ($palette[$m] ?? {}).toolkit
    if type($t) != "map" then raise("PALETTE", "settings.palette has no toolkit block for " .. $m .. " (settingsd too old)") end
    push($files, {path: $cfg .. "/gtk-4.0/mixos/" .. $m .. ".css", content: gtk_css($t.gtk)})
    $scheme = qt_scheme($t.qt)
    $title = if $m == "dark" then "MixOSDark" else "MixOSLight" end
    for $q in ["qt5ct", "qt6ct"]
      push($files, {path: $cfg .. "/" .. $q .. "/colors/" .. $title .. ".conf", content: $scheme})
    end
  end
  push($links, {path: $cfg .. "/gtk-4.0/gtk.css", target: "mixos/" .. $mode .. ".css"})
  push($links, {path: $cfg .. "/gtk-3.0/gtk.css", target: "../gtk-4.0/mixos/" .. $mode .. ".css"})

  $icons = icon_theme($v, $mode, $env.have_icon)
  $font = family($v, "appearance.font_family", $FONT_FAMILY)
  $mono = family($v, "appearance.mono_family", $MONO_FAMILY)
  $pt = points(font_size($v))
  $gtk = [["gtk-application-prefer-dark-theme", if $mode == "dark" then "true" else "false" end],
    ["gtk-font-name", $font .. " " .. $pt],
    ["gtk-decoration-layout", decoration_layout($v)]]
  if $icons.name != nil then push($gtk, ["gtk-icon-theme-name", $icons.name]) end
  $gtk3 = $gtk
  $adw = if $mode == "dark" then "adw-gtk3-dark" else "adw-gtk3" end
  if $env.have_theme($adw) then push($gtk3, ["gtk-theme-name", $adw]) end
  push($ini, {path: $cfg .. "/gtk-3.0/settings.ini", section: "Settings", pairs: $gtk3})
  push($ini, {path: $cfg .. "/gtk-4.0/settings.ini", section: "Settings", pairs: $gtk})

  $title = if $mode == "dark" then "MixOSDark" else "MixOSLight" end
  for $q in ["qt5ct", "qt6ct"]
    $look = [["color_scheme_path", $cfg .. "/" .. $q .. "/colors/" .. $title .. ".conf"],
      ["custom_palette", "true"], ["standard_dialogs", "xdgdesktopportal"], [$QT_STAMP, $QT_VERSION]]
    if $icons.name != nil then push($look, ["icon_theme", $icons.name]) end
    $path = $cfg .. "/" .. $q .. "/" .. $q .. ".conf"
    push($ini, {path: $path, section: "Appearance", pairs: $look})
    push($ini, {path: $path, section: "Fonts", pairs: [
      ["general", "\"" .. $font .. "," .. $pt .. ",-1,5,50,0,0,0,0,0\""],
      ["fixed", "\"" .. $mono .. "," .. $pt .. ",-1,5,50,0,0,0,0,0\""]]})
  end

  $scale = $v["accessibility.text_scale"]
  $gsettings = [["org.gnome.desktop.interface", "color-scheme", if $mode == "dark" then "prefer-dark" else "prefer-light" end],
    ["org.gnome.desktop.interface", "font-name", $font .. " " .. $pt],
    ["org.gnome.desktop.interface", "monospace-font-name", $mono .. " " .. $pt],
    ["org.gnome.desktop.interface", "text-scaling-factor", sprintf("%g", if type($scale) == "number" then $scale else 1 end)],
    ["org.gnome.desktop.a11y.interface", "high-contrast", if $v["appearance.contrast"] == "high" then "true" else "false" end],
    ["org.gnome.desktop.wm.preferences", "button-layout", decoration_layout($v)]]
  if $icons.name != nil then push($gsettings, ["org.gnome.desktop.interface", "icon-theme", $icons.name]) end
  if $env.have_theme($adw) then push($gsettings, ["org.gnome.desktop.interface", "gtk-theme", $adw]) end
  return {files: $files, links: $links, ini: $ini, gsettings: $gsettings, icon_theme_missing: $icons.missing}
end

-- ini-style text (GTK settings.ini, qt5ct.conf): a key's value in a
-- section, or nil.
fn ini_get($text, $section, $key)
  $in = false
  for $line in split($text ?? "", "\n")
    $t = trim($line)
    if starts_with($t, "[") and ends_with($t, "]") then
      $in = $t == "[" .. $section .. "]"
    elif $in and contains($t, "=") and not starts_with($t, "#") and not starts_with($t, ";") then
      $i = index_of($t, "=")
      if trim(slice($t, 0, $i)) == $key then return trim(slice($t, $i + 1)) end
    end
  end
  return nil
end

fn missing_lines($order, $want, $seen)
  $out = []
  for $k in $order
    if $seen[$k] == nil and $want[$k] != nil then push($out, $k .. "=" .. $want[$k]) end
  end
  return $out
end

-- The text with `$pairs` ([key, value], value nil to remove) set in
-- `$section`; every other line, comment and section is kept as it was.
-- Missing keys are appended to the section, a missing section at the end.
fn ini_set($text, $section, $pairs)
  $want = {}
  $order = []
  for $p in $pairs
    $want[$p[0]] = $p[1]
    push($order, $p[0])
  end
  $out = []
  $seen = {}
  $in = false
  $found = false
  $lines = split($text ?? "", "\n")
  if len($lines) > 0 and $lines[len($lines) - 1] == "" then $lines = slice($lines, 0, len($lines) - 1) end
  for $line in $lines
    $t = trim($line)
    if starts_with($t, "[") and ends_with($t, "]") then
      if $in then
        $out = concat($out, missing_lines($order, $want, $seen))
        for $k in $order $seen[$k] = true end
      end
      $in = $t == "[" .. $section .. "]"
      if $in then $found = true end
      push($out, $line)
      continue
    end
    if $in and contains($t, "=") and not starts_with($t, "#") and not starts_with($t, ";") then
      $k = trim(slice($t, 0, index_of($t, "=")))
      if contains($order, $k) then
        if $seen[$k] != nil then continue end
        $seen[$k] = true
        if $want[$k] != nil then push($out, $k .. "=" .. $want[$k]) end
        continue
      end
    end
    push($out, $line)
  end
  if $in then
    $out = concat($out, missing_lines($order, $want, $seen))
  elif not $found and any($order, fn($k) = $want[$k] != nil) then
    if len($out) > 0 and trim($out[len($out) - 1]) != "" then push($out, "") end
    push($out, "[" .. $section .. "]")
    $out = concat($out, missing_lines($order, $want, {}))
  end
  return if len($out) == 0 then "" else join($out, "\n") .. "\n" end
end
