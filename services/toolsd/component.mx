-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Identity of a Mix component (docs/docs/decisions/2026-10-10-mix-components.md).
-- Read by tools/component_index.mix; the same fields as a Cargo package's
-- [package.metadata.mixos], plus the name, version and principal program.
{
  schema: 1,
  name: "toolsd",
  component: "toolsd",
  kind: "service",
  layer: "core",
  contract: "public",
  profiles: ["server"],
  version: "0.1.0",
  program: "scripts/toolsd.mix"
}
