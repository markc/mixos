// SPDX-License-Identifier: MIT OR Apache-2.0
// Install as /etc/polkit-1/rules.d/49-toolsd-wake.rules.
//
// The ABP wake citizen user toolsd-wake may start ONLY the tool drain oneshot — nothing
// else. This lets the credential-free citizen trigger the drain without being root or
// holding generic systemctl authority.
//
// Anything outside this exact (user, verb, unit) triple falls through to the polkit
// default (deny for a system user with no active session). In particular the wake user
// cannot start, stop or restart ANY other unit.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "toolsd-wake") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if (verb == "start" && unit == "toolsd-drain.service") {
            return polkit.Result.YES;
        }
        return polkit.Result.NOT_HANDLED;
    }
});
