#!/usr/bin/env mix
-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.1.0
-- Shipped implementation of mix layout apply. --root is a staging sysroot.
include "render.mix"
$g = getopt(args(), {root: {arg: true}, "dry-run": {}, image: {}, help: {short: "h"}})
if len($g.errors) != 0 or len($g.rest) != 0 then raise("LAYOUT_ARGS", "layout apply [--root DIR] [--dry-run] [--image]") end
if $g.opts.help then print("mix layout apply [--root DIR] [--dry-run] [--image]"); exit(0) end
$stage = $g.opts.root ?? "/"
if not starts_with($stage, "/") or contains(split($stage, "/"), "..") then raise("LAYOUT_ROOT", "--root must be absolute without '..'") end
$stage = if $stage == "/" then "" else $stage end
$dry = $g.opts["dry-run"] == true
$roots = {}
for $name in ["prefix", "config", "state", "cache", "runtime"] $roots[$name] = mixos_path($name) end
$here = dirname(realpath($0))
$manifest = load_data($here .. "/templates.mx")
if $manifest.schema != 1 then raise("LAYOUT_SCHEMA", "unsupported template manifest") end

fn destination($path)
  if not starts_with($path, "/") or contains(split($path, "/"), "..") then raise("LAYOUT_TARGET", "target must be absolute and bounded") end
  $dest = $stage .. $path
  -- Refuse symlinks in every parent: a test root must never escape to the host.
  $part = ""
  for $piece in split(dirname($dest), "/")
    if $piece == "" then continue end
    $part = $part .. "/" .. $piece
    if exists($part, {follow_symlinks: false}) then
      $st = stat($part, {follow_symlinks: false})
      if $st.is_symlink or not $st.is_dir then raise("LAYOUT_TARGET", "non-directory parent " .. $part) end
    end
  end
  return $dest
end

fn write_changed($path, $text)
  $dest = destination($path)
  if exists($dest, {follow_symlinks: false}) then
    if stat($dest, {follow_symlinks: false}).is_symlink or not is_file($dest) then raise("LAYOUT_TARGET", "refusing non-regular file " .. $dest) end
    if read_file($dest) == $text then return end
  end
  print($dest)
  if not $dry then
    mkdir(dirname($dest), {parents: true})
    write_atomic($dest, $text, {mode: 0o644, durability: "full"})
  end
end

fn existing_text($path)
  $dest = destination($path)
  if not exists($dest, {follow_symlinks: false}) then return "" end
  $st = stat($dest, {follow_symlinks: false})
  if $st.is_symlink or not $st.is_file then raise("LAYOUT_TARGET", "refusing non-regular file " .. $dest) end
  return read_file($dest)
end

-- Preflight every template and link before the first mutation.
$pending = []
for $entry in $manifest.files
  $source = $here .. "/" .. $entry.source
  if not is_file($source) then raise("LAYOUT_SOURCE", "missing template " .. $source) end
  $target = render($entry.target, $roots)
  destination($target)
  push($pending, {path: $target, text: external(read_file($source), $roots, $entry.kind)})
end
$link = destination(if $g.opts.image then "/usr/bin/mix" else "/usr/local/bin/mix" end)
if exists($link, {follow_symlinks: false}) and not stat($link, {follow_symlinks: false}).is_symlink then
  raise("LAYOUT_LINK", "refusing to overwrite non-symlink " .. $link)
end
$shell = if $g.opts.image then "/usr/bin/mix" else "/usr/local/bin/mix" end
$shells = existing_text("/etc/shells")
if not contains(lines($shells), $shell) then
  push($pending, {path: "/etc/shells", text: $shells .. (if $shells != "" and not ends_with($shells, "\n") then "\n" else "" end) .. $shell .. "\n"})
end
if env("HOME") != "" then
  $rc_path = env("HOME") .. "/.mixrc"
  $rc = existing_text($rc_path)
  $begin = "# BEGIN MixOS layout\n"
  $end = "# END MixOS layout\n"
  if contains($rc, $begin) then
    $a = index_of($rc, $begin)
    $b = index_of(substr($rc, $a), $end)
    if $b < 0 then raise("LAYOUT_MIXRC", "unterminated managed PATH block") end
    $rc = substr($rc, 0, $a) .. substr($rc, $a + $b + len($end))
  end
  $rc_layout = $roots
  for $name in keys($rc_layout)
    $encoded = data_encode($rc_layout[$name])
    $rc_layout[$name] = substr($encoded, 1, len($encoded) - 2)
  end
  $snippet = render(read_file($here .. "/mixrc.template"), $rc_layout)
  push($pending, {path: $rc_path, text: $rc .. (if $rc != "" and not ends_with($rc, "\n") then "\n" else "" end) .. $begin .. $snippet .. $end})
end
for $entry in $pending
  $dest = destination($entry.path)
  if exists($dest, {follow_symlinks: false}) and (stat($dest, {follow_symlinks: false}).is_symlink or not is_file($dest)) then
    raise("LAYOUT_TARGET", "refusing non-regular file " .. $dest)
  end
end
for $entry in $pending write_changed($entry.path, $entry.text) end
$binary = $roots.prefix .. "/bin/mix"
if not exists($link, {follow_symlinks: false}) or read_link($link) != $binary then
  print($link .. " -> " .. $binary)
  if not $dry then
    mkdir(dirname($link), {parents: true})
    if exists($link, {follow_symlinks: false}) then remove($link) end
    symlink($binary, $link)
  end
end
