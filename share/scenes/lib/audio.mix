-- The volume popup's snapshot and writes: PipeWire's pulse server through
-- pactl (`pactl -f json`). Mix's audio_state() reads only the default sink's
-- level, so devices, streams and every write go through pactl. Reads never
-- raise: a pactl that is missing or does not answer is ok:false.

-- pactl's volume unit: 65536 is 100 %.
$NORM = 65536
-- The most rows each list shows.
$MAX_DEVICES = 16
$MAX_STREAMS = 32

-- A pactl volume map ({channel: {value, ...}}) as one percentage: the
-- loudest channel, as Plasma's applet shows it. 0 when unreadable.
fn level_of($volume)
  $level = 0
  if type($volume) != "map" then return 0 end
  for each $channel, $v in $volume
    if type($v) == "map" and type($v.value) == "number" then $level = max($level, round($v.value * 100 / $NORM)) end
  end
  return $level
end

-- A source that only mirrors a sink's output: not an input device.
fn is_monitor($source)
  $props = type($source.properties) == "map" ? $source.properties : {}
  return $props["device.class"] == "monitor" or ends_with(to_string($source.name), ".monitor")
end

fn device($d, $default)
  $name = to_string($d.name)
  $description = $d.description ?? ""
  if $description == "" then $description = $name end
  return {index: $d.index, name: $name, description: $description,
    level: level_of($d.volume), muted: $d.mute == true, default: $name == $default}
end

fn stream_name($s)
  $props = type($s.properties) == "map" ? $s.properties : {}
  $name = $props["application.name"] ?? ""
  if $name == "" then $name = $props["node.name"] ?? "" end
  if $name == "" then $name = "Stream " .. to_string($s.index) end
  return $name
end

-- from_pactl: pactl's four JSON documents (info, sinks, sources, sink-inputs) as one
-- snapshot: {ok, default_sink, default_source, sinks, sources, streams}.
-- Each device is {index, name, description, level, muted, default}; each
-- stream {index, name, media, level, muted, sink}. Monitors are left out of
-- the sources. Anything that is not the expected shape counts as empty.
fn from_pactl($info, $sinks, $sources, $inputs)
  $info = type($info) == "map" ? $info : {}
  $default_sink = to_string($info.default_sink_name ?? "")
  $default_source = to_string($info.default_source_name ?? "")
  $out = {ok: true, default_sink: $default_sink, default_source: $default_source, sinks: [], sources: [], streams: []}
  $list = []
  for each $d in type($sinks) == "list" ? $sinks : []
    if type($d) == "map" and length($list) < $MAX_DEVICES then push($list, device($d, $default_sink)) end
  end
  $out.sinks = $list
  $list = []
  for each $d in type($sources) == "list" ? $sources : []
    if type($d) == "map" and not is_monitor($d) and length($list) < $MAX_DEVICES then push($list, device($d, $default_source)) end
  end
  $out.sources = $list
  $list = []
  for each $s in type($inputs) == "list" ? $inputs : []
    if type($s) != "map" or length($list) >= $MAX_STREAMS then continue end
    $props = type($s.properties) == "map" ? $s.properties : {}
    push($list, {index: $s.index, name: stream_name($s), media: $props["media.name"] ?? "",
      level: level_of($s.volume), muted: $s.mute == true, sink: $s.sink})
  end
  $out.streams = $list
  return $out
end

-- One pactl call's JSON, or raises with pactl's own message.
fn pactl_json($runtime_dir, $argv)
  $run = run_argv(concat(["pactl", "-f", "json"], $argv), {timeout: 3, env: {XDG_RUNTIME_DIR: $runtime_dir}})
  if not $run.ok then raise("PACTL_FAILED", trim($run.stderr ?? "") != "" ? trim($run.stderr) : "pactl " .. join($argv, " ") .. " failed") end
  return json_parse($run.stdout)
end

-- The whole snapshot, or {ok: false, reason} when pactl is missing or the
-- server does not answer. Up to four pactl runs of 3 s each: call this from
-- an async handler only.
fn snapshot($runtime_dir)
  if which("pactl") == nil then return {ok: false, reason: "pactl is not installed"} end
  try
    $info = pactl_json($runtime_dir, ["info"])
    $sinks = pactl_json($runtime_dir, ["list", "sinks"])
    $sources = pactl_json($runtime_dir, ["list", "sources"])
    $inputs = pactl_json($runtime_dir, ["list", "sink-inputs"])
  catch $message
    return {ok: false, reason: to_string($message)}
  end
  return from_pactl($info, $sinks, $sources, $inputs)
end

-- One pactl write: {ok, message}. Never raises.
fn write($runtime_dir, $argv)
  if which("pactl") == nil then return {ok: false, message: "pactl is not installed"} end
  $run = run_argv(concat(["pactl"], $argv), {timeout: 3, env: {XDG_RUNTIME_DIR: $runtime_dir}})
  if $run.ok then return {ok: true, message: ""} end
  $why = trim($run.stderr ?? "")
  return {ok: false, message: $why != "" ? $why : "pactl " .. $argv[0] .. " failed"}
end

-- A level clamped to 0..$max, as pactl's "N%" argument.
fn percent($level, $max)
  return to_string(max(0, min(round($level), $max))) .. "%"
end
