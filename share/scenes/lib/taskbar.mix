-- Pure taskbar decisions for the panel behaviour: window filtering and click
-- payload validation. No Bus access, no document emission.

-- Normal-band windows in stable id order, so buttons do not jump when focus
-- moves (Plasma's default launch order). Other bands never get a button.
fn normal_windows($windows)
  $out = []
  for each $w in $windows ?? []
    if type($w) == "map" and $w.band == "normal" then push($out, $w) end
  end
  return sort_by($out, function ($w) = $w.id)
end

-- The current workspace's windows, bounded. A window without a workspace
-- (or comp's 0 before its first map) belongs to the current one.
fn current_tasks($windows, $ws_current, $limit)
  $tasks = []
  for each $w in $windows
    if length($tasks) >= $limit then break end
    if not elsewhere($w, $ws_current) then push($tasks, $w) end
  end
  return $tasks
end

-- The panel's task scope (Plasma's "Show only tasks from the current
-- desktop", off by default): "all" or "current"; anything else is nil.
$SCOPES = ["all", "current"]
fn valid_scope($scope)
  if type($scope) == "string" and contains($SCOPES, $scope) then return $scope end
  return nil
end

-- The tasks the panel shows for $scope, bounded, in id order. "all" takes
-- the current workspace's windows first, so the cap never drops a window the
-- user is looking at, then fills from the other workspaces; "current" is
-- current_tasks.
fn panel_tasks($windows, $ws_current, $scope, $limit)
  $here = current_tasks($windows, $ws_current, $limit)
  if $scope == "current" then return $here end
  $tasks = $here
  for each $w in $windows
    if length($tasks) >= $limit then break end
    if elsewhere($w, $ws_current) then push($tasks, $w) end
  end
  return sort_by($tasks, function ($w) = $w.id)
end

-- A window on another workspace than $ws_current. A window without a
-- workspace, or with comp's 0 before its first map, belongs to the current one.
fn elsewhere($w, $ws_current)
  $ws = $w.workspace
  if type($ws) != "number" or $ws < 1 then return false end
  return $ws != $ws_current
end

fn refusal($code, $message)
  return {ok: false, error_code: $code, message: $message}
end

-- A task click carries the complete row the panel published, including the
-- window id and the generation it was rendered with. The action is decided
-- against a FRESH window list: a window that has since changed identity (same
-- id, new generation) or closed is refused rather than acted on, and the
-- compositor re-checks the generation it receives as well.
-- task_action is the pre-scope form, kept because user copies of the panel
-- behaviour call it with two arguments against this shared library; it
-- treats every window as on the current workspace.
fn task_action($windows, $item)
  return task_action_at($windows, $item, nil)
end

-- A window on another workspace than $ws_current is focused, or restored if
-- minimised, and never minimised: it is not the window the user is looking
-- at. The compositor shows its workspace itself (comp.window.focus and
-- restore switch only when the operation is allowed, so a refused click
-- never moves the desktop). $ws_current nil = no workspace check.
fn task_action_at($windows, $item, $ws_current)
  if type($item) != "map" or type($item.window) != "number" or type($item.generation) != "number" then
    return refusal("invalid_args", "item must carry the window id and generation")
  end
  for each $w in $windows
    if $w.id == $item.window then
      if $w.generation != $item.generation then
        return refusal("stale_window", "window changed since the panel was drawn")
      end
      $args = {id: $w.id, generation: $w.generation}
      if $ws_current != nil and elsewhere($w, $ws_current) then
        return {ok: true, command: $w.minimized ? "comp.window.restore" : "comp.window.focus", args: $args}
      end
      if $w.minimized then return {ok: true, command: "comp.window.restore", args: $args} end
      if $w.focused then return {ok: true, command: "comp.window.minimize", args: $args} end
      -- comp.window.focus raises by default
      return {ok: true, command: "comp.window.focus", args: $args}
    end
  end
  return refusal("stale_window", "window no longer exists")
end

-- "Bring here" (a right click on a task): the window comes to the current
-- workspace, on screen. Steps are comp commands run in order, each with the
-- id and generation the fresh list holds. A minimised window is restored; a
-- window elsewhere is sent here; a floating one is centred in $usable (the
-- output's {x, y, width, height} work area, logical px), shrunk to fit if
-- it is larger; a maximised or fullscreen one already fills it. Then focus.
-- $usable nil = no placement (the window still comes here and is focused).
-- $output names the output $usable belongs to: the window's own, or, for a
-- window wholly off screen (no output), the one it is placed on.
fn bring_here_at($windows, $item, $ws_current, $usable, $output)
  if type($item) != "map" or type($item.window) != "number" or type($item.generation) != "number" then
    return refusal("invalid_args", "item must carry the window id and generation")
  end
  $w = nil
  for each $row in $windows
    if $row.id == $item.window then $w = $row end
  end
  if $w == nil then return refusal("stale_window", "window no longer exists") end
  if $w.generation != $item.generation then
    return refusal("stale_window", "window changed since the panel was drawn")
  end
  $id = {id: $w.id, generation: $w.generation}
  $steps = []
  if $w.minimized then push($steps, {command: "comp.window.restore", args: $id}) end
  if $ws_current != nil and elsewhere($w, $ws_current) then
    push($steps, {command: "comp.window.send_to_workspace", args: {id: $w.id, generation: $w.generation, index: $ws_current}})
  end
  if type($usable) == "map" and not $w.maximized and not $w.fullscreen then
    $width = min($w.window_width ?? $w.width, $usable.width)
    $height = min($w.window_height ?? $w.height, $usable.height)
    $place = {id: $w.id, generation: $w.generation,
      x: $usable.x + floor(($usable.width - $width) / 2),
      y: $usable.y + floor(($usable.height - $height) / 2)}
    $on = $output ?? $w.output
    if type($on) == "string" then $place.output = $on end
    if $width < ($w.window_width ?? $w.width) then $place.width = $width end
    if $height < ($w.window_height ?? $w.height) then $place.height = $height end
    push($steps, {command: "comp.window.place", args: $place})
  end
  push($steps, {command: "comp.window.focus", args: $id})
  return {ok: true, steps: $steps}
end

fn workspace_index($item)
  if type($item) != "map" or type($item.index) != "number" or $item.index < 1 or floor($item.index) != $item.index then
    return nil
  end
  return $item.index
end

-- The tray adapter's store KEY ("i<n>", what tray.activate takes; the SNI Id
-- is the application's own name and is not accepted).
fn tray_key($item)
  if type($item) != "map" or type($item.key) != "string" or $item.key == "" then return nil end
  return $item.key
end

