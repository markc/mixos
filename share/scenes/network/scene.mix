---
scene: 1
name: network
citizen: scene-network
window: {"chrome":false,"edge":"right","kind":"edge","title":"Network","w":400}
model: {"count":"No interfaces","dns":"","dns_label":"DNS","edit":{"addresses":"","addresses_hint":"192.0.2.10/24, …","addresses_label":"Addresses","apply_label":"Apply","busy":false,"close_label":"Close","dhcp_bg":"#3daee9","dhcp_color":"#0b1f2b","dhcp_label":"DHCP","dns":"","dns_hint":"optional","dns_label":"DNS servers","gateway":"","gateway_hint":"optional","gateway_label":"Gateway","has_note":false,"has_undo":false,"is_static":false,"note":"","shown":false,"static_bg":"#ffffff0f","static_color":"#fcfcfc","static_label":"Static","title":"","undo_label":"Undo last change"},"empty":true,"empty_text":"No interfaces","gateway":"","has_dns":false,"has_gateway":false,"has_hostd_note":false,"has_note":false,"hostd_note":"","note":"","route_label":"Default route","rows":[],"summary":"Offline","title":"Network"}
---
```mix
root: {"children":["nh","n_summary","n_route","n_dns","n_note","n_hostd","n_edit","n_empty","n_list"],"fill":true,"gap":10,"padding":16,"widget":"column"}
nh: {"align":"center","children":["nh_t","nh_fill","nh_count"],"gap":8,"widget":"row"}
nh_t: {"bold":true,"color":"#fcfcfc","size":18,"text":"= $model.title","widget":"text"}
nh_fill: {"widget":"spacer"}
nh_count: {"color":"#6e7680","size":12,"text":"= $model.count","widget":"text"}
n_summary: {"color":"#a1a9b1","size":13,"text":"= $model.summary","widget":"text"}
n_route: {"children":["n_route_l","n_route_v"],"gap":8,"hidden":"= not $model.has_gateway","widget":"row"}
n_route_l: {"color":"#6e7680","size":12,"text":"= $model.route_label","widget":"text","width":96}
n_route_v: {"color":"#fcfcfc","elide":true,"fill":true,"size":12,"text":"= $model.gateway","widget":"text"}
n_dns: {"children":["n_dns_l","n_dns_v"],"gap":8,"hidden":"= not $model.has_dns","widget":"row"}
n_dns_l: {"color":"#6e7680","size":12,"text":"= $model.dns_label","widget":"text","width":96}
n_dns_v: {"color":"#fcfcfc","elide":true,"fill":true,"size":12,"text":"= $model.dns","widget":"text"}
n_note: {"color":"#6e7680","hidden":"= not $model.has_note","size":11,"text":"= $model.note","widget":"text"}
n_hostd: {"color":"#6e7680","hidden":"= not $model.has_hostd_note","size":11,"text":"= $model.hostd_note","widget":"text"}
n_edit: {"background":"#2a2e32","children":["n_edit_col"],"hidden":"= not $model.edit.shown","padding":12,"radius":10,"widget":"row"}
n_edit_col: {"children":["e_title","e_mode","e_addr_l","e_addr","e_gw_l","e_gw","e_dns_l","e_dns","e_btns","e_note"],"fill":true,"gap":6,"widget":"column"}
e_title: {"bold":true,"color":"#fcfcfc","size":14,"text":"= $model.edit.title","widget":"text"}
e_mode: {"children":["e_dhcp","e_static"],"gap":6,"widget":"row"}
e_dhcp: {"align":"center","background":"= $model.edit.dhcp_bg","children":["e_dhcp_t"],"height":28,"hover":"#ffffff1a","justify":"center","on_click":"net_mode_dhcp","padding":10,"radius":6,"widget":"row"}
e_dhcp_t: {"color":"= $model.edit.dhcp_color","size":12,"text":"= $model.edit.dhcp_label","widget":"text"}
e_static: {"align":"center","background":"= $model.edit.static_bg","children":["e_static_t"],"height":28,"hover":"#ffffff1a","justify":"center","on_click":"net_mode_static","padding":10,"radius":6,"widget":"row"}
e_static_t: {"color":"= $model.edit.static_color","size":12,"text":"= $model.edit.static_label","widget":"text"}
e_addr_l: {"color":"#a1a9b1","hidden":"= not $model.edit.is_static","size":11,"text":"= $model.edit.addresses_label","widget":"text"}
e_addr: {"hidden":"= not $model.edit.is_static","on_change":"net_edit_addr","on_submit":"net_apply","placeholder":"= $model.edit.addresses_hint","value":"= $model.edit.addresses","widget":"field","width":344}
e_gw_l: {"color":"#a1a9b1","hidden":"= not $model.edit.is_static","size":11,"text":"= $model.edit.gateway_label","widget":"text"}
e_gw: {"hidden":"= not $model.edit.is_static","on_change":"net_edit_gw","on_submit":"net_apply","placeholder":"= $model.edit.gateway_hint","value":"= $model.edit.gateway","widget":"field","width":344}
e_dns_l: {"color":"#a1a9b1","size":11,"text":"= $model.edit.dns_label","widget":"text"}
e_dns: {"on_change":"net_edit_dns","on_submit":"net_apply","placeholder":"= $model.edit.dns_hint","value":"= $model.edit.dns","widget":"field","width":344}
e_btns: {"children":["e_apply","e_undo","e_btn_fill","e_close"],"gap":6,"widget":"row"}
e_apply: {"label":"= $model.edit.apply_label","on_click":"net_apply","tone":"primary","widget":"button"}
e_undo: {"hidden":"= not $model.edit.has_undo","label":"= $model.edit.undo_label","on_click":"net_undo","widget":"button"}
e_btn_fill: {"widget":"spacer"}
e_close: {"label":"= $model.edit.close_label","on_click":"net_close","widget":"button"}
e_note: {"color":"#fcfcfc","hidden":"= not $model.edit.has_note","size":12,"text":"= $model.edit.note","widget":"text"}
n_empty: {"color":"#6e7680","hidden":"= not $model.empty","size":13,"text":"= $model.empty_text","widget":"text"}
n_list: {"fill":true,"gap":6,"hidden":"= $model.empty","on_click":"net_row","row":"n_row","row_height":84,"rows":"= $model.rows","widget":"list"}
n_row: {"align":"center","background":"= $item.background","children":["n_dot","n_col","n_cta"],"gap":10,"height":84,"hover":"#343a40","padding":12,"radius":10,"widget":"row"}
n_dot: {"color":"= $item.dot","size":12,"text":"●","widget":"text"}
n_col: {"children":["n_name","n_sub","n_addr","n_detail"],"fill":true,"gap":2,"widget":"column"}
n_name: {"bold":true,"color":"#fcfcfc","elide":true,"size":14,"text":"= $item.name","widget":"text"}
n_sub: {"color":"#a1a9b1","elide":true,"size":12,"text":"= $item.sub","widget":"text"}
n_addr: {"color":"#fcfcfc","elide":true,"size":12,"text":"= $item.addresses","widget":"text"}
n_detail: {"color":"#6e7680","elide":true,"hidden":"= not $item.has_detail","size":11,"text":"= $item.detail","widget":"text"}
n_cta: {"color":"#3daee9","hidden":"= not $item.editable","size":12,"text":"= $item.cta","widget":"text"}
```
