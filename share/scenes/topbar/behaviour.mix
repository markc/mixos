-- version: 0.3.0
-- The top bar's behaviour: launches and popup toggles in, one complete model
-- out through the loader (scenes.model). Icons come from the apps citizen; a
-- missing icon shows its label. Power is two clicks: the first arms the
-- action for five seconds and the second sends it to hostd.
$LIB = env("SCENES_LIB", env("XDG_DATA_HOME", env("HOME") .. "/.local/share") .. "/mixos/scenes/lib")
$r = require($LIB .. "/runtime.mix")
$p = require($LIB .. "/data.mix")
$models = require($LIB .. "/models.mix")
$h = require($LIB .. "/hostd.mix")
$ctx = $r.scene_context("topbar")
$APPS = env("APPS_SERVICE", "apps")
$ICON_THEME = env("TOPBAR_ICON_THEME", "")
-- The loader-owned popup scenes the top bar's buttons toggle.
$POPUPS = {launcher: env("TOPBAR_LAUNCHER_SCENE", "launcher"),
  calendar: env("TOPBAR_CALENDAR_SCENE", "calendar"), notes: env("TOPBAR_NOTES_SCENE", "notes"),
  network: env("TOPBAR_NETWORK_SCENE", "network")}
-- Launch buttons: the desktop entry to start and the icon to show.
$LAUNCH = {term: {app: "dev.mixos.term", icon: "dev.mixos.term-symbolic", label: "Terminal"},
  files: {app: "dev.mixos.dopus", icon: "dev.mixos.dopus-symbolic", label: "Files"},
  shot: {app: "dev.mixos.screenshot", icon: "dev.mixos.screenshot-symbolic", label: "Screenshot"},
  settings: {app: "dev.mixos.prefs", icon: "dev.mixos.prefs-symbolic", label: "Settings"}}
-- Desk power actions. Each names a hostd command and passes this desk's name:
-- restart and stop this machine only, never the host. Writes go only through
-- hostd.
$POWER = {restart: "desk.restart", poweroff: "desk.stop"}
$CONFIRM_S = 5
-- How long a refusal, or a sent action, stays on the bar.
$NOTICE_S = 30

$state = {ready: false, clock_armed: false, ticking: false, icons: {}, themed: {}, armed: nil, armed_at: 0,
  notice: {}}

-- This desk's identity, written into its root by desk_identity.mix: DESK=name,
-- VT=number. Read here, never inferred from the hostname or the foreground VT.
fn identity()
  $out = {desk: "unknown", vt: "?"}
  try
    for $line in read_lines(env("DESK_IDENTITY", "/etc/mixos/desk.env"))
      $kv = split_once($line, "=")
      if $kv != nil and $kv[0] == "DESK" then $out.desk = $kv[1] end
      if $kv != nil and $kv[0] == "VT" then $out.vt = $kv[1] end
    end
  catch $message
    eprint("topbar identity: " .. to_string($message))
  end
  return $out
end
$IDENTITY = identity()

-- Misses are cached too; apps.changed, an apps restart and a reconnect clear
-- the cache, so icons installed after the bar started still appear.
fn apps_icon($name, $size)
  $req = {name: $name, size: $size}
  if $ICON_THEME != "" then $req.theme = $ICON_THEME end
  $hit = $r.call($APPS, "apps.icon", $req)
  if $hit.ok and type($hit.value) == "map" and type($hit.value.path) == "string" then return $hit.value.path end
  return ""
end

fn icon_path($name)
  if not has_key($state.icons, $name) then $state.icons[$name] = apps_icon($name, 24) end
  return $state.icons[$name]
end

-- The launcher mark, by the panel's lookup (models.mix LAUNCHER_ICONS).
fn launcher_themed()
  for each $l in $models.LAUNCHER_ICONS
    if not has_key($state.themed, $l.key) then
      $path = ""
      for each $name in $l.names
        if $path == "" then $path = apps_icon($name, $models.LAUNCHER_ICON_SIZE) end
      end
      $state.themed[$l.key] = $path
    end
  end
  return $state.themed
end

fn forget_icons()
  $state.icons = {}
  $state.themed = {}
end

fn button($label, $icon, $tip)
  $path = icon_path($icon)
  return {label: $label, icon: $path, has_icon: $path != "", background: nil, tip: {title: $tip}}
end

-- Whole seconds left to confirm $key; 0 when it is not armed.
fn armed_left($key)
  if $state.armed != $key then return 0 end
  $left = $CONFIRM_S - (monotonic() - $state.armed_at)
  return $left > 0 ? ceil($left) : 0
end

-- $state.notice[$key]: {text, sent, at} for the last answer, shown $NOTICE_S.
fn notice($key)
  $n = $state.notice[$key]
  if $n == nil or monotonic() - $n.at > $NOTICE_S then return {text: "", sent: false} end
  return $n
end

fn power_model($key, $label, $icon)
  $n = notice($key)
  return $models.topbar_power({label: $label, icon: icon_path($icon), desk: $IDENTITY.desk, vt: $IDENTITY.vt,
    left: armed_left($key), sent: $n.sent, notice: $n.text})
end

fn build_model()
  $now = time()
  $m = {}
  $m.clock = {time: $p.clock_text($now),
    tip: {title: date_format($now, "%A %-d %B %Y")}}
  $m.apps = $models.topbar_apps(launcher_themed())
  for each $key in ["term", "files", "shot", "settings"]
    $a = $LAUNCH[$key]
    $m[$key] = button($a.label, $a.icon, $a.label)
  end
  $m.notes = button("Notes", "notifications-symbolic", "Notifications")
  $m.network = button("Network", "network-wired-activated-symbolic", "Network")
  $m.restart = power_model("restart", "Restart", "dev.mixos.restart-symbolic")
  $m.poweroff = power_model("poweroff", "Shutdown","dev.mixos.shutdown-symbolic")
  return $m
end

fn push_model()
  $state.ready = $r.ensure_ready($ctx, $state.ready)
  if not $state.ready then return end
  $out = $r.publish_model($ctx, build_model())
  if not $out.ok then eprint("topbar model refused: " .. json_encode($out.value)) end
end

fn toggle_popup($key)
  return $r.call($ctx.loader, "scenes.toggle", {name: $POPUPS[$key]})
end

fn launch($key)
  return $r.call($APPS, "apps.launch", {id: $LAUNCH[$key].app})
end

-- The countdown and the notices change with time, not events: one
-- in-process task re-publishes each second while any is showing, then ends.
fn start_tick()
  if $state.ticking then return end
  $state.ticking = true
  try
    task_start("power.tick", "{}")
  catch $message
    $state.ticking = false
    eprint("topbar power: countdown not scheduled: " .. to_string($message))
  end
end

fn power_live()
  if armed_left("restart") > 0 or armed_left("poweroff") > 0 then return true end
  return notice("restart").at != nil or notice("poweroff").at != nil
end

fn power($key)
  $now = monotonic()
  if armed_left($key) == 0 then
    $state.armed = $key
    $state.armed_at = $now
    $state.notice = {}
    push_model()
    start_tick()
    return {ok: true, rc: 0, value: {armed: $key}}
  end
  $state.armed = nil
  -- hostd answers once the host has queued the cycle; the desk goes down after.
  $out = $h.call($POWER[$key], {desk: $IDENTITY.desk}, 15)
  if $out.ok then
    eprint("topbar power: " .. $POWER[$key] .. " sent: " .. json_encode($out.body))
    $state.notice[$key] = {text: "", sent: true, at: monotonic()}
  else
    $status = $out.status ?? "refused"
    eprint("topbar power: " .. $POWER[$key] .. " refused: " .. $status .. " " .. json_encode($out.body ?? {message: $out.message}))
    $state.notice[$key] = {text: $status, sent: false, at: monotonic()}
  end
  push_model()
  start_tick()
  if $out.ok then return {ok: true, rc: 0, value: {ran: $key}} end
  return $r.failure("power_refused", "hostd refused " .. $POWER[$key] .. ": " .. ($out.status ?? "unavailable"))
end

on apps async
  $r.respond(toggle_popup("launcher"))
end
on calendar async
  $r.respond(toggle_popup("calendar"))
end
on notes async
  $r.respond(toggle_popup("notes"))
end
on network async
  $r.respond(toggle_popup("network"))
end

on term async
  $r.respond(launch("term"))
end
on files async
  $r.respond(launch("files"))
end
on shot async
  $r.respond(launch("shot"))
end
on settings async
  $r.respond(launch("settings"))
end

on apps.changed
  forget_icons()
  push_model()
end

on props.changed
  $a = $r.event_args($event)
  if $event.headers.topic == env("NODED_SERVICE", "noded") .. ".props.changed" and $a.path == "services.registered" and not $state.ready then
    push_model()
  end
end

on bus.connected
  if len(keys($event.headers)) != 0 then return end
  forget_icons()
  $state.ready = false
  $ready = $r.ready($ctx)
  $state.ready = $ready.ok
  push_model()
end

on restart async
  $r.respond(power("restart"))
end
on poweroff async
  $r.respond(power("poweroff"))
end

on power.tick async
  if len(keys($event.headers)) != 0 then return end
  try
    while power_live()
      sleep(1)
      if $state.armed != nil and armed_left($state.armed) == 0 then $state.armed = nil end
      push_model()
    end
  finally
    $state.ticking = false
  end
end

fn start_clock()
  if $state.clock_armed then return end
  $state.clock_armed = true
  try
    task_start("clock.deadline", "{}")
  catch $message, $error
    $state.clock_armed = false
    raise($error.code, $message, $error.details)
  end
end

-- One in-process task for the displayed time. No recovery polling.
on clock.deadline async
  if len(keys($event.headers)) != 0 then return end
  try
    while true
      sleep($p.seconds_to_next_minute(time()))
      try
        push_model()
      catch $message
        eprint("topbar clock: " .. to_string($message))
      end
    end
  finally
    $state.clock_armed = false
  end
end

subscribe($APPS .. ".changed")
subscribe(env("NODED_SERVICE", "noded") .. ".props.changed")
$ready = $r.ready($ctx)
if not $ready.ok then raise("SCENE_READY", json_encode($ready.value)) end
$state.ready = true
push_model()
start_clock()
