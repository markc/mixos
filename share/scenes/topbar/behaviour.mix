-- version: 0.1.0
-- The top bar's behaviour: launches and popup toggles in, one complete model
-- out through the loader (scenes.model). Icons come from the apps citizen; a
-- missing icon shows its label. Power is two clicks: the first arms the
-- action for five seconds and the second sends it to hostd.
$LIB = env("SCENES_LIB", env("XDG_DATA_HOME", env("HOME") .. "/.local/share") .. "/mixos/scenes/lib")
$r = require($LIB .. "/runtime.mix")
$p = require($LIB .. "/data.mix")
$h = require($LIB .. "/hostd.mix")
$ctx = $r.scene_context("topbar")
$APPS = env("APPS_SERVICE", "apps")
$ICON_THEME = env("TOPBAR_ICON_THEME", "")
-- The loader-owned popup scenes the top bar's buttons toggle.
$POPUPS = {launcher: env("TOPBAR_LAUNCHER_SCENE", "launcher"),
  calendar: env("TOPBAR_CALENDAR_SCENE", "calendar"), notes: env("TOPBAR_NOTES_SCENE", "notes"),
  network: env("TOPBAR_NETWORK_SCENE", "network")}
-- Launch buttons: the desktop entry to start and the icon to show.
$LAUNCH = {term: {app: "dev.mixos.term", icon: "dev.mixos.term-symbolic", label: "Terminal"},
  files: {app: "dev.mixos.dopus", icon: "dev.mixos.dopus-symbolic", label: "Files"},
  shot: {app: "dev.mixos.screenshot", icon: "dev.mixos.screenshot-symbolic", label: "Screenshot"},
  settings: {app: "dev.mixos.prefs", icon: "dev.mixos.prefs-symbolic", label: "Settings"}}
-- Desk power actions. Each names a hostd verb scoped to the caller's own desk
-- (hostd identifies the desk by its cgroup): restart and stop this machine
-- only, never the host. Writes go only through hostd.
$POWER = {restart: "desk.restart", poweroff: "desk.stop"}
$CONFIRM_S = 5

$state = {ready: false, clock_armed: false, icons: {}, armed: nil, armed_at: 0, notice: {}}

fn icon_path($name)
  if has_key($state.icons, $name) then return $state.icons[$name] end
  $req = {name: $name, size: 24}
  if $ICON_THEME != "" then $req.theme = $ICON_THEME end
  $hit = $r.call($APPS, "apps.icon", $req)
  $path = ""
  if $hit.ok and type($hit.value) == "map" and type($hit.value.path) == "string" then
    $path = $hit.value.path
  end
  $state.icons[$name] = $path
  return $path
end

fn button($label, $icon, $tip)
  $path = icon_path($icon)
  return {label: $label, icon: $path, has_icon: $path != "", background: nil, tip: {title: $tip}}
end

fn power_model($key, $label, $icon)
  $armed = $state.armed == $key and monotonic() - $state.armed_at <= $CONFIRM_S
  $text = $label
  if $armed then $text = "Click again to confirm: " .. $label end
  if ($state.notice[$key] ?? "") != "" then $text = $text .. " (" .. $state.notice[$key] .. ")" end
  $path = icon_path($icon)
  return {label: $label, icon: $path, has_icon: $path != "", background: $armed ? "#c0392b" : nil, tip: {title: $text}}
end

fn build_model()
  $now = time()
  $m = {}
  $m.clock = {time: $p.clock_text($now),
    tip: {title: date_format($now, "%A %-d %B %Y")}}
  $m.apps = button("Apps", "dev.mixos", "Applications")
  for each $key in ["term", "files", "shot", "settings"]
    $a = $LAUNCH[$key]
    $m[$key] = button($a.label, $a.icon, $a.label)
  end
  $m.notes = button("Notes", "notifications-symbolic", "Notifications")
  $m.network = button("Network", "network-wired-activated-symbolic", "Network")
  $m.restart = power_model("restart", "Restart", "dev.mixos.restart-symbolic")
  $m.poweroff = power_model("poweroff", "Shut down", "dev.mixos.shutdown-symbolic")
  return $m
end

fn push_model()
  if not $state.ready then return end
  $out = $r.publish_model($ctx, build_model())
  if not $out.ok then eprint("topbar model refused: " .. json_encode($out.value)) end
end

fn toggle_popup($key)
  return $r.call($ctx.loader, "scenes.toggle", {name: $POPUPS[$key]})
end

fn launch($key)
  return $r.call($APPS, "apps.launch", {id: $LAUNCH[$key].app})
end

fn power($key)
  $now = monotonic()
  if $state.armed != $key or $now - $state.armed_at > $CONFIRM_S then
    $state.armed = $key
    $state.armed_at = $now
    push_model()
    return {ok: true, rc: 0, value: {armed: $key}}
  end
  $state.armed = nil
  $out = $h.call($POWER[$key], {}, 15)
  $state.notice[$key] = $out.ok ? "" : ($out.status ?? "refused")
  push_model()
  if $out.ok then return {ok: true, rc: 0, value: {ran: $key}} end
  return $r.failure("power_refused", "hostd refused " .. $POWER[$key] .. ": " .. ($out.status ?? "unavailable"))
end

on apps async
  $r.respond(toggle_popup("launcher"))
end
on calendar async
  $r.respond(toggle_popup("calendar"))
end
on notes async
  $r.respond(toggle_popup("notes"))
end
on network async
  $r.respond(toggle_popup("network"))
end

on term async
  $r.respond(launch("term"))
end
on files async
  $r.respond(launch("files"))
end
on shot async
  $r.respond(launch("shot"))
end
on settings async
  $r.respond(launch("settings"))
end

on restart async
  $r.respond(power("restart"))
end
on poweroff async
  $r.respond(power("poweroff"))
end

fn start_clock()
  if $state.clock_armed then return end
  $state.clock_armed = true
  try
    task_start("clock.deadline", "{}")
  catch $message, $error
    $state.clock_armed = false
    raise($error.code, $message, $error.details)
  end
end

-- One in-process task for the displayed time. No recovery polling.
on clock.deadline async
  if len(keys($event.headers)) != 0 then return end
  try
    while true
      sleep($p.seconds_to_next_minute(time()))
      try
        push_model()
      catch $message
        eprint("topbar clock: " .. to_string($message))
      end
    end
  finally
    $state.clock_armed = false
  end
end

$ready = $r.ready($ctx)
if not $ready.ok then raise("SCENE_READY", json_encode($ready.value)) end
$state.ready = true
push_model()
start_clock()
