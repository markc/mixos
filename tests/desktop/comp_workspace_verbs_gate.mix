#!/usr/bin/env mix
-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.1.1
-- comp_workspace_verbs_gate.mix — the named workspace verbs and their topic,
-- against a PRIVATE nested compd on its own headless weston host
-- (nested_host_lib).
--
--   mix tests/desktop/comp_workspace_verbs_gate.mix [--bin PATH] --config-file PATH [--env NAME=VALUE ...] [--software]
--
-- Under test:
--   - comp.workspaces.list: count, current, one {index, windows, name} row
--     per workspace, the same object as comp.props.get workspaces;
--   - comp.workspace.rename {index, name, persist?}: set, trim, clear,
--     refusals by field;
--   - comp.workspaces.set_count {count, persist?}: grow, shrink (a removed
--     workspace's name goes), refusals;
--   - persist: the count and names land in preferences.json beside the
--     settings file, other keys kept, and a restarted compd starts with
--     them; persist:false writes nothing;
--   - comp.workspace.changed: one delivery per change with count, current,
--     outputs and names (tests/desktop/bus_watch.mix records it).
--
-- The settings file is COPIED into the run directory, so preferences.json
-- is the run's own: the gate never writes beside the caller's settings.

$n = require("nested_host_lib.mix")
$CLEANUP = {ok: false, run: nil}
try

$CONFIG = ""
$ENV = {}
$SOFTWARE = false
$COMP = ""
$USAGE = "usage: comp_workspace_verbs_gate.mix [--bin PATH] --config-file PATH [--env NAME=VALUE ...] [--software]"
$argv = args()
$i = 0
while $i < len($argv)
  $flag = $argv[$i]
  if $flag == "--bin" and $i + 1 < len($argv) then
    $COMP = $argv[$i + 1]
    $i = $i + 2
  elif $flag == "--config-file" and $i + 1 < len($argv) then
    $CONFIG = $argv[$i + 1]
    $i = $i + 2
  elif $flag == "--env" and $i + 1 < len($argv) and contains($argv[$i + 1], "=") then
    $kv = split_once($argv[$i + 1], "=")
    $ENV[$kv[0]] = $kv[1]
    $i = $i + 2
  elif $flag == "--software" then
    $SOFTWARE = true
    $i = $i + 1
  else
    print($USAGE)
    exit(2)
  end
end
if $CONFIG == "" or not is_file($CONFIG) then
  print($USAGE)
  exit(2)
end

$comp = $n.require_binary("compd", $COMP, ["/opt/mixos/bin"])
$CLEANUP.run = $n.new_run(env("TMPDIR", "/tmp") .. "/compd-wsv-" .. to_string(pid()))
$run = $CLEANUP.run.path
$cfg_dir = $run .. "/config"
mkdir($cfg_dir)
$cfg = $cfg_dir .. "/" .. basename($CONFIG)
write_file($cfg, read_file($CONFIG))
$prefs = $cfg_dir .. "/preferences.json"
-- A key compd does not know must survive a save.
write_file($prefs, json_encode({gate_marker: "keep-me"}))

$TALLY = {pass: 0, fail: 0}
fn check($name, $ok, $detail)
  if $ok then
    print("  PASS " .. $name)
    $TALLY["pass"] = $TALLY["pass"] + 1
  else
    print("  FAIL " .. $name .. ": " .. to_string($detail))
    $TALLY["fail"] = $TALLY["fail"] + 1
  end
  return $ok
end

fn sleep_ms($ms)
  sleep($ms / 1000)
end

fn prefs_doc($path)
  if not is_file($path) then
    return nil
  end
  try
    return json_parse(read_file($path))
  catch $e
    return nil
  end
end

-- The rows of a workspaces object as [index, windows, name] strings, for
-- one readable comparison.
fn names_of($ws)
  $out = []
  if type($ws) != "map" or type($ws["list"]) != "list" then
    return nil
  end
  for each $row in $ws["list"]
    push($out, $row["name"])
  end
  return $out
end

fn watch_lines($path)
  $out = []
  if not is_file($path) then
    return $out
  end
  for each $line in split(read_file($path), "\n")
    if trim($line) != "" then
      $rec = json_parse($line)
      if $rec["command"] == "workspace.changed" then
        push($out, $rec)
      end
    end
  end
  return $out
end

-- The first workspace.changed delivery after the first $from ones whose args
-- satisfy $want, waiting up to $ms; nil at the deadline. Matching on content,
-- not on a count, so an unrelated view change (an output settling late)
-- cannot fail a check.
fn wait_event($path, $from, $want, $ms)
  $deadline = time() + $ms / 1000
  while true
    $lines = watch_lines($path)
    $i = $from
    while $i < len($lines)
      if $want($lines[$i]["args"]) then
        return $lines[$i]
      end
      $i = $i + 1
    end
    if time() >= $deadline then
      return nil
    end
    sleep_ms(100)
  end
end

fn start_compd($tag)
  $s = $n.start({bin: $comp, tag: $tag, run: $CLEANUP.run, config: $cfg, env: $ENV, software: $SOFTWARE})
  if not $n.wait_ready($s, 30) then
    print("  ERROR: nested compd did not answer " .. $s["service"] .. ".comp.ping (log " .. $s["log"] .. ")")
    $n.stop($s)
    exit(1)
  end
  return $s
end

$session = start_compd("wsv")
$svc = $session["service"]
$watch = {pid: nil}
print("nested compd (" .. $comp .. "): service " .. $svc .. ", settings " .. $cfg)

try
  fn call($verb, $args)
    return $n.call($svc, $verb, $args)
  end
  fn list()
    $r = call("comp.workspaces.list", {})
    if $r["rc"] != 0 or type($r["result"]) != "map" then
      return nil
    end
    return $r["result"]
  end
  fn refused_on($r, $path)
    return $r["rc"] != 0 and type($r["result"]) == "map" and $r["result"]["path"] == $path
  end

  -- The topic subscriber, before any change.
  $watch_out = $run .. "/bus-watch.jsonl"
  $ws_script = dirname(script_path()) .. "/bus_watch.mix"
  $mix_bin = which("mix") ?? "/opt/mixos/bin/mix"
  $watch.pid = spawn([$mix_bin, "--serve", $ws_script, "--name", "compd-wsv-watch-" .. to_string(pid())],
    {env: {BUS_WATCH_SERVICE: $svc, BUS_WATCH_OUT: $watch_out}, stdout: {file: $run .. "/bus-watch.log"}, stderr: "stdout", detach: true})
  $t = 0
  while not is_file($watch_out) and $t < 40
    sleep(0.25)
    $t = $t + 1
  end
  check("topic subscriber confirmed", is_file($watch_out), "no " .. $watch_out)

  -- 1. The list at start: the defaults (the run's preferences hold no count).
  $l = list()
  check("list: count 4, current 1", $l != nil and $l["count"] == 4 and $l["current"] == 1, json_encode($l))
  check("list: 4 unnamed rows", deep_eq(names_of($l), [nil, nil, nil, nil]), json_encode($l))
  $tree = call("comp.props.get", {path: "workspaces"})
  check("list is the props workspaces object", $tree["rc"] == 0 and deep_eq($tree["result"], $l), json_encode($tree))
  check("list refuses an argument by name", call("comp.workspaces.list", {count: 1})["rc"] != 0, "")

  -- 2. Rename without persisting.
  $mark = len(watch_lines($watch_out))
  $r = call("comp.workspace.rename", {index: 2, name: "  Mail  ", persist: false})
  check("rename 2 -> Mail (trimmed)", $r["rc"] == 0 and $r["result"]["name"] == "Mail" and $r["result"]["previous"] == nil, json_encode($r))
  check("persist:false reports no persisted field", $r["rc"] == 0 and $r["result"]["persisted"] == nil, json_encode($r))
  check("list shows the name", deep_eq(names_of(list()), [nil, "Mail", nil, nil]), json_encode(list()))
  check("persist:false left preferences.json alone", deep_eq(prefs_doc($prefs), {gate_marker: "keep-me"}), read_file($prefs))
  $e = wait_event($watch_out, $mark, fn($a) = deep_eq($a["names"], [nil, "Mail", nil, nil]) and $a["count"] == 4, 3000)
  check("rename published workspace.changed", $e != nil, json_encode(watch_lines($watch_out)))
  check("the topic is the service's own", $e != nil and $e["topic"] == $svc .. ".workspace.changed", json_encode($e))
  check("the event carries version 1 and the current", $e != nil and $e["args"]["version"] == 1 and $e["args"]["current"] == 1, json_encode($e))
  -- A no-op rename publishes no second copy of the same view.
  $mark = len(watch_lines($watch_out))
  $r = call("comp.workspace.rename", {index: 2, name: "Mail", persist: false})
  -- A duplicate is the whole previous view again (event_seq aside); any
  -- other view is a legitimate change, not a failure.
  $prev = $e == nil ? {} : $e["args"]
  $same = fn($a) = $a["count"] == $prev["count"] and $a["current"] == $prev["current"] and deep_eq($a["outputs"], $prev["outputs"]) and deep_eq($a["names"], $prev["names"])
  $dup = wait_event($watch_out, $mark, $same, 800)
  check("the same name again publishes nothing", $dup == nil, json_encode($dup))

  -- 3. Refusals.
  check("rename index 9 refused on index", refused_on(call("comp.workspace.rename", {index: 9, name: "x"}), "index"), "")
  check("rename index 0 refused on index", refused_on(call("comp.workspace.rename", {index: 0, name: "x"}), "index"), "")
  $long = repeat("x", 65)
  check("a 65-character name refused on name", refused_on(call("comp.workspace.rename", {index: 1, name: $long}), "name"), "")
  check("set_count 17 refused on count", refused_on(call("comp.workspaces.set_count", {count: 17}), "count"), "")
  check("set_count 0 refused on count", refused_on(call("comp.workspaces.set_count", {count: 0}), "count"), "")
  check("refusals changed nothing", deep_eq(names_of(list()), [nil, "Mail", nil, nil]) and list()["count"] == 4, json_encode(list()))

  -- 4. Grow and persist.
  $mark = len(watch_lines($watch_out))
  $r = call("comp.workspaces.set_count", {count: 6})
  check("set_count 6 (persist defaults on)", $r["rc"] == 0 and $r["result"]["from"] == 4 and $r["result"]["count"] == 6 and $r["result"]["persisted"] == true,
    json_encode($r))
  $p = prefs_doc($prefs)
  check("preferences.json: count 6 and the names", $p != nil and $p["workspaces_count"] == 6 and deep_eq($p["workspace_names"], ["", "Mail", "", "", "", ""]),
    json_encode($p))
  check("preferences.json: other keys kept", $p != nil and $p["gate_marker"] == "keep-me", json_encode($p))
  check("props workspaces.count is 6", call("comp.props.get", {path: "workspaces.count"})["result"] == 6, "")
  $e = wait_event($watch_out, $mark, fn($a) = $a["count"] == 6 and len($a["names"]) == 6, 3000)
  check("grow published workspace.changed with 6 names", $e != nil, json_encode(watch_lines($watch_out)))

  -- 5. Switch: a current change publishes too.
  $mark = len(watch_lines($watch_out))
  $_ = call("comp.workspace.switch", {index: 5})
  $e = wait_event($watch_out, $mark, fn($a) = $a["current"] == 5, 3000)
  check("switch published workspace.changed (current 5)", $e != nil and len(keys($e["args"]["outputs"])) >= 1,
    json_encode(watch_lines($watch_out)))
  $mark = len(watch_lines($watch_out))
  $_ = call("comp.workspace.switch", {index: 1})
  $_ = wait_event($watch_out, $mark, fn($a) = $a["current"] == 1, 3000)

  -- 6. Name the last one, then restart: the saved state comes back.
  $r = call("comp.workspace.rename", {index: 6, name: "Scratch"})
  check("rename 6 -> Scratch, persisted", $r["rc"] == 0 and $r["result"]["persisted"] == true, json_encode($r))
finally
  if $watch.pid != nil then
    $_k = run_argv(["kill", to_string($watch.pid)])
  end
  $n.stop($session)
end

$session = start_compd("wsv2")
$svc = $session["service"]
try
  fn call2($verb, $args)
    return $n.call($svc, $verb, $args)
  end
  $r = call2("comp.workspaces.list", {})
  $l = if $r["rc"] == 0 then $r["result"] else nil end
  check("restart: count 6 from preferences.json", $l != nil and $l["count"] == 6, json_encode($r))
  check("restart: the names came back", deep_eq(names_of($l), [nil, "Mail", nil, nil, nil, "Scratch"]), json_encode($l))

  -- 7. Shrink: the removed workspaces' names go, and are saved gone.
  $r = call2("comp.workspaces.set_count", {count: 2})
  check("set_count 2", $r["rc"] == 0 and $r["result"]["from"] == 6 and $r["result"]["count"] == 2, json_encode($r))
  $r = call2("comp.workspaces.list", {})
  check("shrink kept only names in range", $r["rc"] == 0 and deep_eq(names_of($r["result"]), [nil, "Mail"]), json_encode($r))
  $p = prefs_doc($prefs)
  check("preferences.json follows the shrink", $p != nil and $p["workspaces_count"] == 2 and deep_eq($p["workspace_names"], ["", "Mail"]), json_encode($p))
  check("rename 3 now refused on index", call2("comp.workspace.rename", {index: 3, name: "x"})["rc"] != 0, "")
  -- Clear restores an unnamed row.
  $r = call2("comp.workspace.rename", {index: 2, name: ""})
  check("an empty name clears", $r["rc"] == 0 and $r["result"]["name"] == nil and $r["result"]["previous"] == "Mail", json_encode($r))
finally
  $n.stop($session)
end

print("")
print("=== WORKSPACE VERBS GATE: " .. to_string($TALLY["pass"]) .. " pass, " .. to_string($TALLY["fail"]) .. " fail ===")
if $TALLY["fail"] > 0 then
  exit(1)
end
$CLEANUP.ok = true
finally
  $n.finish_run($CLEANUP.run, $CLEANUP.ok)
end
