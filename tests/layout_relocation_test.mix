#!/usr/bin/env mix
-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.1.0
-- Run with the CBC-built binary. All writes stay below an owned temp root.
$g = getopt(args(), {bin: {arg: true}, child: {}, "fixture-root": {arg: true}})
if len($g.errors) != 0 then raise("RELOCATION_ARGS", join($g.errors, "; ")) end
$repo = dirname(dirname(realpath($0)))

if $g.opts.child then
  $scratch = $g.opts["fixture-root"]
  if $scratch == nil or not starts_with($scratch, "/tmp/mixos-relocation-") then raise("RELOCATION_ROOT", "invalid fixture root") end
  -- A new mount namespace only. Never mount over host paths in the parent.
  if is_dir("/opt/mixos") then run_argv_must(["mount", "-t", "tmpfs", "tmpfs", "/opt/mixos"]) end
  if is_dir("/etc/mixos") then run_argv_must(["mount", "-t", "tmpfs", "tmpfs", "/etc/mixos"]) end
  if exists("/opt/mixos/bin/mix") or exists("/etc/mixos/node.conf.mix") then raise("RELOCATION_HIDE", "old roots are still visible") end
  print("relocation: old prefix and config are hidden")
  $mix = $scratch .. "/moved prefix/bin/mix"
  $envmap = {MIXOS: nil, MIXOS_PREFIX: nil, MIXOS_SHARE: nil, MIXOS_ETC: $scratch .. "/config", MIXOS_VAR: $scratch .. "/state", MIXOS_CACHE: $scratch .. "/cache", MIXOS_RUN: $scratch .. "/runtime"}
  -- No MIXOS_PREFIX override: this must come from /proc/self/exe.
  $oracle = run_argv_must([$mix, "-c", 'print(mixos_path("prefix"))'], {env: $envmap})
  if trim($oracle) != $scratch .. "/moved prefix" then raise("RELOCATION_PREFIX", $oracle) end
  $apply = [$mix, "layout", "apply", "--root", $scratch .. "/sysroot"]
  $home_rc = if env("HOME") != "" and is_file(env("HOME") .. "/.mixrc") then hash_file(env("HOME") .. "/.mixrc", "sha256") else nil end
  $host_shells = if is_file("/etc/shells") then hash_file("/etc/shells", "sha256") else nil end
  $first = run_argv_must($apply, {env: $envmap})
  $second = run_argv_must($apply, {env: $envmap})
  if trim($second) != "" then raise("RELOCATION_IDEMPOTENCE", $second) end
  $other_share = $envmap
  $other_share.MIXOS_SHARE = $scratch .. "/external-share"
  $share_apply = run_argv(concat($apply, ["--dry-run"]), {env: $other_share})
  if not $share_apply.ok then raise("RELOCATION_SHARE", "renderer must load from the prefix even with MIXOS_SHARE: " .. $share_apply.stderr) end
  print("relocation: renderer is idempotent; " .. to_string(len(lines($first))) .. " changes on first apply")
  $link = $scratch .. "/sysroot/usr/local/bin/mix"
  if read_link($link) != $mix then raise("RELOCATION_LINK", "managed link target differs") end
  $staged_prefix = $scratch .. "/sysroot" .. $scratch .. "/moved prefix"
  for $path in walk($scratch .. "/sysroot", {follow_symlinks: false})
    if $path != $link and not starts_with($path, $staged_prefix .. "/") then raise("RELOCATION_WRITES", "unexpected outside-prefix write: " .. $path) end
  end
  if exists($scratch .. "/sysroot/etc/shells") then raise("RELOCATION_WRITES", "--root wrote shells without --image") end
  if ($home_rc != (if env("HOME") != "" and is_file(env("HOME") .. "/.mixrc") then hash_file(env("HOME") .. "/.mixrc", "sha256") else nil end) or
    $host_shells != (if is_file("/etc/shells") then hash_file("/etc/shells", "sha256") else nil end)) then
    raise("RELOCATION_WRITES", "--root changed host shells or the running user's mixrc")
  end
  $bad_image = run_argv([$mix, "layout", "apply", "--image"], {env: $envmap})
  if $bad_image.ok or not contains($bad_image.stderr, "--image requires --root") then raise("RELOCATION_IMAGE", "--image without --root was accepted") end
  mkdir($scratch .. "/image")
  print(run_argv_must([$mix, "layout", "apply", "--root", $scratch .. "/image", "--image"], {env: $envmap}))
  if read_file($scratch .. "/image/etc/shells") != "/usr/bin/mix\n" then raise("RELOCATION_IMAGE", "image shells differs") end
  for $path in walk($scratch .. "/image", {follow_symlinks: false})
    if (not starts_with($path, $scratch .. "/image" .. $scratch .. "/moved prefix/") and
      not contains([$scratch .. "/image/usr/bin/mix", $scratch .. "/image/etc/shells"], $path)) then
      raise("RELOCATION_WRITES", "unexpected image write: " .. $path)
    end
  end
  print("relocation: writes stay inside the prefix except the link and explicit image shells")
  $logical = run_argv_must([$mix, "-c", 'print(mixos_path("mixos:share/scenes/editor/scene.mix"))'], {env: $envmap})
  if trim($logical) != $scratch .. "/moved prefix/share/scenes/editor/scene.mix" then raise("RELOCATION_LOGICAL", $logical) end
  $escape = run_argv([$mix, "-c", 'print(mixos_path("mixos:prefix/../escape"))'], {env: $envmap})
  if $escape.ok then raise("RELOCATION_ESCAPE", "root escape accepted") end
  -- Native component installer tests and scene loader tests use owned fixtures.
  for $test in ["tests/component_install_test.mix", "services/compd/tests/scenes_io_test.mix", "services/compd/tests/scenes_test.mix"]
    print(run_argv_must([$mix, $repo .. "/" .. $test], {env: $envmap, timeout: 300}))
  end
  -- Parse/resolve scenes with the native scene reader, already covered by the
  -- scene-host and scene library tests in the worker's cargo test stage.
  for $scene in glob($scratch .. "/moved prefix/share/scenes/*/scene.mix")
    if not contains(read_file($scene), "mixos:prefix/") and contains(read_file($scene), "/opt/mixos") then raise("RELOCATION_SCENE", $scene) end
  end
  $loop = ssh_mix("localhost", 'print(mixos_path("prefix"))', {mix_bin: $mix, connect_timeout: 3, timeout: 10})
  if $loop.ok then
    if trim($loop.stdout) != $scratch .. "/moved prefix" then raise("RELOCATION_SSH", "loopback resolved another prefix") end
    print("relocation: ssh_mix loopback passed")
  else
    print("SKIP ssh_mix loopback: " .. ($loop.stderr ?? $loop.error ?? "loopback SSH unavailable"))
  end
  -- Existing desktop helpers need nspawn, the nested compositor and an owned
  -- bus. Refuse to substitute a host desk when that isolated path is absent.
  $bin = $g.opts.bin ?? ($repo .. "/target/debug")
  if which("systemd-nspawn") == nil or which("weston") == nil or which("weston-simple-shm") == nil or not is_file($scratch .. "/moved prefix/bin/compd") then
    print("SKIP nested desk: systemd-nspawn, Weston fixtures or CBC-built compd unavailable")
  else
    $desk = run_argv([$mix, $repo .. "/tests/desktop/nested_smoke.mix", $scratch .. "/moved prefix/bin/compd", "--secs", "3", "--config-file", $repo .. "/tests/desktop/smoke-settings.json"], {env: $envmap, timeout: 300})
    if not $desk.ok then raise("RELOCATION_DESK", $desk.stderr .. $desk.stdout) end
    print($desk.stdout)
  end
  exit(0)
end

$scratch = "/tmp/mixos-relocation-" .. uuid()
mkdir($scratch .. "/first prefix/bin", {parents: true})
try
  $binary = realpath("/proc/self/exe")
  copy($binary, $scratch .. "/first prefix/bin/mix")
  chmod($scratch .. "/first prefix/bin/mix", 0o755)
  symlink("mix", $scratch .. "/first prefix/bin/noded")
  $bin = $g.opts.bin ?? ($repo .. "/target/debug")
  for $name in ["compd", "testkit-layer-client", "testkit-screenshot"]
    if is_file($bin .. "/" .. $name) then
      copy($bin .. "/" .. $name, $scratch .. "/first prefix/bin/" .. $name)
      chmod($scratch .. "/first prefix/bin/" .. $name, 0o755)
    end
  end
  mkdir($scratch .. "/first prefix/share", {parents: true})
  copy_tree($repo .. "/share/layout", $scratch .. "/first prefix/share/layout")
  copy_tree($repo .. "/share/scenes", $scratch .. "/first prefix/share/scenes")
  $manifest = load_data($repo .. "/share/layout/templates.mx")
  $packages = load_data($repo .. "/tools/release_packages.mx").packages
  $owners = concat($packages["mixos-desktop"], $packages["mixos-server"])
  $files = []
  for $entry in $manifest.files
    $rel = strip_prefix($entry.source, "../../")
    -- Match what the two actual packages ship. Unpackaged dnsd has an
    -- EnvironmentFile prefix path and correctly refuses whitespace there.
    if not contains($owners, split($rel, "/")[1]) then continue end
    $to = "templates/" .. $rel
    mkdir(dirname($scratch .. "/first prefix/share/layout/" .. $to), {parents: true})
    copy($repo .. "/" .. $rel, $scratch .. "/first prefix/share/layout/" .. $to)
    $entry.source = $to
    push($files, $entry)
  end
  write_file($scratch .. "/first prefix/share/layout/templates.mx", data_encode({schema: 1, files: $files}))
  rename($scratch .. "/first prefix", $scratch .. "/moved prefix")
  mkdir($scratch .. "/sysroot", {parents: true})
  -- Probe namespace support without touching either old root.
  $probe = run_argv(["unshare", "-rm", $binary, "-c", "print(1)"], {timeout: 10})
  if not $probe.ok then
    print("SKIP relocation isolation: worker cannot create user/mount namespace: " .. $probe.stderr)
    exit(0)
  end
  print(run_argv_must(["unshare", "-rm", $binary, $0, "--child", "--fixture-root", $scratch, "--bin", $g.opts.bin ?? ($repo .. "/target/debug")], {timeout: 1500}))
finally
  remove_dir($scratch)
end
