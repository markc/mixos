-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Installer/bootstrap contracts under the previous Mix, with no live writes.
$repo = dirname(dirname(realpath($0)))
$targets = require($repo .. "/tools/lib/layout_target.mix")
$source_paths = require($repo .. "/docs/_build/source_paths.mix")
$tmp = "/tmp/mixos-target-test-" .. uuid()
$prefix = $tmp .. "/target prefix"
$binary = $tmp .. "/staged mix"
$fixture = {prefix: $prefix, share: $prefix .. "/share", etc: $tmp .. "/default-config", var: $tmp .. "/default-state",
  cache: $tmp .. "/default-cache", run: $tmp .. "/default-runtime"}
fn need($ok, $message)
  if not $ok then raise("TARGET_TEST", $message) end
end
fn refuses($thunk)
  try $thunk(); return false catch $message return true end
end
mkdir($prefix, {parents: true})
try
  write_file($tmp .. "/defaults.mx", data_encode($fixture))
  $program = <<PROGRAM
#!/usr/bin/env mix
$g = getopt(args(), {tier: {arg: true}, prefix: {arg: true}, json: {}})
if not deep_eq($g.rest, ["layout", "defaults"]) or not $g.opts.json then raise("DEFAULTS_TEST", "bad query") end
$roots = load_data(@DOCUMENT@)
if $g.opts.prefix != nil then $roots.prefix = $g.opts.prefix end
print(json_encode($roots))
PROGRAM
  write_file($binary, replace($program, "@DOCUMENT@", json_encode($tmp .. "/defaults.mx")))
  chmod($binary, 0o755)
  $first = $targets.resolve({}, $binary, "", {})
  need(deep_eq($first, $fixture), "default target came from the running interpreter")
  write_file($prefix .. "/layout.mx", data_encode({etc: $tmp .. "/file-config", cache: $tmp .. "/file-cache"}))
  $next = $targets.resolve({prefix: $prefix, etc: $tmp .. "/cli-config"}, $binary, "", {})
  need($next.prefix == $prefix and $next.etc == $tmp .. "/cli-config" and
    $next.cache == $tmp .. "/file-cache" and $next.var == $fixture.var,
    "per-root CLI > target layout > staged defaults precedence differs")
  remove($prefix .. "/layout.mx")
  $saved = $targets.resolve({"record-only": true}, nil, "", $next)
  need(deep_eq($saved, $next), "receipt-only rollback required an installed binary")
  need(refuses(fn() = $targets.resolve({prefix: $prefix, "record-only": true}, $binary, "", {})),
    "incomplete rollback layout queried a binary")
  need(refuses(fn() = $targets.resolve({}, nil, "", {})), "unidentified target used the interpreter prefix")
  need(refuses(fn() = $targets.checked({prefix: $prefix, other: "/bad"})), "unknown target root was accepted")
  need(refuses(fn() = $targets.checked({prefix: $prefix .. "/../escape"})), "escaping target root was accepted")
  write_file($prefix .. "/layout.mx", "unknown: '/bad'\n")
  need(refuses(fn() = $targets.resolve({prefix: $prefix}, $binary, "", {})), "unknown layout key was ignored")
  remove($prefix .. "/layout.mx")
  symlink($tmp .. "/defaults.mx", $prefix .. "/layout.mx")
  need(refuses(fn() = $targets.resolve({prefix: $prefix}, $binary, "", {})), "symlinked target layout was followed")
  remove($prefix .. "/layout.mx")
  $sysroot = $tmp .. "/sysroot"
  mkdir($sysroot .. $prefix, {parents: true})
  write_file($sysroot .. $prefix .. "/layout.mx", data_encode(delete($fixture, "prefix")))
  need(deep_eq($targets.resolve({prefix: $prefix}, nil, $sysroot, {}), $fixture), "staging root was mistaken for a prefix")
  need($source_paths.resolve($repo, "mixos:prefix/share/x") == $repo .. "/share/x" and
    $source_paths.resolve($repo, "mixos:share/x") == $repo .. "/share/x", "docs resolved outside the checkout")
  need(refuses(fn() = $source_paths.resolve($repo, "mixos:prefix/../outside")), "docs accepted a source escape")
  $installed_share = env("MIXOS_SHARE", env("MIXOS", dirname(dirname(realpath("/proc/self/exe")))) .. "/share")
  if has_builtin("mixos_path") then $installed_share = mixos_path("share") end
  need($source_paths.installed("mixos:share/assets/x") == $installed_share .. "/assets/x",
    "an installed asset did not resolve against the installed share root")
  need(refuses(fn() = $source_paths.installed("mixos:share/../../outside")), "an installed asset escaped its root")
  for $name in ["config", "state", "runtime", "bin", "lib"]
    need(refuses(fn() = $source_paths.resolve($repo, "mixos:" .. $name .. "/x")), "docs accepted an unknown root")
  end
  $copy = $tmp .. "/saved-copy"
  mkdir($copy)
  $saved_text = json_encode({file: $prefix .. "/share/example"})
  write_file($copy .. "/saved.json", $saved_text)
  write_file($tmp .. "/old-layout.mx", data_encode(delete($fixture, "prefix")))
  $migration = run_argv([realpath("/proc/self/exe"), $repo .. "/tools/layout_migrate_saved.mix",
    "--source", $copy, "--from-prefix", $prefix, "--from-layout", $tmp .. "/old-layout.mx"], {timeout: 30, stderr: "stdout"})
  need($migration.ok and contains($migration.stdout, "would migrate") and read_file($copy .. "/saved.json") == $saved_text and
    not is_file($copy .. "/saved.json.layout-original"), "N-1 migration dry-run changed its offline input")
  -- Left and right boundaries: these embedded/sibling roots must stay intact.
  $negative = ["/srv/backup/opt/mixos/share/x", "/srv/backup/etc/mixos/x", "/srv/backup/var/lib/mixos/x",
    "/opt/mixos-old/share/x", "/etc/mixos-old/x", "/usr/bin:/opt/mixos/bin:/bin"]
  $public_old = {share: "/opt/mixos/share", etc: "/etc/mixos", var: "/var/lib/mixos", run: "/run/mixos", cache: "/var/cache/mixos"}
  write_file($tmp .. "/public-layout.mx", data_encode($public_old))
  $boundary_copy = $tmp .. "/boundary-copy"
  mkdir($boundary_copy)
  $before = join($negative, "\n") .. "\n" .. '"/opt/mixos/share/x" =/etc/mixos/x =/var/lib/mixos/x (/run/mixos/x [/var/cache/mixos/x ,/opt/mixos/bin/mix' .. "\n/opt/mixos\n"
  $boundary_file = $boundary_copy .. "/paths.mix"
  write_file($boundary_file, $before)
  $argv = [realpath("/proc/self/exe"), $repo .. "/tools/layout_migrate_saved.mix", "--source", $boundary_copy,
    "--from-prefix", "/opt/mixos", "--from-layout", $tmp .. "/public-layout.mx"]
  -- Model a kill after the backup write and before the rename.
  write_file($boundary_file .. ".layout-original", $before)
  write_file($boundary_file .. ".layout-new", "interrupted\n")
  $preview = run_argv($argv, {stderr: "stdout"})
  need($preview.ok and read_file($boundary_file) == $before and read_file($boundary_file .. ".layout-new") == "interrupted\n", "resumable dry-run wrote files")
  $resumed = run_argv(concat($argv, ["--apply"]), {stderr: "stdout"})
  need($resumed.ok, "interrupted migration could not resume: " .. $resumed.stdout)
  $after = read_file($boundary_file)
  for $path in $negative need(contains($after, $path), "migration corrupted embedded or sibling root " .. $path) end
  for $path in ["mixos:share/x", "mixos:etc/x", "mixos:var/x", "mixos:run/x", "mixos:cache/x", "mixos:prefix/bin/mix", "mixos:prefix/"]
    need(contains($after, $path), "migration missed a token boundary: " .. $path)
  end
  need(read_file($boundary_file .. ".layout-original") == $before and not exists($boundary_file .. ".layout-new"), "migration lost its original or left a temporary")
  $again = run_argv(concat($argv, ["--apply"]), {stderr: "stdout"})
  need($again.ok and contains($again.stdout, "0 files"), "migration was not idempotent")
  write_file($boundary_file, $before .. "drift\n")
  $drift = run_argv(concat($argv, ["--apply"]), {stderr: "stdout"})
  need(not $drift.ok and contains($drift.stdout, "MIGRATE_BACKUP"), "migration overwrote a drifted original")
  -- Journal old host-entry states in an isolated host-shaped sysroot.
  $writer = require($repo .. "/share/layout/files.mix")
  $journal = require($repo .. "/tools/lib/gold_entrance.mix")
  $entry_root = $tmp .. "/entrance-prefix"
  $entry_stage = $entry_root .. "/.layout-root"
  mkdir($entry_stage .. "/usr/local/bin", {parents: true})
  mkdir($entry_stage .. "/etc")
  symlink("/previous/tree/bin/mix", $entry_stage .. "/usr/local/bin/mix")
  write_file($entry_stage .. "/etc/shells", "/usr/bin/previous-shell\n")
  chmod($entry_stage .. "/etc/shells", 0o640)
  $entry_roots = $fixture
  $entry_roots.prefix = $entry_root
  $entry_plan = $writer.entrance_plan($entry_roots, $entry_stage, false, true)
  $backup = $tmp .. "/entrance-backup"
  $entry_record = $journal.capture($entry_plan, $entry_root, false, $backup)
  need(read_file($backup .. "/.entrance/shells") == "/usr/bin/previous-shell\n" and
    stat($backup .. "/.entrance/shells").perm == 0o640 and read_link($backup .. "/.entrance/link") == "/previous/tree/bin/mix", "entrance backups lost bytes, mode or old link")
  $fresh_plan = $journal.prepare_apply($entry_record, $entry_root, false)
  $entry_record.started = true
  $writer.apply($fresh_plan, false)
  remove($entry_stage .. "/usr/local/bin/mix")
  symlink("/foreign/tree/bin/mix", $entry_stage .. "/usr/local/bin/mix")
  need(refuses(fn() = $journal.restore($entry_record, $entry_root, false, $backup, "receipt-1234")) and
    read_file($entry_stage .. "/etc/shells") == $entry_plan[1].text, "link drift partially restored shells")
  remove($entry_stage .. "/usr/local/bin/mix")
  symlink($entry_root .. "/bin/mix", $entry_stage .. "/usr/local/bin/mix")
  -- Interrupted cp -a before rename: both names are receipt-scoped debris.
  write_file($entry_stage .. "/etc/shells.rollback-receipt-1234", "partial copy\n")
  symlink($tmp .. "/outside-keep", $entry_stage .. "/usr/local/bin/mix.rollback-receipt-1234")
  write_file($tmp .. "/outside-keep", "keep\n")
  $journal.restore($entry_record, $entry_root, false, $backup, "receipt-1234")
  $journal.assert_restored($entry_record, $entry_root, false)
  $journal.restore($entry_record, $entry_root, false, $backup, "receipt-1234")
  need(read_link($entry_stage .. "/usr/local/bin/mix") == "/previous/tree/bin/mix" and
    read_file($entry_stage .. "/etc/shells") == "/usr/bin/previous-shell\n" and stat($entry_stage .. "/etc/shells").perm == 0o640, "entrance recovery did not restore old states")
  need(read_file($tmp .. "/outside-keep") == "keep\n" and not exists($entry_stage .. "/etc/shells.rollback-receipt-1234") and
    not exists($entry_stage .. "/usr/local/bin/mix.rollback-receipt-1234", {follow_symlinks: false}), "restore followed or retained stale copy debris")
  -- Recompose from capture-time and apply-time reads, not the stale plan.
  $stale_plan = $writer.entrance_plan($entry_roots, $entry_stage, false, true)
  write_file($entry_stage .. "/etc/shells", "/usr/bin/previous-shell\n/usr/bin/before-capture\n")
  $fresh_record = $journal.capture($stale_plan, $entry_root, false, $tmp .. "/fresh-backup")
  $fresh_plan = $journal.prepare_apply($fresh_record, $entry_root, false)
  need(contains($fresh_plan[1].text, "/usr/bin/before-capture\n") and hash_sha256($fresh_plan[1].text) == $fresh_record.files[1].after.sha256,
    "freshly composed append disagrees with its receipt")
  write_file($entry_stage .. "/etc/shells", read_file($entry_stage .. "/etc/shells") .. "/usr/bin/after-capture\n")
  need(refuses(fn() = $journal.prepare_apply($fresh_record, $entry_root, false)), "late shells edit was not detected")
  $journal.restore($fresh_record, $entry_root, false, $tmp .. "/fresh-backup", "receipt-5678")
  need(contains(read_file($entry_stage .. "/etc/shells"), "/usr/bin/after-capture\n"), "unstarted entrance undo lost the concurrent edit")
  $bad_entry = $entry_record
  $bad_entry.files[0].name = "../../outside"
  need(refuses(fn() = $journal.restore($bad_entry, $entry_root, false, $backup, "receipt-1234")), "receipt supplied an arbitrary entrance path")
  $bad_entry = $entry_record
  $bad_entry.sysroot = "host"
  need(refuses(fn() = $journal.restore($bad_entry, $entry_root, false, $backup, "receipt-1234")), "fixture receipt redirected entrance restore to the host")
  print("PASS entrance backups, late-state guard, fresh shells append, restore debris cleanup, idempotent recovery and fixed receipt targets")
  print("PASS target defaults, per-root precedence, receipt-only rollback, sysroot, strict layout, docs source paths and offline migration dry-run under N-1 Mix")
finally
  remove_dir($tmp)
end
