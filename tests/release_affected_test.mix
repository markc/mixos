-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Canned metadata: no cargo invocation or compiler required.
$a = require("../tools/lib/release_affected.mix")
$fixture = json_parse('{"workspace_root":"/fixture","workspace_members":["a","b","c","d","e","f"],"packages":[{"id":"a","name":"a","manifest_path":"/fixture/libs/a/Cargo.toml"},{"id":"b","name":"b","manifest_path":"/fixture/libs/a/crates/b/Cargo.toml"},{"id":"c","name":"c","manifest_path":"/fixture/libs/c/Cargo.toml"},{"id":"d","name":"d","manifest_path":"/fixture/libs/d/Cargo.toml"},{"id":"e","name":"editd","manifest_path":"/fixture/services/editd/Cargo.toml"},{"id":"f","name":"f","manifest_path":"/fixture/libs/f/Cargo.toml"},{"id":"external","name":"external","manifest_path":"/cache/external/Cargo.toml"}],"resolve":{"nodes":[{"id":"a","dependencies":[]},{"id":"b","dependencies":[]},{"id":"c","dependencies":["b"],"deps":[{"pkg":"b","dep_kinds":[{"kind":"dev","target":null}]}]},{"id":"d","dependencies":["c"],"deps":[{"pkg":"c","dep_kinds":[{"kind":"build","target":null}]}]},{"id":"e","dependencies":[]},{"id":"f","dependencies":["a"]},{"id":"external","dependencies":[]}]}}')

fn check($ok, $label)
  if not $ok then raise("TEST", $label) end
  print("PASS " .. $label)
end

$graph = $fixture
$packages = $fixture
$packages.resolve = nil  -- cargo metadata --no-deps has no resolve graph.
$packages.packages = filter($fixture.packages, fn($p) = contains($fixture.workspace_members, $p.id))

check($a.owner("libs/a/crates/b/src/lib.rs", $fixture) == "b", "longest package directory wins")
check($a.owner("libs/ab/src/lib.rs", $fixture) == nil, "directory prefix requires slash boundary")
check($a.owner("libs/a/deleted.rs", $fixture) == "a", "deleted file maps without filesystem access")
$narrow = $a.select_affected(["libs/a/crates/b/src/lib.rs"], $packages, $graph)
check(not $narrow.full and deep_eq($narrow.crates, ["b", "c", "d"]), "synthetic narrow diff includes transitive dev and build dependants; exactly half stays narrow")
$normal = $a.select_affected(["libs/a/src/lib.rs"], $packages, $graph)
check(not $normal.full and deep_eq($normal.crates, ["a", "f"]), "normal reverse edge and unaffected members")
$empty = $a.select_affected([], $packages, $graph)
check(not $empty.full and len($empty.crates) == 0, "empty diff skips test")
$large = $a.select_affected(["libs/a/src/lib.rs", "libs/a/crates/b/src/lib.rs"], $packages, $graph)
check($large.full and $large.reason == "more than half the workspace affected", "more than half forces full")
for $file in ["rust-toolchain", "rust-toolchain.toml", ".cargo/config.toml", "vendor/egui-wgpu/src/lib.rs", "libs/a/layers.conf.mix"]
  check($a.full_reason($file) != "" and $a.select_affected([$file], $packages, $graph).full, "force full: " .. $file)
end
check(not $a.select_affected(["README.md"], $packages, $graph).full, "README skips crates")
check($a.select_affected(["libs/removed/src/lib.rs"], $packages, $graph).full, "removed package forces full")
$result = $a.select_affected(["libs/a/Cargo.toml"], $packages, $graph)
check(not $result.full and deep_eq($result.crates, ["a", "f"]), "member manifest selects a and f")
$result = $a.select_affected(["services/editd/src/lib.rs"], $packages, $graph)
check(not $result.full and deep_eq($result.crates, ["editd"]), "editd selected by package name")

for $file in ["libs/a/testdata/input.bin", "libs/a/snapshots/result.snap", "libs/a/assets/icon.svg", "libs/a/helper.mix", "libs/a/options.conf.mix", "libs/a/other.rs"]
  $result = $a.select_affected([$file], $packages, $graph)
  check($result.full and $result.reason == "non-source package input: " .. $file, "non-source forces full with reason: " .. $file)
end
for $file in ["libs/a/tests/integration.rs", "libs/a/tests/render_test.mix", "libs/a/tests/fixtures/train.mix", "libs/a/benches/speed.rs", "libs/a/examples/demo.rs", "libs/a/build.rs"]
  $result = $a.select_affected([$file], $packages, $graph)
  check(not $result.full and deep_eq($result.crates, ["a", "f"]), "allowed input stays narrow: " .. $file)
end

-- A root package owns only paths not claimed by a deeper workspace member.
-- The full resolve graph connects it to f through two non-member packages.
$root_packages = $packages
$root_packages.workspace_members = push($root_packages.workspace_members, "root")
$root_packages.packages = push($root_packages.packages, {id: "root", name: "root", manifest_path: "/fixture/Cargo.toml"})
$root_graph = $graph
$root_graph.workspace_members = $root_packages.workspace_members
$root_graph.packages = $root_packages.packages
$root_graph.packages = push($root_graph.packages, $graph.packages[6])
$root_graph.packages = push($root_graph.packages, {id: "bridge", name: "bridge", manifest_path: "/cache/bridge/Cargo.toml"})
$root_graph.resolve.nodes = push($root_graph.resolve.nodes, {id: "root", dependencies: []})
$root_graph.resolve.nodes = push($root_graph.resolve.nodes, {id: "bridge", dependencies: ["root"]})
-- Existing external node reverses bridge, and f reverses external.
$root_graph.resolve.nodes[6].dependencies = ["bridge"]
$root_graph.resolve.nodes[5].dependencies = ["external"]
check($a.owner("src/lib.rs", $root_packages) == "root", "root package owns root sources")
check($a.owner("libs/a/src/lib.rs", $root_packages) == "a", "nested member wins over root package")
$root_result = $a.select_affected(["src/lib.rs"], $root_packages, $root_graph)
check(not $root_result.full and deep_eq($root_result.crates, ["f", "root"]), "reverse closure traverses non-member chain from root package")
for $file in ["docs/manual.html", "README.md", "libs/a/README.md", ".github/workflows/check.yml", "tests/check.mix", "tools/helper.mix", "tools/lib/helper.mix"]
  $result = $a.select_affected([$file], $packages, $graph)
  check(not $result.full and len($result.crates) == 0, "no crate: " .. $file)
end
$result = $a.select_affected(["libs/a/i18n/en/a.ftl"], $packages, $graph)
check(not $result.full and deep_eq($result.crates, ["a", "f"]), "embedded translation selects owner and dependants")
$ctx = {root_full: false, locked: []}
$result = $a.select_affected(["Cargo.lock", "libs/a/Cargo.toml"], $packages, $graph, $ctx)
check(not $result.full and deep_eq($result.crates, ["a", "f"]), "lockfile plus member manifest")
$result = $a.select_affected(["Cargo.lock"], $packages, $graph, $ctx)
check(not $result.full and len($result.crates) == 0, "unchanged lock versions select nothing")
$ctx.locked = ["external"]
$lock_graph = $graph
$lock_graph.resolve.nodes[0].dependencies = ["external"]
$result = $a.select_affected(["Cargo.lock"], $packages, $lock_graph, $ctx)
check(not $result.full and deep_eq($result.crates, ["a", "f"]), "external version selects reverse workspace closure")
$ctx.root_full = true
check($a.select_affected(["Cargo.toml"], $packages, $graph, $ctx).full, "workspace or profile change is full")
$ctx.root_full = false
check(not $a.select_affected(["Cargo.toml"], $packages, $graph, $ctx).full, "other root manifest sections stay narrow")
check($a.select_affected(["Cargo.lock"], $packages, $graph).full, "missing lock context fails closed")
check(deep_eq($a.lock_pairs({package: [{name: "x", version: "1"}, {name: "x", version: "2"}]}), {x: ["1", "2"]}), "multiple locked versions retained")
check(deep_eq($a.mix_names(["tools/lib/release_affected.mix", "tests/check_test.mix"], $packages, ["a"]), ["libs/a/", "release_affected_test.mix", "tests/check_test.mix"]), "Mix scripts select crate directories and matching tests")
for $name in ["offscreen", "latency", "relocation", "layout-templates"]
  check(not $a.covered($name, ["README.md"]), "unrelated stage skips: " .. $name)
end
check($a.covered("offscreen", ["vendor/egui-wgpu/src/lib.rs"]), "offscreen coverage")
check($a.covered("latency", ["services/editd/src/lib.rs"]), "latency coverage")
check($a.covered("relocation", ["libs/paths/src/lib.rs"]), "relocation coverage")
check($a.covered("layout-templates", ["services/editd/units/editd.service"]), "unit template coverage")

-- Exercise the actual gate branches without cargo or the gate entry point.
$gate = read_file(dirname(dirname(realpath($0))) .. "/tools/release_gate.mix")
$start = "  if $affected == nil or $affected.full then\n"
$test_branch = $start .. split(split($gate, $start)[1], "  if $affected == nil or $affected.full or $selector.covered(\"offscreen\"")[0]
$special = "  if $affected == nil or $affected.full or $selector.covered(\"offscreen\"" ..
  split(split($gate, "  if $affected == nil or $affected.full or $selector.covered(\"offscreen\"")[1], "  $mix =")[0]
$tmp = "/tmp/release-affected-branches-" .. uuid() .. ".mix"
try
  for $selection in [nil, {full: true, crates: []}, {full: false, crates: ["a"]}, {full: false, crates: []}]
    $setup = "$selector = require(" .. json_encode(dirname(dirname(realpath($0))) .. "/tools/lib/release_affected.mix") .. ")\n" ..
      "$files = [\"README.md\"]\n$affected = json_parse(" .. json_encode(json_encode($selection)) .. ")\n" ..
      "fn stage($name, $argv, $timeout) print($name .. \":\" .. json_encode($argv)) end\n"
    write_file($tmp, $setup .. $test_branch .. $special)
    $r = run_argv([which("mix"), $tmp])
    check($r.ok, "gate branch executes: " .. json_encode($selection))
    if $selection == nil or $selection.full then
      check(contains($r.stdout, "--workspace") and contains($r.stdout, "offscreen:") and contains($r.stdout, "latency:"), "full stages preserved")
    else
      check(not contains($r.stdout, "offscreen:") and not contains($r.stdout, "latency:"), "uncovered expensive stages skip")
      if len($selection.crates) == 0 then
        check(contains($r.stdout, "SKIP test (no crate affected)"), "empty gate test selection skips")
      else
        check(contains($r.stdout, 'test:["cargo","test","--locked","--no-fail-fast","-p","a"]'), "gate uses exact narrowed cargo arguments")
      end
    end
  end
finally
  run_argv_must(["rm", "--", $tmp])
end
