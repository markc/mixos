-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Deterministic /proc fixtures and opt-in live checks using owned sleepers.
$o = require("../tools/lib/release_orphans.mix")
$tmp = "/tmp/release-orphans-test-" .. uuid()
mkdir($tmp .. "/checkout/target/debug", {parents: true})
mkdir($tmp .. "/other/target/debug", {parents: true})
write_file($tmp .. "/checkout/target/debug/mix", "")
write_file($tmp .. "/other/target/debug/mix", "")

fn process($id, $ppid, $start, $exe)
  $base = $tmp .. "/proc/" .. $id
  mkdir($base, {parents: true})
  -- Embedded ')' and spaces exercise the real stat comm parsing rule.
  $fields = ["S", to_string($ppid), "10", "10"]
  for $i = 4 to 18 push($fields, "0") end
  push($fields, to_string($start))
  write_file($base .. "/stat", $id .. " (test ) process) " .. join($fields, " "))
  run_argv_must(["ln", "-s", $exe, $base .. "/exe"])
end

fn check($ok, $label)
  if not $ok then raise("TEST", $label) end
  print("PASS " .. $label)
end

$live = []
fn orphan($exe)
  $mix = env("MIXOS_TEST_MIX", "")
  if $mix == "" then $mix = realpath("/proc/self/exe") end
  $source = "print(spawn(" .. data_encode([$exe, "60"]) .. "))"
  $id = to_number(trim(run_argv_must([$mix, "-c", $source])))
  $deadline = monotonic() + 5
  loop
    $item = $o.identity("/proc", $id, dirname(dirname($exe)))
    if $item != nil then return $item end
    if monotonic() >= $deadline then
      if realpath("/proc/" .. $id .. "/exe") == $exe then kill($id, 9) end
      raise("TEST", "fixture did not become an orphan (run live checks without a subreaper)")
    end
    sleep(0.01)
  end
end

try
  $target = $tmp .. "/checkout/target"
  process(101, 1, 11, $target .. "/debug/mix")
  process(102, 2, 12, $target .. "/debug/mix")
  process(103, 1, 13, $tmp .. "/other/target/debug/mix")
  process(104, 1, 14, $tmp .. "/missing")
  run_argv_must(["ln", "-s", $target, $tmp .. "/target-link"])
  $before = $o.snapshot($tmp .. "/target-link", $tmp .. "/proc")
  check(len($before) == 1 and $before[0].pid == 101 and $before[0].start == "11", "only own checkout's canonical orphan is counted")
  process(105, 1, 15, $target .. "/debug/mix")
  $after = $o.snapshot($target, $tmp .. "/proc")
  $new = $o.added($before, $after)
  check(len($new) == 1 and $new[0].pid == 105, "existing orphan is excluded")
  check(len($o.added($after, $after)) == 0, "unchanged stage has no new orphans")
  check(len($o.added([{pid: 105, start: "old"}], $new)) == 1, "PID reuse uses kernel start time")
  check(len($o.snapshot($tmp .. "/absent", $tmp .. "/proc")) == 0, "target absent before build is empty")
  -- The live check runs on CBC, whose test orphans are adopted by PID 1.
  -- Some local agent supervisors are subreapers, so opt in explicitly.
  if env("MIXOS_RELEASE_ORPHAN_LIVE", "") == "1" then
    -- Exercise actual reporting/cleanup too. The only signalled PIDs are
    -- dedicated sleeper copies created by this test below its private root.
    $other = $tmp .. "/other/target"
    run_argv_must(["cp", which("sleep"), $target .. "/debug/sleeper"])
    run_argv_must(["cp", which("sleep"), $other .. "/debug/sleeper"])
    $existing = orphan($target .. "/debug/sleeper")
    push($live, $existing)
    $outside = orphan($other .. "/debug/sleeper")
    push($live, $outside)
    $before = $o.snapshot($target)
    $leaked = orphan($target .. "/debug/sleeper")
    push($live, $leaked)
    $failed = false
    try
      $o.finish("fixture", $target, $before)
    catch $message, $error
      $failed = $error.code == "RELEASE_GATE" and contains($message, "fixture leaked 1 orphan processes")
    end
    check($failed, "a leaking stage fails with its orphan count")
    $deadline = monotonic() + 5
    while $o.same_orphan($leaked, $target) and monotonic() < $deadline sleep(0.01) end
    check(not $o.same_orphan($leaked, $target), "new orphan was killed")
    check($o.same_orphan($existing, $target), "existing orphan was not killed")
    check($o.same_orphan($outside, $other), "other checkout was not killed")
  end
finally
  for $item in $live
    if $o.same_orphan($item, dirname(dirname($item.exe))) then kill($item.pid, 9) end
  end
  remove_dir($tmp)
end
