-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Copyright 2026 Mark Constable <mc@mixos.dev>
-- verb_registry_families_test: tools/verb_registry.mix in its schema 3 and
-- family modes, run as a child process against throwaway trees. Every case
-- owns a directory under one temp root, removed at the end. Nothing starts a
-- session, a broker or an application. The gate binary is MIXOS_TEST_MIX when
-- set, else /opt/mixos/bin/mix. The source cases need that native mix to
-- answer `mix lint --json` with parsed handler metadata (schema 2); the fake
-- lint cases stand in for it to prove each fail-closed path. The
-- unreadable-directory cases lock a directory to mode 0o000 for their own
-- case only, restore it in a finally, and are skipped where the process can
-- still list it (root). A skip is printed as SKIP and never counted as a pass.
-- Those cases run only as a non-root user, so a root run leaves them
-- unexercised, by design.
-- Run from the checkout root: mix tests/verb_registry_families_test.mix

$tool = realpath(dirname(realpath($0)) .. "/../tools/verb_registry.mix")
$real = realpath(dirname(realpath($0)) .. "/../docs/docs/spec/bus/verbs.conf.mix")
$mix = env("MIXOS_TEST_MIX") ?? ""
if $mix == "" then $mix = "/opt/mixos/bin/mix" end
$tmp = "/var/tmp/verb-registry-families-test." .. uuid()
mkdir($tmp, {parents: true})
$results = []
$skips = []

fn check($name, $ok)
  push($results, {name: $name, ok: $ok})
  print((if $ok then "PASS " else "FAIL " end) .. $name)
end

fn gate($extra)
  $argv = [$mix, $tool]
  for each $x in $extra
    push($argv, $x)
  end
  return run_argv($argv, {timeout: 60, stderr: "stdout"})
end

-- The gate with its lint binary set to $bin (MIXOS_TEST_MIX in the child).
fn gate_env($extra, $bin)
  $argv = [$mix, $tool]
  for each $x in $extra
    push($argv, $x)
  end
  return run_argv($argv, {timeout: 60, stderr: "stdout", env: {MIXOS_TEST_MIX: $bin}})
end

fn expect($name, $extra, $pass)
  $r = gate($extra)
  $ok = ($r.exit_code == 0) == $pass
  check($name, $ok)
  if not $ok then
    print($r.stdout)
  end
end

-- As expect, with a lint binary of our own and, when given, a text the
-- gate's output must contain.
fn expect_fake($name, $extra, $bin, $pass, $needle)
  $r = gate_env($extra, $bin)
  $ok = ($r.exit_code == 0) == $pass
  if $needle != "" then
    $ok = $ok and contains($r.stdout, $needle)
  end
  check($name, $ok)
  if not $ok then
    print($r.stdout)
  end
end

fn put($path, $text)
  mkdir(dirname($path), {parents: true})
  write_file($path, $text)
  return $path
end

-- Whether ls can list dir. A directory at mode 0o000 is listable only by root.
fn readable($dir)
  $ok = true
  try
    ls($dir)
  catch $m
    $ok = false
  end
  return $ok
end

-- A case that is not run, with the reason, so it is never counted as a pass.
fn note_skip($name, $why)
  push($skips, $name)
  print("SKIP " .. $name .. ": " .. $why)
end

-- An unreadable-directory case: dir is locked to 0o000 while the check runs and
-- restored after, so the cleanup can remove it. A dir that is still listable
-- (root) is skipped, not passed.
fn locked_case($name, $dir, $extra)
  try
    chmod($dir, 0o000)
    if readable($dir) then
      note_skip($name, "still readable at mode 000 (root)")
    else
      expect($name, $extra, false)
    end
  finally
    chmod($dir, 0o700)
  end
end

fn case_dir($name)
  $d = $tmp .. "/" .. $name
  mkdir($d, {parents: true})
  return $d
end

-- Verb lines, canonical: every line but the last ends with a comma.
$a = "    {name:\"demo.ping\", owner:\"demo\", version:\"0.1.0\", status:\"accepted\", class:\"query\"},"
$b = "    {name:\"demo.open\", owner:\"demo\", version:\"0.1.0\", status:\"accepted\", class:\"intent\"}"
$verbs = $a .. "\n" .. $b
-- The same prefix, demo, with a verb of another owner.
$verbs_mixed = $a .. "\n" .. $b .. ",\n    {name:\"demo.close\", owner:\"other\", version:\"0.1.0\", status:\"accepted\", class:\"input\"}"

fn fam($pattern, $owner, $members, $class)
  return "    {pattern:\"" .. $pattern .. "\", owner:\"" .. $owner .. "\", members:" .. $members .. ", version:\"0.1.0\", status:\"accepted\", class:\"" .. $class .. "\"}"
end

-- The six instance families, all owned by fakeapp (the neutral fixture owner).
fn six()
  $lines = []
  push($lines, fam("<app>.call", "fakeapp", "\"instances\"", "intent"))
  push($lines, fam("<app>.commands", "fakeapp", "\"instances\"", "query"))
  push($lines, fam("<app>.execute", "fakeapp", "\"instances\"", "intent"))
  push($lines, fam("<app>.inspect", "fakeapp", "\"instances\"", "query"))
  push($lines, fam("<app>.screenshot", "fakeapp", "\"instances\"", "query"))
  push($lines, fam("<app>.status", "fakeapp", "\"instances\"", "query"))
  return join($lines, ",\n")
end

fn reg3($verbs_text, $families_text)
  return "-- test\n{\n  schema: 3,\n  verbs: [\n" .. $verbs_text .. "\n  ],\n  families: [\n" .. $families_text .. "\n  ]\n}\n"
end

fn reg2($verbs_text)
  return "-- test\n{\n  schema: 2,\n  verbs: [\n" .. $verbs_text .. "\n  ]\n}\n"
end

-- A declaration handler as the instance code writes it, and the six of them.
$suffixes = ["call", "commands", "execute", "inspect", "screenshot", "status"]

fn handler($suffix)
  return "on @." .. $suffix .. " desc \"fixture\"\n  reply(0, \"ok\")\nend\n"
end

fn handlers_for($list)
  $text = ""
  for each $s in $list
    $text = $text .. handler($s)
  end
  return $text
end

fn without($items, $skip)
  $out = []
  for each $x in $items
    if $x != $skip then push($out, $x) end
  end
  return $out
end

fn full_app()
  return "-- fixture\n" .. handlers_for($suffixes)
end

-- The six written as concrete handlers: no @, so not an instance prefix.
fn concrete_app()
  $text = "-- fixture\n"
  for each $s in $suffixes
    $text = $text .. "on fakeapp." .. $s .. " desc \"fixture\"\n  reply(0, \"ok\")\nend\n"
  end
  return $text
end

-- Lint answers for the fake binary. FILE stands for the file it is given.
$PAY_OK = '{"schema_version":2,"tool":"mix lint","files":["FILE"],"handlers":[{"command":"@.call","file":"FILE","line":2}],"diagnostics":[],"summary":{"errors":0,"warnings":0}}'
$PAY_BAD_LINE = replace($PAY_OK, "\"line\":2", "\"line\":0")
$PAY_EMPTY_CMD = replace($PAY_OK, "\"command\":\"@.call\"", "\"command\":\"\"")
$PAY_ERRORS = replace($PAY_OK, "\"errors\":0", "\"errors\":1")
$PAY_WRONG_FILE = replace($PAY_OK, "\"files\":[\"FILE\"]", "\"files\":[\"/elsewhere/other.mix\"]")
$PAY_OLD_SCHEMA = replace($PAY_OK, "\"schema_version\":2", "\"schema_version\":1")
$PAY_NO_HANDLERS = '{"schema_version":1,"tool":"mix lint","files":["FILE"],"diagnostics":[],"summary":{"errors":0,"warnings":0}}'
$PAY_TRUNCATED = '{"schema_version":2,"tool":"mix lint","files":["FILE"],"handlers":[{"command":"@.call"'

-- A fake native lint: a Mix script under its own shebang. It prints payload
-- with FILE replaced by the file it is given (its last argument) and exits
-- with status. It answers `mix lint` only.
fn fake_lint($dir, $payload, $status)
  $pay = put($dir .. "/payload.json", $payload)
  $p = $dir .. "/fake-lint"
  $body = "#!" .. $mix .. "\n"
  $body = $body .. '$a = args()' .. "\n"
  $body = $body .. 'print(replace(read_file("' .. $pay .. '"), "FILE", $a[len($a) - 1]))' .. "\n"
  $body = $body .. 'exit(' .. to_string($status) .. ')' .. "\n"
  put($p, $body)
  run_argv_must(["chmod", "755", $p], {timeout: 30})
  return $p
end

-- One fake-lint case: a registry with the call family and a source that
-- declares it. The fake's answer decides the result.
fn fake_case($name, $payload, $status, $pass, $needle)
  $c = case_dir("fake-" .. $name)
  $reg = put($c .. "/registry.conf.mix", reg3($verbs, fam("<app>.call", "fakeapp", "\"instances\"", "intent")))
  put($c .. "/apps/fakeapp/scripts/fakeapp.mix", "-- fixture\n" .. handler("call"))
  $bin = fake_lint($c, $payload, $status)
  expect_fake("fake lint: " .. $name, [$reg, "--source", $c], $bin, $pass, $needle)
end

$fatal = ""
try
  -- The real registry and the legacy shape.
  expect("legacy: the schema 2 fixture passes", [put(case_dir("legacy") .. "/registry.conf.mix", reg2($verbs))], true)
  expect("legacy: the real registry, data only", [$real], true)
  expect("legacy: the repository registry with its sources", [], true)
  expect("schema 1 is refused", [put(case_dir("schema1") .. "/registry.conf.mix", "-- test\n{\n  schema: 1,\n  verbs: [\n" .. $verbs .. "\n  ]\n}\n")], false)
  $r = gate([put(case_dir("malformed") .. "/registry.conf.mix", "-- test\n{\n  schema: 3,\n  verbs: [\n")])
  check("malformed strict data: fails with a diagnostic and no source text", $r.exit_code == 1 and contains($r.stdout, "cannot read registry as strict data") and (not contains($r.stdout, "schema: 3")))

  -- The real registry's bridged families and their classes. The gate does not
  -- infer a class, so this holds them to the decision: screenshot is intent
  -- because its focus option changes what another caller sees.
  $real_reg = load_data($real)
  $want_classes = {}
  $want_classes["call"] = "intent"
  $want_classes["commands"] = "query"
  $want_classes["execute"] = "intent"
  $want_classes["inspect"] = "query"
  $want_classes["screenshot"] = "intent"
  $want_classes["status"] = "query"
  $got_classes = {}
  for each $f in $real_reg.families
    if $f.owner == "bridged" then
      $got_classes[strip_prefix($f.pattern, "<app>.")] = $f.class
    end
  end
  $classes_ok = len(keys($got_classes)) == 6
  for each $k in keys($want_classes)
    if not has_key($got_classes, $k) or $got_classes[$k] != $want_classes[$k] then
      $classes_ok = false
    end
  end
  check("real registry: bridged call, execute, screenshot are intent; commands, inspect, status are query", $classes_ok)

  -- Schema 3 shape: valid families and their refusals.
  expect("validschema3: six families", [put(case_dir("valid3") .. "/registry.conf.mix", reg3($verbs, six()))], true)
  expect("listed members: a valid listed family", [put(case_dir("listed-ok") .. "/registry.conf.mix", reg3($verbs, fam("<app>.call", "fakeapp", "[\"otherd\"]", "intent")))], true)
  expect("sneakyfamilies: schema 2 with a nonempty families list", [put(case_dir("sneaky") .. "/registry.conf.mix", "-- test\n{\n  schema: 2,\n  verbs: [\n" .. $verbs .. "\n  ],\n  families: [\n" .. six() .. "\n  ]\n}\n")], false)
  expect("sneakyfamilies: schema 2 with an empty families key", [put(case_dir("sneaky-empty") .. "/registry.conf.mix", "-- test\n{\n  schema: 2,\n  verbs: [\n" .. $verbs .. "\n  ],\n  families: [\n  ]\n}\n")], false)
  expect("schema 3 without families", [put(case_dir("missing-families") .. "/registry.conf.mix", "-- test\n{\n  schema: 3,\n  verbs: [\n" .. $verbs .. "\n  ]\n}\n")], false)
  expect("families is not a list", [put(case_dir("families-string") .. "/registry.conf.mix", "-- test\n{\n  schema: 3,\n  verbs: [\n" .. $verbs .. "\n  ],\n  families: \"none\"\n}\n")], false)
  expect("family: unknown field", [put(case_dir("fam-unknown") .. "/registry.conf.mix", reg3($verbs, replace(six(), "owner:\"fakeapp\"", "owner:\"fakeapp\", extra:\"x\"")))], false)
  expect("family: unknown class", [put(case_dir("fam-class") .. "/registry.conf.mix", reg3($verbs, replace(six(), "class:\"intent\"", "class:\"read\"")))], false)
  expect("family: unknown status", [put(case_dir("fam-status") .. "/registry.conf.mix", reg3($verbs, replace(six(), "status:\"accepted\"", "status:\"beta\"")))], false)
  expect("family: leading zero version", [put(case_dir("fam-version") .. "/registry.conf.mix", reg3($verbs, replace(six(), "version:\"0.1.0\"", "version:\"01.0.0\"")))], false)
  expect("family: duplicate pattern across owners", [put(case_dir("fam-dup") .. "/registry.conf.mix", reg3($verbs, six() .. ",\n" .. fam("<app>.call", "other", "\"instances\"", "intent")))], false)
  expect("family: a catch-all pattern", [put(case_dir("fam-catchall") .. "/registry.conf.mix", reg3($verbs, replace(six(), "<app>.call", "<app>")))], false)
  expect("family: a wildcard pattern", [put(case_dir("fam-wild") .. "/registry.conf.mix", reg3($verbs, replace(six(), "<app>.call", "*.call")))], false)
  expect("family: a name: field, not pattern:", [put(case_dir("fam-name") .. "/registry.conf.mix", reg3($verbs, replace(six(), "pattern:\"<app>.call\"", "name:\"<app>.call\"")))], false)
  expect("family: fields out of order", [put(case_dir("fam-order") .. "/registry.conf.mix", reg3($verbs, replace(six(), "pattern:\"<app>.call\", owner:\"fakeapp\"", "owner:\"fakeapp\", pattern:\"<app>.call\"")))], false)
  expect("family: a line split across two lines", [put(case_dir("fam-split") .. "/registry.conf.mix", reg3($verbs, replace(six(), "members:\"instances\", ", "members:\"instances\",\n      ")))], false)
  expect("family: a listed member that is not a Bus name", [put(case_dir("fam-badmember") .. "/registry.conf.mix", reg3($verbs, fam("<app>.call", "fakeapp", "[\"Bad_Name\"]", "intent")))], false)
  expect("family: a listed member that is another owner's concrete verb prefix", [put(case_dir("fam-collide-verb") .. "/registry.conf.mix", reg3($verbs, fam("<app>.call", "fakeapp", "[\"demo\"]", "intent")))], false)
  expect("family: a listed member whose concrete prefix has two owners", [put(case_dir("fam-mixed-prefix") .. "/registry.conf.mix", reg3($verbs_mixed, fam("<app>.call", "demo", "[\"demo\"]", "intent")))], false)
  expect("family: a listed member gives an exact concrete verb name", [put(case_dir("fam-collide-wire") .. "/registry.conf.mix", reg3($verbs, fam("<app>.ping", "demo", "[\"demo\"]", "query")))], false)
  expect("family: a same-owner concrete prefix with a free wire name", [put(case_dir("fam-same-owner-prefix") .. "/registry.conf.mix", reg3($verbs, fam("<app>.call", "demo", "[\"demo\"]", "intent")))], true)
  expect("family: two families of one owner share a listed member", [put(case_dir("fam-shared-owner") .. "/registry.conf.mix", reg3($verbs, fam("<app>.call", "fakeapp", "[\"otherd\"]", "intent") .. ",\n" .. fam("<app>.status", "fakeapp", "[\"otherd\"]", "query")))], true)
  expect("family: two owners cannot share a listed member", [put(case_dir("fam-shared-owners") .. "/registry.conf.mix", reg3($verbs, fam("<app>.call", "fakeapp", "[\"otherd\"]", "intent") .. ",\n" .. fam("<app>.status", "other", "[\"otherd\"]", "query")))], false)

  -- Source check: the on @ declarations in component runtime sources, as the
  -- native lint reports them.
  $c = case_dir("source-real")
  $reg = put($c .. "/registry.conf.mix", reg3($verbs, six()))
  put($c .. "/apps/fakeapp/scripts/fakeapp.mix", full_app())
  expect("real on@ match: six declarations, owner fakeapp", [$reg, "--source", $c], true)

  $c = case_dir("source-impostor")
  $reg = put($c .. "/registry.conf.mix", reg3($verbs, six()))
  put($c .. "/apps/fakeapp/scripts/fakeapp.mix", full_app())
  put($c .. "/apps/impostor/scripts/impostor.mix", handler("call"))
  expect("wrongowner: another component declares on @.call", [$reg, "--source", $c], false)

  $c = case_dir("source-undeclared")
  $reg = put($c .. "/registry.conf.mix", reg3($verbs, six()))
  put($c .. "/apps/fakeapp/scripts/fakeapp.mix", full_app() .. handler("bogus"))
  expect("undeclaredsuffix: on @.bogus has no family", [$reg, "--source", $c], false)

  $c = case_dir("source-concrete")
  $reg = put($c .. "/registry.conf.mix", reg3($verbs, six()))
  put($c .. "/apps/fakeapp/scripts/fakeapp.mix", concrete_app())
  expect("concrete on only: fakeapp.call does not satisfy the family", [$reg, "--source", $c], false)

  $c = case_dir("source-examples")
  $reg = put($c .. "/registry.conf.mix", reg3($verbs, six()))
  put($c .. "/apps/fakeapp/scripts/fakeapp.mix", "-- on @.call desc \"x\"\n# on @.commands desc \"x\"\n$s = \"on @.execute desc\"\n$doc = <<EOF\non @.inspect desc \"x\"\nEOF\n$t = 'on @.screenshot'\n$u = \"on @.status\"\n")
  expect("quoted, comment and heredoc examples cannot satisfy", [$reg, "--source", $c], false)

  -- The forgery: an on @.call written inside a string's interpolation. The
  -- native parser reads it as text, so the call family stays undeclared.
  $c = case_dir("source-forgery")
  $reg = put($c .. "/registry.conf.mix", reg3($verbs, six()))
  put($c .. "/apps/fakeapp/scripts/fakeapp.mix", "-- fixture\n" .. handlers_for(without($suffixes, "call")) .. '$sample = "${"on @.call"}"' .. "\n")
  expect("quoted nested interpolation: example text does not satisfy the call family", [$reg, "--source", $c], false)

  $c = case_dir("source-semicolon")
  $reg = put($c .. "/registry.conf.mix", reg3($verbs, six()))
  put($c .. "/apps/fakeapp/scripts/fakeapp.mix", "-- fixture\non @.call desc \"a\"\n  reply(0, \"a\")\nend; on @.commands desc \"b\"\n  reply(0, \"b\")\nend\n\non    @.execute desc \"c\"\n  reply(0, \"c\")\nend\n" .. handler("inspect") .. handler("screenshot") .. handler("status"))
  expect("semicolons and newlines between declarations", [$reg, "--source", $c], true)

  -- Chained and piped handlers are declarations too: the call family chained
  -- to another statement, the commands family piped to an external command.
  -- Lint reads both and runs neither.
  $c = case_dir("source-chained-piped")
  $reg = put($c .. "/registry.conf.mix", reg3($verbs, six()))
  put($c .. "/apps/fakeapp/scripts/fakeapp.mix", "-- fixture\n" .. 'on @.call reply(0, "ok") end && print("registered")' .. "\n" .. 'on @.commands reply(0, "ok") end | cat' .. "\n" .. handlers_for(without(without($suffixes, "call"), "commands")))
  expect("chained call and piped commands declare their families", [$reg, "--source", $c], true)

  $c = case_dir("source-nested")
  $reg = put($c .. "/registry.conf.mix", reg3($verbs, six()))
  put($c .. "/apps/fakeapp/scripts/fakeapp.mix", "-- fixture\non @.call desc \"fixture\"\n  on @.commands desc \"nested\"\n    reply(0, \"ok\")\n  end\n  reply(0, \"ok\")\nend\n" .. handlers_for(without(without($suffixes, "call"), "commands")))
  expect("nested declaration: on @.commands inside on @.call counts for its owner", [$reg, "--source", $c], true)

  $c = case_dir("source-duplicate")
  $reg = put($c .. "/registry.conf.mix", reg3($verbs, six()))
  put($c .. "/apps/fakeapp/scripts/fakeapp.mix", full_app() .. handler("call"))
  expect("duplicate declarations of an owner's family are fine", [$reg, "--source", $c], true)

  $c = case_dir("source-other-owner-extra")
  $reg = put($c .. "/registry.conf.mix", reg3($verbs, six()))
  put($c .. "/apps/fakeapp/scripts/fakeapp.mix", full_app())
  put($c .. "/apps/otherd/scripts/otherd.mix", handler("commands"))
  expect("another owner's extra on @.commands is refused", [$reg, "--source", $c], false)

  $c = case_dir("source-file-symlink")
  $reg = put($c .. "/registry.conf.mix", reg3($verbs, six()))
  put($c .. "/apps/fakeapp/scripts/fakeapp.mix", full_app())
  $target = put($c .. "/outside/handlers.mix", handler("call"))
  run_argv_must(["ln", "-s", $target, $c .. "/apps/fakeapp/scripts/linked.mix"], {timeout: 30})
  expect("sourcefile symlink: a symlinked runtime source is refused", [$reg, "--source", $c], false)

  $c = case_dir("source-invalid")
  $reg = put($c .. "/registry.conf.mix", reg3($verbs, six()))
  put($c .. "/apps/fakeapp/scripts/fakeapp.mix", full_app() .. "$x = \"open\n")
  expect("invalid source: an unterminated string fails closed", [$reg, "--source", $c], false)

  $c = case_dir("source-tests-only")
  $reg = put($c .. "/registry.conf.mix", reg3($verbs, six()))
  put($c .. "/apps/fakeapp/tests/fakeapp_test.mix", full_app())
  expect("test directories are not runtime source", [$reg, "--source", $c], false)

  -- The lint answers, through the fake binary. The good answer must pass;
  -- each other answer must fail with its reason in the report.
  fake_case("good", $PAY_OK, 0, true, "")
  fake_case("no-handlers", $PAY_NO_HANDLERS, 0, false, "native Mix lacks parsed handler metadata; rebuild current Mix")
  fake_case("old-schema", $PAY_OLD_SCHEMA, 0, false, "lint schema_version is not 2")
  fake_case("truncated", $PAY_TRUNCATED, 0, false, "lint output is not a JSON object")
  fake_case("nonzero-exit", $PAY_OK, 3, false, "does not lint (exit 3)")
  fake_case("wrong-file", $PAY_WRONG_FILE, 0, false, "file attribution")
  fake_case("bad-line", $PAY_BAD_LINE, 0, false, "a lint handler line is not a positive integer")
  fake_case("empty-command", $PAY_EMPTY_CMD, 0, false, "a lint handler command is not a nonempty string")
  fake_case("lint-errors", $PAY_ERRORS, 0, false, "lint reports errors")

  -- Instance names: the --instances directory.
  $reg6 = put(case_dir("inst-shared") .. "/registry.conf.mix", reg3($verbs, six()))

  expect("missingdir: the instances directory does not exist", [$reg6, "--instances", $tmp .. "/no-such-dir"], false)

  $c = case_dir("inst-clean")
  put($c .. "/fakeapp.conf.mix", "-- fixture\n")
  expect("clean private instance name succeeds", [$reg6, "--instances", $c], true)

  expect("an empty instances directory is fine", [$reg6, "--instances", case_dir("inst-empty")], true)

  $c = case_dir("inst-other-files")
  put($c .. "/README.md", "not a config\n")
  expect("files that are not *.conf.mix are ignored", [$reg6, "--instances", $c], true)

  $c = case_dir("inst-nested")
  put($c .. "/sub/fakeapp.conf.mix", "-- fixture\n")
  expect("configs in subdirectories are not collected", [$reg6, "--instances", $c], true)

  for each $n in ["Fake_App", "a", "mixos-fakeapp", "noded", "noded-fake", "t1-abcdefghijklmnopqrstuv", "demo", ".hidden", "fake app", "fake\napp"]
    $c = case_dir("inst-name-" .. $n)
    put($c .. "/" .. $n .. ".conf.mix", "-- fixture\n")
    expect("instance name " .. $n .. " is refused", [$reg6, "--instances", $c], false)
  end

  $c = case_dir("inst-dir-named")
  mkdir($c .. "/dirc.conf.mix", {parents: true})
  expect("a directory named *.conf.mix is refused", [$reg6, "--instances", $c], false)

  $c = case_dir("inst-glob[x]")
  put($c .. "/fakeapp.conf.mix", "-- fixture\n")
  expect("a directory path with glob characters works (ls takes a name, not a pattern)", [$reg6, "--instances", $c], true)

  $c = case_dir("inst-symlink")
  $target = put($c .. "/target.txt", "fixture\n")
  mkdir($c .. "/configs", {parents: true})
  run_argv_must(["ln", "-s", $target, $c .. "/configs/fakeapp.conf.mix"], {timeout: 30})
  expect("symlink: a config that is a symlink is refused", [$reg6, "--instances", $c .. "/configs"], false)

  $c = case_dir("inst-real-dir")
  put($c .. "/fakeapp.conf.mix", "-- fixture\n")
  $link = $tmp .. "/inst-dir-link"
  run_argv_must(["ln", "-s", $c, $link], {timeout: 30})
  expect("symlink: a symlinked instances directory is refused", [$reg6, "--instances", $link], false)
  expect("symlink: a symlinked instances directory with a trailing slash is refused", [$reg6, "--instances", $link .. "/"], false)

  $reg_listed = put(case_dir("inst-listed") .. "/registry.conf.mix", reg3($verbs, fam("<app>.status", "fakeapp", "[\"demod\"]", "query")))
  $c = case_dir("inst-listed-collide")
  put($c .. "/demod.conf.mix", "-- fixture\n")
  expect("a listed family member cannot be an instance name", [$reg_listed, "--instances", $c], false)

  $reg_noinst = put(case_dir("inst-noinstances") .. "/registry.conf.mix", reg3($verbs, fam("<app>.status", "fakeapp", "[\"otherd\"]", "query")))
  $c = case_dir("inst-no-family")
  put($c .. "/fakeapp.conf.mix", "-- fixture\n")
  expect("configs need an instances family", [$reg_noinst, "--instances", $c], false)

  -- Unreadable directories fail closed: an unreadable instances directory, an
  -- unreadable source root, and an unreadable nested source directory.
  $c = case_dir("inst-unreadable")
  put($c .. "/fakeapp.conf.mix", "-- fixture\n")
  locked_case("unreadable instances directory fails closed", $c, [$reg6, "--instances", $c])

  $c = case_dir("source-unreadable-root")
  $reg = put(case_dir("source-unreadable-root-reg") .. "/registry.conf.mix", reg3($verbs, six()))
  put($c .. "/src/apps/fakeapp/scripts/fakeapp.mix", full_app())
  locked_case("unreadable source root fails closed", $c .. "/src", [$reg, "--source", $c .. "/src"])

  $c = case_dir("source-unreadable-nested")
  $reg = put(case_dir("source-unreadable-nested-reg") .. "/registry.conf.mix", reg3($verbs, six()))
  put($c .. "/apps/fakeapp/scripts/fakeapp.mix", full_app())
  put($c .. "/apps/fakeapp/scripts/locked/extra.mix", handler("call"))
  locked_case("unreadable nested source directory fails closed", $c .. "/apps/fakeapp/scripts/locked", [$reg, "--source", $c])

  -- Usage.
  $r = gate(["--bogus"])
  check("an unknown option is a usage error (exit 2)", $r.exit_code == 2)
  $r = gate(["--help"])
  check("--help exits 0 and shows the usage", $r.exit_code == 0 and contains($r.stdout, "usage"))
catch $m
  $fatal = $m
end

remove_dir($tmp)

$failed = 0
for each $r in $results
  if not $r.ok then
    $failed = $failed + 1
  end
end
if $fatal != "" then
  print("verb_registry_families_test: error: " .. $fatal)
  exit(1)
end
print("verb_registry_families_test: " .. to_string(len($results) - $failed) .. "/" .. to_string(len($results)) .. " passed")
if len($skips) > 0 then print("verb_registry_families_test: " .. to_string(len($skips)) .. " skipped (not run, not passed)") end
if $failed > 0 then
  exit(1)
end
