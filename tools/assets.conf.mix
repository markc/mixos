-- SPDX-License-Identifier: MIT OR Apache-2.0
-- assets.conf.mix — the licence manifest for every image, icon, font, sound
-- and embedded asset in the tree. Read by tools/asset_gate.mix. Rule:
-- AGENTS.md "Assets are original or permissively licensed" (2026-10-31).
--
-- Entry: one of `path` (a file), `glob` (a vendored set; `**` crosses
-- directories) or `dependency` (bytes a crate embeds, not in this tree), plus
-- title, author, source (URL and version or commit), SPDX `licence`,
-- `licence_file` (repo-relative) and the bytes' hash:
--   sha256     the file's SHA-256; for a glob, SHA-256 of the sorted lines
--              "<path> <file sha256>" joined by newlines plus a final one;
--              for `embedded: true`, SHA-256 of the file's sorted data-URI and
--              base64 payloads joined by newlines.
--   pinned_by  instead of sha256: a manifest in `pins` already pins each
--              file's hash. The gate reads it rather than repeating it.
--   generated  instead of sha256: original test renders (egui_kittest
--              snapshots), regenerated by the tests themselves.
-- `mix tools/asset_gate.mix --hashes` prints the current hashes.
--
-- allow: original MixOS work (MIT OR Apache-2.0, author "MixOS, original
--        artwork" or the named original author) and third-party assets under
--        the allowlist below. A public-domain entry also names `agency` and
--        `why`, and its source is the URL.
-- brand: the MixOS marks (LicenseRef-MixOS-Brand). Trademarks: forks remove
--        them. Under share/brand, or a byte copy of one (`copy_of`).
-- debt:  assets present today whose licence is outside the allowlist, each
--        with a reason and an exit. The gate refuses a debt key the base
--        does not have, so this list only shrinks.
--
-- Licence texts that libs/toolkit/assets/licenses.conf.mix and
-- share/icons/manifest.conf.mix already pin are checked against those pins
-- (`pins`); this file does not copy their hashes.
assets: {
  scan: {
    ext: [".png", ".jpg", ".jpeg", ".webp", ".gif", ".svg", ".ico", ".icns", ".ttf", ".otf", ".woff", ".woff2", ".wav", ".ogg", ".flac", ".mp3", ".cur"],
    font_ext: [".ttf", ".otf", ".woff", ".woff2"],
    -- Every other file under these directories is an asset too, except
    -- code and text (and LICENSE* files).
    dirs: ["assets", "share"],
    dir_skip_ext: [".mix", ".mx", ".rs", ".toml", ".md", ".txt", ".desktop", ".theme", ".css", ".js", ".html"],
    -- Design-tool swatches, brushes, presets and camera profiles: their
    -- provenance cannot be checked, so they never enter the tree.
    forbid_ext: [".ase", ".aco", ".abr", ".lrtemplate", ".dcp", ".lcp"],
    skip: ["target/", ".git/"],
    -- Not searched for embedded payloads: vendored trees keep their own
    -- licences (vendor/README.md), llms-full.txt is generated from docs, and
    -- the gate and its test carry the patterns themselves.
    embed_skip: ["vendor/", "docs/llms-full.txt", "tools/asset_gate.mix", "tests/asset_gate_test.mix"]
  },
  licences: {allow: ["MIT", "Apache-2.0", "ISC", "CC0-1.0", "OFL-1.1", "LicenseRef-Public-Domain"],
    font_only: ["OFL-1.1"], original: "MIT OR Apache-2.0", brand: "LicenseRef-MixOS-Brand",
    public_domain: "LicenseRef-Public-Domain"},
  pins: ["libs/toolkit/assets/licenses.conf.mix", "share/icons/manifest.conf.mix"],

  allow: [
    -- Fonts
    {glob: "libs/toolkit/assets/fonts/Inter-*.ttf", title: "Inter 4.1 static faces (Light, Regular, Medium, SemiBold, Bold)",
      author: "The Inter Project Authors", source: "https://github.com/rsms/inter/releases/tag/v4.1 (extras/ttf)",
      licence: "OFL-1.1", licence_file: "libs/toolkit/assets/fonts/OFL-Inter.txt",
      sha256: "0c77fdeecc7bdb4e221c2e877c59d262d16ebf9525c6049997c901155d2033f1"},
    {glob: "libs/toolkit/assets/fonts/JetBrainsMono-*.ttf", title: "JetBrains Mono 2.304 static faces (Light, Regular, Medium)",
      author: "The JetBrains Mono Project Authors", source: "https://github.com/JetBrains/JetBrainsMono/releases/tag/v2.304",
      licence: "OFL-1.1", licence_file: "libs/toolkit/assets/fonts/OFL-JetBrainsMono.txt",
      sha256: "1fe30b970fe53b8a941527e22130c231f5cb602ff60b36b0a91c2c6d5474dcbf"},
    {path: "docs/_web/fonts/sans.woff2", title: "Inter (variable), web subset cut by docs/_build/gen-site.mix",
      author: "The Inter Project Authors", source: "https://github.com/rsms/inter (asset set 2026-10-04-core-3, docs/_build/site.conf.mix)",
      licence: "OFL-1.1", licence_file: "docs/_web/fonts/LICENSE-Inter.txt",
      sha256: "22f05185ef28152883cd8ee9767c011eec4bd8b20a43f30bc1e741f7a3314763"},
    {glob: "docs/_web/fonts/mono*.woff2", title: "JetBrains Mono (variable, roman and italic), web subsets cut by gen-site.mix",
      author: "The JetBrains Mono Project Authors", source: "https://github.com/JetBrains/JetBrainsMono (asset set 2026-10-04-core-3)",
      licence: "OFL-1.1", licence_file: "docs/_web/fonts/LICENSE-JetBrainsMono.txt",
      sha256: "2030b410384eaf3d60e5b2722a239ebb210e7cb172f38905184aa79a281ac1f7"},
    {path: "docs/_web/fonts/display.woff2", title: "Quicksand (variable), web subset cut by gen-site.mix",
      author: "The Quicksand Project Authors", source: "https://github.com/andrew-paglinawan/QuicksandFamily (asset set 2026-10-04-core-3)",
      licence: "OFL-1.1", licence_file: "docs/_web/fonts/LICENSE-Quicksand.txt",
      sha256: "fed44df28c1d90d5662a7f421b31c591fa15f9235d0976563013bcae11ea6260"},
    {path: "docs/_web/fonts/emoji.woff2", title: "Noto Color Emoji (COLRv1), web subset cut by gen-site.mix",
      author: "Google LLC", source: "https://github.com/googlefonts/noto-emoji (asset set 2026-10-04-core-3)",
      licence: "OFL-1.1", licence_file: "docs/_web/fonts/LICENSE-NotoColorEmoji.txt",
      sha256: "d0b2321c02e6449f8c8cf38b60dad34cb47b46d103802ca0a606eae2c0d9b2a6"},
    {dependency: "epaint_default_fonts 0.37.0: NotoEmoji-Regular.ttf", title: "Noto Emoji Regular (egui fallback)",
      author: "Google Inc.", source: "https://crates.io/crates/epaint_default_fonts/0.37.0 (fonts/)",
      licence: "OFL-1.1", licence_file: "libs/toolkit/assets/fonts/fallbacks/LICENSE-NotoEmoji.txt"},
    {dependency: "epaint_default_fonts 0.37.0: emoji-icon-font.ttf", title: "Emoji Icon Font (egui fallback and the egui-icons subset)",
      author: "John Slegers", source: "https://crates.io/crates/epaint_default_fonts/0.37.0 (fonts/)",
      licence: "MIT", licence_file: "libs/toolkit/assets/fonts/fallbacks/LICENSE-EmojiIcon.txt"},

    -- Icons
    {glob: "libs/icons/assets/*.svg", title: "Lucide icons, unmodified",
      author: "Lucide Icons and Contributors; Cole Bemis (Feather-derived icons)",
      source: "https://github.com/lucide-icons/lucide/releases/tag/1.54.0",
      licence: "ISC AND MIT", licence_file: "libs/icons/assets/LICENSE-lucide.txt",
      sha256: "c78be43b02fd8ce58fbe9f6e9cd1d42c287ddce0ccc924650efc0705ab3027e0"},
    {path: "apps/screenshot/assets/dev.mixos.screenshot-symbolic.svg", title: "Screenshot app icon (Lucide camera.svg, unmodified)",
      author: "Lucide Icons and Contributors; Cole Bemis (Feather-derived icons)",
      source: "https://github.com/lucide-icons/lucide/releases/tag/1.54.0 (icons/camera.svg)",
      licence: "ISC AND MIT", licence_file: "libs/icons/assets/LICENSE-lucide.txt",
      sha256: "ebbb3178dd80dfd942770a2237fe7bfc3515c55c7daa9d3666933a656d2790e3"},
    {glob: "share/icons/lucide/*.svg", title: "Icon bundle: Lucide icons, unmodified",
      author: "Lucide Icons and Contributors; Cole Bemis (Feather-derived icons)",
      source: "https://github.com/lucide-icons/lucide/releases/tag/1.54.0",
      licence: "ISC AND MIT", licence_file: "share/icons/LICENSE-lucide.txt",
      pinned_by: "share/icons/manifest.conf.mix"},
    {glob: "share/icons/scalable/actions/window-*-symbolic.svg", title: "Window caption glyphs (minimise, maximise, restore, close)",
      author: "MixOS, original artwork", source: "https://github.com/markc/mixos (share/icons)",
      licence: "MIT OR Apache-2.0", licence_file: "LICENSE-MIT",
      pinned_by: "share/icons/manifest.conf.mix"},
    {glob: "docs/_web/icons/*.svg", title: "mixos.dev interface icons: Lucide with stroke-width 1.5, generated by gen-site.mix",
      author: "Lucide Icons and Contributors; Cole Bemis (Feather-derived icons)",
      source: "https://github.com/lucide-icons/lucide/releases/tag/1.54.0",
      licence: "ISC AND MIT", licence_file: "docs/_web/icons/LICENSE-Lucide.txt",
      sha256: "75d5c87c35f2dde58f87b44c793d59fb2984e8e566fb64f0ea2fc8bb9a236cae"},
    {path: "services/webd/vhosts/assets/lucide.min.js", title: "Lucide icon bundle for the webd SPA (minified, upstream @license header kept)",
      author: "Lucide Contributors; Cole Bemis (Feather-derived icons)",
      source: "https://github.com/lucide-icons/lucide/releases/tag/1.17.0 (npm lucide 1.17.0, dist/umd/lucide.min.js)",
      licence: "ISC AND MIT", licence_file: "services/webd/vhosts/assets/LICENSE-lucide.txt",
      sha256: "5e943127343691a9b640d959bbfbdeb742f4a99e0ebc17a4fa77e94654e5318b"},
    {path: "services/webd/vhosts/assets/app.css", embedded: true, title: "Select chevron data URI (Lucide/Feather chevron-down polyline)",
      author: "Lucide Icons and Contributors; Cole Bemis (Feather-derived icons)",
      source: "https://github.com/lucide-icons/lucide (icons/chevron-down.svg)",
      licence: "ISC AND MIT", licence_file: "services/webd/vhosts/assets/LICENSE-lucide.txt",
      sha256: "8cf58e5df72cf3bf976645d5193ac63185f9418e57f694337fc919ced573a350"},

    -- Original web art
    {path: "services/webd/vhosts/assets/dcs-wordmark.svg", title: "Dual Carousel Sidebars wordmark (SVG text and gradient)",
      author: "Mark Constable, original artwork", source: "https://github.com/markc/mixos (services/webd, transplanted from the predecessor webd)",
      licence: "MIT OR Apache-2.0", licence_file: "LICENSE-MIT",
      sha256: "8f45c15eb840eaf78cb9d750c94ade930521ce48b04f7937494d14e0dc5340fe"},
    {path: "services/webd/vhosts/assets/favicon.svg", title: "webd default favicon (three coloured squares)",
      author: "Mark Constable, original artwork", source: "https://github.com/markc/mixos (services/webd)",
      licence: "MIT OR Apache-2.0", licence_file: "LICENSE-MIT",
      sha256: "d78bf8ef2fbe3be964a9f2487807a8cbf13851c9db447940c84c7b85420f1615"},
    {path: "services/webd/vhosts/assets/favicon.ico", title: "webd default favicon.ico (empty placeholder)",
      author: "Mark Constable, original artwork", source: "https://github.com/markc/mixos (services/webd)",
      licence: "MIT OR Apache-2.0", licence_file: "LICENSE-MIT",
      sha256: "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"},

    -- Test fixtures and renders
    {glob: "**/tests/snapshots/**", generated: true, title: "egui_kittest snapshot renders",
      author: "MixOS, original artwork", source: "generated by each crate's snapshot tests",
      licence: "MIT OR Apache-2.0", licence_file: "LICENSE-MIT"},
    {path: "services/compd/tests/fixtures/scenes/example.svg", title: "Scene test icon (rounded square, three bars)",
      author: "MixOS, original artwork", source: "https://github.com/markc/mixos (services/compd/tests)",
      licence: "MIT OR Apache-2.0", licence_file: "LICENSE-MIT",
      sha256: "faac3a56ffdb9fd0eea0d7afed3301a30f46776e2c87579ddb64fd0ad7e0b089"},
    {path: "services/compd/crates/scene-host/tests/fixtures/icon.png", title: "1x1 PNG test fixture",
      author: "MixOS, original artwork", source: "https://github.com/markc/mixos (scene-host tests)",
      licence: "MIT OR Apache-2.0", licence_file: "LICENSE-MIT",
      sha256: "7591144776509b0a6c033614ec49d560b8211c59b949aa98e4670932c3a14c5e"},
    {path: "services/compd/crates/scene-host/tests/fixtures/embedded-icon.svg", title: "SVG wrapping a 1x1 PNG data URI (test fixture)",
      author: "MixOS, original artwork", source: "https://github.com/markc/mixos (scene-host tests)",
      licence: "MIT OR Apache-2.0", licence_file: "LICENSE-MIT",
      sha256: "81e8330b96158e05796345384ee573207e5de6dd21aced94521dd78f3a0edf1d"},
    {path: "apps/screenshot/tests/edit_path_test.mix", embedded: true, title: "1x1 PNG written by the test (base64)",
      author: "MixOS, original artwork", source: "https://github.com/markc/mixos (apps/screenshot/tests)",
      licence: "MIT OR Apache-2.0", licence_file: "LICENSE-MIT",
      sha256: "c20653bc25c1fecc68a82cd8b6310892ad15453c48fda02cb811c181a4559a5f"},
    {path: "services/maild/tests/sieve_interpreter.rs", embedded: true, title: "Truncated GIF header in a MIME test message (base64)",
      author: "MixOS, original artwork", source: "https://github.com/markc/mixos (services/maild/tests)",
      licence: "MIT OR Apache-2.0", licence_file: "LICENSE-MIT",
      sha256: "3f43bce13cc5635b6e5b701832c201fc6e8a7d80af7efbcc66a15bf712ee41b8"},

    -- Vendored crates
    {path: "vendor/eframe/data/icon.png", title: "eframe default window icon (egui logo)",
      author: "Emil Ernerfeldt and egui contributors", source: "https://github.com/emilk/egui (eframe 0.37.0, crates/eframe/data/icon.png)",
      licence: "MIT OR Apache-2.0", licence_file: "vendor/eframe/LICENSE-MIT",
      sha256: "9e076c34e32a0b0ef35c62ebf6be8b5594a4601e7bcd478b681e9eff1f327973"},
    {path: "vendor/smithay/anvil/resources/numbers.png", title: "anvil FPS digit sprite",
      author: "Victor Berger, Victoria Brekenfeld and Smithay contributors", source: "https://github.com/Smithay/smithay (7ddcd1736b47, anvil/resources/numbers.png)",
      licence: "MIT", licence_file: "vendor/smithay/LICENSE.txt",
      sha256: "17f7de3b885f5dd02c62d7d07ded15f83fb416dbbf38f1921255da5eefa8af53"}
  ],

  brand: [
    {glob: "share/brand/logos/*.svg", title: "MixOS M (black, white) and Alien Cyclops mascot logos",
      author: "Mark Constable (MixOS brand)", source: "https://github.com/markc/mixos (share/brand)",
      licence: "LicenseRef-MixOS-Brand", licence_file: "share/brand/README.md",
      sha256: "9eefb7af8b84562401b3639f6600f4f29df6c69c41a88ec558eb0cb12e9bcae3"},
    {glob: "share/brand/favicons/**", title: "MixOS M and Alien Cyclops favicon sets",
      author: "Mark Constable (MixOS brand)", source: "https://github.com/markc/mixos (share/brand)",
      licence: "LicenseRef-MixOS-Brand", licence_file: "share/brand/README.md",
      sha256: "4c8cd61ed7fefb45cfcc9f297a5ad4780c70804e6660c9af1f28d2720338070c"},
    {path: "share/brand/preview.png", title: "MixOS M colour treatments preview",
      author: "Mark Constable (MixOS brand)", source: "https://github.com/markc/mixos (share/brand)",
      licence: "LicenseRef-MixOS-Brand", licence_file: "share/brand/README.md",
      sha256: "1a70a8add758354d4b12dac81b7f2ff256e5e9d93ab41f45c6f64189ebb9d3e1"},
    {path: "docs/_web/brand/alien-cyclops.svg", copy_of: "share/brand/logos/alien-cyclops.svg", title: "mixos.dev copy of the Alien Cyclops logo",
      author: "Mark Constable (MixOS brand)", source: "https://github.com/markc/mixos (share/brand)",
      licence: "LicenseRef-MixOS-Brand", licence_file: "share/brand/README.md",
      sha256: "78c965ac326d2ba6375003c7581c8b78d779e76ab59ad266b6646cda096cf2e7"},
    {path: "docs/_web/favicon.svg", copy_of: "share/brand/logos/alien-cyclops-favicon.svg", title: "mixos.dev favicon (Alien Cyclops)",
      author: "Mark Constable (MixOS brand)", source: "https://github.com/markc/mixos (share/brand)",
      licence: "LicenseRef-MixOS-Brand", licence_file: "share/brand/README.md",
      sha256: "4eb2d646771d7441f7ebb1c101160db9ebf78a49dda09213ad0605f6ec78b7f2"},
    {path: "docs/favicon.ico", copy_of: "share/brand/favicons/cyclops/favicon.ico", title: "mixos.dev favicon.ico (Alien Cyclops)",
      author: "Mark Constable (MixOS brand)", source: "https://github.com/markc/mixos (share/brand)",
      licence: "LicenseRef-MixOS-Brand", licence_file: "share/brand/README.md",
      sha256: "400d5816f332b3ccb8848c6035c5eb87aee828f3ae6e5aba132e2ccd391ae3dc"},
    {path: "docs/_web/brand/apple-touch-icon.png", copy_of: "share/brand/favicons/cyclops/apple-touch-icon.png", title: "mixos.dev apple-touch icon (Alien Cyclops)",
      author: "Mark Constable (MixOS brand)", source: "https://github.com/markc/mixos (share/brand)",
      licence: "LicenseRef-MixOS-Brand", licence_file: "share/brand/README.md",
      sha256: "edebfa382565bf42fc2a2795ec8a808d79d90e3d5d928d2539ef83db3e1d2fdd"},
    {glob: "docs/_web/brand/favicon-32-*.png", copy_of: "share/brand/favicons/cyclops/favicon-32x32.png", title: "mixos.dev 32 px favicons (Alien Cyclops, light and dark)",
      author: "Mark Constable (MixOS brand)", source: "https://github.com/markc/mixos (share/brand)",
      licence: "LicenseRef-MixOS-Brand", licence_file: "share/brand/README.md",
      sha256: "3488dad800748756bcab6048fb8c854cfb687ee23fb664ab1aa1f8d807dfbb01"}
  ],

  debt: [
    {path: "docs/_web/Server_Room_Dark.webp", title: "mixos.dev hero background (darkened server room photo)",
      author: "unknown", source: "unknown: no provenance recorded when the site moved in (REUSE NOASSERTION)",
      licence: "NOASSERTION", licence_file: "REUSE.toml",
      sha256: "61c3c48a4f7e5093a885f368c26b64def2c2d34526b7fef259841c3da715882c",
      reason: "the site's hero image; its source and licence were never recorded",
      exit: "replace it with a hero generated in code (or a recorded CC0/PD image) and delete the file"},
    {dependency: "epaint_default_fonts 0.37.0: Hack-Regular.ttf", title: "Hack Regular (egui monospace fallback)",
      author: "Source Foundry Authors; Bitstream Inc. (Bitstream Vera Sans Mono)",
      source: "https://crates.io/crates/epaint_default_fonts/0.37.0 (fonts/)",
      licence: "MIT AND Bitstream-Vera", licence_file: "libs/toolkit/assets/fonts/fallbacks/LICENSE-Hack.txt",
      reason: "egui's default fonts embed it; the Bitstream Vera terms are not on the allowlist",
      exit: "build egui without default_fonts and give the toolkit its own fallback chain (JetBrains Mono for monospace)"},
    {dependency: "epaint_default_fonts 0.37.0: Ubuntu-Light.ttf", title: "Ubuntu Light (egui proportional fallback)",
      author: "Canonical Ltd.", source: "https://crates.io/crates/epaint_default_fonts/0.37.0 (fonts/)",
      licence: "Ubuntu-font-1.0", licence_file: "libs/toolkit/assets/fonts/fallbacks/LICENSE-Ubuntu.txt",
      reason: "egui's default fonts embed it; the Ubuntu Font Licence is not on the allowlist",
      exit: "build egui without default_fonts (Inter covers proportional text)"}
  ]
}
