-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Temporary worker-only preparation; removed before the final source gate.
$rc = 0
$had_png = is_file("apps/ced/tests/snapshots/mail_document_header_strip_pro_light.png")
try
  $r = run_argv(["cargo", "fmt", "--all"], {timeout: 300, stderr: "stdout"})
  print($r.stdout)
  print("PATCH_BEGIN")
  print(run_argv_must(["git", "diff", "--binary"]))
  print("PATCH_END")
  $r = run_argv(["cargo", "test", "-p", "ced", "--test", "window", "mail_document_header_strip_pro_light", "--", "--exact"], {timeout: 1800, stderr: "stdout", env: {UPDATE_SNAPSHOTS: "1"}})
  print($r.stdout)
  $rc = $r.exit_code ?? 124
  $png = "apps/ced/tests/snapshots/mail_document_header_strip_pro_light.png"
  if is_file($png) then
    print("PNG_BEGIN")
    print(run_argv_must(["base64", "-w", "0", $png]))
    print("PNG_END")
  end
  if $rc == 0 then
    $r = run_argv(["cargo", "test", "-p", "documents", "-p", "citizen", "-p", "ced", "--lib", "--no-fail-fast"], {timeout: 1800, stderr: "stdout"})
    print($r.stdout)
    $rc = $r.exit_code ?? 124
    $r = run_argv(["cargo", "test", "-p", "editd", "--test", "dispatch", "--no-fail-fast"], {timeout: 1800, stderr: "stdout"})
    print($r.stdout)
    if $r.exit_code != 0 then $rc = $r.exit_code ?? 124 end
    $r = run_argv(["cargo", "test", "-p", "ced", "--test", "window", "--no-fail-fast"], {timeout: 1800, stderr: "stdout"})
    print($r.stdout)
    if $r.exit_code != 0 then $rc = $r.exit_code ?? 124 end
  end
finally
  print("LOCK_PATCH_BEGIN")
  print(run_argv_must(["git", "diff", "--", "Cargo.lock"]))
  print("LOCK_PATCH_END")
  print(run_argv_must(["git", "checkout", "-q", "--", "."]))
  if not $had_png and is_file("apps/ced/tests/snapshots/mail_document_header_strip_pro_light.png") then
    print(run_argv_must(["rm", "--", "apps/ced/tests/snapshots/mail_document_header_strip_pro_light.png"]))
  end
end
exit($rc)
