-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Copyright 2026 Mark Constable <mc@mixos.dev>
-- version: 0.5.0
-- The Bus command registry gate (AGENTS.md §5) for docs/docs/spec/bus/commands.conf.mix:
--
-- - schema 2, 3, 4 or 5 (the repository must use 5; 5 is 4 under the
--   command registry's names);
-- - schema 4 adds a trailing schema string to every command and family: none,
--   pending (through 2026-11-30 inclusive in UTC), or a Rust request type path
--   deriving JsonSchema, matching ^[a-z][a-z0-9_]*(::[A-Za-z][A-Za-z0-9_]*)+$;
--   time() and date_parse are UTC. --today YYYY-MM-DD overrides the test date;
-- - commands in schema 4: every entry is a map of exactly name, owner, version,
--   status, class and schema, all strings (schema 2/3 omit schema);
--   names are unique and well formed, owners are
--   component names, versions are release versions (MAJOR.MINOR.PATCH, no
--   leading zeros), statuses and classes come from their fixed sets
--   (classes: docs/docs/decisions/2026-10-11-verb-classes.md);
-- - families (schema 3 and 4; docs/docs/decisions/2026-10-13-instance-verb-families.md):
--   each is a map of exactly pattern, owner, members, version, status, class
--   and schema (schema 3 omits schema). pattern is <app>.<suffix> and unique;
--   members is "instances" (the
--   runtime members are instances, not listed) or a nonempty list of unique
--   Bus service names. A listed member may be shared by families of one owner
--   only. It may equal a concrete command prefix only when every concrete command
--   with that prefix has the family's owner, and the expanded name
--   (member.suffix) is not itself a concrete command. Sharing across owners is
--   refused;
-- - the file is in canonical form: inside `commands: [ … ]` and `families: [ … ]`
--   every line is blank or exactly one entry, its fields in the order given
--   above, each written key:"value" with ", " between them, braces round it
--   and a trailing comma except on the last. No comments inside the blocks.
--   Outside the commands block no line may contain the exact text name:" (the
--   key name, its colon and an opening double quote; pattern:" is allowed).
--   The applications' registry tests read the file line by line, so this is
--   what keeps them honest.
--
-- With --source ROOT the component sources under ROOT are checked
-- structurally (every on @.<suffix> declaration belongs to its owner's
-- instances family; every instances family is declared by its owner). With
-- --instances DIR the instance config names in DIR are checked against the
-- Bus name rule, the reserved names and the registry's collisions. Neither
-- check reads a config's contents or a token, or touches the network.
--
--   mix tools/command_registry.mix [FILE] [--source ROOT] [--instances DIR] [--today YYYY-MM-DD]
--
-- With no FILE the repository registry must be schema 5, and its source is checked
-- against the repository root unless --source names another root. With an
-- explicit FILE and no --source the check is data only. Exit 0 when clean,
-- 1 when any check fails, 2 on a usage error.
$root = dirname(dirname(realpath($0)))
$src = require("lib/command_registry_source.mix")

$USAGE = "usage: mix tools/command_registry.mix [FILE] [--source ROOT] [--instances DIR] [--today YYYY-MM-DD]\n  FILE: the registry (default docs/docs/spec/bus/commands.conf.mix; repository must be schema 5)\n  schema 4 and 5: trailing schema field is none, pending, or a Rust request type path matching ^[a-z][a-z0-9_]*(::[A-Za-z][A-Za-z0-9_]*)+$\n  --source ROOT: check the component sources under ROOT (default with no FILE: the repository)\n  --instances DIR: check the instance config names in DIR against the registry\n  --today YYYY-MM-DD: override today's UTC date for the pending cutoff (2026-11-30 inclusive)\n  --help: this text"
-- A listed family member is a Bus service name, as the instance names are.
$_MEMBER = "^[a-z][a-z0-9-]{1,30}$"

fn usage_error($message)
  eprint("command_registry: " .. $message)
  eprint($USAGE)
  exit(2)
end

$file = nil
$source = nil
$instances = nil
$today = time()
$a = args()
$i = 0
while $i < len($a)
  $x = $a[$i]
  if $x == "--help" or $x == "-h" then
    print($USAGE)
    exit(0)
  elif $x == "--source" or $x == "--instances" or $x == "--today" then
    if $i + 1 >= len($a) then usage_error($x .. " needs a value") end
    if $x == "--source" then
      $source = $a[$i + 1]
    elif $x == "--instances" then
      $instances = $a[$i + 1]
    else
      $date = $a[$i + 1]
      if not re_match($date, "^[0-9]{4}-[0-9]{2}-[0-9]{2}$") then usage_error("--today needs YYYY-MM-DD") end
      try
        $today = date_parse($date)
      catch $m
        usage_error("--today needs a valid date")
      end
    end
    $i = $i + 2
  elif starts_with($x, "--") then
    usage_error("unknown option " .. $x)
  else
    if $file != nil then usage_error("only one FILE") end
    $file = $x
    $i = $i + 1
  end
end

$path = $file
if $file == nil then
  $path = $root .. "/docs/docs/spec/bus/commands.conf.mix"
  if $source == nil then $source = $root end
end

$fields = ["name", "owner", "version", "status", "class"]
$classes = ["intent", "query", "input", "system"]
$statuses = ["accepted", "draft", "deprecated"]
$family_fields = ["pattern", "owner", "members", "version", "status", "class"]
$problems = []

-- The canonical block bounds: the line of `<title>: [` and the first line
-- after it that is `]` or `],`. -1 when missing.
fn find_block($lines, $title)
  $start = -1
  $end_at = -1
  $i = 0
  while $i < len($lines)
    if $start < 0 and trim($lines[$i]) == ($title .. ": [") then
      $start = $i
    elif $start >= 0 and $end_at < 0 and (trim($lines[$i]) == "]" or trim($lines[$i]) == "],") then
      $end_at = $i
    end
    $i = $i + 1
  end
  return {start: $start, end_at: $end_at}
end

-- The non-blank lines strictly inside a block.
fn block_lines($lines, $block)
  $out = []
  $i = $block.start + 1
  while $i < $block.end_at
    if trim($lines[$i]) != "" then push($out, $lines[$i]) end
    $i = $i + 1
  end
  return $out
end

-- ["a", "b"] as written in the canonical form.
fn quoted_list($items)
  $parts = []
  for each $x in $items
    push($parts, "\"" .. $x .. "\"")
  end
  return "[" .. join($parts, ", ") .. "]"
end

-- A file that is not strict data fails here with one line. The parser's own
-- message can quote the file, so it is never printed.
$registry = nil
$read_failed = false
try
  $registry = load_data($path)
catch $m
  $read_failed = true
end
if $read_failed then
  print("command_registry: cannot read registry as strict data: " .. $path)
  exit(1)
end
$schema = nil
if type($registry) == "map" and has_key($registry, "schema") then $schema = $registry.schema end
if type($schema) != "number" or ($schema != 2 and $schema != 3 and $schema != 4 and $schema != 5) then
  push($problems, "schema must be 2, 3 or 4")
end
if $file == nil and $schema != 5 then
  push($problems, "repository registry must be schema 5")
end
if $schema >= 4 then
  push($fields, "schema")
  push($family_fields, "schema")
end
$has_families = type($registry) == "map" and has_key($registry, "families")
if $schema == 2 and $has_families then
  push($problems, "schema 2 takes no families; a families list needs schema 3")
end
$families = []
if $schema >= 3 then
  if $has_families and type($registry.families) == "list" then
    $families = $registry.families
  else
    push($problems, "schema " .. to_string($schema) .. " requires a families list")
  end
end

fn body_schema_problem($row, $today)
  if not has_key($row, "schema") or type($row.schema) != "string" then
    return "schema must be a string"
  end
  if $row.schema == "pending" then
    if $today >= date_parse("2026-11-30") + 86400 then
      return "pending schema expired after 2026-11-30"
    end
  elif $row.schema != "none" and not re_match($row.schema, "^[a-z][a-z0-9_]*(::[A-Za-z][A-Za-z0-9_]*)+$") then
    return "schema must be none, pending or a Rust request type path"
  end
  return nil
end

$commands = []
if type($registry) == "map" and has_key($registry, "commands") and type($registry.commands) == "list" then
  $commands = $registry.commands
else
  push($problems, "commands must be a list")
end

$seen = {}
$concrete = {}
-- concrete_owner maps a command prefix to its owner; mixed_prefix marks a prefix
-- whose commands have more than one owner.
$concrete_owner = {}
$mixed_prefix = {}
$index = 0
for each $command in $commands
  $index = $index + 1
  $where = "entry " .. to_string($index)
  if type($command) != "map" then
    push($problems, $where .. ": not a map")
  else
    for each $key in keys($command)
      if not contains($fields, $key) then
        push($problems, $where .. ": unknown field " .. $key)
      end
    end
    $ok = true
    for each $key in $fields
      if not has_key($command, $key) or type($command[$key]) != "string" then
        push($problems, $where .. ": " .. $key .. " must be a string")
        $ok = false
      end
    end
    if $ok then
      $name = $command.name
      $where = $name
      if $schema >= 4 then
        $problem = body_schema_problem($command, $today)
        if $problem != nil then push($problems, $where .. ": " .. $problem) end
      end
      if not re_match($name, "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_]*)+$") then
        push($problems, $where .. ": malformed name")
      end
      if has_key($seen, $name) then
        push($problems, $where .. ": duplicate")
      end
      $seen[$name] = true
      $prefix = split($name, ".")[0]
      $concrete[$prefix] = true
      if has_key($concrete_owner, $prefix) and $concrete_owner[$prefix] != $command.owner then
        $mixed_prefix[$prefix] = true
      end
      $concrete_owner[$prefix] = $command.owner
      if not re_match($command.owner, "^[a-z][a-z0-9-]*$") then
        push($problems, $where .. ": owner must be a component name")
      end
      if not re_match($command.version, "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$") then
        push($problems, $where .. ": version must be MAJOR.MINOR.PATCH without leading zeros")
      end
      if not contains($statuses, $command.status) then
        push($problems, $where .. ": status " .. $command.status .. " is not one of " .. join($statuses, ", "))
      end
      if not contains($classes, $command.class) then
        push($problems, $where .. ": class " .. $command.class .. " is not one of " .. join($classes, ", "))
      end
    end
  end
end

-- Families: validated one by one. good keeps only the valid ones, which the
-- source and instance checks use; member_owner maps each listed member to its
-- family's pattern.
$good = []
$patterns = {}
$member_owner = {}
$has_instance_family = false
$index = 0
for each $f in $families
  $index = $index + 1
  $where = "family " .. to_string($index)
  if type($f) != "map" then
    push($problems, $where .. ": not a map")
  else
    if has_key($f, "pattern") and type($f.pattern) == "string" then $where = $f.pattern end
    if $schema >= 4 then
      $problem = body_schema_problem($f, $today)
      if $problem != nil then push($problems, $where .. ": " .. $problem) end
    end
    for each $key in keys($f)
      if not contains($family_fields, $key) then
        push($problems, $where .. ": unknown field " .. $key)
      end
    end
    $ok = true
    for each $key in ["pattern", "owner", "version", "status", "class"]
      if not has_key($f, $key) or type($f[$key]) != "string" then
        push($problems, $where .. ": " .. $key .. " must be a string")
        $ok = false
      end
    end
    if not has_key($f, "members") then
      push($problems, $where .. ": members must be \"instances\" or a list of names")
      $ok = false
    elif type($f.members) == "string" then
      if $f.members != "instances" then
        push($problems, $where .. ": members must be \"instances\" or a list of names")
        $ok = false
      end
    elif type($f.members) != "list" or len($f.members) == 0 then
      push($problems, $where .. ": members must be \"instances\" or a list of names")
      $ok = false
    else
      $listed = {}
      for each $m in $f.members
        if type($m) != "string" or not re_match($m, $_MEMBER) then
          push($problems, $where .. ": member " .. to_string($m) .. " is not a Bus service name")
          $ok = false
        elif has_key($listed, $m) then
          push($problems, $where .. ": member " .. $m .. " is listed twice")
          $ok = false
        end
        if type($m) == "string" then $listed[$m] = true end
      end
    end
    if $ok then
      if not re_match($f.pattern, "^<app>\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$") then
        push($problems, $where .. ": pattern must be <app>.<suffix>")
        $ok = false
      end
      if has_key($patterns, $f.pattern) then
        push($problems, $where .. ": duplicate pattern")
        $ok = false
      end
      $patterns[$f.pattern] = true
      if not re_match($f.owner, "^[a-z][a-z0-9-]*$") then
        push($problems, $where .. ": owner must be a component name")
        $ok = false
      end
      if not re_match($f.version, "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$") then
        push($problems, $where .. ": version must be MAJOR.MINOR.PATCH without leading zeros")
        $ok = false
      end
      if not contains($statuses, $f.status) then
        push($problems, $where .. ": status " .. $f.status .. " is not one of " .. join($statuses, ", "))
        $ok = false
      end
      if not contains($classes, $f.class) then
        push($problems, $where .. ": class " .. $f.class .. " is not one of " .. join($classes, ", "))
        $ok = false
      end
    end
    if $ok and type($f.members) == "list" then
      $suffix = strip_prefix($f.pattern, "<app>.")
      for each $m in $f.members
        if has_key($concrete, $m) then
          if has_key($mixed_prefix, $m) or $concrete_owner[$m] != $f.owner then
            push($problems, $where .. ": member " .. $m .. " is a concrete command prefix of another owner")
            $ok = false
          elif has_key($seen, $m .. "." .. $suffix) then
            push($problems, $where .. ": member " .. $m .. " gives " .. $m .. "." .. $suffix .. ", which is already a concrete command")
            $ok = false
          end
        end
        if has_key($member_owner, $m) and $member_owner[$m] != $f.owner then
          push($problems, $where .. ": member " .. $m .. " is already a member of another owner's family")
          $ok = false
        end
      end
    end
    if $ok then
      push($good, $f)
      if $f.members == "instances" then
        $has_instance_family = true
      else
        for each $m in $f.members
          $member_owner[$m] = $f.owner
        end
      end
    end
  end
end

-- Canonical form, compared line by line with the parsed entries.
$lines = split(read_file($path), "\n")
$vblock = find_block($lines, "commands")
if $vblock.start < 0 or $vblock.end_at < 0 then
  push($problems, "no `commands: [` … `]` block on lines of their own")
else
  $entry_lines = block_lines($lines, $vblock)
  if len($entry_lines) != len($commands) then
    push($problems, "canonical form: " .. to_string(len($entry_lines)) .. " entry lines for " .. to_string(len($commands)) .. " entries")
  else
    $i = 0
    while $i < len($commands)
      $command = $commands[$i]
      if type($command) == "map" and has_key($command, "name") then
        $expected = "    {name:\"" .. to_string($command.name) .. "\", owner:\"" .. to_string($command.owner) .. "\", version:\"" .. to_string($command.version) .. "\", status:\"" .. to_string($command.status) .. "\", class:\"" .. to_string($command.class) .. "\"}"
        if $schema >= 4 then
          $expected = strip_suffix($expected, "}") .. ", schema:\"" .. to_string($command.schema) .. "\"}"
        end
        if $i < len($commands) - 1 then
          $expected = $expected .. ","
        end
        if $entry_lines[$i] != $expected then
          push($problems, "canonical form: line for " .. to_string($command.name) .. " should read: " .. trim($expected))
        end
      end
      $i = $i + 1
    end
  end
end

if $schema >= 3 then
  $fblock = find_block($lines, "families")
  if $fblock.start < 0 or $fblock.end_at < 0 then
    push($problems, "no `families: [` … `]` block on lines of their own")
  else
    $family_lines = block_lines($lines, $fblock)
    if len($family_lines) != len($families) then
      push($problems, "canonical form: " .. to_string(len($family_lines)) .. " family lines for " .. to_string(len($families)) .. " families")
    else
      $i = 0
      while $i < len($families)
        $f = $families[$i]
        if type($f) == "map" and has_key($f, "pattern") and type($f.pattern) == "string" then
          $mem = "\"instances\""
          if type($f.members) == "list" then $mem = quoted_list($f.members) end
          $expected = "    {pattern:\"" .. to_string($f.pattern) .. "\", owner:\"" .. to_string($f.owner) .. "\", members:" .. $mem .. ", version:\"" .. to_string($f.version) .. "\", status:\"" .. to_string($f.status) .. "\", class:\"" .. to_string($f.class) .. "\"}"
          if $schema >= 4 then
            $expected = strip_suffix($expected, "}") .. ", schema:\"" .. to_string($f.schema) .. "\"}"
          end
          if $i < len($families) - 1 then
            $expected = $expected .. ","
          end
          if $family_lines[$i] != $expected then
            push($problems, "canonical form: line for " .. to_string($f.pattern) .. " should read: " .. trim($expected))
          end
        end
        $i = $i + 1
      end
    end
  end
end

-- Outside the commands block, nothing may look like a concrete entry to a line
-- reader (families lines included: they use pattern:).
$i = 0
while $i < len($lines)
  if ($vblock.start < 0 or $i <= $vblock.start or $i >= $vblock.end_at) and contains($lines[$i], "name:" .. "\"") then
    push($problems, "line " .. to_string($i + 1) .. ": name:" .. "\"" .. " outside an entry line")
  end
  $i = $i + 1
end

-- Source check: explicit --source, or the repository default with no FILE.
$source_note = ""
if $source != nil then
  $report = $src.check_source($source, $good)
  for each $p in $report.problems
    push($problems, $p)
  end
  $source_note = "source: " .. to_string($report.declared) .. " on @ declarations in " .. to_string($report.files) .. " files"
end

-- Instance check: the config names in --instances DIR.
$instance_note = ""
if $instances != nil then
  $report = $src.check_instances($instances, $concrete, $member_owner, $has_instance_family)
  for each $p in $report.problems
    push($problems, $p)
  end
  $instance_note = "instances: " .. to_string($report.count) .. " configs"
end

if len($problems) > 0 then
  for each $p in $problems
    print("command_registry: " .. $p)
  end
  exit(1)
end
print("command_registry: " .. to_string(len($commands)) .. " commands, " .. to_string(len($families)) .. " families, schema " .. to_string($schema) .. ", canonical, ok")
if $source_note != "" then print("command_registry: " .. $source_note .. ", ok") end
if $instance_note != "" then print("command_registry: " .. $instance_note .. ", ok") end
