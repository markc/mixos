-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.2.0
-- Validate component ownership and generate the public map without Cargo.
-- Two identity sources: Cargo workspace members ([package.metadata.mixos])
-- and Mix components (component.mx, docs/decisions/2026-10-10-mix-components.md).
$root = dirname(dirname(realpath($0)))
$check = contains(args(), "--check")
if len(args()) > 1 or (len(args()) == 1 and not $check) then
  raise("USAGE", "component_index.mix [--check]")
end
$workspace = toml_parse(read_file($root .. "/Cargo.toml"))
$manifests = []
for each $member in $workspace.workspace.members
  for each $path in glob($root .. "/" .. $member .. "/Cargo.toml")
    push($manifests, $path)
  end
end
$entries = []
$names = []
$kinds = {apps:"app", services:"service", cli:"cli", libs:"lib", tools:"tool", tests:"test"}
$layers = ["bus", "mix", "core", "desktop"]
$contracts = ["none", "public"]
for each $manifest in sort($manifests)
  $relative = substr($manifest, len($root) + 1)
  $parts = split($relative, "/")
  $pkg = toml_parse(read_file($manifest)).package
  $meta = $pkg.metadata.mixos
  $valid_kind = $meta.kind == $kinds[$parts[0]] or (len($parts) == 5 and $meta.kind == "test")
  if $pkg.publish != false or $meta.component != $parts[1] or not $valid_kind then
    raise("COMPONENT_IDENTITY", "Invalid component identity or publish flag: " .. $relative)
  end
  if len($parts) == 3 and $pkg.name != $meta.component then
    raise("COMPONENT_NAME", "Principal package does not match its directory: " .. $relative)
  end
  if not contains($layers, $meta.layer) or not contains($contracts, $meta.contract) then
    raise("COMPONENT_METADATA", "Invalid layer or contract: " .. $relative)
  end
  if contains($names, $pkg.name) then raise("COMPONENT_DUPLICATE", $pkg.name) end
  push($names, $pkg.name)
  $version = type($pkg.version) == "map" ? $workspace.workspace.package.version : $pkg.version
  push($entries, {path: $relative, name: $pkg.name, component: $meta.component, kind: $meta.kind, layer: $meta.layer, contract: $meta.contract, version: $version})
end
-- Mix components: one component.mx at the top of a kind directory, and no
-- Cargo.toml beside it (a component is one or the other).
for each $kind_dir in ["apps", "services", "cli", "libs"]
  for each $doc_path in sort(glob($root .. "/" .. $kind_dir .. "/*/component.mx"))
    $relative = substr($doc_path, len($root) + 1)
    $dir = dirname($doc_path)
    $dir_name = basename($dir)
    if is_file($dir .. "/Cargo.toml") then
      raise("COMPONENT_IDENTITY", "Both Cargo.toml and component.mx: " .. $relative)
    end
    $doc = load_data($doc_path)
    if type($doc) != "map" or $doc.schema != 1 then raise("COMPONENT_METADATA", "Expected schema 1: " .. $relative) end
    if $doc.name != $dir_name or $doc.component != $dir_name or $doc.kind != $kinds[$kind_dir] then
      raise("COMPONENT_IDENTITY", "Invalid component identity: " .. $relative)
    end
    if not contains($layers, $doc.layer) or not contains($contracts, $doc.contract) then
      raise("COMPONENT_METADATA", "Invalid layer or contract: " .. $relative)
    end
    if type($doc.version) != "string" or not re_match($doc.version, "^[0-9]+\\.[0-9]+\\.[0-9]+$") then
      raise("COMPONENT_METADATA", "Version must be MAJOR.MINOR.PATCH: " .. $relative)
    end
    $program = $doc.program ?? ""
    if type($program) != "string" or not ends_with($program, ".mix") or contains($program, "..") or starts_with($program, "/") or not is_file($dir .. "/" .. $program) then
      raise("COMPONENT_PROGRAM", "program must name a .mix file inside the component: " .. $relative)
    end
    if contains($names, $doc.name) then raise("COMPONENT_DUPLICATE", $doc.name) end
    push($names, $doc.name)
    push($entries, {path: $relative, name: $doc.name, component: $doc.component, kind: $doc.kind, layer: $doc.layer, contract: $doc.contract, version: $doc.version})
  end
end
$rows = map(sort_by($entries, fn($e) = $e.path), fn($e) =
  "| [" .. $e.name .. "](https://github.com/markc/mixos/blob/main/" .. $e.path .. ") | " .. $e.component .. " | " .. $e.kind .. " | " .. $e.layer .. " | " .. $e.contract .. " | " .. $e.version .. " |")
$output = "<!-- generated by tools/component_index.mix; do not edit -->\n# Components\n\nComponent ownership and declared layers come from the workspace manifests\nand, for Mix components, from `component.mx`. Private crates remain under\ntheir owning component. Dependency closure is checked separately by the\nlayering gate.\n\n| Package | Owner | Kind | Layer | Contract | Version |\n|---|---|---|---|---|---|\n" .. join($rows, "\n") .. "\n"
$dest = $root .. "/docs/dev/components.md"
if $check then
  if not is_file($dest) or read_file($dest) != $output then
    raise("COMPONENT_INDEX_STALE", "Run mix tools/component_index.mix")
  end
else
  mkdir(dirname($dest), {parents:true})
  write_file($dest, $output)
end
print("component identity and index: " .. to_string(len($names)) .. " components")
