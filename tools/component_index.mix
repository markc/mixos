-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Copyright 2026 Mark Constable <mc@mixos.dev>
-- version: 0.4.0
-- Validate component ownership without Cargo, and read every component's
-- metadata for the tools that publish it.
-- Two identity sources: Cargo workspace members ([package.metadata.mixos])
-- and Mix components (component.mx, docs/docs/decisions/2026-10-10-mix-components.md).
--
--   mix tools/component_index.mix [--check]   validate; print a one-line summary
--   mix tools/component_index.mix --json      validate; print every package as JSON
--
-- The public component index is /docs/components/, generated from --json by
-- docs/_build/gen-site.mix (docs/docs/decisions/2026-10-16-site-url-layout.md).
$root = dirname(dirname(realpath($0)))
$check = contains(args(), "--check")
$json = contains(args(), "--json")
if len(args()) > 1 or (len(args()) == 1 and not $check and not $json) then
  raise("USAGE", "component_index.mix [--check | --json]")
end
$profile_names = ["base", "desktop", "server"]
-- Install profiles (docs/docs/decisions/2026-10-12-one-repository-install-profiles.md):
-- declared only by a shipping principal (app, service, cli), non-empty, no
-- duplicates, only the three profiles. Absent means not yet classified: [].
fn check_profiles($profiles, $principal, $kind, $relative)
  if $profiles == nil then
    return []
  end
  if not $principal or not contains(["app", "service", "cli"], $kind) then
    raise("COMPONENT_PROFILES", $relative .. ": only the principal of an app, service or cli component declares profiles")
  end
  if type($profiles) != "list" or len($profiles) == 0 or len(unique($profiles)) != len($profiles) then
    raise("COMPONENT_PROFILES", $relative .. ": profiles must be a non-empty list without duplicates")
  end
  for each $p in $profiles
    if not contains($profile_names, $p) then
      raise("COMPONENT_PROFILES", $relative .. ": unknown install profile \"" .. to_string($p) .. "\" (base, desktop, server)")
    end
  end
  return $profiles
end
$workspace = toml_parse(read_file($root .. "/Cargo.toml"))
$manifests = []
for each $member in $workspace.workspace.members
  for each $path in glob($root .. "/" .. $member .. "/Cargo.toml")
    push($manifests, $path)
  end
end
$entries = []
$names = []
$kinds = {apps:"app", services:"service", cli:"cli", libs:"lib", tools:"tool", tests:"test"}
$layers = ["bus", "mix", "core", "desktop"]
$contracts = ["none", "public"]
-- Package name -> kind, and each package's non-dev dependency names, for
-- the cli rule (AGENTS.md §6).
$package_kinds = {}
$runtime_deps = {}
-- The names a manifest's dependency table refers to (a renamed dependency
-- by its `package`).
fn dependency_names($table)
  $out = []
  for each $key in keys($table ?? {})
    $spec = $table[$key]
    push($out, (type($spec) == "map" and $spec.package != nil) ? $spec.package : $key)
  end
  return $out
end
-- Component names (docs/decisions/2026-10-16-site-url-layout.md, "Component
-- names"): a lowercase letter, then lowercase letters, digits and hyphens.
-- `docs` and `v` are reserved.
fn check_component_name($name, $package, $relative)
  if type($name) != "string" or not re_match($name, "^[a-z][a-z0-9-]*$") then
    raise("COMPONENT_NAME", $package .. " in " .. $relative .. ": component \"" .. to_string($name) .. "\" must start with a lowercase letter, then contain only lowercase letters, digits and hyphens")
  end
  if contains(["docs", "v"], $name) then
    raise("COMPONENT_NAME", $package .. " in " .. $relative .. ": component \"" .. $name .. "\" is a reserved name (docs, v)")
  end
end
for each $manifest in sort($manifests)
  $relative = substr($manifest, len($root) + 1)
  $parts = split($relative, "/")
  $doc = toml_parse(read_file($manifest))
  $pkg = $doc.package
  $meta = $pkg.metadata.mixos
  check_component_name($meta.component, $pkg.name, $relative)
  $valid_kind = $meta.kind == $kinds[$parts[0]] or (len($parts) == 5 and $meta.kind == "test")
  if $pkg.publish != false or $meta.component != $parts[1] or not $valid_kind then
    raise("COMPONENT_IDENTITY", "Invalid component identity or publish flag: " .. $relative)
  end
  if len($parts) == 3 and $pkg.name != $meta.component then
    raise("COMPONENT_NAME", "Principal package does not match its directory: " .. $relative)
  end
  if not contains($layers, $meta.layer) or not contains($contracts, $meta.contract) then
    raise("COMPONENT_METADATA", "Invalid layer or contract: " .. $relative)
  end
  if contains($names, $pkg.name) then raise("COMPONENT_DUPLICATE", $pkg.name) end
  push($names, $pkg.name)
  $package_kinds[$pkg.name] = $meta.kind
  $deps = concat(dependency_names($doc.dependencies), dependency_names($doc["build-dependencies"]))
  for each $target in keys($doc.target ?? {})
    $deps = concat($deps, dependency_names($doc.target[$target].dependencies), dependency_names($doc.target[$target]["build-dependencies"]))
  end
  $runtime_deps[$pkg.name] = $deps
  $version = type($pkg.version) == "map" ? $workspace.workspace.package.version : $pkg.version
  $principal = len($parts) == 3
  $profiles = check_profiles($meta.profiles, $principal, $meta.kind, $relative)
  push($entries, {path: $relative, dir: dirname($relative), name: $pkg.name, component: $meta.component, kind: $meta.kind, layer: $meta.layer, contract: $meta.contract, version: $version, principal: $principal, profiles: $profiles})
end
-- No non-dev dependency on a `kind = "cli"` package, except from cli/system,
-- the system binary's host (docs/docs/decisions/2026-10-12-one-system-binary.md).
for each $name in sort(keys($runtime_deps))
  for each $dep in $runtime_deps[$name]
    if $package_kinds[$dep] == "cli" and $name != "system" then
      raise("COMPONENT_CLI_DEPENDENCY", $name .. " depends on the cli package " .. $dep .. "; only cli/system may")
    end
  end
end
-- Mix components: one component.mx at the top of a kind directory, and no
-- Cargo.toml beside it (a component is one or the other).
for each $kind_dir in ["apps", "services", "cli", "libs"]
  for each $doc_path in sort(glob($root .. "/" .. $kind_dir .. "/*/component.mx"))
    $relative = substr($doc_path, len($root) + 1)
    $dir = dirname($doc_path)
    $dir_name = basename($dir)
    if is_file($dir .. "/Cargo.toml") then
      raise("COMPONENT_IDENTITY", "Both Cargo.toml and component.mx: " .. $relative)
    end
    $doc = load_data($doc_path)
    if type($doc) != "map" or $doc.schema != 1 then raise("COMPONENT_METADATA", "Expected schema 1: " .. $relative) end
    check_component_name($doc.component, to_string($doc.name), $relative)
    if $doc.name != $dir_name or $doc.component != $dir_name or $doc.kind != $kinds[$kind_dir] then
      raise("COMPONENT_IDENTITY", "Invalid component identity: " .. $relative)
    end
    if not contains($layers, $doc.layer) or not contains($contracts, $doc.contract) then
      raise("COMPONENT_METADATA", "Invalid layer or contract: " .. $relative)
    end
    if type($doc.version) != "string" or not re_match($doc.version, "^[0-9]+\\.[0-9]+\\.[0-9]+$") then
      raise("COMPONENT_METADATA", "Version must be MAJOR.MINOR.PATCH: " .. $relative)
    end
    $program = $doc.program ?? ""
    if type($program) != "string" or not ends_with($program, ".mix") or contains($program, "..") or starts_with($program, "/") or not is_file($dir .. "/" .. $program) then
      raise("COMPONENT_PROGRAM", "program must name a .mix file inside the component: " .. $relative)
    end
    if contains($names, $doc.name) then raise("COMPONENT_DUPLICATE", $doc.name) end
    push($names, $doc.name)
    $profiles = check_profiles($doc.profiles, true, $doc.kind, $relative)
    push($entries, {path: $relative, dir: dirname($relative), name: $doc.name, component: $doc.component, kind: $doc.kind, layer: $doc.layer, contract: $doc.contract, version: $doc.version, principal: true, profiles: $profiles})
  end
end
if $json then
  print(json_encode(sort_by($entries, fn($e) = $e.path), true))
  exit(0)
end
print("component identity: " .. to_string(len($names)) .. " packages")
