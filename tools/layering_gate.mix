-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Copyright 2026 Mark Constable <mc@mixos.dev>
-- layering_gate.mix — component or cross-component crate layering gate.
-- version: 0.2.0
--
-- Purpose: map every workspace package to its layer from
--   services/compd/layers.conf.mix
--   and fail on any dependency edge that goes UP (from a lower layer to a
--   higher one), and on any package of the table's component missing from
--   the table ("unknown crate"). A table with `component: NAME` covers only
--   packages whose [package.metadata.mixos] component is NAME. Same-layer edges are allowed. Reads `cargo metadata
--   --format-version 1 --no-deps` (declared dependencies only: no resolution,
--   no compilation, no network) or a pre-saved metadata JSON.
--
-- Usage:
--   mix tools/layering_gate.mix (--manifest-path <Cargo.toml> | --metadata-file <json>)
--       [--layers <conf>] [--allow-unlisted] [--include-dev] [--require]
--       [--offline] [--locked] [--frozen]
--       [--across-components]
--     --manifest-path   workspace manifest; runs cargo metadata --no-deps.
--                       With --across-components, resolves external packages
--                       too so their transitive dependency paths are checked.
--     --metadata-file   pre-saved `cargo metadata --format-version 1` JSON
--                       (with or without --no-deps).
--     --layers          layer table (default: services/compd/layers.conf.mix
--                       under the repo root, found from this script's directory).
--     --allow-unlisted  warn instead of fail for workspace crates not in the
--                       table; their edges are not checked.
--     --include-dev     also check dev-dependency edges (default: normal+build;
--                       cargo permits dev-dependency cycles).
--     --across-components select listed workspace crates regardless of owner;
--                       check dependency paths through unlisted packages too,
--                       including edges to listed external GUI dependencies.
--                       --no-deps metadata covers all workspace paths and their
--                       declared external edges; resolved metadata additionally
--                       covers paths through external packages. Workspace
--                       optional deps are checked even when their features are
--                       off; external edges follow Cargo's resolved features.
--     --require         fail when no listed crate is in the workspace yet.
--     --offline/--locked/--frozen  passed through to cargo metadata.
--
-- Exit codes:
--   0  clean, or nothing to check (no listed crate in the workspace, no --require)
--   1  upward edge(s), unknown crate(s), or nothing to check with --require
--   2  bad arguments, unreadable/invalid layer table, cargo metadata failed

fn usage_die($msg)
  eprint("layering_gate: " .. $msg)
  eprint("usage: mix tools/layering_gate.mix (--manifest-path <Cargo.toml> | --metadata-file <json>) [--layers <conf>] [--across-components] [--allow-unlisted] [--include-dev] [--require] [--offline] [--locked] [--frozen]")
  exit(2)
end

fn kind_label($k)
  return $k ?? "normal"
end

-- ---- arguments ----
$tools = dirname(realpath($0))
$layers_path = dirname($tools) .. "/services/compd/layers.conf.mix"
$manifest = nil
$meta_file = nil
$allow_unlisted = false
$include_dev = false
$across = false
$require = false
$passthrough = []
$av = args()
$i = 0
while $i < len($av)
  $a = $av[$i]
  if $a == "--manifest-path" or $a == "--metadata-file" or $a == "--layers" then
    if $i + 1 >= len($av) then
      usage_die($a .. " needs a value")
    end
    $v = $av[$i + 1]
    if $a == "--manifest-path" then
      $manifest = $v
    elif $a == "--metadata-file" then
      $meta_file = $v
    else
      $layers_path = $v
    end
    $i = $i + 2
    continue
  elif $a == "--allow-unlisted" then
    $allow_unlisted = true
  elif $a == "--include-dev" then
    $include_dev = true
  elif $a == "--across-components" then
    $across = true
  elif $a == "--require" then
    $require = true
  elif $a == "--offline" or $a == "--locked" or $a == "--frozen" then
    push($passthrough, $a)
  elif $a == "-h" or $a == "--help" then
    print("see the header of " .. $0 .. " for usage")
    exit(0)
  else
    usage_die("unknown argument: " .. $a)
  end
  $i = $i + 1
end
if ($manifest == nil) == ($meta_file == nil) then
  usage_die("give exactly one of --manifest-path or --metadata-file")
end

-- ---- layer table ----
if !is_file($layers_path) then
  usage_die("layer table not found: " .. $layers_path)
end
$conf = nil
try
  $conf = validate(load_data($layers_path), {layers: {type: "map"}, binary: {type: "string", nonblank: true}, effects_crates: {type: "list", items: {type: "string"}}, core_crates: {type: "list", items: {type: "string"}}})
catch $msg
  eprint("layering_gate: invalid layer table " .. $layers_path .. ": " .. $msg)
  exit(2)
end
$layers = $conf.layers
for each $k in keys($layers)
  if type($layers[$k]) != "number" or floor($layers[$k]) != $layers[$k] or $layers[$k] < 0 then
    eprint("layering_gate: layer for " .. $k .. " is not an integer: " .. to_string($layers[$k]))
    exit(2)
  end
end

-- ---- metadata ----
$raw = nil
if $meta_file != nil then
  if !is_file($meta_file) then
    usage_die("metadata file not found: " .. $meta_file)
  end
  $raw = read_file($meta_file)
else
  if !is_file($manifest) then
    usage_die("manifest not found: " .. $manifest)
  end
  $argv = ["cargo", "metadata", "--format-version", "1"]
  if !$across then push($argv, "--no-deps") end
  $argv = concat($argv, ["--manifest-path", $manifest], $passthrough)
  $r = run_argv($argv, {timeout: 600, max_output: 536870912})
  if !$r.ok or $r.stdout_truncated then
    eprint("layering_gate: cargo metadata failed" .. if $r.stdout_truncated then " (stdout truncated)" else "" end)
    eprint($r.stderr)
    exit(2)
  end
  $raw = $r.stdout
end
$meta = nil
try
  $meta = json_parse($raw)
catch $msg
  eprint("layering_gate: metadata is not JSON: " .. $msg)
  exit(2)
end

-- workspace packages by name
$member_ids = {}
for each $id in $meta.workspace_members ?? []
  $member_ids[$id] = true
end
-- A table that names its component covers only that component's packages
-- ([package.metadata.mixos] component); everything else in the workspace
-- (shared libs, other components) sits outside it and is not checked here.
$component = $conf.component ?? nil
$ws = {}
$graph = {}
$id_names = {}
for each $p in $meta.packages ?? []
  $id_names[$p.id] = $p.name
end
-- External packages can declare inactive GUI tooling (for example a GPU
-- allocator's optional visualiser). Follow their resolved feature edges,
-- rather than treating every feature in their manifest as enabled.
$resolved = {}
for each $node in ($meta.resolve ?? {}).nodes ?? []
  $deps = []
  for each $edge in $node.deps ?? []
    for each $kind in $edge.dep_kinds ?? [{kind: nil}]
      push($deps, {name: $id_names[$edge.pkg], kind: $kind.kind})
    end
  end
  $resolved[$node.id] = $deps
end
for each $p in $meta.packages ?? []
  -- Multiple external versions may share a name. Union their declarations
  -- conservatively instead of overwriting one version's edges.
  $deps = $p.dependencies ?? []
  if $member_ids[$p.id] == nil and $resolved[$p.id] != nil then
    $deps = $resolved[$p.id]
  end
  $graph[$p.name] = concat($graph[$p.name] ?? [], $deps)
  if $member_ids[$p.id] != nil then
    $owner = (($p.metadata ?? {}).mixos ?? {}).component ?? nil
    if ($across and $layers[$p.name] != nil) or (!$across and ($component == nil or $owner == $component)) then
      $ws[$p.name] = $p
    end
  end
end
$names = sort(keys($ws))
$listed = filter($names, fn($n) = $layers[$n] != nil)
$unlisted = filter($names, fn($n) = $layers[$n] == nil)

print("layering gate: " .. len($names) .. " workspace packages, " .. len($listed) .. " in the layer table, " .. len($unlisted) .. " unlisted")
if len($listed) == 0 then
  if $require then
    eprint("FAIL: nothing to check — no crate from " .. $layers_path .. " is in this workspace (--require)")
    exit(1)
  end
  print("nothing to check: no crate from the layer table is in this workspace yet")
  exit(0)
end

-- ---- edges ----
$up = []
$to_unlisted = 0
$checked = 0
for each $n in $listed
  if $across then
    $pending = [{name: $n, path: $n}]
    $seen = {}
    while len($pending) > 0
      $next = $pending[0]
      $pending = slice($pending, 1, len($pending))
      if $seen[$next.name] != nil then continue end
      $seen[$next.name] = true
      for each $d in $graph[$next.name] ?? []
        if $d.kind == "dev" and !$include_dev then continue end
        $checked = $checked + 1
        $path = $next.path .. " -> " .. $d.name
        if $layers[$d.name] != nil and $layers[$d.name] > $layers[$n] then
          push($up, $path .. " (" .. $layers[$n] .. " -> " .. $layers[$d.name] .. ") [" .. kind_label($d.kind) .. "]")
        elif $graph[$d.name] != nil and $seen[$d.name] == nil then
          push($pending, {name: $d.name, path: $path})
        end
      end
    end
    continue
  end
  $p = $ws[$n]
  for each $d in $p.dependencies ?? []
    if $ws[$d.name] == nil then
      continue
    end
    if $d.kind == "dev" and !$include_dev then
      continue
    end
    $tl = $layers[$d.name]
    if $tl == nil then
      $to_unlisted = $to_unlisted + 1
      continue
    end
    $checked = $checked + 1
    if $tl > $layers[$n] then
      push($up, $n .. " (L" .. $layers[$n] .. ") -> " .. $d.name .. " (L" .. $tl .. ") [" .. kind_label($d.kind) .. "]")
    end
  end
end

$fail = false
if len($up) > 0 then
  $fail = true
  print("")
  print("FAIL: " .. len($up) .. " upward edge(s) (lower layer -> higher layer):")
  for each $e in sort(unique($up))
    print("  " .. $e)
  end
end
if len($unlisted) > 0 then
  print("")
  if $allow_unlisted then
    print("WARN: " .. len($unlisted) .. " workspace crate(s) not in the layer table (--allow-unlisted; edges to/from them not checked):")
  else
    $fail = true
    print("FAIL: " .. len($unlisted) .. " unknown crate(s) (not in " .. $layers_path .. "):")
  end
  $shown = 0
  for each $n in $unlisted
    if $allow_unlisted and $shown >= 20 then
      print("  … and " .. (len($unlisted) - $shown) .. " more")
      break
    end
    print("  " .. $n)
    $shown = $shown + 1
  end
end
print("")
print("checked " .. $checked .. " edge(s) between listed crates" .. if $to_unlisted > 0 then "; " .. $to_unlisted .. " edge(s) from listed to unlisted crates not checked" else "" end .. if $include_dev then " (dev edges included)" else " (normal+build)" end)
if $fail then
  exit(1)
end
print("OK: layering clean")
exit(0)
