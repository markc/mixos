-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Gold's host entrance journal. Receipt names never supply arbitrary paths.
$files = require("../../share/layout/files.mix")
$PATHS = {link: "/usr/local/bin/mix", shells: "/etc/shells"}

fn stage($root, $live)
  if $live then return "" end
  $path = $root .. "/.layout-root"
  if not is_dir($path) or stat($path, {follow_symlinks: false}).is_symlink or realpath($path) != $path then
    raise("GOLD_RECEIPT", "fixture entrance needs its canonical .layout-root directory")
  end
  return $path
end

-- A plan validates a missing fixture root without creating it.
fn planning_stage($root, $live)
  if $live then return "" end
  $path = $root .. "/.layout-root"
  if exists($path, {follow_symlinks: false}) then return stage($root, $live) end
  $files.destination("", $path .. "/check")
  return $path
end

fn state($path)
  if not exists($path, {follow_symlinks: false}) then return {kind: "absent"} end
  $st = stat($path, {follow_symlinks: false})
  if $st.is_symlink then return {kind: "link", target: read_link($path)} end
  if $st.is_file then return {kind: "file", sha256: hash_file($path, "sha256")} end
  raise("GOLD_ENTRANCE", "entrance path is not a file or symlink: " .. $path)
end

fn checked_state($value, $name, $after, $root)
  if type($value) != "map" then raise("GOLD_RECEIPT", "invalid entrance state") end
  if $value.kind == "absent" and not $after then return end
  if $name == "link" and $value.kind == "link" and type($value.target) == "string" then
    if $after and $value.target != $root .. "/bin/mix" then raise("GOLD_RECEIPT", "entrance link does not name target mix") end
    return
  end
  if $name == "shells" and $value.kind == "file" and type($value.sha256) == "string" and re_match($value.sha256, "^[a-f0-9]{64}$") then return end
  raise("GOLD_RECEIPT", "invalid entrance state for " .. $name)
end

fn verify($record, $root, $live)
  if $record == nil then return end
  $where = if $live then "host" else "mixos:prefix/.layout-root" end
  if type($record) != "map" or $record.schema != 1 or $record.sysroot != $where or type($record.files) != "list" or len($record.files) > 2 then
    raise("GOLD_RECEIPT", "invalid entrance journal")
  end
  if has_key($record, "started") and type($record.started) != "bool" then raise("GOLD_RECEIPT", "invalid entrance started flag") end
  $seen = []
  for $entry in $record.files
    if type($entry.name) != "string" or not has_key($PATHS, $entry.name) or contains($seen, $entry.name) or type($entry.same) != "bool" then raise("GOLD_RECEIPT", "invalid entrance target") end
    push($seen, $entry.name)
    checked_state($entry.before, $entry.name, false, $root)
    checked_state($entry.after, $entry.name, true, $root)
    if $entry.same != deep_eq($entry.before, $entry.after) then raise("GOLD_RECEIPT", "invalid entrance unchanged flag") end
  end
end

-- Back up prior bytes/metadata before the pending receipt is published.
fn capture($pending, $root, $live, $backup)
  $record = {schema: 1, sysroot: if $live then "host" else "mixos:prefix/.layout-root" end, started: false, files: []}
  $stage = stage($root, $live)
  $files.preflight($pending)
  for $entry in $pending
    $name = if $entry.path == $PATHS.link then "link" elif $entry.path == $PATHS.shells then "shells" else "" end
    if $name == "" or $entry.stage != $stage then raise("GOLD_ENTRANCE", "unexpected entrance plan target") end
    $dest = $files.destination($stage, $PATHS[$name])
    $before = state($dest)
    if $name == "shells" then
      $text = $files.shells_contents($stage)
      if $before.kind == "file" and hash_sha256($text) != $before.sha256 then raise("GOLD_ENTRANCE_CHANGED", "shells changed during capture") end
      $entry.text = $files.shells_text($text, $PATHS.link)
    end
    $after = if $name == "link" then {kind: "link", target: $entry.link} else {kind: "file", sha256: hash_sha256($entry.text)} end
    $same = deep_eq($before, $after)
    if not $same and $before.kind != "absent" then
      mkdir($backup .. "/.entrance", {parents: true})
      $copy = $backup .. "/.entrance/" .. $name
      run_argv_must(["cp", "-a", "--", $dest, $copy], {timeout: 30})
      if not deep_eq(state($copy), $before) then raise("GOLD_BACKUP", "entrance backup differs: " .. $name) end
    end
    $record.files = push($record.files, {name: $name, before: $before, after: $after, same: $same})
  end
  verify($record, $root, $live)
  return $record
end

-- Validate the entire entrance immediately before its first write. Read
-- shells again and compose from these bytes, never from the earlier plan.
fn prepare_apply($record, $root, $live)
  verify($record, $root, $live)
  if $record == nil then return [] end
  $stage = stage($root, $live)
  $pending = []
  for $entry in $record.files
    $dest = $files.destination($stage, $PATHS[$entry.name])
    if not deep_eq(state($dest), $entry.before) then raise("GOLD_ENTRANCE_CHANGED", "entrance changed after capture: " .. $dest) end
    if $entry.name == "link" then
      push($pending, {stage: $stage, path: $PATHS.link, link: $entry.after.target})
    else
      $text = $files.shells_contents($stage)
      if $entry.before.kind == "file" and hash_sha256($text) != $entry.before.sha256 then raise("GOLD_ENTRANCE_CHANGED", "shells changed before append") end
      $text = $files.shells_text($text, $PATHS.link)
      if hash_sha256($text) != $entry.after.sha256 then raise("GOLD_ENTRANCE_CHANGED", "shells no longer matches the captured append") end
      push($pending, {stage: $stage, path: $PATHS.shells, text: $text})
    end
  end
  $files.preflight($pending)
  return $pending
end

-- The only change gold ever makes to /etc/shells is appending the link's
-- line, so undo is line-oriented: other lines added since (add-shell, an
-- admin edit) are kept.
fn shells_without_line($dest)
  if not is_file($dest) then return nil end
  $text = read_file($dest)
  $kept = filter(lines($text), fn($l) = $l != $PATHS.link)
  if len($kept) == len(lines($text)) then return nil end
  return if len($kept) == 0 then "" else join($kept, "\n") .. "\n" end
end

fn assert_restored($record, $root, $live)
  verify($record, $root, $live)
  if $record == nil or $record.started == false then return end
  $stage = stage($root, $live)
  for $entry in $record.files
    -- An unchanged entry was never touched by this receipt.
    if $entry.same then continue end
    $dest = $files.destination($stage, $PATHS[$entry.name])
    if deep_eq(state($dest), $entry.before) then continue end
    if $entry.name == "shells" and is_file($dest) and not contains(lines(read_file($dest)), $PATHS.link) then continue end
    raise("GOLD_ROLLBACK_FOREIGN", "recovered entrance changed: " .. $dest)
  end
end

fn restore($record, $root, $live, $backup, $id)
  verify($record, $root, $live)
  if $record == nil or $record.started == false then return end
  if not re_match($id, "^[a-z0-9-]{8,100}$") then raise("GOLD_RECEIPT", "invalid entrance receipt id") end
  $stage = stage($root, $live)
  -- Validate all states and backups before undoing the first entrance target.
  $undo = []
  for $entry in reverse($record.files)
    -- An unchanged entry was never touched by this receipt: nothing to undo,
    -- even if the path was legitimately changed later.
    if $entry.same then continue end
    $dest = $files.destination($stage, $PATHS[$entry.name])
    $current = state($dest)
    if deep_eq($current, $entry.before) then continue end
    if $entry.name == "shells" and not deep_eq($current, $entry.after) then
      -- Edited since install: drop only our line, keep everything else.
      $text = shells_without_line($dest)
      if $text == nil then continue end
      if not access(dirname($dest), "wx") then raise("GOLD_WRITABLE", "cannot restore entrance " .. $dest) end
      push($undo, {path: $dest, text: $text})
      continue
    end
    if not deep_eq($current, $entry.after) then raise("GOLD_ROLLBACK_FOREIGN", "entrance changed since install: " .. $dest) end
    $copy = $backup .. "/.entrance/" .. $entry.name
    if $entry.before.kind != "absent" and not deep_eq(state($copy), $entry.before) then raise("GOLD_BACKUP", "entrance backup differs: " .. $entry.name) end
    $parent = dirname($dest)
    if not access($parent, "wx") then raise("GOLD_WRITABLE", "cannot restore entrance " .. $dest) end
    push($undo, {path: $dest, copy: $copy, before: $entry.before})
  end
  for $entry in $undo
    if $entry.text != nil then write_atomic($entry.path, $entry.text)
    elif $entry.before.kind == "absent" then remove($entry.path)
    else
      $temp = $entry.path .. ".rollback-" .. $id
      if exists($temp, {follow_symlinks: false}) then remove($temp) end
      try
        run_argv_must(["cp", "-a", "--", $entry.copy, $temp], {timeout: 30})
        rename($temp, $entry.path)
      finally
        if exists($temp, {follow_symlinks: false}) then remove($temp) end
      end
    end
  end
end
