-- Pure selection over Cargo metadata and repository-relative changed paths.
fn owner($file, $metadata)
  $best = nil
  $width = 0
  for $pkg in $metadata.packages
    if contains($metadata.workspace_members, $pkg.id) then
      $dir = dirname($pkg.manifest_path)
      $path = $metadata.workspace_root .. "/" .. $file
      if starts_with($path, $dir .. "/") and len($dir) > $width then
        $best = $pkg.id
        $width = len($dir)
      end
    end
  end
  return $best
end

fn full_reason($file)
  if starts_with($file, "rust-toolchain") then return $file end
  for $prefix in [".cargo/", "vendor/"]
    if starts_with($file, $prefix) then return $file end
  end
  if basename($file) == "layers.conf.mix" then return $file end
  return ""
end

fn narrow_input($file, $id, $packages)
  for $pkg in $packages.packages
    if $pkg.id == $id then
      $path = $packages.workspace_root .. "/" .. $file
      $relative = slice($path, len(dirname($pkg.manifest_path)) + 1)
      if $relative == "Cargo.toml" or $relative == "build.rs" then return true end
      if starts_with($relative, "tests/") and ends_with($relative, ".mix") then return true end
      if starts_with($relative, "i18n/") and ends_with($relative, ".ftl") then return true end
      if ends_with($relative, ".rs") then
        for $prefix in ["src/", "tests/", "benches/", "examples/"]
          if starts_with($relative, $prefix) then return true end
        end
      end
      return false
    end
  end
  return false
end

-- Context is supplied from the exact two Git trees, never the working tree.
fn diff_context($base, $tip)
  $ctx = {root_full: false, locked: []}
  $old = toml_parse(run_argv_must(["git", "show", $base .. ":Cargo.toml"]))
  $new = toml_parse(run_argv_must(["git", "show", $tip .. ":Cargo.toml"]))
  $ctx.root_full = not deep_eq($old.workspace, $new.workspace) or not deep_eq($old.profile, $new.profile)
  $before = lock_pairs(toml_parse(run_argv_must(["git", "show", $base .. ":Cargo.lock"])))
  $after = lock_pairs(toml_parse(run_argv_must(["git", "show", $tip .. ":Cargo.lock"])))
  for $name in sort(concat(keys($before), keys($after)))
    if not deep_eq(sort($before[$name] ?? []), sort($after[$name] ?? [])) and not contains($ctx.locked, $name) then
      $ctx.locked = push($ctx.locked, $name)
    end
  end
  return $ctx
end

fn lock_pairs($lock)
  $pairs = {}
  for $pkg in $lock.package
    $versions = $pairs[$pkg.name] ?? []
    push($versions, $pkg.version)
    $pairs[$pkg.name] = $versions
  end
  return $pairs
end

fn mix_names($files, $packages, $crates)
  $names = []
  for $pkg in $packages.packages
    if contains($crates, $pkg.name) then
      push($names, slice(dirname($pkg.manifest_path), len($packages.workspace_root) + 1) .. "/")
    end
  end
  for $file in $files
    if ends_with($file, ".mix") and (starts_with($file, "tests/") or starts_with($file, "tools/")) then
      if ends_with($file, "_test.mix") then push($names, $file)
      else push($names, replace(basename($file), ".mix", "_test.mix")) end
    end
  end
  return sort($names)
end

fn covered($name, $files)
  $prefixes = if $name == "offscreen" then ["vendor/egui-wgpu/", "libs/toolkit/", "libs/design/"]
    elif $name == "latency" then ["services/editd/", "libs/editor/"]
    elif $name == "relocation" then ["libs/paths/", "share/layout/", "cli/mix-shell/src/layout"]
    else ["share/layout/", "libs/paths/", "cli/mix-shell/src/layout"] end
  for $file in $files
    if $file == "tests/layout_" .. replace($name, "layout-", "") .. "_test.mix" then return true end
    if $name == "layout-templates" and contains($file, "/units/") then return true end
    for $prefix in $prefixes
      if starts_with($file, $prefix) then return true end
    end
  end
  return false
end

fn select_affected($files, $packages, $graph, $context = nil)
  $selected = []
  $reason = ""
  for $file in $files
    if starts_with($file, "docs/") or ends_with($file, ".md") or starts_with($file, ".github/") then continue end
    if contains(["Cargo.toml", "Cargo.lock"], $file) then
      if $context == nil then
        if $reason == "" then $reason = "missing diff context: " .. $file end
      elif $file == "Cargo.toml" then
        if $context.root_full and $reason == "" then $reason = "global input: Cargo.toml" end
      else
        for $pkg in $graph.packages
          if contains($context.locked, $pkg.name) and not contains($selected, $pkg.id) then push($selected, $pkg.id) end
        end
      end
      continue
    end
    if ends_with($file, ".mix") and (starts_with($file, "tests/") or starts_with($file, "tools/")) then continue end
    $forced = full_reason($file)
    if $forced != "" and $reason == "" then $reason = "global input: " .. $forced end
    $id = owner($file, $packages)
    if $id == nil then
      if $reason == "" then $reason = "outside workspace packages: " .. $file end
    else
      if not narrow_input($file, $id, $packages) and $reason == "" then
        $reason = "non-source package input: " .. $file
      end
      if not contains($selected, $id) then push($selected, $id) end
    end
  end
  -- Traverse all resolve edges, including dev, build and target-specific ones.
  -- External nodes can connect two workspace members too.
  $changed = true
  while $changed
    $changed = false
    for $node in $graph.resolve.nodes
      if not contains($selected, $node.id) then
        for $dep in $node.dependencies
          if contains($selected, $dep) then
            push($selected, $node.id)
            $changed = true
            break
          end
        end
      end
    end
  end
  $names = []
  for $pkg in $packages.packages
    if contains($packages.workspace_members, $pkg.id) and contains($selected, $pkg.id) then push($names, $pkg.name) end
  end
  $names = sort($names)
  if len($names) * 2 > len($packages.workspace_members) and $reason == "" then
    $reason = "more than half the workspace affected"
  end
  return {crates: $names, full: $reason != "", reason: $reason}
end
