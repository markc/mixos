-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Preserve the newest 20, active runs, and logs referenced by retained CBC
-- receipts or their associated stdout logs. Old formats need no migration.
fn prune($base, $receipts, $keep)
  $dirs = []
  for $name in filter(split(run_argv_must(["find", $base, "-mindepth", "1", "-maxdepth", "1", "-printf", "%f\\0"]), "\u{0}"), fn($n) = $n != "")
    if starts_with($name, "mixos-release-gate-") then
      $path = $base .. "/" .. $name
      $s = stat($path, {follow_symlinks: false})
      if $s.is_dir and $s.uid == uid() then
        push($dirs, {path: $path, mtime: $s.mtime})
      end
    end
  end
  $pinned = {}
  if is_dir($receipts) then
    for $name in filter(split(run_argv_must(["find", $receipts, "-mindepth", "1", "-maxdepth", "1", "-printf", "%f\\0"]), "\u{0}"), fn($n) = $n != "")
      $path = $receipts .. "/" .. $name
      if is_file($path) then
        $text = read_file($path)
        for $d in $dirs
          if contains($text, $d.path) then $pinned[$d.path] = true end
        end
      end
    end
  end
  $dirs = reverse(sort_by($dirs, fn($d) = $d.mtime))
  $i = 0
  for $d in $dirs
    $i = $i + 1
    if $i > $keep and not ($pinned[$d.path] ?? false) then
      $active = $d.path .. "/active.pid"
      if not is_file($active) or not process_alive(to_number(trim(read_file($active)))) then
        remove_dir($d.path)
      end
    end
  end
end
