-- SPDX-License-Identifier: MIT OR Apache-2.0
-- A checkout owns only executables canonically below its target/ directory.
-- proc_root permits deterministic fixtures without signalling real processes.
fn identity($proc_root, $id, $target)
  try
    $base = $proc_root .. "/" .. to_string($id)
    $text = read_file($base .. "/stat")
    $fields = split(slice($text, last_index_of($text, ")") + 2), " ")
    if len($fields) < 20 or $fields[1] != "1" then return nil end
    $exe = realpath($base .. "/exe")
    if $exe == nil or not starts_with($exe, $target .. "/") then return nil end
    return {pid: $id, start: $fields[19], exe: $exe}
  catch $message
    -- Processes may exit while /proc is being read. Other users' exe links
    -- may be unreadable; they cannot be established as this checkout's own.
    return nil
  end
end

fn snapshot($target, $proc_root = "/proc")
  $target = realpath($target)
  if $target == nil then return [] end
  $found = []
  for $path in glob($proc_root .. "/*/stat")
    $name = basename(dirname($path))
    if not re_match($name, "^[0-9]+$") then continue end
    $item = identity($proc_root, to_number($name), $target)
    if $item != nil then push($found, $item) end
  end
  return $found
end

fn added($before, $after)
  return filter($after, fn($item) = not any($before,
    fn($old) = $old.pid == $item.pid and $old.start == $item.start))
end

fn same_orphan($item, $target)
  $now = identity("/proc", $item.pid, $target)
  return $now != nil and $now.start == $item.start and $now.exe == $item.exe
end

fn finish($name, $target, $before)
  $target = realpath($target)
  if $target == nil then return end
  $after = snapshot($target)
  $new = added($before, $after)
  print("ORPHANS " .. $name .. " before=" .. len($before) .. " after=" .. len($after) .. " new=" .. len($new))
  for $item in $new
    if not same_orphan($item, $target) then continue end
    $report = run_argv(["ps", "-o", "pid,etime,args,tty", "-p", to_string($item.pid)], {timeout: 10})
    print(trim($report.stdout))
    -- ps is diagnostic only. Revalidate ownership and start time immediately
    -- before signalling, including after a diagnostic delay.
    if same_orphan($item, $target) then kill($item.pid, 9) end
  end
  if len($new) > 0 then
    raise("RELEASE_GATE", $name .. " leaked " .. len($new) .. " orphan processes")
  end
end
