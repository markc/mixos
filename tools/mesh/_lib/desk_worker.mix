-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Namespace-local primitives. dispatch is the only remote entry point.
-- Requiring this module never performs I/O or runs a service command.

fn refuse($message)
  raise("DESK_DISTRIBUTOR", $message)
end

fn plain($value)
  return type($value) == "string" and re_match($value, "^[a-z][a-z0-9-]{0,31}$")
end

fn no_links($path)
  $cursor = $path
  while $cursor != "/"
    if exists($cursor, {follow_symlinks:false}) then
      if stat($cursor, {follow_symlinks:false}).is_symlink then refuse("symlink in target path") end
    end
    $cursor = dirname($cursor)
  end
end

fn file_state($path)
  no_links($path)
  if not exists($path, {follow_symlinks:false}) then return {present:false} end
  $s = stat($path, {follow_symlinks:false})
  if not $s.is_file or $s.nlink != 1 then refuse("target must be a single-link regular file") end
  return {present:true, sha256:hash_file($path,"sha256"), uid:$s.uid,gid:$s.gid,perm:$s.perm,
    dev:$s.dev,ino:$s.ino,ctime:$s.ctime,ctime_nsec:$s.ctime_nsec}
end

fn directory($path, $uid, $gid, $perm)
  no_links($path)
  $s = stat($path, {follow_symlinks:false})
  if not $s.is_dir or $s.uid != $uid or $s.gid != $gid or $s.perm != $perm then refuse("profile directory ownership or mode differs from plan") end
  return {dev:$s.dev,ino:$s.ino,uid:$s.uid,gid:$s.gid,perm:$s.perm}
end

fn property($unit, $name)
  return trim(run_argv_must(["systemctl","show",$unit,"--property=" .. $name,"--value"],{timeout:10}))
end

-- A final, mandatory, root-owned environment file makes the service binding
-- explicit. The bounded format is literal KEY=value, not arbitrary shell.
fn service_binding($target, $gid)
  $path = $target.etc .. "/noded/service.env"
  $s = file_state($path)
  if not $s.present or $s.uid != 0 or $s.gid != $gid or $s.perm != 0o640 then refuse("dedicated service environment is not root-owned 0640") end
  if property($target.unit,"User") != $target.account then refuse("session unit account mismatch") end
  if not ends_with(property($target.unit,"EnvironmentFiles"), $path .. " (ignore_errors=no)") then refuse("dedicated environment must be the final mandatory unit environment file") end
  $prefix = upper($target.project)
  $expected = {}
  $expected[$prefix .. "_ETC"] = $target.etc
  $expected[$prefix .. "_VAR"] = $target.var
  $expected[$prefix .. "_NODE_CONFIG"] = $target.etc .. "/node.conf.mix"
  $expected[$prefix .. "_RUN"] = $target.run
  $expected[$prefix .. "_BROKER_ACCOUNT"] = $target.account
  $actual = {}
  for $line in lines(read_file($path))
    if trim($line) == "" or starts_with(trim($line),"#") then continue end
    $fields = split($line,"=")
    if len($fields) != 2 or has_key($actual,$fields[0]) then refuse("service environment must contain unique literal assignments") end
    $actual[$fields[0]] = $fields[1]
  end
  if not deep_eq($expected,$actual) then refuse("service environment differs from target plan") end
  for $key in keys($expected)
    if contains(property($target.unit,"UnsetEnvironment"),$key) then refuse("unit unsets required profile environment") end
  end
  $start = property($target.unit,"ExecStart")
  if contains($start,"--node") or contains($start,"--listen") or contains($start,"--mesh-config") then refuse("unit command overrides profile identity or endpoint") end
  return {environment:$s,command:$start}
end

fn namespace_context($request)
  $t = $request.target
  if type($t) != "map" or $t.kind != "desk" or not plain($t.project) or not plain($t.node) or not plain($t.account) or $t.account == "root" then refuse("invalid desk identity") end
  if type($t.session) != "number" or floor($t.session) != $t.session or $t.session < 1 or $t.session > 6 then refuse("invalid session") end
  if not re_match($t.profile,"^/var/lib/" .. $t.project .. "/[a-z][a-z0-9-]{0,31}$") then refuse("invalid profile") end
  if $t.etc != $t.profile .. "/etc" or $t.var != $t.profile .. "/var" or $t.run != "/run/" .. $t.project .. "/session/" .. to_string($t.session) or $t.unit != "noded@" .. to_string($t.session) .. ".service" then refuse("inconsistent desk paths") end
  if trim(run_argv_must(["id","-u"])) != "0" then refuse("admin operation requires namespace root") end
  $ancestor = dirname($t.profile)
  while $ancestor != "/"
    no_links($ancestor)
    $a = stat($ancestor,{follow_symlinks:false})
    if not $a.is_dir or $a.uid != 0 or floor($a.perm / 16) % 2 != 0 or floor($a.perm / 2) % 2 != 0 then refuse("profile ancestor must be root-owned and not writable by others") end
    $ancestor = dirname($ancestor)
  end
  $uid = to_number(trim(run_argv_must(["id","-u",$t.account])))
  $gid = to_number(trim(run_argv_must(["id","-g",$t.account])))
  if $uid == 0 or $gid == 0 then refuse("desk account must have private unprivileged ids") end
  $dirs = {}
  for $path in [$t.profile,$t.etc,$t.etc .. "/noded",$t.var]
    $dirs[$path] = directory($path,0,$gid,0o750)
  end
  $dirs[$t.var .. "/noded"] = directory($t.var .. "/noded",$uid,$gid,0o700)
  $binding = service_binding($t,$gid)
  $binary = dirname($request.mix_bin) .. "/noded"
  if not contains($binding.command,"path=" .. $binary .. " ;") then refuse("unit does not execute the planned native noded") end
  $version = trim(run_argv_must([$binary,"--version"],{timeout:10}))
  $binary_hash = hash_file($binary,"sha256")
  $config_path = $t.etc .. "/node.conf.mix"
  $config_state = file_state($config_path)
  if not $config_state.present or $config_state.uid != 0 or $config_state.gid != $gid or $config_state.perm != 0o640 then refuse("node configuration ownership mismatch") end
  $config = load_data($config_path)
  if $config.node != $t.node or $config.mesh != $request.mesh or $config.wg_ip != $request.ip or $config.noded.port != $request.port or $config.noded.mesh_config != $t.etc .. "/noded/config.conf.mix" or $config.noded.unix_socket != $t.run .. "/noded/bus.sock" or $config.noded.admission != $request.admission or $config.noded.mesh_open != $request.mesh_open then refuse("node config identity, endpoint or posture differs from authenticated plan") end
  $paths = {genesis:$t.etc .. "/noded/genesis.pub",seed:$t.etc .. "/noded/d2.seed",seed_receipt:$t.etc .. "/noded/d2-receipt.json",roster:$t.etc .. "/noded/config.conf.mix",inventory:$t.var .. "/noded/inventory.signed"}
  $states = {}
  for $key in keys($paths)
    $states[$key] = file_state($paths[$key])
    $state = $states[$key]
    if $state.present and ($state.uid != 0 or $state.gid != $gid or $state.perm != 0o640) then refuse("existing target file ownership or mode differs from plan") end
  end
  $baseline = file_state($t.var .. "/noded/inventory.baseline")
  if $baseline.present and ($baseline.uid != $uid or $baseline.gid != $gid or $baseline.perm != 0o600) then refuse("existing authority witness ownership mismatch") end
  if $states.genesis.present and trim(read_file($paths.genesis)) != $request.genesis then refuse("different genesis: anchor rotation is forbidden") end
  return {target:$t,uid:$uid,gid:$gid,writer:0,dirs:$dirs,binding:$binding,config:$config_state,paths:$paths,states:$states,binary:{version:$version,sha256:$binary_hash}}
end

fn save_receipt($directory, $receipt)
  $tmp = $directory .. "/.receipt-" .. uuid()
  write_new($tmp,json_encode($receipt,true),0o600)
  rename($tmp,$directory .. "/receipt.json")
  run_argv_must(["sync",$directory .. "/receipt.json",$directory],{timeout:10})
end

-- Testable filesystem transaction. Production context always comes from the
-- checked namespace preflight above; remote dispatch cannot supply a context.
fn apply_files($ctx, $payloads, $before, $token)
  if not re_match($token,"^[a-zA-Z0-9-]{8,64}$") then refuse("invalid run token") end
  $root = $ctx.target.profile .. "/.mesh-rollout"
  no_links($root)
  if not exists($root,{follow_symlinks:false}) then mkdir($root); chown($root,$ctx.writer,$ctx.gid); chmod($root,0o700) end
  directory($root,$ctx.writer,$ctx.gid,0o700)
  if not flock($root .. "/writer.lock",{wait:0}) then refuse("desk writer lock contended") end
  $backup = $root .. "/" .. $token
  if exists($backup,{follow_symlinks:false}) then refuse("run receipt already exists; inspect it before retrying") end
  mkdir($backup)
  chown($backup,$ctx.writer,$ctx.gid)
  chmod($backup,0o700)
  $receipt = {token:$token,node:$ctx.target.node,status:"snapshot",published:[],inventory_published:false,files:[]}
  $keys = []
  for $entry in $payloads
    if not contains(["seed","seed_receipt","roster","inventory"],$entry.kind) or contains($keys,$entry.kind) then refuse("invalid or repeated payload kind") end
    push($keys,$entry.kind)
    if type($entry.bytes) != "string" or hash_sha256($entry.bytes) != $entry.sha256 then refuse("payload hash mismatch") end
    $path = $ctx.paths[$entry.kind]
    if not deep_eq(file_state($path),$before[$entry.kind]) then refuse("destination changed after preflight") end
    if $before[$entry.kind].present then
      write_new($backup .. "/" .. $entry.kind,read_file($path),0o600)
      if hash_file($backup .. "/" .. $entry.kind,"sha256") != $before[$entry.kind].sha256 then refuse("snapshot changed while copying") end
    end
    $receipt.files = push($receipt.files,{kind:$entry.kind,before:$before[$entry.kind],after_sha256:$entry.sha256})
  end
  save_receipt($backup,$receipt)
  $staging = nil
  try
    for $entry in $payloads
      $path = $ctx.paths[$entry.kind]
      $tmp = dirname($path) .. "/.mesh-stage-" .. $token
      no_links($tmp)
      write_new($tmp,$entry.bytes,0o640)
      $staging = $tmp
      chown($tmp,$ctx.writer,$ctx.gid)
      if hash_file($tmp,"sha256") != $entry.sha256 then refuse("staged bytes differ") end
      run_argv_must(["sync",$tmp],{timeout:10})
      if not deep_eq(file_state($path),$before[$entry.kind]) then remove($tmp); refuse("destination changed immediately before publication") end
      rename($tmp,$path)
      $staging = nil
      run_argv_must(["sync",dirname($path)],{timeout:10})
      if $entry.kind == "inventory" then $receipt.inventory_published = true end
      $receipt.published = push($receipt.published,$entry.kind)
      $receipt.status = "partial"
      save_receipt($backup,$receipt)
      $s = file_state($path)
      if $s.sha256 != $entry.sha256 or $s.uid != $ctx.writer or $s.gid != $ctx.gid or $s.perm != 0o640 then refuse("published bytes or owner differ") end
    end
    $receipt.status = "placed"
    save_receipt($backup,$receipt)
  catch $failure
    if $staging != nil and exists($staging,{follow_symlinks:false}) then remove($staging) end
    $receipt.status = if $receipt.inventory_published then "higher-epoch-recovery-required" else "restore-required" end
    save_receipt($backup,$receipt)
    refuse("transaction failed; inspect protected receipt " .. $backup .. "/receipt.json")
  end
  return {receipt:$backup .. "/receipt.json",status:$receipt.status,hashes:map($payloads,fn($item)={kind:$item.kind,sha256:$item.sha256})}
end

fn restore_files($ctx, $token)
  if not re_match($token,"^[a-zA-Z0-9-]{8,64}$") then refuse("invalid run token") end
  $root = $ctx.target.profile .. "/.mesh-rollout"
  directory($root,$ctx.writer,$ctx.gid,0o700)
  if not flock($root .. "/writer.lock",{wait:0}) then refuse("desk writer lock contended") end
  $backup = $root .. "/" .. $token
  directory($backup,$ctx.writer,$ctx.gid,0o700)
  $meta = file_state($backup .. "/receipt.json")
  if $meta.uid != $ctx.writer or $meta.perm != 0o600 then refuse("receipt permissions changed") end
  $receipt = json_parse(read_file($backup .. "/receipt.json"))
  if $receipt.node != $ctx.target.node or $receipt.token != $token or $receipt.inventory_published then refuse("inventory acceptance requires higher-epoch recovery, never file rollback") end
  -- Preflight every restore before changing the first file. A crash between
  -- inventory rename and receipt update is detected by the original preimage.
  $restore = []
  for $file in $receipt.files
    if not contains(["seed","seed_receipt","roster","inventory"],$file.kind) then refuse("invalid receipt payload kind") end
    $path = $ctx.paths[$file.kind]
    $current = file_state($path)
    if $file.kind == "inventory" then
      if not deep_eq($current,$file.before) then refuse("inventory changed; higher-epoch recovery required") end
    elif not deep_eq($current,$file.before) then
      if not $current.present or $current.sha256 != $file.after_sha256 or $current.uid != $ctx.writer or $current.gid != $ctx.gid or $current.perm != 0o640 then refuse("published file changed; rollback refuses concurrent update") end
      if $file.before.present and hash_file($backup .. "/" .. $file.kind,"sha256") != $file.before.sha256 then refuse("backup hash changed") end
      push($restore,$file.kind)
    end
  end
  for $file in reverse($receipt.files)
    if contains($restore,$file.kind) then
      $path = $ctx.paths[$file.kind]
      if $file.before.present then
        $tmp = dirname($path) .. "/.mesh-restore-" .. $token
        write_new($tmp,read_file($backup .. "/" .. $file.kind),$file.before.perm)
        chown($tmp,$file.before.uid,$file.before.gid)
        rename($tmp,$path)
      else
        remove($path)
      end
    end
  end
  $receipt.status = "restored"
  save_receipt($backup,$receipt)
  return {receipt:$backup .. "/receipt.json",status:"restored"}
end

fn live_process($ctx)
  $pid = property($ctx.target.unit,"MainPID")
  if not re_match($pid,"^[1-9][0-9]*$") then refuse("service has no live process") end
  $proc = "/proc/" .. $pid
  if stat($proc).uid != $ctx.uid or hash_file($proc .. "/exe","sha256") != $ctx.binary.sha256 then refuse("live daemon binary or account mismatch") end
  $environment = {}
  for $entry in split(read_file($proc .. "/environ"),chr(0))
    $pair = split($entry,"=")
    if len($pair) == 2 then $environment[$pair[0]] = $pair[1] end
  end
  $prefix = upper($ctx.target.project)
  for $pair in [["_ETC",$ctx.target.etc],["_VAR",$ctx.target.var],["_NODE_CONFIG",$ctx.target.etc .. "/node.conf.mix"],["_RUN",$ctx.target.run],["_BROKER_ACCOUNT",$ctx.target.account]]
    if $environment[$prefix .. $pair[0]] != $pair[1] then refuse("live daemon profile environment mismatch") end
  end
  return {pid:$pid,sha256:$ctx.binary.sha256,uid:$ctx.uid}
end

fn dispatch($request)
  if not contains(["preflight","seed","sync","restart","restore","live"],$request.operation) then refuse("unknown operation") end
  $ctx = namespace_context($request)
  if $request.operation == "preflight" then return $ctx end
  if not deep_eq($ctx,$request.before) then refuse("namespace, service or target preimage changed") end
  if $request.operation == "restore" then return restore_files($ctx,$request.token) end
  if $request.operation == "live" then return live_process($ctx) end
  if $request.operation == "restart" then
    $old_pid = property($ctx.target.unit,"MainPID")
    $socket = $ctx.target.run .. "/noded/bus.sock"
    $watch = fs_watch($ctx.target.run,{recursive:true,events:["created","moved","modified","deleted"]})
    try
      run_argv_must(["systemctl","restart",$ctx.target.unit],{timeout:30})
      while not exists($socket,{follow_symlinks:false})
        $_batch = fs_wait($watch)
      end
    finally
      fs_unwatch($watch)
    end
    $live = live_process($ctx)
    if $live.pid == $old_pid then refuse("restart did not create a fresh service process") end
    return {restarted:$ctx.target.unit,live:$live}
  end
  if $request.operation == "seed" then
    if len($request.payloads) != 2 or $request.payloads[0].kind != "seed" or $request.payloads[1].kind != "seed_receipt" then refuse("seed operation requires seed and provenance receipt only") end
    $proof = json_parse($request.payloads[1].bytes)
    if $proof.node != $ctx.target.node or $proof.mesh != $request.mesh or $proof.seed_sha256 != $request.payloads[0].sha256 or not contains($request.d2_keys,$proof.public_key) then refuse("seed provenance is not bound to a current authenticated D2 key") end
  else
    if len($request.payloads) != 2 or $request.payloads[0].kind != "roster" or $request.payloads[1].kind != "inventory" then refuse("sync requires roster before exact signed inventory") end
    if not $ctx.states.seed.present or not $ctx.states.seed_receipt.present then refuse("stage verified D2 seed provenance before signed inventory") end
    $proof = json_parse(read_file($ctx.paths.seed_receipt))
    if $proof.node != $ctx.target.node or $proof.mesh != $request.mesh or $proof.seed_sha256 != $ctx.states.seed.sha256 or not contains($request.d2_keys,$proof.public_key) then refuse("staged D2 seed no longer matches current authenticated identity") end
    if not $ctx.states.genesis.present then
      write_new($ctx.paths.genesis,$request.genesis .. chr(10),0o640)
      chown($ctx.paths.genesis,0,$ctx.gid)
    end
  end
  return apply_files($ctx,$request.payloads,$ctx.states,$request.token)
end
