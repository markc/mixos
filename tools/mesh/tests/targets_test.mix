-- SPDX-License-Identifier: MIT OR Apache-2.0
$targets = require("../_lib/targets.mix")
fn check($condition, $message)
  if not $condition then raise("TEST", $message) end
end
fn refuses($document)
  try
    $targets.parse_targets($document)
    return false
  catch $message, $error
    return $error.code == "MESH_TARGET"
  end
end
$system = {node:"node-a",host:"host-a",kind:"system"}
$desk = {node:"desk-a",host:"host-a",kind:"desk",machine:"desk-a",profile:"/var/lib/example/profile-a",session:3,account:"user-a"}
$document = {schema_version:1,project:"example",targets:[$system,$desk]}
$parsed = $targets.parse_targets($document)
$first = $targets.plan($parsed.targets[0])
$second = $targets.plan($parsed.targets[1])
check($first.inventory == "/var/lib/example/noded/inventory.signed", "system state root")
check($first.unit == "noded.service", "system service")
check($second.inventory == "/var/lib/example/profile-a/var/noded/inventory.signed", "desk state root")
check($second.seed == "/var/lib/example/profile-a/etc/noded/d2.seed", "desk private path")
check($second.unit == "noded@3.service" and $second.account == "user-a", "desk account/unit")
check(not $second.mutation_supported, "no partial desk write path")
$bad = $document
$bad.targets[1].profile = "/var/lib/example/../elsewhere"
check(refuses($bad), "traversal refused")
$bad = $document
$bad.targets[1].host = "-proxy-command"
check(refuses($bad), "option-shaped host refused")
$bad = $document
$bad.targets[1].session = 3.5
check(refuses($bad), "fractional session refused")
$bad = $document
$bad.targets[1].node = "node-a"
check(refuses($bad), "duplicate identity refused")
$bad = $document
$bad.targets[0].machine = "desk-a"
check(refuses($bad), "system/desk confusion refused")
$bad = $document
$bad.targets[1].unexpected = true
check(refuses($bad), "unknown field refused")
$bad = $document
$bad.targets[1].account = "root"
check(refuses($bad), "privileged desk account refused")
$bad = $document
$other = $desk
$other.node = "desk-b"
$bad.targets = push($document.targets, $other)
check(refuses($bad), "duplicate broker endpoint refused")
$refused = false
try
  $targets.require_system_mutation($document)
catch $message, $error
  $refused = $error.code == "MESH_TARGET"
end
check($refused, "desk mutation must refuse before any I/O")
check(len($targets.require_system_mutation({schema_version:1,project:"example",targets:[$system]}).targets) == 1, "system mutation policy")
print("PASS native mesh target model: paths, identity boundaries and desk mutation refusal")
