-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Copyright 2026 Mark Constable <mc@mixos.dev>
-- version: 0.1.1
-- Runs the Mix test scripts (AGENTS.md §7, the bus and gates tiers) that
-- need nothing beyond a checkout, its fresh binaries and bsdtar: each one
-- owns a private broker, private ports and a temp dir, so it can run on a
-- bare CI runner. Every script runs to the end; exit 1 if any failed.
--
--   mix tools/mix_tests.mix [--bin DIR] [NAME...]
--
-- --bin is the directory holding the freshly built mix, noded, editd and
-- dopus (default target/debug). Scripts that still name <prefix>/bin
-- directly need those binaries installed there too; CI does that. NAME
-- runs only the scripts whose path contains it.
--
-- Not run here, and why:
-- - services/compd/tests/scenes_mesh_test.mix: needs a live mesh route
--   (SCENES_LOCAL_TARGET, SCENES_REMOTE_TARGET).
-- - services/portald/tests/restart_recovery_test.mix: needs a systemd
--   --user manager.
-- - services/compd/tests/settings_test.mix: runs its own release-fast cargo
--   build.
-- - services/compd/tests/scene_editor_e2e.mix: in a debug build the editor
--   behaviour crash-loops on the global-scope promotion debug_assert
--   (libs/mix/src/scope.rs); back in once that scope design is settled.
-- - tests/desktop/: nested and on-hardware compositor runs.
-- - services/clipd/tests/wayland_test.mix: needs a private headless compd and
--   wl-clipboard. Run with MIXOS_TEST_COMPD and MIXOS_TEST_BLOBD from the build.
-- - apps/dopus/tests/chooser_bus_test.mix: drives real chooser windows on a
--   nested compd, which needs a headless weston host (nested_host_lib). Run
--   it where weston is installed:
--   MIXOS_TEST_BIN=<bin> mix apps/dopus/tests/chooser_bus_test.mix.
-- - services/portald/tests/chooser_bus_test.mix: needs the same headless
--   weston host; runs a persistent zbus caller against the real portal and
--   chooser. Build portald's filechooser_probe example first, then run:
--   MIXOS_TEST_BIN=<bin> mix services/portald/tests/chooser_bus_test.mix.
$root = dirname(dirname(realpath($0)))
$bin = $root .. "/target/debug"
$only = []
$argv = args()
$i = 0
while $i < len($argv)
  if $argv[$i] == "--bin" and $i + 1 < len($argv) then
    $bin = $argv[$i + 1]
    $i = $i + 2
  elif starts_with($argv[$i], "-") then
    raise("USAGE", "mix_tests.mix [--bin DIR] [NAME...]")
  else
    push($only, $argv[$i])
    $i = $i + 1
  end
end
-- Absolute: the scripts spawn these binaries from their own working dirs.
$bin = realpath($bin)

$scripts = [
  "tests/component_install_test.mix",
  "tests/layering_gate_test.mix",
  "tests/command_registry_test.mix",
  "tests/command_registry_families_test.mix",
  "tests/webd_lint_test.mix",
  "tools/gold_release_test.mix",
  "services/bridged/tests/bridge_core_test.mix",
  "services/bridged/tests/bridged_test.mix",
  "services/clipd/tests/clipboard_test.mix",
  "services/clipd/tests/clipd_test.mix",
  "services/compd/tests/apps_bus_test.mix",
  "services/compd/tests/apps_test.mix",
  "services/compd/tests/desktop_icons_test.mix",
  "services/compd/tests/editor_app_test.mix",
  "services/compd/tests/editor_app_bus_test.mix",
  "services/compd/tests/scene_editor_fixtures_test.mix",
  "services/compd/tests/scene_editor_test.mix",
  "services/compd/tests/scene_template_test.mix",
  "services/compd/tests/scene_reconnect_test.mix",
  "services/compd/tests/toast_summary_test.mix",
  "services/compd/tests/scenes_test.mix",
  "services/compd/tests/scenes_io_test.mix",
  "services/compd/tests/network_behaviour_test.mix",
  "services/compd/tests/volume_behaviour_test.mix",
  "services/editd/tests/edit_bus_test.mix",
  "services/releasesd/tests/releases_test.mix",
  "services/releasesd/tests/releasesd_test.mix",
  "services/notifyd/tests/notify_test.mix",
  "services/notifyd/tests/notifyd_test.mix",
  "apps/dopus/tests/dopus_bus_test.mix",
  "apps/screenshot/tests/edit_path_test.mix"
]
if len($only) > 0 then
  $scripts = filter($scripts, fn($s) = any($only, fn($n) = contains($s, $n)))
end

$env = {
  MIXOS: $root,
  MIXOS_TEST_MIX: $bin .. "/mix",
  -- The bridged tests' child processes run the fresh mix, not the installed one.
  BRIDGED_MIX: $bin .. "/mix",
  MIXOS_TEST_NODED: $bin .. "/noded",
  MIXOS_TEST_BLOBD: $bin .. "/blobd",
  MIXOS_TEST_EDITD: $bin .. "/editd",
  MIXOS_TEST_DOPUS: $bin .. "/dopus",
  MIXOS_TEST_COMPD: $bin .. "/compd",
  MIXOS_TEST_SCREENSHOT: $bin .. "/screenshot",
  -- Pinned so a host's SCENES_FIRST_RUN=0 cannot leak into scenes_test.mix.
  SCENES_FIRST_RUN: "1",
  TZ: "UTC"
}
$failed = []
for each $s in $scripts
  -- The releasesd installer deliberately refuses root. The CBC worker may
  -- run this gate as root, so exercise those user-install tests as nobody.
  $argv = if starts_with($s, "services/releasesd/tests/") and uid() == 0 then
    ["runuser", "-u", "nobody", "--", $bin .. "/mix", $s]
  else [$bin .. "/mix", $s] end
  $r = run_argv($argv, {cwd: $root, env: $env, timeout: 900, stderr: "stdout"})
  $secs = to_string(round($r.duration_ms / 1000))
  if $r.ok then
    print("PASS " .. $s .. " (" .. $secs .. " s)")
  else
    push($failed, $s)
    $why = $r.timed_out ? "timed out" : "exit " .. to_string($r.exit_code)
    print("FAIL " .. $s .. " (" .. $why .. ", " .. $secs .. " s)")
    $out = lines($r.stdout)
    for each $l in slice($out, max(len($out) - 80, 0), len($out))
      print("  | " .. $l)
    end
  end
end
print(to_string(len($scripts) - len($failed)) .. "/" .. to_string(len($scripts)) .. " Mix test scripts passed")
if len($failed) > 0 then exit(1) end
nil
