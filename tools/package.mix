-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Copyright 2026 Mark Constable <mc@mixos.dev>
-- version: 0.1.0
-- package.mix: the release tarballs, from binaries cargo has already built.
-- Run by .github/workflows/release.yml with the freshly built mix; locally:
--
--   mix tools/package.mix --release 0.1.1 [--arch x86_64] [--bin-dir target/release] [--out dist/release]
--
-- Two prefix tarballs per architecture, the layout releasesd installs
-- (docs/releasesd/README.md): one top directory holding bin/ and share/.
--
--   mixos-server-<v>-linux-<arch>.tar.gz    mix and the headless services
--   mixos-desktop-<v>-linux-<arch>.tar.gz   the compositor and the apps
--
-- releasesd picks between them by the catalogue name (mixos-server,
-- mixos-desktop), so neither needs an `asset` pattern. The checksum file is
-- written by the release job over every tarball, not here.

$g = getopt(args(), {help: {short: "h"}, release: {arg: true}, arch: {arg: true},
  "bin-dir": {arg: true}, out: {arg: true}})
if len($g.errors) != 0 then raise("PACKAGE_ARGS", join($g.errors, "; ")) end
if $g.opts.help then
  print("usage: mix tools/package.mix --release V [--arch ARCH] [--bin-dir DIR] [--out DIR]")
  exit(0)
end

$PACKAGES = {
  "mixos-server": ["mix", "noded", "editd", "settingsd", "portald", "maild"],
  "mixos-desktop": ["compd", "ced", "dopus", "prefs", "busviewer", "monitor", "screenshot"]
}
-- Desktop entries ship with their app: a packaged binary NAME with an
-- apps/NAME/assets/dev.mixos.NAME.desktop carries it, so binary and entry
-- always travel as a pair. Exec and TryExec lose the system path so
-- releasesd points them at the installed binary.
fn entries_for($root, $bins)
  $out = []
  for each $b in $bins
    $e = "apps/" .. $b .. "/assets/dev.mixos." .. $b .. ".desktop"
    if is_file($root .. "/" .. $e) then push($out, $e) end
  end
  return $out
end
$DOCS = ["README.md", "LICENSE-MIT", "LICENSE-APACHE", "NOTICE"]

$version = $g.opts.release ?? ""
if not re_match($version, "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$") then
  raise("PACKAGE_ARGS", "--release must be a version like 1.2.3 or 1.2.3-rc.1, got '" .. $version .. "'")
end
$arch = $g.opts.arch ?? platform().arch
if not re_match($arch, "^(x86_64|aarch64)$") then raise("PACKAGE_ARGS", "--arch must be x86_64 or aarch64") end
$source = dirname(dirname(realpath($0)))
-- Use the native Mix executing this packager, including release bootstrap.
$mix = realpath("/proc/self/exe")
if $mix == nil then raise("PACKAGE_MIX", "cannot resolve the running Mix binary") end
$bin_dir = $g.opts["bin-dir"] ?? ($source .. "/target/release")
$out = $g.opts.out ?? ($source .. "/dist/release")

mkdir($out, {parents: true})
$stage = $out .. "/.stage"
remove_dir($stage)

for $pkg in sort(keys($PACKAGES))
  $name = $pkg .. "-" .. $version .. "-linux-" .. $arch
  $top = $stage .. "/" .. $name
  mkdir($top .. "/bin", {parents: true})
  for $b in $PACKAGES[$pkg]
    if $b == "maild" then
      -- maild is carried by the system binary, never a second executable.
      symlink("mix", $top .. "/bin/maild")
      continue
    end
    $src = $bin_dir .. "/" .. $b
    if not is_file($src) then raise("PACKAGE_MISSING", $src .. " is not built") end
    copy($src, $top .. "/bin/" .. $b)
    chmod($top .. "/bin/" .. $b, 0o755)
  end
  for $e in entries_for($source, $PACKAGES[$pkg])
    mkdir($top .. "/share/applications", {parents: true})
    -- replace() covers every Exec= and TryExec= line, actions included.
    $text = replace(read_file($source .. "/" .. $e), "Exec=/opt/mixos/bin/", "Exec=")
    write_file($top .. "/share/applications/" .. basename($e), $text)
    chmod($top .. "/share/applications/" .. basename($e), 0o644)
  end
  mkdir($top .. "/share/doc/" .. $pkg, {parents: true})
  for $d in $DOCS
    copy($source .. "/" .. $d, $top .. "/share/doc/" .. $pkg .. "/" .. $d)
    chmod($top .. "/share/doc/" .. $pkg .. "/" .. $d, 0o644)
  end
  if $pkg == "mixos-desktop" then
    run_argv_must([$mix, $source .. "/libs/toolkit/scripts/install_licenses.mix",
      "--root", $top .. "/share"], {timeout: 30})
  end
  if $pkg == "mixos-server" then
    mkdir($top .. "/share/maild/units", {parents: true})
    for $u in ["maild@.service", "sysusers.conf"]
      copy($source .. "/services/maild/units/" .. $u, $top .. "/share/maild/units/" .. $u)
      chmod($top .. "/share/maild/units/" .. $u, 0o644)
    end
    $licences = $top .. "/share/licenses/maild/mail-parser"
    mkdir($licences, {parents: true})
    for $name in ["Apache-2.0.txt", "MIT.txt"]
      copy($source .. "/vendor/mail-parser/LICENSES/" .. $name, $licences .. "/" .. $name)
      chmod($licences .. "/" .. $name, 0o644)
    end
  end
  $tar = $out .. "/" .. $name .. ".tar.gz"
  -- Owner-neutral and sorted, so the archive does not depend on the runner.
  run_argv_must(["tar", "--sort=name", "--owner=0", "--group=0", "--numeric-owner",
    "-czf", $tar, "-C", $stage, $name], {timeout: 600})
  print($tar .. "  sha256:" .. hash_file($tar, "sha256"))
end
remove_dir($stage)
