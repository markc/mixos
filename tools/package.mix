-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Copyright 2026 Mark Constable <mc@mixos.dev>
-- version: 0.1.0
-- package.mix: the release tarballs, from binaries cargo has already built.
-- Run inside the Ubuntu 24.04 CBC build root with the freshly built mix:
--
--   mix tools/package.mix --release 0.1.1 --commit FULL_SHA [--arch x86_64] [--bin-dir target/release] [--out dist/release]
--
-- Up to two prefix tarballs per architecture, the layout releasesd installs
-- (docs/releasesd/README.md): one top directory holding bin/ and share/.
--
--   mixos-server-<v>-linux-<arch>.tar.gz    mix and the headless services
--   mixos-desktop-<v>-linux-<arch>.tar.gz   the compositor and the apps
--
-- releasesd picks between them by the catalogue name (mixos-server,
-- mixos-desktop), so neither needs an `asset` pattern. The checksum file is
-- written here over every tarball and the manifest.

$g = getopt(args(), {help: {short: "h"}, release: {arg: true}, commit: {arg: true}, arch: {arg: true},
  "bin-dir": {arg: true}, out: {arg: true}, package: {arg: true},
  "libinput-source": {arg: true}, "fixture-binaries": {}})
if len($g.errors) != 0 then raise("PACKAGE_ARGS", join($g.errors, "; ")) end
$fixture = $g.opts["fixture-binaries"] == true
if $g.opts.help then
  print("usage: mix tools/package.mix --release V --commit FULL_SHA [--package desktop|server|all] [--arch ARCH] [--bin-dir DIR] [--out DIR] [--fixture-binaries for tests only]")
  exit(0)
end

$source = dirname(dirname(realpath($0)))
$release = load_data($source .. "/tools/release_packages.mx")
if $release.schema != 1 then raise("PACKAGE_SCHEMA", "unsupported release_packages.mx schema") end
$PACKAGES = $release.packages
for $pkg in keys($PACKAGES)
  for $b in $PACKAGES[$pkg]
    if $release.crates[$b] == nil then
      raise("PACKAGE_SCHEMA", $b .. " has no Cargo package in release_packages.mx")
    end
  end
end
-- Desktop entries ship with their app: a packaged binary NAME with an
-- apps/NAME/assets/dev.mixos.NAME.desktop carries it, so binary and entry
-- always travel as a pair. Gold renders them at staging time.
fn entries_for($root, $bins)
  $out = []
  for each $b in $bins
    $e = "apps/" .. $b .. "/assets/dev.mixos." .. $b .. ".desktop"
    if is_file($root .. "/" .. $e) then push($out, $e) end
  end
  return $out
end
fn add_tree($from, $to)
  if not is_dir($from) then raise("PACKAGE_MISSING", "runtime tree " .. $from .. " is missing") end
  -- Docs stage pinned source fonts here. They are build inputs, while the
  -- server ships the asset installer and its lock, not a local asset cache.
  $asset_sources = $from == $source .. "/share/assets"
  $asset_cache = ["sets", "current", ".install.lock"]
  -- git status does not list ignored files, but cp -a would ship them, so the
  -- clean-source check alone cannot vouch for a copied tree.
  if not $fixture then
    if not starts_with($from, $source .. "/") then
      raise("PACKAGE_SOURCE", "runtime tree " .. $from .. " is outside the source checkout")
    end
    $rel = strip_prefix($from, $source .. "/")
    $ignored = trim(run_argv_must(["git", "-C", $source, "ls-files", "--others", "--ignored",
      "--exclude-standard", "--directory", "--no-empty-directory", "--", $rel], {timeout: 30}))
    if $asset_sources then
      $ignored = join(filter(lines($ignored), fn($p) = not any($asset_cache,
        fn($name) = $p == $rel .. "/" .. $name or starts_with($p, $rel .. "/" .. $name .. "/"))), "\n")
    end
    if $ignored != "" then
      raise("PACKAGE_SOURCE", "runtime tree " .. $rel .. " holds gitignored files: " .. replace($ignored, "\n", ", "))
    end
  end
  mkdir($to, {parents: true})
  if $asset_sources then
    for $name in sort(ls($from))
      if not contains($asset_cache, $name) then run_argv_must(["cp", "-a", "--", $from .. "/" .. $name, $to .. "/" .. $name], {timeout: 120}) end
    end
  else
    run_argv_must(["cp", "-a", $from .. "/.", $to], {timeout: 120})
  end
end
$DOCS = ["README.md", "LICENSE-MIT", "LICENSE-APACHE", "NOTICE"]

$version = $g.opts.release ?? ""
if not re_match($version, "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$") then
  raise("PACKAGE_ARGS", "--release must be a version like 1.2.3 or 1.2.3-rc.1, got '" .. $version .. "'")
end
$commit = $g.opts.commit ?? ""
if not re_match($commit, "^[0-9a-f]{40}$") then raise("PACKAGE_ARGS", "--commit must be a full source SHA") end
$head = trim(run_argv_must(["git", "-C", $source, "rev-parse", "HEAD"], {timeout: 15}))
if $head != $commit then raise("PACKAGE_SOURCE", "source checkout differs from --commit") end
if not $fixture then
  $dirty = trim(run_argv_must(["git", "-C", $source, "status", "--porcelain"], {timeout: 30}))
  if $dirty != "" then raise("PACKAGE_SOURCE", "source checkout is not clean; commit or stash before packaging") end
end
$arch = $g.opts.arch ?? platform().arch
if not re_match($arch, "^(x86_64|aarch64)$") then raise("PACKAGE_ARGS", "--arch must be x86_64 or aarch64") end
if $arch != platform().arch then raise("PACKAGE_ARCH", "--arch must match the build host") end
$glibc = "fixture"
if not $fixture then
  $libc = trim(run_argv_must(["getconf", "GNU_LIBC_VERSION"], {timeout: 10}))
  if $libc != "glibc 2.39" then
    raise("PACKAGE_GLIBC", "the first release must be packaged and exercised in the Ubuntu 24.04 glibc 2.39 build root; got " .. $libc)
  end
  $glibc = "2.39"
end
-- Use the native Mix executing this packager, including release bootstrap.
$mix = realpath("/proc/self/exe")
if $mix == nil then raise("PACKAGE_MIX", "cannot resolve the running Mix binary") end
$bin_dir = $g.opts["bin-dir"] ?? ($source .. "/target/release")
$out = $g.opts.out ?? ($source .. "/dist/release")
$selection = $g.opts.package ?? "all"
if not contains(["desktop", "server", "all"], $selection) then
  raise("PACKAGE_ARGS", "--package must be desktop, server or all")
end
$selected = if $selection == "all" then sort(keys($PACKAGES))
  elif $selection == "desktop" then ["mixos-desktop"] else ["mixos-server"] end
$libinput_source = $g.opts["libinput-source"] ?? ""
if not $fixture and contains($selected, "mixos-desktop") then
  if (not is_dir($libinput_source) or
      trim(run_argv_must(["git", "-C", $libinput_source, "rev-parse", "HEAD"], {timeout: 15})) !=
      "3402f380019dc4f882e1d8627029607aca3f4be6") then
    raise("PACKAGE_LIBINPUT", "desktop needs the pinned libinput 1.26.2 source")
  end
end

if is_dir($out) and len(glob($out .. "/*")) != 0 then
  raise("PACKAGE_OUTPUT", "output directory is not empty: " .. $out)
end
mkdir($out, {parents: true})
$stage = $out .. "/.stage"
remove_dir($stage)
$archives = []

for $pkg in $selected
  $name = $pkg .. "-" .. $version .. "-linux-" .. $arch
  $top = $stage .. "/" .. $name
  mkdir($top .. "/bin", {parents: true})
  $members = []
  $libraries = []
  for $b in $PACKAGES[$pkg]
    $src = $bin_dir .. "/" .. $b
    if not is_file($src) then raise("PACKAGE_MISSING", $src .. " is not built") end
    $v = if $fixture then "fixture" else
      trim(run_argv_must([$src, "--version"], {timeout: 10, stderr: "stdout"})) end
    if (not $fixture and
        (not starts_with($v, $b .. " ") or not contains($v, slice($commit, 0, 12)))) then
      raise("PACKAGE_SOURCE", $b .. " does not identify itself and source " .. slice($commit, 0, 12) .. ": " .. $v)
    end
    push($members, {name: $b, sha256: hash_file($src, "sha256"), version: $v})
    copy($src, $top .. "/bin/" .. $b)
    chmod($top .. "/bin/" .. $b, 0o755)
  end
  for $e in entries_for($source, $PACKAGES[$pkg])
    mkdir($top .. "/share/applications", {parents: true})
    copy($source .. "/" .. $e, $top .. "/share/applications/" .. basename($e))
    chmod($top .. "/share/applications/" .. basename($e), 0o644)
  end
  mkdir($top .. "/share/doc/" .. $pkg, {parents: true})
  -- Ship the renderer with component-owned templates copied into share.
  add_tree($source .. "/share/layout", $top .. "/share/layout")
  remove($top .. "/share/layout/templates.mx")
  $layout_manifest = load_data($source .. "/share/layout/templates.mx")
  $layout_files = []
  $layout_owners = $PACKAGES[$pkg]
  if $pkg == "mixos-desktop" then
    -- Preserve main's shipped unit copies. These prefix copies are separate
    -- from the /etc units owned and recorded by component_install.
    $layout_owners = concat($layout_owners, ["notifyd", "releasesd"])
    for $owner in ["notifyd", "releasesd"]
      for $unit in sort(glob($source .. "/services/" .. $owner .. "/units/*"))
        if is_file($unit) and contains(read_file($unit), "@{") then
          $layout_manifest.files = push($layout_manifest.files, {source: "../../services/" .. $owner .. "/units/" .. basename($unit),
            target: "@{prefix}/share/" .. $owner .. "/units/" .. basename($unit), kind: "unit"})
        end
      end
    end
  end
  for $entry in $layout_manifest.files
    $rel = strip_prefix($entry.source, "../../")
    if (starts_with($rel, "apps/") or starts_with($rel, "services/")) and not contains($layout_owners, split($rel, "/")[1]) then continue end
    $template_rel = "templates/" .. $rel
    mkdir(dirname($top .. "/share/layout/" .. $template_rel), {parents: true})
    copy($source .. "/" .. $rel, $top .. "/share/layout/" .. $template_rel)
    $entry.source = $template_rel
    push($layout_files, $entry)
  end
  mkdir($top .. "/share/layout/manifests", {parents: true})
  write_file($top .. "/share/layout/manifests/" .. $pkg .. ".mx", data_encode({schema: 1, files: $layout_files}) .. "\n")
  for $d in $DOCS
    copy($source .. "/" .. $d, $top .. "/share/doc/" .. $pkg .. "/" .. $d)
    chmod($top .. "/share/doc/" .. $pkg .. "/" .. $d, 0o644)
  end
  if $pkg == "mixos-desktop" then
    if not $fixture then
      $input = "/usr/lib/x86_64-linux-gnu/libinput.so.10.13.0"
      $input_version = trim(run_argv_must(["pkg-config", "--modversion", "libinput"], {timeout: 10}))
      if $input_version != "1.26.2" then raise("PACKAGE_LIBINPUT", "libinput 1.26.2 is required") end
      mkdir($top .. "/lib", {parents: true})
      copy($input, $top .. "/lib/libinput.so.10")
      chmod($top .. "/lib/libinput.so.10", 0o644)
      push($libraries, {name: "libinput.so.10", version: $input_version,
        source: "3402f380019dc4f882e1d8627029607aca3f4be6",
        sha256: hash_file($top .. "/lib/libinput.so.10", "sha256")})
      mkdir($top .. "/share/licenses/libinput", {parents: true})
      copy($libinput_source .. "/COPYING", $top .. "/share/licenses/libinput/COPYING")
      $loaded = run_argv_must(["ldd", $top .. "/bin/compd"], {timeout: 20})
      if not contains(replace($loaded, "/bin/../lib/", "/lib/"),
          "libinput.so.10 => " .. $top .. "/lib/libinput.so.10") then
        raise("PACKAGE_LIBINPUT", "compd does not load the bundled libinput")
      end
    end
    add_tree($source .. "/share/scenes", $top .. "/share/scenes")
    add_tree($source .. "/share/brand", $top .. "/share/brand")
    add_tree($source .. "/share/icons", $top .. "/share/icons")
    add_tree($source .. "/services/compd/scripts", $top .. "/share/compd/scripts")
    add_tree($source .. "/services/notifyd/scripts", $top .. "/lib/notifyd")
    add_tree($source .. "/services/releasesd/scripts", $top .. "/lib/releasesd")
    for $svc in ["compd", "indexd", "notifyd", "settingsd", "hostd", "noded", "monitord", "editd", "portald", "releasesd"]
      add_tree($source .. "/services/" .. $svc .. "/units", $top .. "/share/" .. $svc .. "/units")
    end
    mkdir($top .. "/share/indexd/examples", {parents: true})
    copy($source .. "/services/indexd/examples/config.conf.mix", $top .. "/share/indexd/examples/config.conf.mix")
    chmod($top .. "/share/indexd/examples/config.conf.mix", 0o644)
    run_argv_must([$mix, $source .. "/libs/toolkit/scripts/install_licenses.mix",
      "--root", $top .. "/share"], {timeout: 30})
  end
  if $pkg == "mixos-server" then
    add_tree($source .. "/share/assets", $top .. "/share/assets")
    for $svc in ["hostd", "noded", "monitord", "maild"]
      add_tree($source .. "/services/" .. $svc .. "/units", $top .. "/share/" .. $svc .. "/units")
    end
    $licences = $top .. "/share/licenses/maild/mail-parser"
    mkdir($licences, {parents: true})
    for $licence_name in ["Apache-2.0.txt", "MIT.txt"]
      copy($source .. "/vendor/mail-parser/LICENSES/" .. $licence_name, $licences .. "/" .. $licence_name)
      chmod($licences .. "/" .. $licence_name, 0o644)
    end
  end
  $tar = $out .. "/" .. $name .. ".tar.gz"
  -- Owner-neutral and sorted, so the archive does not depend on the runner.
  run_argv_must(["tar", "--sort=name", "--owner=0", "--group=0", "--numeric-owner", "--mtime=@0",
    "-czf", $tar, "-C", $stage, $name], {timeout: 600})
  $sha = hash_file($tar, "sha256")
  push($archives, {name: $pkg, asset: basename($tar), sha256: $sha,
    binaries: $members, libraries: $libraries})
  print($tar .. "  sha256:" .. $sha)
end
remove_dir($stage)
$manifest = $out .. "/release.manifest.mx"
write_file($manifest, data_encode({schema: 1, version: $version, source: $commit,
  platform: "linux-" .. $arch .. "-glibc", glibc_floor: $glibc,
  fixture: $fixture, archives: $archives}) .. "\n")
$sums = []
for $row in $archives push($sums, $row.sha256 .. "  " .. $row.asset) end
push($sums, hash_file($manifest, "sha256") .. "  " .. basename($manifest))
write_file($out .. "/SHA256SUMS.txt", join($sums, "\n") .. "\n")
print($manifest .. "  sha256:" .. hash_file($manifest, "sha256"))
