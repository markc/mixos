    "mixos-desktop": ["mix", "mixos-mcp", "noded", "hostd", "monitord", "editd", "portald", "clipd", "settingsd", "backdrop", "workshop", "ced", "compd", "dopus", "email", "monitor", "prefs", "screenshot", "term", "indexd"]
