-- Toolkit coverage only. Application literal policy lands in its own phase.

fn arguments($source, $start)
  $items = []
  $depth = 0
  $quoted = false
  $escaped = false
  $begin = $start + 1
  $xs = chars($source)
  for $i = $start + 1 to length($xs) - 1
    $c = $xs[$i]
    if $quoted then
      if $escaped then $escaped = false elif $c == "\\" then $escaped = true elif $c == '"' then $quoted = false end
      continue
    end
    if $c == '"' then $quoted = true; continue end
    if contains(["(", "[", "{"], $c) then $depth = $depth + 1
    elif contains([")", "]", "}"], $c) then
      if $depth == 0 then
        push($items, trim(slice($source, $begin, $i)))
        return $items
      end
      $depth = $depth - 1
    elif $c == "," and $depth == 0 then
      push($items, trim(slice($source, $begin, $i)))
      $begin = $i + 1
    end
  end
  return []
end

fn findings($text)
  $source = before($text, "#[cfg(test)]") ?? $text
  $source = re_replace($source, '(?m)^\s*//[^\n]*', '')
  $out = []
  for $found in re_find($source, '(?m)^\s*(?:pub(?:\([^)]*\))? )?const ([A-Z_]+):\s*(?:f32|f64|u8|i8|Vec2|Margin|Color32|Rangef|Shadow|Style)\s*=')
    push($out, "unlisted style constant " .. $found.groups[0])
  end
  for $call in re_find($source, '\b(Stroke::new|Margin::same|Margin::symmetric|add_space|rect_filled|rect_stroke|Color32::from_rgb|Color32::from_rgba_unmultiplied|Color32::from_gray|Color32::from_black_alpha)\s*\(')
    $values = arguments($source, $call.end - 1)
    $name = $call.groups[0]
    $indices = if contains(["rect_filled", "rect_stroke"], $name) then [1] elif starts_with($name, "Color32::") or $name == "Margin::symmetric" then range(0, length($values)) else [0] end
    for $index in $indices
      $value = $values[$index] ?? ""
      if re_match($value, '^-?[0-9]+(?:\.[0-9]*)?(?:f32|f64|u8|i8)?$') then
        $line = length(split(slice($source, 0, $call.start), "\n"))
        push($out, "literal painting value in " .. $name .. " at line " .. to_string($line))
      end
    end
  end
  for $block in re_find($source, '\b(?:Style|Shadow)\s*\{[^}]*\}')
    if re_match($block.match, '\b(?:blur|spread|offset|animation_time|item_spacing|button_padding):\s*(?:[0-9]|\[\s*[0-9]|vec2\(\s*[0-9])') then
      push($out, "literal in a style or shadow initialiser")
    end
  end
  if re_match($source, '\bgalley\.size\(\)\.x\s*\+\s*[0-9]+(?:\.[0-9]+)?(?:f32|f64)?\s*[),;]') then
    push($out, "literal galley padding; read button_push_padding from the installed style")
  end
  return $out
end

$options = getopt(args(), {toolkit: {}, root: {arg: true}, "self-test": {}})
if length($options.errors) > 0 or length($options.rest) > 0 then
  raise("STYLE_GATE_ARGS", "usage: style_gate.mix --toolkit [--root DIR] [--self-test]")
end
if $options.opts["self-test"] ?? false then
  for $source in ["const EXTRA: f32 = 4.0;", "Stroke::new(2.0, ink)", "Margin::symmetric(6, 3)", "painter.rect_filled(rect, 4.0, ink)", "Shadow { blur: 10, ..default() }", "(galley.size().x + 28.0).max(tokens.dialog_button_min)"]
    if length(findings($source)) == 0 then raise("STYLE_GATE_TEST", "missed adversarial fixture: " .. $source) end
  end
  if length(findings("Stroke::new(tokens.hairline_width as f32, ink)")) != 0 then raise("STYLE_GATE_TEST", "refused token fixture") end
  print("style gate fixtures: clean")
end
if not ($options.opts.toolkit ?? false) then
  raise("STYLE_GATE_MODE", "phase 1 implements --toolkit coverage")
end
$root = $options.opts.root ?? dirname(dirname(realpath($0)))
$style = read_file($root .. "/libs/design/src/family/style.rs")
$names = map(re_find($style, '(?m)^    ([a-z_0-9]+): (?:f64|u8|bool|[A-Z][A-Za-z]+) = '), fn($m) = $m.groups[0])
$required = slice($names, 0, 40)
$table = load_data($root .. "/libs/design/src/defaults/compat.conf.mix").compat
$defaults = {}
for $version in keys($table)
  if not re_match($version, '^v[0-9]+$') then continue end
  for $name in keys($table[$version].tokens)
    if $defaults[$name] != nil then raise("STYLE_GATE_DUPLICATE", "duplicate token " .. $name) end
    $defaults[$name] = $table[$version].tokens[$name]
  end
end
$design = load_data($root .. "/libs/design/src/defaults/revision-1.theme.conf.mix")
$errors = []
for $name in slice($names, 40)
  if $defaults[$name] == nil then push($errors, "missing compatibility token " .. $name) end
end
for $name in keys($defaults)
  if not contains($names, $name) then push($errors, "compatibility token has no declaration: " .. $name) end
end
for $name in keys($design.design.v1.families.style.styles)
  $authored = $design.design.v1.families.style.styles[$name]
  for $token in $names
    if $authored[$token] == nil then push($errors, $name .. " does not author " .. $token) end
  end
end
$consumers = ""
for $file in ["chrome", "style", "field", "canvas", "button", "toggle", "slider", "tabs", "panel", "bars", "dialog", "combo", "menu", "titlebar", "markdown/view", "icons", "space", "text"]
  $source = read_file($root .. "/libs/toolkit/src/" .. $file .. ".rs")
  $production = before($source, "#[cfg(test)]") ?? $source
  $consumers = $consumers .. "\n" .. $production
  if $file == "icons" then
    $production = re_replace($production, '(?m)^pub const DEFAULT_STROKE:[^\n]+', '')
  end
  for $message in findings($production)
    push($errors, $file .. ": " .. $message)
  end
end
-- Tokens of the removed Pro panel strip and panel-menu glyph (panel groups
-- became plain sections, 2026-10-23). They stay in the schema, the compat
-- tables and frozen designs until their retirement (style.rs RETIRED plus a
-- compat version) lands; until then they need no consumer, and listing one
-- that has a consumer again is an error, so this list cannot go stale.
$retiring = ["panel_pro_size", "panel_pro_pad", "panel_pro_min", "panel_pro_radius", "panel_pro_hover_alpha", "panel_pro_margin", "panel_pro_after", "panel_menu_from_right", "panel_menu_line", "panel_menu_pitch", "panel_menu_box_w", "panel_menu_box_h", "panel_pill_hover_alpha"]
for $name in keys($defaults)
  $consumed = re_match($consumers, '\.\s*' .. $name .. '\b')
  if contains($retiring, $name) then
    if $consumed then push($errors, "retiring token has a consumer again: " .. $name) end
  elif not $consumed then
    push($errors, "no toolkit consumer for " .. $name)
  end
end
if length($required) != 40 then push($errors, "required set is not forty names") end
if length($errors) > 0 then
  for $message in $errors
    eprint("style gate: " .. $message)
  end
  exit(1)
end
print("style gate: toolkit coverage clean (" .. to_string(length($names)) .. " tokens)")
