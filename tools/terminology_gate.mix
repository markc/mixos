-- version: 0.1.0
-- One concept, one word (docs/docs/decisions/2026-10-24-bus-commands-and-actions.md):
-- a dotted name a service answers is a Bus command, and "verb" is retired.
-- This refuses the whole word "verb" or "verbs" in any tracked file outside
-- history and outside names other systems own.
--
--   mix tools/terminology_gate.mix
$root = dirname(dirname(realpath($0)))
-- History, generated mirrors, and other systems' names.
$ALLOW = [
  "CHANGELOG.md",
  "/changelog.md",
  "docs/docs/decisions/2026-10-11-verb-classes.md",
  "docs/docs/decisions/2026-10-13-instance-verb-families.md",
  "docs/docs/decisions/2026-10-24-bus-commands-and-actions.md",
  "docs/sitemap.xml",
  "vendor/",
  -- polkit's systemd1 action.lookup("verb") is polkit's API.
  "services/toolsd/units/49-toolsd-wake.rules",
  -- the props store migration names the pre-rename column.
  "libs/props/src/sqlite.rs",
  -- SMTP/IMAP command parsing: protocol vocabulary, not the Bus.
  "services/maild/src/command.rs",
  "tools/terminology_gate.mix"
]
$MARKER = "generated by docs/_build/gen-site.mix"
$SLUGS = ["2026-10-11-verb-classes", "2026-10-13-instance-verb-families"]

$r = run_argv(["git", "-C", $root, "grep", "-l", "-I", "-i", "-w", "-E", "verbs?"], {timeout: 120, max_output: 8000000})
if $r.exit_code > 1 then raise("TERMINOLOGY_GIT", trim($r.stderr)) end
$bad = []
for $rel in lines(trim($r.stdout))
  if $rel == "" then continue end
  if any($ALLOW, fn($a) = $rel == $a or starts_with($rel, $a) or ends_with($rel, $a)) then continue end
  $text = read_file($root .. "/" .. $rel)
  if contains($text, $MARKER) then continue end
  for $s in $SLUGS
    $text = replace($text, $s, "")
  end
  for $m in re_find($text, '(?i)\bverbs?\b')
    push($bad, $rel)
    break
  end
end
if len($bad) > 0 then
  for $b in $bad
    print("terminology: " .. $b .. ": says \"verb\"; the word is \"command\" (Bus) or \"action\" (app registry)")
  end
  exit(1)
end
print("terminology: no \"verb\" outside history")
