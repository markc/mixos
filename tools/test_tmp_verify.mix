-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Run only on CBC, through cbc-build.mix --commit SHA.
$mix = realpath("/proc/" .. to_string(pid()) .. "/exe")
if contains(args(), "--format") then
  run_argv_must(["cargo", "fmt"], {timeout: 300})
  run_argv_must(["cargo", "metadata", "--format-version", "1"], {timeout: 300, max_output: 64000000})
  print(run_argv_must(["git", "diff"], {max_output: 64000000}))
  run_argv_must(["git", "checkout", "-q", "--", "."])
  exit(0)
end
if contains(args(), "--regressions") then
  $r = run_argv([$mix, "tools/test_tmp.mix", "cargo", "test", "--workspace", "--locked", "--no-fail-fast", "--test", "snapshot", "--test", "chooser_snapshot", "--test", "script_path_entry", "--test", "lint_notes", "--test", "lint_fix_and_pragmas", "--test", "owned_editor_pty"], {timeout: 7200, max_output: 64000000, stderr: "stdout"})
  print($r.stdout)
  if not $r.ok then exit(1) end
  exit(0)
end
-- Full sweeps are deliberately separate from the affected-crate recipes.
if contains(args(), "--whole-rust") or contains(args(), "--whole-mix") then
  $built = run_argv(["cargo", "build", "--workspace", "--all-targets", "--locked"], {timeout: 7200, max_output: 64000000, stderr: "stdout"})
  print($built.stdout)
  if not $built.ok then exit(1) end
  $fresh = realpath("target/debug/mix")
  $bin = dirname($fresh)
  $env = {MIXOS_TEST_MIX: $fresh, MIXOS_TEST_NODED: $bin .. "/noded", MIXOS_TEST_EDITD: $bin .. "/editd", MIXOS_TEST_DOPUS: $bin .. "/dopus"}
  $command = if contains(args(), "--whole-rust") then
    ["cargo", "test", "--workspace", "--locked", "--no-fail-fast"]
  else [$fresh, "tools/mix_tests.mix", "--bin", $bin] end
  for $pass = 1 to 2
    print("WHOLE PASS " .. to_string($pass) .. " " .. join($command, " "))
    $r = run_argv(concat([$mix, "tools/test_tmp.mix"], $command), {timeout: 7200, max_output: 64000000, stderr: "stdout", env: $env})
    print($r.stdout)
    if not $r.ok then exit(1) end
  end
  exit(0)
end
if contains(args(), "--lint") then
  $r = run_argv(["cargo", "clippy", "--locked", "--all-targets", "-p", "mimedb", "-p", "mix", "-p", "testkit", "-p", "slots", "-p", "maild", "-p", "mesh-sign", "-p", "mesh", "-p", "noded", "-p", "portald", "-p", "toolkit", "-p", "model", "-p", "scene-host", "-p", "prefs", "-p", "workshop", "--", "-D", "clippy::all", "-A", "clippy::module_inception", "-A", "clippy::too_many_arguments", "-A", "clippy::type_complexity", "-A", "clippy::large_enum_variant", "-A", "clippy::mutable_key_type"], {timeout: 7200, max_output: 64000000, stderr: "stdout"})
  print($r.stdout)
  if not $r.ok then exit(1) end
  exit(0)
end
if contains(args(), "--mail") then
  $r = run_argv([$mix, "tools/test_tmp.mix", "cargo", "test", "--locked", "-p", "maild", "--test", "native_bus_submission"], {timeout: 7200, max_output: 64000000, stderr: "stdout"})
  print($r.stdout)
  if not $r.ok then exit(1) end
  exit(0)
end
if contains(args(), "--extra") then
  for $pass = 1 to 2
    $r = run_argv([$mix, "tools/test_tmp.mix", "cargo", "test", "--locked", "-p", "mesh-sign", "-p", "mesh", "-p", "noded", "-p", "portald", "-p", "toolkit", "--no-fail-fast"], {timeout: 7200, max_output: 64000000, stderr: "stdout"})
    print($r.stdout)
    if not $r.ok then exit(1) end
  end
  exit(0)
end
if contains(args(), "--mix") then
  $built = run_argv(["cargo", "build", "--locked", "-p", "system", "-p", "noded"], {timeout: 7200, max_output: 64000000, stderr: "stdout"})
  print($built.stdout)
  if not $built.ok then exit(1) end
  $fresh = realpath("target/debug/mix")
  $noded = realpath("target/debug/noded")
  for $pass = 1 to 2
    print("MIX PASS " .. to_string($pass))
    for $script in ["tests/test_tmp_test.mix", "services/agentd/tests/agent_test.mix", "services/agentd/tests/log_test.mix", "services/agentd/tests/agent_cli_test.mix", "services/agentd/tests/agentd_test.mix", "services/agentd/tests/agentd_resume_test.mix", "services/compd/tests/scene_template_test.mix"]
      $r = run_argv([$mix, "tools/test_tmp.mix", $fresh, $script], {timeout: 600, max_output: 64000000, stderr: "stdout", env: {MIXOS_TEST_MIX: $fresh, MIXOS_TEST_NODED: $noded}})
      print($r.stdout)
      if not $r.ok then exit(1) end
    end
  end
  exit(0)
end
for $pass = 1 to 2
  print("PASS " .. to_string($pass))
  $r = run_argv([$mix, "tools/test_tmp.mix", "cargo", "test", "--locked", "-p", "mimedb", "-p", "workshop", "-p", "prefs", "-p", "testkit", "-p", "mix", "-p", "model", "-p", "slots", "-p", "scene-host", "--no-fail-fast"], {timeout: 7200, max_output: 64000000, stderr: "stdout"})
  print($r.stdout)
  if not $r.ok then exit(1) end
end
