  {name: "round 17: a literal that is only the return value of a match arm is not an answer (clean; the gate reads pattern literals only)", args: tree_args("rs-arm-rhs", "clean"), exit: 0, codes: [], text: ["verb-registry-gate: clean"], lock: ""},
