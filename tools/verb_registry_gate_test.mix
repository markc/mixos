  {name: "parse arm with no owner variant arm is not-answered (bus parse is no answer)", args: tree_args("parse-unanswered", "parse"), exit: 1, codes: ["not-answered"], text: ["noded.session.hello is declared at libs/bus/src/native_session/bootstrap.rs:"], absent: ["violation owner-mismatch"], lock: ""},
