  {name: "empty tree fails closed (no vacuous pass)", args: tree_args("empty", "empty"), exit: 2, codes: [], text: ["no verb registrations found"], lock: ""},
  {name: "unreadable directory fails closed (find error)", args: tree_args("unreadable", "empty"), exit: 2, codes: [], text: ["cannot-check scan: cannot list libs"], lock: $TREES .. "/unreadable/libs/locked"},
  {name: "inline test module skipped by brace balance; a production handler after it is read", args: tree_args("after-test", "after-test"), exit: 1, codes: ["unregistered"], text: ["unregistered: alpha.late (dispatch, owner alpha)"], absent: ["alpha.test_only"], lock: ""},
  {name: "match on method: unregistered literal read, HTTP tokens exempt", args: tree_args("method-match", "empty"), exit: 1, codes: ["unregistered"], text: ["unregistered: alpha.unreg_match (dispatch, owner alpha)"], absent: ["'GET'", "'HEAD'"], lock: ""},
  {name: "guard on method: unregistered literal read, HTTP tokens exempt", args: tree_args("method-guard", "empty"), exit: 1, codes: ["unregistered"], text: ["unregistered: alpha.unreg_guard (guard, owner alpha)"], absent: ["'HEAD'"], lock: ""},
