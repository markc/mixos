-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Regression fixtures for the verb registry gate (tools/verb_registry_gate.mix).
-- Each case runs the gate on a mini tree and registry under tools/fixtures/verb_gate,
-- or on bad arguments, and asserts the exit code, the violation codes and the
-- report text. The real tree is checked by the gate itself, not here.
-- Usage: mix tools/verb_registry_gate_test.mix
-- Exit: 0 every case passed, 1 a case failed, 2 the runner could not run.

$HERE = dirname(realpath($0))
$GATE = $HERE .. "/verb_registry_gate.mix"
$FIX = $HERE .. "/fixtures/verb_gate"
$TREES = $FIX .. "/trees"
$REGS = $FIX .. "/registries"

-- The gate's arguments for a fixture tree and a fixture registry, with no reviewed value
-- comparisons (exemptions/none.conf.mix), so an unreviewed comparison is a violation.
fn tree_args($tree, $reg)
  return ex_args($tree, $reg, "none")
end

-- The same, with a named fixture exemptions file (exemptions/NAME.conf.mix).
fn ex_args($tree, $reg, $ex)
  return ["--root", $TREES .. "/" .. $tree, "--registry", $REGS .. "/" .. $reg .. ".conf.mix", "--exemptions", $FIX .. "/exemptions/" .. $ex .. ".conf.mix"]
end

-- Runs the gate with these arguments; returns the process result, or nil.
fn run_gate($args)
  $argv = ["mix", $GATE]
  for each $a in $args
    push($argv, $a)
  end
  $res = nil
  try
    -- the default invocation scans the whole repo and takes minutes, so the timeout is 1500s
    $res = run_argv($argv, {timeout: 1500})
  catch $e
    eprint("verb-registry-gate-test: cannot run the gate: " .. to_string($e))
  end
  return $res
end

-- chmod a path to this mode; true when it worked.
fn set_mode($mode, $path)
  $res = nil
  try
    $res = run_argv(["chmod", $mode, $path], nil)
  catch $e
    return false
  end
  return $res.ok and $res.exit_code == 0
end

-- Each case: args for the gate, the exit code it must give, the violation codes
-- it must report, text it must print, and a directory to make unreadable ("" for none).
$CASES = [
  {name: "clean tree: every form, declared_by, tests skipped", args: tree_args("clean", "clean"), exit: 0, codes: [], text: ["verb-registry-gate: clean"], lock: ""},
  {name: "missed dispatch forms are read (offset, leading |, tuple, guard, prefix, on)", args: tree_args("forms", "forms"), exit: 1, codes: ["unregistered"], text: ["unregistered: x.form.offset ", "unregistered: x.form.leading ", "unregistered: x.form.tuple ", "unregistered: x.form.guard ", "unregistered: the prefix x.form.prefix.", "unregistered: x.form.on "], lock: ""},
  {name: "invalid literal is reported, not dropped", args: tree_args("bad-name", "bad-name"), exit: 1, codes: ["bad-name"], text: ["'Bad.Name' at apps/bad/src/main.rs:5"], lock: ""},
  {name: "two family patterns overlap", args: tree_args("clean", "family-overlap"), exit: 1, codes: ["family-overlap"], text: ["<app>.ui.* and <app>.ui.tree"], lock: ""},
  {name: "concrete verb also matched by a family", args: tree_args("clean", "double"), exit: 1, codes: ["double-registered", "registry-overlap"], text: [], lock: ""},
  {name: "answering component is not the owner", args: tree_args("clean", "owner-mismatch"), exit: 1, codes: ["owner-mismatch"], text: ["alpha.ping is owned by beta but answered by alpha"], lock: ""},
  {name: "declared_by missing: declaring component is not the owner", args: tree_args("clean", "declared-by"), exit: 1, codes: ["owner-mismatch"], text: ["edit.ping is declared by edit but owned by editd"], lock: ""},
  {name: "two components answer one verb", args: tree_args("conflict", "conflict"), exit: 1, codes: ["owner-conflict"], text: ["x.shared.verb is answered by more than one component: alpha, beta"], lock: ""},
  {name: "retired name still answered", args: tree_args("clean", "retired"), exit: 1, codes: ["retired-in-code"], text: ["alpha.ping is retired but still answered"], lock: ""},
  {name: "declared but unanswered, and registered with no code", args: tree_args("unanswered", "unanswered"), exit: 1, codes: ["not-answered", "not-in-code"], text: [], lock: ""},
  {name: "registry shape, protocol verb, duplicate, bad version", args: tree_args("clean", "registry-bad"), exit: 1, codes: ["registry-shape", "registry-protocol", "registry-duplicate", "registry-entry"], text: [], lock: ""},
  {name: "unloadable registry fails closed", args: tree_args("clean", "unloadable"), exit: 2, codes: [], text: ["cannot-check registry: cannot load"], lock: ""},
  {name: "missing --root directory fails closed", args: ["--root", $FIX .. "/no-such-root"], exit: 2, codes: [], text: ["is not a directory"], lock: ""},
  {name: "missing --registry file fails closed", args: ["--root", $TREES .. "/clean", "--registry", "no-such.conf.mix"], exit: 2, codes: [], text: ["cannot-check registry: cannot load"], lock: ""},
  {name: "unknown argument is a usage error", args: ["--bogus"], exit: 2, codes: [], text: ["usage:"], lock: ""},
  {name: "--root without a value is a usage error", args: ["--root"], exit: 2, codes: [], text: ["usage:"], lock: ""},
