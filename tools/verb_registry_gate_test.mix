  {name: "round 18 regression: the DEFAULT invocation (repo root, no arguments) is clean, with the fixture trees in the repo", args: [], exit: 0, codes: [], text: ["verb-registry-gate: clean"], lock: ""},
  {name: "round 15: lifetimes and loop labels stay code (clean, no unreadable literal)", args: tree_args("rs-lifetime-label", "alpha-field"), exit: 0, codes: [], text: ["verb-registry-gate: clean"], absent: ["unreadable literal"], lock: ""},
]

$ran = 0
$failed = 0
for each $c in $CASES
  $ran = $ran + 1
  $problems = []
  $skip = false
  $locked = false
  if $c.lock != "" then
    $locked = true
    $id = run_argv(["id", "-u"], nil)
    if trim($id.stdout) == "0" then
      $skip = true
      $locked = false
    elif not set_mode("000", $c.lock) then
      push($problems, "could not chmod 000 " .. $c.lock)
      $locked = false
    end
  end
  if $skip then
    print("SKIP " .. $c.name .. " (running as root: mode bits do not bind)")
  else
    $res = run_gate($c.args)
    if $res == nil then
      push($problems, "the gate did not run")
    else
      $out = $res.stdout .. $res.stderr
      if $res.exit_code != $c.exit then
        push($problems, "exit " .. to_string($res.exit_code) .. ", expected " .. to_string($c.exit))
      end
      for each $code in $c.codes
        if not contains($out, "violation " .. $code .. ":") then
          push($problems, "no violation " .. $code)
        end
      end
      for each $t in $c.text
        if not contains($out, $t) then
          push($problems, "output lacks: " .. $t)
        end
      end
      -- absent: text the output must NOT contain (a test-only literal, an HTTP token).
      if has_key($c, "absent") then
        for each $t in $c.absent
          if contains($out, $t) then
            push($problems, "output has: " .. $t)
          end
        end
      end
    end
  end
  if $locked then
    if not set_mode("755", $c.lock) then
      push($problems, "could not restore mode of " .. $c.lock)
    end
  end
  if $skip then
    -- counted as neither pass nor fail
  elif len($problems) == 0 then
    print("PASS " .. $c.name)
  else
    $failed = $failed + 1
    print("FAIL " .. $c.name)
    for each $p in $problems
      print("  " .. $p)
    end
  end
end

print("verb-registry-gate-test: " .. to_string($ran) .. " cases, " .. to_string($failed) .. " failed")
if $failed > 0 then
  exit(1)
end
exit(0)
