-- version: 0.1.0
-- Focused entry point for the command registry's webd source checks.
-- Merge note: installing this branch's CBC-built mix must land with the merge.
-- The gate requires lint schema 3 and fails closed on the older schema 2 binary.
$src = require("lib/command_registry_source.mix")
$root = dirname(dirname(realpath($0)))
if len(args()) != 0 then
  eprint("usage: mix tools/webd_lint.mix")
  exit(2)
end
$report = $src.check_vhosts($root)
for $problem in $report.problems
  print("webd_lint: " .. $problem)
end
print("webd_lint: " .. to_string($report.files) .. " files, " .. to_string(len($report.problems)) .. " errors")
if len($report.problems) != 0 then exit(1) end
